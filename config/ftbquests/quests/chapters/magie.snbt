	title: "&5Magie"
	quests: [
		{
			description: ["&6Was ist das?", "Mit Zauberbuechern wirkst du Zauber. Sie kosten Mana (blauer Balken).", "Mana stellt sich mit der Zeit wieder her.", "", "&6So gehts", "Du findest Schriftrollen mit Zaubern in Dungeons oder stellst sie her.", "Zauber kommen in ein Zauberbuch, das du wie eine Waffe ausruestest.", "", "&6Wofuer ist das wichtig?", "Magie ist eine Alternative zu Schwert und Bogen. Heilen, Teleportieren, Feuerbaelle und Beschwoerungen."]
			id: "9E42A216A64F391A"
			title: "Was ist Irons Spells?"
			rewards: [{ id: "8BB6BF94DD6946E2", type: "xp_levels", xp_levels: 1 }]
