		{
			dependencies: ["1F7C16EE6236AB7A"]
			description: ["&6Was ist das?", "Das Magie-Zeitalter hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Grundlagen, Zauberbücher, Runen, Magier-Ausrüstung, Magie-Waffen, Schmuck, Elixiere, Magier jagen.", "", "&6So gehts", "Wähle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofür ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins nächste. Nebenzweige kannst du jederzeit später machen."]
			icon: { id: "irons_spellbooks:iron_spell_book" }
			id: "5C54807EC3EC2CDC"
			title: "Beginn: Magie-Zeitalter"
			rewards: [{ id: "65E37EB4245C9FB2", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "706C72C41E79529B", type: "item", item: { id: "irons_spellbooks:iron_spell_book", count: 1 }, count: 1L }]
			shape: "hexagon"
			size: 1.5d
			x: 1.50d
			y: -3.00d
		}
		{
			dependencies: ["76DD817B2C61A19D"]
			description: ["&6Was ist das?", "Hier beginnt das Zeitalter der Welten. Es schaltet frei:", "Das Aether und der Zwielichtwald: Die Portale lassen dich jetzt durch.", "", "&6So gehts", "Schließe den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort für alle Spieler, auch für die, die gerade nicht online sind.", "", "&6Wofür ist das wichtig?", "Im nächsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus früheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "aether:golden_parachute" }
			id: "388349920682B0BC"
			title: "Zeitalter: Zeitalter der Welten"
			rewards: [{ id: "1C5EA4ED9B92E395", type: "historystages:history_stage", stage: "himmelszeit", remove: false, individual: false }, { id: "137FF82BB8A158CB", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "01A18DEFA71CDF83", type: "item", item: { id: "aether:golden_parachute", count: 1 }, count: 1L }]
			shape: "hexagon"
			size: 1.5d
			x: 7.50d
			y: 1.38d
		}
		{
			dependencies: ["3BEB5C9EE91D54CF"]
			description: ["&6Was ist das?", "Einzigartige Waffe mit besonderer Fähigkeit.", "Rezept oder Fundort siehe JEI (Item anklicken, R bzw. U drücken).", "Aus der Mod Simply Swords.", "", "&6So gehts", "Rezept oder Fundort: Item mit R in JEI nachschlagen. Einzigartige Waffen gibt es nur als Beute oder von Bossen.", "Fortschritt: Schwerter von Vanilla, Aether und Simply Swords baust du Stufe für Stufe. Die nächste Stufe braucht die vorherige Waffe im Rezept.", "Better Combat: Jede Waffenart hat eigene Kombos. Teste sie an der Trainingspuppe, der Tooltip zeigt Schaden und Tempo.", "", "&6Wofür ist das wichtig?", "Je stärker die Waffe, desto leichter die Bosse. Gute Verzauberungen: Schärfe, Plünderung, Haltbarkeit, Reparatur."]
			icon: { id: "simplyswords:frostfall" }
			hide_dependency_lines: true
