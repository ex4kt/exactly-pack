		}
		{
			dependencies: ["01E061C09C31FC15"]
			description: ["&6Was ist das?", "Du wählst einen Zauber aus und wirkst ihn.", "", "&6So gehts", "Die Tasten findest du unter Optionen, Steuerung, Kategorie Irons Spells. Meist wählst du den Zauber mit einem Rad und wirkst ihn mit der Wirk-Taste.", "Manche Zauber dauern, andere sind sofort fertig.", "", "&6Wofür ist das wichtig?", "Zauber sind dein Fernkampf und deine Verteidigung. Übe an leichten Gegnern."]
			id: "563A4ACACD81AA94"
			title: "Magie: Zauber wirken"
			rewards: [{ id: "4C00FCEF80B9259E", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2326F24B8673E1C6", type: "checkmark" }]
			x: 6.00d
			y: -4.50d
		}
		{
			dependencies: ["563A4ACACD81AA94"]
			description: ["&6Was ist das?", "Zauber sind in Schulen eingeteilt: Feuer, Eis, Blitz, Heilig, Ender, Blut, Evokation, Natur und Eldritch.", "", "&6So gehts", "Wähle eine Schule, die zu deinem Spielstil passt: Feuer für Schaden, Heilig zum Heilen, Eis zum Bremsen.", "Stäbe und Rüstungen verstärken oft eine bestimmte Schule.", "", "&6Wofür ist das wichtig?", "Wer eine Schule konzentriert ausbaut, wird deutlich stärker."]
			id: "07D7C3C2394446BC"
