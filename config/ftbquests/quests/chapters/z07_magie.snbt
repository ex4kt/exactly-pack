	title: "&dV. Magie-Zeitalter"
	quests: [
		{
			dependencies: ["5C54807EC3EC2CDC"]
			description: ["&6Was ist das?", "Mit Zauberbüchern wirkst du Zauber. Sie kosten Mana (blauer Balken).", "Mana stellt sich mit der Zeit wieder her.", "", "&6So gehts", "Du findest Schriftrollen mit Zaubern in Dungeons oder stellst sie her.", "Zauber kommen in ein Zauberbuch, das du wie eine Waffe ausrüstest.", "", "&6Wofür ist das wichtig?", "Magie ist eine Alternative zu Schwert und Bogen. Heilen, Teleportieren, Feuerbälle und Beschwörungen."]
			id: "46C833DCD22312A1"
			title: "Was ist Irons Spells?"
			rewards: [{ id: "1B98146C6D62439E", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "4899F4480F2DB606", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["46C833DCD22312A1"]
			description: ["&6Was ist das?", "Das Kupfer-Zauberbuch ist dein erstes Zauberbuch. Es gibt dir Platz für wenige Zauber.", "", "&6So gehts", "Rezept: links und rechts je 1 Kupferbarren in der oberen und unteren Reihe, dazu Papier und in der Mitte links 1 Faden (Muster in JEI, Taste R).", "Lege es in den Zauberbuch-Platz (Zubehör-Reiter).", "", "&6Wofür ist das wichtig?", "Ohne Zauberbuch kannst du keine Zauber wirken."]
			id: "3DAA1F6F53E0A842"
			title: "Zauberbuch"
			rewards: [{ id: "138D0773182C8F12", type: "item", item: { id: "minecraft:book", count: 2 } }]
			tasks: [{ id: "7826C8029F5FAA7F", type: "item", item: { id: "irons_spellbooks:copper_spell_book", count: 1 }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["3DAA1F6F53E0A842"]
			description: ["&6Was ist das?", "Am Inschriftentisch lernst du Zauber in dein Zauberbuch.", "", "&6So gehts", "Rezept: Buch oben rechts, 3 Holzstufen in der Mitte, 2 Zäune unten (Werkbank).", "Lege Zauberbuch und Schriftrolle hinein und klicke auf einen freien Platz.", "", "&6Wofür ist das wichtig?", "Grundlage der Magie."]
			id: "255A8186AF0DC2F0"
			title: "Inschriftentisch"
			rewards: [{ id: "74A04B57579CC26D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "6648C2BBD35E7356", type: "item", item: { id: "irons_spellbooks:inscription_table", count: 1 }, count: 1L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["255A8186AF0DC2F0"]
			description: ["&6Was ist das?", "Die Tasten findest du unter Optionen, Steuerung (Suche nach Spell).", "Schritt 1: Zauber im Buch auswählen.", "Schritt 2: Zaubern mit der Wirken-Taste.", "", "&6So gehts", "Taste R (Standard) wirkt, mit Mausrad oder Zauber-Rad wählst du.", "Mana unten zeigt, wie viel du noch hast.", "", "&6Wofür ist das wichtig?", "Zauber kosten Mana, das sich langsam auffüllt."]
			id: "1A9412A09F97208E"
			title: "Zauber wählen und wirken"
			rewards: [{ id: "7AA1E9A611C37A6D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "1440E3EA697F1DBC", type: "checkmark" }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["1A9412A09F97208E"]
			description: ["&6Was ist das?", "In der Schriftrollen-Schmiede stellst du Schriftrollen her.", "", "&6So gehts", "Rezept: 3 polierter Tiefenschiefer oben, darunter Weinender Obsidian: 1 in der Mitte, 3 unten (Werkbank). Weinenden Obsidian findest du im Nether.", "Lege Papier, Tinte und einen Zauberfokus hinein.", "", "&6Wofür ist das wichtig?", "Eigene Zauber erschaffen."]
			id: "658987F414C2C179"
			title: "Schriftrollen-Schmiede"
			rewards: [{ id: "79D425193CFCF804", type: "item", item: { id: "minecraft:paper", count: 8 } }]
