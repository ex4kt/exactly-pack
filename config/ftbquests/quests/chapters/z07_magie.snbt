		{
			dependencies: ["46C833DCD22312A1"]
			description: ["&6Was ist das?", "Zauber kosten Mana. Die blaue Leiste im Bild zeigt dein Mana, sie fuellt sich mit der Zeit wieder auf.", "", "&6So gehts", "Baue ein Zauberbuch und trage es in seinem Accessoire-Platz. Es bestimmt, wie viele Zauber du ausruesten kannst.", "Ein Mana-Ring (Kapitel unten) erhoeht dein Mana.", "", "&6Wofuer ist das wichtig?", "Ohne Mana und Buch kannst du nicht zaubern. Das ist die Basis fuer alles in diesem Kapitel."]
			id: "9E9363E2414872E0"
			title: "Magie: Mana und Zauberbuch"
			rewards: [{ id: "C01A6162A6F08F17", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "19D09413A8C6D10B", type: "checkmark" }]
			x: 4.50d
			y: -3.00d
		}
		{
			dependencies: ["9E9363E2414872E0"]
			description: ["&6Was ist das?", "Zauber kommen aus Schriftrollen. Du findest sie in Truhen oder stellst sie an der Schriftrollen-Schmiede her.", "", "&6So gehts", "Lege die Schriftrolle am Inschriftentisch in dein Zauberbuch.", "", "&6Wofuer ist das wichtig?", "Jeder Zauber gehoert zu einer Schule. Gute Zauber haben hoehere Seltenheit und Stufe."]
			id: "01E061C09C31FC15"
			title: "Magie: Zauber lernen"
			rewards: [{ id: "2066469102073E28", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "77A00A588D20506D", type: "checkmark" }]
			x: 6.00d
			y: -3.00d
		}
		{
			dependencies: ["01E061C09C31FC15"]
			description: ["&6Was ist das?", "Du waehlst einen Zauber aus und wirkst ihn.", "", "&6So gehts", "Die Tasten findest du unter Optionen, Steuerung, Kategorie Irons Spells. Meist waehlst du den Zauber mit einem Rad und wirkst ihn mit der Wirk-Taste.", "Manche Zauber dauern, andere sind sofort fertig.", "", "&6Wofuer ist das wichtig?", "Zauber sind dein Fernkampf und deine Verteidigung. Uebe an leichten Gegnern."]
			id: "D924641E3CA1D470"
			title: "Magie: Zauber wirken"
			rewards: [{ id: "4C00FCEF80B9259E", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2326F24B8673E1C6", type: "checkmark" }]
			x: 7.50d
			y: -3.00d
		}
		{
			dependencies: ["D924641E3CA1D470"]
			description: ["&6Was ist das?", "Zauber sind in Schulen eingeteilt: Feuer, Eis, Blitz, Heilig, Ender, Blut, Evokation, Natur und Eldritch.", "", "&6So gehts", "Waehle eine Schule, die zu deinem Spielstil passt: Feuer fuer Schaden, Heilig zum Heilen, Eis zum Bremsen.", "Staebe und Ruestungen verstaerken oft eine bestimmte Schule.", "", "&6Wofuer ist das wichtig?", "Wer eine Schule konzentriert ausbaut, wird deutlich staerker."]
			id: "07D7C3C2394446BC"
			title: "Magie: Schulen der Magie"
			rewards: [{ id: "63AFC98D5F9D8ADE", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "5436A3E3FF9C5E91", type: "checkmark" }]
			x: 9.00d
			y: -3.00d
		}
		{
			dependencies: ["07D7C3C2394446BC"]
			description: ["&6Was ist das?", "Magieausruestung erhoeht Zauberkraft, Mana und senkt die Abklingzeit.", "", "&6So gehts", "Staebe verstaerken Zauber. Ruestungen der Schulen geben passende Boni. Ringe und Amulette (Abschnitt unten) senken Abklingzeit und Wirkzeit.", "", "&6Wofuer ist das wichtig?", "Gute Ausruestung ist wichtiger als hohe Stufen alleine."]
			id: "694866570148F85F"
			title: "Magie: Ausruestung"
			rewards: [{ id: "C1C15BD179A63CD9", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "38888AC9CBE9B575", type: "checkmark" }]
			x: 10.50d
			y: -3.00d
		}
		{
			dependencies: ["694866570148F85F"]
			description: ["&6Was ist das?", "Die Bosse dieses Zeitalters sind Kryomant, Totenbeschwoerer, Erz-Beschwoerer, Feuerboss und der Tote Koenig.", "", "&6So gehts", "Schaue dir jede Boss-Quest im Hauptpfad an. Bereite Heilung, Magie-Ruestung und passende Zauber vor.", "", "&6Wofuer ist das wichtig?", "Sie geben seltene Beute und sind Pflicht fuer den Aufstieg in die naechste Epoche."]
