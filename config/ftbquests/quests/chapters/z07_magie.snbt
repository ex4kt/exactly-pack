			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["658987F414C2C179"]
			description: ["&6Was ist das?", "Arkane Essenz ist die wichtigste Zutat der Magie.", "", "&6So gehts", "Du findest sie in Truhen: Magier-Türme, Katakomben, Zitadelle, Eisspinnen-Bau, Bibliotheken, Alte Stadt, Trial Chambers.", "Auch Zauberer lassen sie fallen: Pyromant, Kryomant, Totenbeschwörer, Priester, Apotheker, Archevoker, Kultist.", "", "&6Wofür ist das wichtig?", "Für Bücher, Stäbe, Runen, Rüstung und Tinte."]
			id: "76F11D27CBE5A57F"
			title: "Arkane Essenz"
			rewards: [{ id: "6A9BD2231B54663C", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "759E5492CC14D944", type: "item", item: { id: "irons_spellbooks:arcane_essence", count: 1 }, count: 4L }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["76F11D27CBE5A57F"]
			description: ["&6Was ist das?", "Tinte braucht die Schriftrollen-Schmiede. Bessere Tinte macht stärkere Schriftrollen.", "", "&6So gehts", "In der Alchemie herstellen.", "", "&6Wofür ist das wichtig?", "Höhere Tinte ergibt stärkere Schriftrollen.", "", "&6Gut zu wissen", "Die Tinte bestimmt die Seltenheit des Zaubers, den du auf die Schriftrolle schreibst. Bessere Tinte erlaubt stärkere Zauber."]
			id: "6418DDFDACD70044"
			title: "Tinte"
			rewards: [{ id: "23AE727EFD3C42F8", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "1BA2BF7826D2EE31", type: "item", item: { id: "irons_spellbooks:common_ink", count: 1 }, count: 1L }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["6418DDFDACD70044"]
			description: ["&6Was ist das?", "Der Alchemistenkessel braut Tränke und Elixiere der Magie.", "", "&6So gehts", "Werkbank: 5 Eisenbarren, 1 Kessel, 2 Arkane Essenz und 1 Aschenessenz (Muster in JEI, Taste R).", "", "&6Wofür ist das wichtig?", "Heiltränke und Elixiere für Kämpfe."]
