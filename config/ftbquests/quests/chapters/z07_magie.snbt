		{
			dependencies: ["53528799012DD531"]
			description: ["&6Was ist das?", "Der Pyromant ist ein Feuer-Magier und dein erster Zauberer-Gegner.", "", "&6So gehts", "Suche einen Pyromanten-Turm in der Oberwelt. Dort steht der Pyromant.", "Nimm Feuerresistenz-Trank, Wasser-Eimer und gute Rüstung mit. Er wirft Feuerbälle.", "Geh nah ran und schlage zu, solange er nachlädt. Weiche den Feuerbällen seitlich aus.", "", "&6Wofür ist das wichtig?", "Er lässt Arkane Essenz und Schriftrollen fallen. Damit geht die Magie-Linie weiter.", "", "&6Gut zu wissen", "Auf dem Turm liegen Truhen mit Beute. Nimm sie mit."]
			id: "3BEB5C9EE91D54CF"
			hide_dependent_lines: true
			title: "Zauberer jagen"
			rewards: [{ id: "16468B41E572C384", type: "item", item: { id: "minecraft:experience_bottle", count: 8 } }]
			tasks: [{ id: "4D18A49A6BB25B55", type: "kill", entity: "irons_spellbooks:pyromancer", value: 1L, icon: { id: "irons_spellbooks:fire_upgrade_orb" } }]
			x: 15.00d
			y: 0.00d
		}
		{
			dependencies: ["3BEB5C9EE91D54CF"]
			description: ["&6Was ist das?", "Der Kryomant beherrscht Eis und Frost.", "", "&6So gehts", "Du findest ihn in Eis-Strukturen in kalten Gebieten (Magier-Turm im Gebirge).", "Nimm Heilung und gute Rüstung mit. Er friert dich mit Eiszaubern ein.", "Greife ihn im Nahkampf an, wenn er nachlädt.", "", "&6Wofür ist das wichtig?", "Er lässt Arkane Essenz und Eis-Schriftrollen fallen."]
			id: "7752AE4A249A5EB3"
			title: "Der Kryomant"
			rewards: [{ id: "7CB6F0C9B2921628", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "44901E7CD8B1496B", type: "kill", entity: "irons_spellbooks:cryomancer", value: 1L, icon: { id: "irons_spellbooks:ice_upgrade_orb" } }]
			x: 16.50d
			y: 4.50d
		}
		{
			dependencies: ["7752AE4A249A5EB3"]
			description: ["&6Was ist das?", "Der Necromancer, ein Magier, der Skelette und Zombies ruft.", "", "&6Wo findest du ihn?", "In den Katakomben von Iron's Spells unter der Oberwelt (in vielen Biomen: Wald, Taiga, Ebene, Wüste, Sumpf, Hügel).", "", "&6Was brauchst du?", "Gute Rüstung, Bogen oder Fernkampf-Zauber, Heilung.", "", "&6So gehts", "Erst seine Diener erledigen, dann ihn. Er hält Abstand: verfolge ihn oder schieße.", "", "&6Beute", "Arkane Essenz und Schriftrollen."]
			id: "1C765747185689E7"
			title: "Der Totenbeschwörer"
			rewards: [{ id: "01CA078F49250E93", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "7F820E0EB40E1930", type: "kill", entity: "irons_spellbooks:necromancer", value: 1L, icon: { id: "irons_spellbooks:evocation_upgrade_orb" } }]
			x: 18.00d
			y: 4.50d
		}
		{
			dependencies: ["1C765747185689E7"]
			description: ["&6Was ist das?", "Kultisten sind dunkle Magier. Sie rufen Gehilfen.", "", "&6So gehts", "Sie stehen in den Katakomben und anderen dunklen Strukturen der Oberwelt.", "Töte erst die Gehilfen, dann den Kultisten. Bringe Heilung mit.", "", "&6Wofür ist das wichtig?", "Beute für Magier: Arkane Essenz und Schriftrollen."]
			id: "5F1780F474913F9F"
			title: "Kultisten"
			rewards: [{ id: "2DACDB000DFDEA4A", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "1267B6B9B1FEE8B4", type: "kill", entity: "irons_spellbooks:cultist", value: 1L, icon: { id: "irons_spellbooks:blood_rune" } }]
			x: 19.50d
			y: 4.50d
		}
		{
			dependencies: ["5F1780F474913F9F"]
			description: ["&6Was ist das?", "Der Apotheker wirft Tränke mit Gift und Schwäche.", "", "&6So gehts", "Er lebt in Hütten und Türmen der Oberwelt. Das Mangrovenhaus im Sumpf ist ein Ort dafür.", "Nimm Milch mit, die macht Gift unwirksam. Dann greifst du direkt an.", "", "&6Wofür ist das wichtig?", "Er lässt Zutaten und Arkane Essenz fallen. Damit braust du Tränke in der Alchemie."]
			id: "5340EC175AEFCBE3"
			title: "Apotheker"
			rewards: [{ id: "681A94235C307224", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "60D4F76BB53ADAB5", type: "kill", entity: "irons_spellbooks:apothecarist", value: 1L, icon: { id: "minecraft:brewing_stand" } }]
			x: 21.00d
			y: 4.50d
		}
		{
			dependencies: ["1C765747185689E7"]
			description: ["&6Was ist das?", "Der Archevoker ist ein mächtiger Magier der Illager.", "", "&6So gehts", "Er wohnt im Evoker-Fort der Oberwelt. Nimm viele Heiltränke und Rüstung mit.", "Er beschwört Vexe und schießt Magie. Erledige zuerst die Vexe oder renne am Fort vorbei und schlage zu.", "", "&6Wofür ist das wichtig?", "Er lässt seltene Beute und Arkane Essenz fallen."]
			id: "6145C3A0D3F0E332"
			title: "Der Erz-Beschwörer"
			rewards: [{ id: "0A20A8304BCDF74E", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "5588FBBC572B6D53", type: "kill", entity: "irons_spellbooks:archevoker", value: 1L, icon: { id: "irons_spellbooks:evocation_rune" } }]
			x: 19.50d
			y: 6.00d
		}
		{
			dependencies: ["5340EC175AEFCBE3"]
			description: ["&6Was ist das?", "Der Uralte Ritter bewacht die Zitadelle im Nether.", "", "&6So gehts", "Die Zitadelle liegt in der Bastion-Ruine (Nether).", "Nimm Feuerresistenz, Heilung und Netherit- oder gute Magie-Rüstung mit.", "Er schlägt hart mit dem Flamberge. Weiche aus und greife nach seinen Hieben an.", "", "&6Wofür ist das wichtig?", "Beute: Aschenessenz und Netheritplatten, wichtig für Magie-Waffen."]
			id: "04EF5409B5EAB371"
			title: "Zitadellen-Wächter"
			rewards: [{ id: "474C0024744EA290", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "2CAC1FC9CED15FCB", type: "kill", entity: "irons_spellbooks:citadel_keeper", value: 1L, icon: { id: "irons_spellbooks:arcane_essence" } }]
			x: 22.50d
			y: 4.50d
		}
		{
			dependencies: ["04EF5409B5EAB371"]
			description: ["&6Was ist das?", "Die Eisspinne lebt in einem Bau im Schnee.", "", "&6So gehts", "Suche in kalten Gebieten nach einem Eisspinnen-Bau. Er liegt oft unter Eis.", "Sie vergiftet und verlangsamt dich. Milch hilft dagegen.", "Schlage zu, sobald sie dich erreicht.", "", "&6Wofür ist das wichtig?", "Im Bau liegen Truhen mit Eis-Beute und Arkaner Essenz."]
			id: "30A1A33A3BB96820"
			title: "Eisspinne"
			rewards: [{ id: "37B4E7660278B55E", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "55FDDB544DBD2A02", type: "kill", entity: "irons_spellbooks:ice_spider", value: 1L, icon: { id: "irons_spellbooks:ice_spider_egg" } }]
			x: 24.00d
			y: 4.50d
		}
		{
			dependencies: ["6145C3A0D3F0E332"]
			description: ["&6Was ist das?", "Echo von Tyros, dem Ersten Flammenträger: der Feuerboss von Iron's Spells.", "", "&6Wo findest du ihn?", "Er wird in der Zitadelle im Nether gerufen, an einer Aschenen Seelenrune.", "", "&6Was brauchst du?", "Einen Aschenen Seelenrufer (Rezept in JEI, braucht Aschenessenz vom Uralten Ritter). Dazu Feuerresistenz, Heilung, starke Rüstung.", "", "&6So gehts", "Benutze den Seelenrufer bei der Seelenrune. Tyros greift mit Feuer an: Feuerresistenz-Trank vorher trinken, in Bewegung bleiben.", "", "&6Beute", "Arkane Essenz, Aschenessenz, Göttlicher Seelensplitter, seltene Waffen und für jeden Spieler ein Verfallener Schlüssel."]
			id: "34D1BD35BFBDF3D8"
			title: "Feuerboss"
			rewards: [{ id: "341A79464A4B3AA5", type: "item", item: { id: "minecraft:diamond", count: 4 } }]
			tasks: [{ id: "78468FD53B562EDC", type: "kill", entity: "irons_spellbooks:fire_boss", value: 1L, icon: { id: "irons_spellbooks:cinder_essence" } }]
			x: 21.00d
			y: 6.00d
		}
		{
			dependencies: ["34D1BD35BFBDF3D8"]
			description: ["&6Was ist das?", "Der Tote König ist der Endboss der Katakomben.", "", "&6So gehts", "Wo: In den Katakomben unter der Oberwelt. Wayward-Kompass hilft beim Suchen (Rezept: 4 Arkane Essenz, 4 Eisenbarren, Seelenlaterne).", "Vorbereitung: gute Rüstung, Heilung, Fernkampf. Räume zuerst die Katakomben-Zombies, Skelette und Totenbeschwörer.", "Er beschwört Untote und wirft Blutzauber. Weiche aus und greife an, wenn er nachlädt.", "Beute: Blutstab, Arkane Essenz, leere Runen, Musikplatte.", "", "&6Wofür ist das wichtig?", "Nach ihm ist der Weg zum Zeitalter der Welten frei.", "", "&6Gut zu wissen", "Sein Phylakterium kannst du aus Splittern bauen, wenn du ihn nochmal rufen willst."]
			id: "76DD817B2C61A19D"
			title: "Der Tote König"
			rewards: [{ id: "1DE8EEBB25F65E1A", type: "item", item: { id: "minecraft:diamond", count: 5 } }]
			tasks: [{ id: "67918124991ACF60", type: "kill", entity: "irons_spellbooks:dead_king", value: 1L, icon: { id: "irons_spellbooks:legendary_ink" } }]
			x: 22.50d
			y: 6.00d
		}
		{
			dependencies: ["1F7C16EE6236AB7A"]
			description: ["&6Was ist das?", "Das Magie-Zeitalter hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Grundlagen, Zauberbücher, Runen, Magier-Ausrüstung, Magie-Waffen, Schmuck, Elixiere, Magier jagen.", "", "&6So gehts", "Wähle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofür ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins nächste. Nebenzweige kannst du jederzeit später machen."]
			icon: { id: "irons_spellbooks:iron_spell_book" }
			id: "5C54807EC3EC2CDC"
			title: "Beginn: Magie-Zeitalter"
			rewards: [{ id: "65E37EB4245C9FB2", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "706C72C41E79529B", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["76DD817B2C61A19D"]
			description: ["&6Was ist das?", "Hier beginnt das Zeitalter der Welten. Es schaltet frei:", "Der Aether und der Zwielichtwald: Die Portale lassen dich jetzt durch.", "", "&6So gehts", "Schließe den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort für alle Spieler, auch für die, die gerade nicht online sind.", "", "&6Wofür ist das wichtig?", "Im nächsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus früheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "aether:golden_parachute" }
			id: "388349920682B0BC"
			title: "Zeitalter: Zeitalter der Welten"
			rewards: [{ id: "1C5EA4ED9B92E395", type: "historystages:history_stage", stage: "himmelszeit", remove: false, individual: false }, { id: "137FF82BB8A158CB", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "01A18DEFA71CDF83", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 24.00d
			y: 6.00d
		}
		{
			dependencies: ["5C54807EC3EC2CDC"]
			description: ["&6Was ist das?", "Die Void Blossom ist eine riesige Pflanze in der Tiefe.", "", "&6So gehts", "Verzauberte Diamantrüstung, Heiltränke, Spruchbuch. Zerstöre die Ranken zuerst.", "", "&6Wofür ist das wichtig?", "Erster Boss der Magiezeit."]
			id: "449BF7C358F0A86C"
			title: "Blütenschreck"
			rewards: [{ id: "33862D9390601465", type: "xp_levels", xp_levels: 10 }, { id: "462E44916F097851", type: "item", item: { id: "minecraft:diamond", count: 5 } }]
			tasks: [{ id: "1EA7D860FE61C624", type: "kill", entity: "bosses_of_mass_destruction:void_blossom", value: 1L, icon: { id: "minecraft:flowering_azalea" } }]
			x: 1.50d
			y: 1.50d
		}
		{
			dependencies: ["449BF7C358F0A86C"]
			description: ["&6Was ist das?", "Der Lich aus Bosses of Mass Destruction (siehe auch Kapitel Bosse der Zerstörung).", "", "&6Wo findest du ihn?", "Im Lich-Turm in kalten Biomen (verschneite Taiga, Ebenen, Hänge, Eiszapfen, gefrorene Gipfel).", "", "&6Was brauchst du?", "4 Seelensterne: nach je 50 besiegten Untoten fällt einer. In die Luft geworfen fliegt er Richtung Turm.", "", "&6So gehts", "Im Turm die 4 Gemeißelten Steinaltäre mit je einem Seelenstern füllen. 300 Leben, verlangsamende Geschosse und Kometen: Fernkampf und ausweichen.", "", "&6Beute", "Antike Anima, Diamanten, Bücher."]
			id: "54937D4D0780D58C"
			title: "Lich"
			rewards: [{ id: "21F8299FEEE3BD43", type: "xp_levels", xp_levels: 10 }, { id: "7316109A7525F144", type: "item", item: { id: "minecraft:diamond", count: 5 } }]
			tasks: [{ id: "01D3FC736ABBF0C5", type: "kill", entity: "bosses_of_mass_destruction:lich", value: 1L, icon: { id: "minecraft:soul_lantern" } }]
			x: 3.00d
			y: 1.50d
		}
		{
			dependencies: ["3DAA1F6F53E0A842"]
