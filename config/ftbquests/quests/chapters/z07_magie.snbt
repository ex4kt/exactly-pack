		{
			dependencies: ["1F7C16EE6236AB7A"]
			description: ["&6Was ist das?", "Das Magie-Zeitalter hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Grundlagen, Zauberbuecher, Runen, Magier-Ausruestung, Magie-Waffen, Schmuck, Elixiere, Magier jagen.", "", "&6So gehts", "Waehle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofuer ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins naechste. Nebenzweige kannst du jederzeit spaeter machen."]
			icon: { id: "irons_spellbooks:iron_spell_book" }
			id: "5C54807EC3EC2CDC"
			title: "Beginn: Magie-Zeitalter"
			rewards: [{ id: "65E37EB4245C9FB2", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "706C72C41E79529B", type: "item", item: { id: "irons_spellbooks:iron_spell_book", count: 1 }, count: 1L }]
			shape: "hexagon"
			size: 1.5d
			x: 1.50d
			y: -3.00d
		}
		{
			dependencies: ["76DD817B2C61A19D"]
			description: ["&6Was ist das?", "Hier beginnt das Zeitalter der Welten. Es schaltet frei:", "Das Aether und der Zwielichtwald: Die Portale lassen dich jetzt durch.", "", "&6So gehts", "Schliesse den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort fuer alle Spieler, auch fuer die, die gerade nicht online sind.", "", "&6Wofuer ist das wichtig?", "Im naechsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus frueheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "aether:golden_parachute" }
			id: "388349920682B0BC"
			title: "Zeitalter: Zeitalter der Welten"
			rewards: [{ id: "1C5EA4ED9B92E395", type: "historystages:history_stage", stage: "himmelszeit", remove: false, individual: false }, { id: "137FF82BB8A158CB", type: "xp_levels", xp_levels: 5 }]
