		{
			dependencies: ["D118FFCA6AB4CDE4"]
			description: ["&6Was ist das?", "Client Sort und Inventory Profiles Next sortieren dein Inventar und Kisten.", "Client Sort: Shift und mittlere Maustaste.", "", "&6So gehts", "Oeffne eine Kiste. Rechts oben erscheinen kleine Knoepfe zum Sortieren.", "Mit Client Sort: Shift halten und mittlere Maustaste im Inventar.", "", "&6Wofuer ist das wichtig?", "Spart viel Zeit. Mit Profilen kannst du auch Ausruestungs-Sets schnell wechseln."]
			id: "7C3CAF1D69D38273"
