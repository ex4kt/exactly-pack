		{
			dependencies: ["462876583536DBDA"]
			description: ["&6Was ist das?", "Im Tisch siehst du Hinweise, welche Verzauberungen du ungefähr bekommen wirst.", "", "&6So gehts", "Lege einen Gegenstand und Lapis in den Tisch und wähle eine der drei Stufen.", "", "&6Wofür ist das wichtig?", "Du kannst vorher entscheiden, ob sich die Stufe lohnt."]
			icon: { id: "minecraft:enchanting_table" }
