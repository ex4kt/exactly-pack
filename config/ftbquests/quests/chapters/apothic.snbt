		}
		{
			dependencies: ["7C303C5E4B7608E0"]
			description: ["&6Was ist das?", "Apothic Enchanting baut den Verzauberungstisch stark aus. Mit Regalen steuerst du, was du verzauberst und wie stark.", "", "&6So gehts", "Diese Anleitung führt dich in kleinen Schritten: Tisch, Regale, die drei Werte (Eterna, Quanta, Arcana), erste Verzauberung, Bibliothek.", "", "&6Wofür ist das wichtig?", "Mit gutem Aufbau bekommst du viel stärkere Verzauberungen als im normalen Spiel."]
			id: "4CB07467E3856DE3"
			title: "Verzauberung: Überblick"
			rewards: [{ id: "79B54E29085FD548", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "360C1BEDFEB12BF3", type: "checkmark" }]
			x: 1.50d
			y: 7.50d
		}
		{
			dependencies: ["4CB07467E3856DE3"]
			description: ["&6Was ist das?", "Der Apothic-Tisch ist der erweiterte Verzauberungstisch.", "", "&6So gehts", "Baue ihn wie den normalen Tisch oder wandle einen normalen Tisch um. Das Rezept zeigt dir das Rezeptbuch: Maus aufs Item und R drücken.", "", "&6Wofür ist das wichtig?", "Er zeigt dir die Werte Eterna, Quanta und Arcana und erlaubt viele zusätzliche Regale."]
			id: "5D15724A898B5ABF"
			title: "Verzauberung: Tisch bauen"
			rewards: [{ id: "08144D7623D60F5B", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "0AE144EEF31DB98E", type: "checkmark" }]
			x: 3.00d
			y: 7.50d
		}
		{
			dependencies: ["5D15724A898B5ABF"]
			description: ["&6Was ist das?", "Regale um den Tisch geben ihm Kraft.", "", "&6So gehts", "Stelle Regale in einem Ring um den Tisch, jeweils mit einem Block Abstand (also mit Luft dazwischen). Einfache Regale sind der Anfang.", "", "&6Wofür ist das wichtig?", "Mehr Regale heißt mehr Eterna und damit höhere Verzauberungsstufen."]
			id: "0F6726590BA97C2E"
			title: "Verzauberung: Erste Regale"
			rewards: [{ id: "7D87C696A4FEB92D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "1D25A169EAA64FAE", type: "checkmark" }]
			x: 4.50d
			y: 7.50d
		}
		{
			dependencies: ["0F6726590BA97C2E"]
			description: ["&6Was ist das?", "Eterna ist die Stärke: Sie bestimmt, wie hoch die Stufe deiner Verzauberung werden kann.", "", "&6So gehts", "Schaue im Tisch auf die Anzeige. Steinregale und bessere Regale erhöhen Eterna. Die Quests unten zeigen, welches Regal was gibt.", "", "&6Wofür ist das wichtig?", "Für hohe Stufen brauchst du viel Eterna."]
			id: "552BD35F16BFD31E"
			title: "Verzauberung: Eterna"
			rewards: [{ id: "6C8AFA6D057571FB", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "446F880CB5B97EE4", type: "checkmark" }]
			x: 6.00d
			y: 7.50d
		}
		{
			dependencies: ["552BD35F16BFD31E"]
			description: ["&6Was ist das?", "Quanta ist der Zufall: Sie bestimmt, wie stark die angebotenen Verzauberungen schwanken.", "", "&6So gehts", "Manche Regale (zum Beispiel Bienen- und Melonenregal) verändern Quanta. Ein hoher Wert macht Ergebnisse unberechenbar, aber oft mächtiger.", "", "&6Wofür ist das wichtig?", "Mit Quanta bekommst du seltene Glückstreffer."]
			id: "7953D1415A72E055"
			title: "Verzauberung: Quanta"
			rewards: [{ id: "5C9CF8C22671D9C3", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "63513A3B40E36EBE", type: "checkmark" }]
			x: 7.50d
			y: 7.50d
		}
		{
			dependencies: ["7953D1415A72E055"]
			description: ["&6Was ist das?", "Arcana ist die Vielfalt: Sie bestimmt, welche Arten von Verzauberungen angeboten werden.", "", "&6So gehts", "Höhere Arcana schaltet seltene Verzauberungen frei. Arcana kommt aus besonderen Regalen (z. B. Nether-, See-, Tiefen- und Endregale).", "", "&6Wofür ist das wichtig?", "Für die besten Verzauberungen brauchst du hohe Arcana."]
			id: "452670B269C91C4A"
			title: "Verzauberung: Arcana"
			rewards: [{ id: "0CF207610BECE9DB", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2DA4FD616DA36E0B", type: "checkmark" }]
			x: 9.00d
			y: 7.50d
		}
		{
			dependencies: ["452670B269C91C4A"]
			description: ["&6Was ist das?", "Im Tisch siehst du Hinweise, welche Verzauberungen möglich sind.", "", "&6So gehts", "Bewege die Maus über die Stufen im Tisch. Du siehst eine Verzauberung als Tipp. Ändere Regale, bis die gewünschte erscheint.", "", "&6Wofür ist das wichtig?", "So planst du gezielt, statt nur zu raten."]
			id: "1422043FBDAD21A1"
