		{
			dependencies: ["7C303C5E4B7608E0"]
			description: ["&6Was ist das?", "Eterna ist die Stärke deines Verzauberungstischs. Sie bestimmt, wie hoch die Stufe der Verzauberung sein kann.", "", "&6So gehts", "Eterna kommt von den Regalen um den Tisch. Fahre mit der Maus über den Tisch, um den Wert zu sehen.", "", "&6Wofür ist das wichtig?", "Ohne genug Eterna bleiben starke Verzauberungen unerreichbar."]
			icon: { id: "minecraft:lapis_lazuli" }
			id: "38115819797BA204"
			title: "Eterna: Stärke"
			rewards: [{ id: "4708139E1946CA77", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "4123494EEFB7488A", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["38115819797BA204"]
			description: ["&6Was ist das?", "Quanta bestimmt, wie stark die Stufe der Verzauberung schwanken kann, also wie viel Zufall im Spiel ist.", "", "&6So gehts", "Auch Quanta kommt von den Regalen. Im Tisch siehst du den Wert.", "", "&6Wofür ist das wichtig?", "Mit gezielter Quanta kannst du Ergebnisse verlässlicher oder mutiger machen."]
			icon: { id: "minecraft:amethyst_shard" }
			id: "5EA3EE051D0B69AB"
			title: "Quanta: Zufall"
			rewards: [{ id: "1BD2D545C17C1331", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "609F4C49E90B735A", type: "checkmark" }]
			x: 3.00d
			y: -7.50d
		}
		{
			dependencies: ["5EA3EE051D0B69AB"]
			description: ["&6Was ist das?", "Arcana bestimmt, wie viele und wie seltene Verzauberungen zusammen auf einem Gegenstand landen können.", "", "&6So gehts", "Arcana kommt ebenfalls von den Regalen. Mehr Arcana bedeutet mehr Verzauberungen auf einmal.", "", "&6Wofür ist das wichtig?", "Für Gegenstände mit vielen guten Verzauberungen gleichzeitig."]
			icon: { id: "minecraft:ender_eye" }
			id: "462876583536DBDA"
			title: "Arcana: Vielfalt"
