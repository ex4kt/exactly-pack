			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: ["5EA3EE051D0B69AB"]
			description: ["&6Was ist das?", "Arcana bestimmt, wie viele und wie seltene Verzauberungen zusammen auf einem Gegenstand landen koennen.", "", "&6So gehts", "Arcana kommt ebenfalls von den Regalen. Mehr Arcana bedeutet mehr Verzauberungen auf einmal.", "", "&6Wofuer ist das wichtig?", "Fuer Gegenstaende mit vielen guten Verzauberungen gleichzeitig."]
			icon: { id: "minecraft:ender_eye" }
			id: "462876583536DBDA"
