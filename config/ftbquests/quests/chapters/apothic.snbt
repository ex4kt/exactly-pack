		{
			dependencies: ["6D2FCC0F6ED488B9", "7AD3F56EE2DA5961", "1068BF974B3CF68E", "7E8A4C888E9CEA2A"]
			description: ["&6Was ist das?", "Du hast die höchsten Regale jeder Art gebaut. Damit hast du alles in diesem Kapitel erreicht.", "", "&6So gehts", "Baue die vier erfüllten Regale (Hölle, See, Tiefe, Ende) und stelle sie rund um einen Verzauberungstisch.", "", "&6Wofür ist das wichtig?", "Dein Tisch kann jetzt die besten Verzauberungen anbieten."]
