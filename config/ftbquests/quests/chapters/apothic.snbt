		{
			dependencies: ["AE10000000000001"]
			description: ["&6Was ist das?", "Eterna ist die Staerke deines Verzauberungstischs. Sie bestimmt, wie hoch die Stufe der Verzauberung sein kann.", "", "&6So gehts", "Eterna kommt von den Regalen um den Tisch. Fahre mit der Maus ueber den Tisch, um den Wert zu sehen.", "", "&6Wofuer ist das wichtig?", "Ohne genug Eterna bleiben starke Verzauberungen unerreichbar."]
			icon: { id: "minecraft:lapis_lazuli" }
			id: "AE10000000000002"
			title: "Eterna: Staerke"
			rewards: [{ id: "AE30000000000002", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "AE20000000000002", type: "checkmark" }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["AE10000000000002"]
			description: ["&6Was ist das?", "Quanta bestimmt, wie stark die Stufe der Verzauberung schwanken kann, also wie viel Zufall im Spiel ist.", "", "&6So gehts", "Auch Quanta kommt von den Regalen. Im Tisch siehst du den Wert.", "", "&6Wofuer ist das wichtig?", "Mit gezielter Quanta kannst du Ergebnisse verlaesslicher oder mutiger machen."]
			icon: { id: "minecraft:amethyst_shard" }
			id: "AE10000000000003"
			title: "Quanta: Zufall"
			rewards: [{ id: "AE30000000000003", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "AE20000000000003", type: "checkmark" }]
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: ["AE10000000000003"]
			description: ["&6Was ist das?", "Arcana bestimmt, wie viele und wie seltene Verzauberungen zusammen auf einem Gegenstand landen koennen.", "", "&6So gehts", "Arcana kommt ebenfalls von den Regalen. Mehr Arcana bedeutet mehr Verzauberungen auf einmal.", "", "&6Wofuer ist das wichtig?", "Fuer Gegenstaende mit vielen guten Verzauberungen gleichzeitig."]
			icon: { id: "minecraft:ender_eye" }
			id: "AE10000000000004"
			title: "Arcana: Vielfalt"
			rewards: [{ id: "AE30000000000004", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "AE20000000000004", type: "checkmark" }]
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["AE10000000000004"]
			description: ["&6Was ist das?", "Im Tisch siehst du Hinweise, welche Verzauberungen du ungefaehr bekommen wirst.", "", "&6So gehts", "Lege einen Gegenstand und Lapis in den Tisch und waehle eine der drei Stufen.", "", "&6Wofuer ist das wichtig?", "Du kannst vorher entscheiden, ob sich die Stufe lohnt."]
			icon: { id: "minecraft:enchanting_table" }
