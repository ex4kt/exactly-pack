		{
			dependencies: ["7C303C5E4B7608E0"]
			description: ["&6Was ist das?", "Eterna ist die Staerke deines Verzauberungstischs. Sie bestimmt, wie hoch die Stufe der Verzauberung sein kann.", "", "&6So gehts", "Eterna kommt von den Regalen um den Tisch. Fahre mit der Maus ueber den Tisch, um den Wert zu sehen.", "", "&6Wofuer ist das wichtig?", "Ohne genug Eterna bleiben starke Verzauberungen unerreichbar."]
			icon: { id: "minecraft:lapis_lazuli" }
			id: "38115819797BA204"
			title: "Eterna: Staerke"
			rewards: [{ id: "4708139E1946CA77", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "4123494EEFB7488A", type: "checkmark" }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["38115819797BA204"]
			description: ["&6Was ist das?", "Quanta bestimmt, wie stark die Stufe der Verzauberung schwanken kann, also wie viel Zufall im Spiel ist.", "", "&6So gehts", "Auch Quanta kommt von den Regalen. Im Tisch siehst du den Wert.", "", "&6Wofuer ist das wichtig?", "Mit gezielter Quanta kannst du Ergebnisse verlaesslicher oder mutiger machen."]
			icon: { id: "minecraft:amethyst_shard" }
