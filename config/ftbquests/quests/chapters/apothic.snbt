	quests: [
		{
			dependencies: ["1DB3F417D7AE0137"]
			description: ["&6Was ist das?", "Dieses Kapitel erklärt Apothic Enchanting Schritt für Schritt: Werte, Regale, Bücher und Maschinen.", "", "&6So gehts", "Gehe die Reihen von oben nach unten durch. Alle Quests hier sind freiwillig. Du musst nichts davon fertig haben.", "", "&6Wofür ist das wichtig?", "Gute Verzauberungen machen Waffen und Rüstung für die Bosse viel stärker."]
			icon: { id: "minecraft:enchanted_book" }
			id: "7C303C5E4B7608E0"
