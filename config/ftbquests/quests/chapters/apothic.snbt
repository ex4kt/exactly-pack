		}
		{
			dependencies: ["1422043FBDAD21A1"]
			description: ["&6Was ist das?", "Jetzt verzauberst du etwas.", "", "&6So gehts", "Lege den Gegenstand und Lapislazuli in den Tisch. Wähle eine Stufe. Das kostet Erfahrungsstufen und Lapis.", "", "&6Wofür ist das wichtig?", "Das Ergebnis hängt von deinen Regalen ab. Verbessere sie Schritt für Schritt."]
			id: "3F10C459B21AE233"
			title: "Verzauberung: Erste Verzauberung"
