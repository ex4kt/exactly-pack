		{
			dependencies: ["5F5A8C6451AE31E7"]
			description: ["&6Was ist das?", "Ein fester Block, der Drohnen-Programme ausführt.", "", "&6So gehts", "Programm einlegen und Luft anschließen.", "", "&6Wofür ist das wichtig?", "Drohnen-Arbeit ohne Drohne."]
			icon: { id: "pneumaticcraft:programmable_controller" }
