	title: "&3Pneumatik"
	quests: [
		{
			dependencies: ["3ED2EEBB1CFA992F"]
			description: ["&6Was ist das?", "PneumaticCraft hat ein eigenes Handbuch im Spiel (Patchouli).", "Suche im JEI-Menü nach dem Buch. Es erklärt jedes Gebäude.", "", "&6So gehts", "Halte ein PneumaticCraft-Item und drücke I, oder baue das Handbuch.", "", "&6Wofür ist das wichtig?", "Bei Druckluft-Technik gibt es viele Zahlen. Das Handbuch erklärt jede Maschine genau."]
			id: "1ADDD6C9F3C1DE3C"
			title: "Handbuch im Spiel"
			rewards: [{ id: "28F928DBD1E5C558", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "2093DA3DD35001AB", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["35BD5341300C9F5F"]
			description: ["&6Was ist das?", "Der Luftkompressor macht aus Brennstoff Druckluft, die Maschinen brauchen.", "", "&6So gehts", "Rezept: 3 Verstärkte Steinziegel oben, links einer und rechts das Druckrohr in der Mitte, unten Ziegel, Ofen, Ziegel (Muster in JEI). Verstärkte Ziegel: 4 Verstärkter Stein in der Werkbank.", "Stelle ihn hin, lege Kohle oder Holz hinein. Die Anzeige zeigt, wie der Druck steigt.", "Schließe Druckrohre an. Nichts mehr entnehmen, wenn der Druck 5 bar erreicht, sonst platzt etwas.", "", "&6Wofür ist das wichtig?", "Druckluft (bar) ist die Energie für alles in diesem Kapitel.", "", "&6Gut zu wissen", "Ein Sicherheitsventil im Rohrnetz baust du später mit dem Handbuch ein."]
			id: "04815340C4F710AA"
			title: "Luftkompressor"
			rewards: [{ id: "7405CE993E6BCE08", type: "item", item: { id: "minecraft:coal", count: 8 } }]
			tasks: [{ id: "6779CBA27DFC4AD8", type: "item", item: { id: "pneumaticcraft:air_compressor", count: 1 }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["4B1CDA02C5F025E2"]
			description: ["&6Was ist das?", "Druckrohre leiten die Druckluft von Block zu Block.", "", "&6So gehts", "Rezept: oben in einer Reihe Verdichtetes Eisen, Glas, Verdichtetes Eisen (Werkbank, ergibt 8).", "Lege sie als Strecke zwischen Kompressor und Maschine.", "Mit dem Schlüssel schließt du einzelne Seiten ab, damit die Luft nicht überall hinläuft.", "", "&6Wofür ist das wichtig?", "Ein Kompressor kann viele Maschinen über ein Rohrnetz versorgen."]
			id: "35BD5341300C9F5F"
			title: "Druckrohre"
			rewards: [{ id: "52BE18BF3E85356C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "4C2AEF425FF74630", type: "item", item: { id: "pneumaticcraft:pressure_tube", count: 1 }, count: 8L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["04815340C4F710AA"]
			description: ["&6Was ist das?", "Das Manometer zeigt, wie hoch der Druck ist.", "", "&6So gehts", "Rezept: Druckmesser oben (Verdichtetes Eisen in der Mitte, 4 Kupferbarren kreuzförmig drumherum), Luftkanister darunter (Werkbank).", "Rechtsklick auf Rohr oder Maschine zeigt den Druck.", "", "&6Wofür ist das wichtig?", "So siehst du Druckprobleme, bevor etwas platzt."]
			id: "1E49B8E5BFC25779"
			title: "Manometer"
			rewards: [{ id: "4A5C5EEB833CD7DC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2EB668977BEB291B", type: "item", item: { id: "pneumaticcraft:manometer", count: 1 }, count: 1L }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["1E49B8E5BFC25779"]
			description: ["&6Was ist das?", "Mit dem Pneumatischen Schlüssel drehst du Blöcke und baust Rohre ab.", "Er braucht Druckluft aus deinem Netz.", "", "&6So gehts", "Drehen und Rohrseiten schließen.", "", "&6Wofür ist das wichtig?", "Saubere Rohrnetze."]
			id: "616C7E4CA96161A9"
			title: "Druckluft-Schlüssel"
			rewards: [{ id: "5B7783237ACEFD2B", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "391951156ACD5DD0", type: "item", item: { id: "pneumaticcraft:pneumatic_wrench", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["616C7E4CA96161A9"]
			description: ["&6Was ist das?", "Die Druckkammer ist ein Mehrblock-Gebäude, in dem Items unter Druck zu neuen Items werden.", "", "&6So gehts", "Wand-Block: 8 Verstärkte Ziegel in einem Ring (Werkbank, ergibt 16).", "Baue einen Hohlraum aus Wänden, mindestens 3 mal 3 mal 3 innen.", "Setze ein Ventil in eine Wand (Rezept: Rohr und 4 Wände formlos). Setze eine Schnittstelle in eine Wand (Trichter und 2 Wände formlos).", "Verbinde das Ventil mit Druckluft. Wirf Items durch die Schnittstelle hinein.", "", "&6Wofür ist das wichtig?", "Hier entstehen Verdichtetes Eisen, Transistoren und leere Platinen.", "", "&6Gut zu wissen", "Einige Rezepte brauchen bis 4 bar, die Kammer zeigt den aktuellen Druck."]
			id: "574A9938F9FEA985"
			title: "Druckkammer"
			rewards: [{ id: "62FAA2AA3342346D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "3F8EABBD2374933A", type: "item", item: { id: "pneumaticcraft:pressure_chamber_wall", count: 1 }, count: 8L }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["1ADDD6C9F3C1DE3C"]
			description: ["&6Was ist das?", "Verdichtetes Eisen ist das wichtigste Metall von PneumaticCraft. Fast alles besteht daraus.", "", "&6So gehts", "Am Anfang gibt es nur den Weg mit TNT: Wirf Eisenbarren als Items auf den Boden und lasse daneben TNT explodieren.", "Die Barren in der Explosion werden zu Verdichtetem Eisen. Etwa ein Fünftel geht verloren.", "Später geht es sicherer in der Druckkammer bei 2 bar Druck (siehe Quest Druckkammer).", "Gehe mit Abstand zur TNT-Explosion und sammle das Eisen danach ein.", "", "&6Wofür ist das wichtig?", "Ohne Verdichtetes Eisen kannst du kein Druckrohr und keinen Kompressor bauen.", "", "&6Gut zu wissen", "Aus Verdichtetem Eisen lässt sich auch Verstärkter Stein herstellen: 8 Stein um 1 Verdichtetes Eisen (Werkbank)."]
			id: "4B1CDA02C5F025E2"
			title: "Verdichtetes Eisen"
			rewards: [{ id: "7544EFE81975BAC5", type: "item", item: { id: "minecraft:redstone", count: 16 } }]
			tasks: [{ id: "2F5824ADA910F754", type: "item", item: { id: "pneumaticcraft:ingot_iron_compressed", count: 1 }, count: 4L }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["2997ECFAA38F40C0"]
			description: ["&6Was ist das?", "Fortgeschrittene Rohre halten viel mehr Druck aus.", "", "&6So gehts", "Sie entstehen in der Montagelinie mit dem Laser aus Druckrohren (Rezept in JEI).", "Das ist Voraussetzung für Fortgeschrittenen Kompressor und Jet-Boots.", "", "&6Wofür ist das wichtig?", "Größere Anlagen, mehr Druck."]
			id: "5A20E02B588EBC84"
			title: "Fortgeschrittene Rohre"
			rewards: [{ id: "6B26D4D94A23A82E", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "167FD40272F119BC", type: "item", item: { id: "pneumaticcraft:advanced_pressure_tube", count: 1 }, count: 4L }]
			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["1E49B8E5BFC25779"]
			description: ["&6Was ist das?", "Die Ladestation füllt Gegenstände mit Druckluft.", "", "&6So gehts", "Rezept: Druckrohr oben rechts, 3 Ziegel in der Mitte, 3 Verstärkte Steinplatten unten (Muster in JEI).", "Lege ein pneumatisches Werkzeug oder die Rüstung hinein, schließe Druckluft an.", "", "&6Wofür ist das wichtig?", "Jedes pneumatische Werkzeug braucht Luft aus der Ladestation."]
			id: "26F0E7A797B1459C"
			title: "Ladestation"
			rewards: [{ id: "2A96203835B77566", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "76C57D93F37F6F83", type: "item", item: { id: "pneumaticcraft:charging_station", count: 1 }, count: 1L }]
			x: 13.50d
			y: 0.00d
		}
		{
			dependencies: ["26F0E7A797B1459C"]
			description: ["&6Was ist das?", "Der Luftkanister speichert Druckluft zum Mitnehmen.", "", "&6So gehts", "Rezept: Druckrohr oben, darunter Verdichtetes Eisen, Redstone, Verdichtetes Eisen, in zwei Reihen (Muster in JEI).", "In der Ladestation lädst du ihn auf.", "", "&6Wofür ist das wichtig?", "Gebraucht für Manometer, Schlüssel und Rüstung."]
			id: "6A0D6E72CF8686EC"
			title: "Druckluft-Behälter"
			rewards: [{ id: "6276474F963157DA", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "626C3DF880474A90", type: "item", item: { id: "pneumaticcraft:air_canister", count: 1 }, count: 1L }]
			x: 15.00d
			y: 0.00d
		}
		{
			dependencies: ["6A0D6E72CF8686EC"]
			description: ["&6Was ist das?", "Der kleine Tank speichert Flüssigkeiten wie Öl oder Treibstoff.", "", "&6So gehts", "Rezept: Eisengitter in den Ecken, Verdichtetes Eisen an den Seiten, Glas in der Mitte (Werkbank).", "Stelle ihn auf und verbinde ihn mit Rohren oder Eimern.", "", "&6Wofür ist das wichtig?", "Für Öl, Diesel und andere Flüssigkeiten."]
			id: "180C3D47022C0326"
			title: "Tanks"
			rewards: [{ id: "503A4C4A25711760", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "7F2ED26A996DE281", type: "item", item: { id: "pneumaticcraft:small_tank", count: 1 }, count: 1L }]
			x: 16.50d
			y: 0.00d
		}
		{
			dependencies: ["180C3D47022C0326"]
			description: ["&6Was ist das?", "Die Thermopneumatische Anlage verarbeitet Flüssigkeiten mit Hitze und Druck.", "", "&6So gehts", "Rezept: Verstärkte Steinplatten rundherum, in der Mitte links und rechts ein kleiner Tank, in der Mitte oben ein Druckrohr (Muster in JEI).", "Sie braucht Druckluft und Hitze. Für Hitze brauchst du Lava oder Feuer darunter (siehe Wärmerahmen).", "Rezepte: JEI, Taste R.", "", "&6Wofür ist das wichtig?", "Zwischenschritt für Plastik, Treibstoff und Bohrer."]
			id: "27EC460A72A7BB44"
			title: "Thermopneumatische Anlage"
			rewards: [{ id: "77B8D31C2AAE6C9F", type: "item", item: { id: "minecraft:blaze_powder", count: 4 } }]
			tasks: [{ id: "61AD835910DD8517", type: "item", item: { id: "pneumaticcraft:thermopneumatic_processing_plant", count: 1 }, count: 1L }]
			x: 18.00d
			y: 0.00d
		}
		{
			dependencies: ["27EC460A72A7BB44"]
			description: ["&6Was ist das?", "Die Raffinerie zerlegt Rohöl in Diesel, Kerosin, Benzin und LPG.", "", "&6So gehts", "Rezept: Verstärkte Steinplatten, Redstone, kleiner Tank (Muster in JEI).", "Stapele sie mit Ausgabe-Modulen (Rezept: Verstärkte Platten, Glas, Diamant).", "Setze Heizer unter die Raffinerie: Sie braucht mindestens 100 Grad (373 K).", "", "&6Wofür ist das wichtig?", "Treibstoffe für Kompressoren und Plastik."]
			id: "31292358F7BF209E"
			title: "Raffinerie"
			rewards: [{ id: "393F2BC21F22247E", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "028CCCF6C2213D96", type: "item", item: { id: "pneumaticcraft:refinery", count: 1 }, count: 1L }]
			x: 19.50d
			y: 0.00d
		}
		{
			dependencies: ["31292358F7BF209E"]
			description: ["&6Was ist das?", "Plastik ist wichtig für Platinen, Drohnen und Upgrades.", "", "&6So gehts", "In der Thermopneumatischen Anlage: 100 mB LPG und 1 Kohle ergeben Flüssigplastik.", "Lasse das Flüssigplastik im Wärmerahmen abkühlen, es wird zu Plastik.", "Alternativ: Biodiesel mit Holzkohle (Rezept in JEI).", "", "&6Wofür ist das wichtig?", "Plastik braucht jede Platine."]
			id: "0FB1ABFEB86194BB"
			title: "Plastik"
			rewards: [{ id: "46C3531FF2F3A409", type: "item", item: { id: "minecraft:lime_dye", count: 8 } }]
			tasks: [{ id: "255D35012EE083F5", type: "item", item: { id: "pneumaticcraft:plastic", count: 1 }, count: 8L }]
			x: 21.00d
			y: 0.00d
		}
		{
			dependencies: ["0FB1ABFEB86194BB"]
			description: ["&6Was ist das?", "Die UV-Lichtbox belichtet Platinen mit einem Muster.", "", "&6So gehts", "Werkbank: 3 Redstone-Lampen oben, Verdichtete Eisenbarren, PCB-Blaupause, Druckrohr, Verdichtete Eisenbarren unten (Muster in JEI).", "Lege eine leere Platine hinein und gib Druckluft.", "Danach kommt der Ätztank.", "", "&6Wofür ist das wichtig?", "Teil des Platinen-Verfahrens."]
			id: "4DEDD78F25CCB176"
			title: "UV-Lichtbox"
			rewards: [{ id: "0D7D8770207CA376", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "5F1472FAAF21BC0B", type: "item", item: { id: "pneumaticcraft:uv_light_box", count: 1 }, count: 1L }]
			x: 22.50d
			y: 0.00d
		}
		{
			dependencies: ["4DEDD78F25CCB176"]
			description: ["&6Was ist das?", "Im Ätztank ätzt Säure die belichtete Platine fertig.", "", "&6So gehts", "Rezept: Glas, Obsidian, Verstärkte Wandsteine und kleiner Tank (Muster in JEI).", "Ätzsäure: In der Druckkammer bei 1 bar aus 1 Plastikeimer, 2 Faulfleisch, 2 Spinnenaugen, 2 Schwarzpulver.", "", "&6Wofür ist das wichtig?", "Zweiter Schritt zur Platine."]
			id: "428BF85B580E5F2E"
			title: "Ätztank"
			rewards: [{ id: "15F624A67FDC399E", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "563AB48A494269A5", type: "item", item: { id: "pneumaticcraft:etching_tank", count: 1 }, count: 1L }]
			x: 24.00d
			y: 0.00d
		}
		{
			dependencies: ["428BF85B580E5F2E", "5F5A8C6451AE31E7", "1956BCF7D61579A0"]
			description: ["&6Was ist das?", "Die Platine ist das Herz vieler Upgrades.", "", "&6So gehts", "Werkbank: unfertige Platine in die Mitte, oben und unten je ein Transistor, links und rechts je ein Kondensator.", "Die unfertige Platine entsteht aus einer leeren Platine in der Montagelinie (Laser).", "", "&6Wofür ist das wichtig?", "Für Rüstung, Drohnen, Montagelinie und Programmierer."]
			id: "05B51B13768CB084"
			title: "Platine"
			rewards: [{ id: "50568560A9760CAB", type: "item", item: { id: "minecraft:gold_ingot", count: 4 } }]
			tasks: [{ id: "5834387553913B05", type: "item", item: { id: "pneumaticcraft:printed_circuit_board", count: 1 }, count: 1L }]
			x: 25.50d
			y: 0.00d
		}
		{
			dependencies: ["05B51B13768CB084"]
			description: ["&6Was ist das?", "Die Montagelinie bohrt, lasert und baut automatisch Bauteile.", "", "&6So gehts", "Steuerung: Platine, Rohr und 3 Verdichtetes Eisen (Werkbank). Dazu Plattform, Laser und Bohrer (Rezepte in JEI).", "Schließe alles mit Druckluft an. Im Steuergerät wählst du das Programm.", "", "&6Wofür ist das wichtig?", "Fortgeschrittene Rohre, Solarzellen und viele Bauteile."]
			id: "2997ECFAA38F40C0"
			title: "Montagelinie"
			rewards: [{ id: "7D0C7B037275549A", type: "xp_levels", xp_levels: 5 }]
