	title: "&3Pneumatik"
	quests: [
		{
			dependencies: ["3ED2EEBB1CFA992F"]
			description: ["&6Was ist das?", "PneumaticCraft hat ein eigenes Handbuch im Spiel (Patchouli).", "Suche im JEI-Menü nach dem Buch. Es erklärt jedes Gebäude.", "", "&6So gehts", "Halte ein PneumaticCraft-Item und drücke I, oder baue das Handbuch.", "", "&6Wofür ist das wichtig?", "Bei Druckluft-Technik gibt es viele Zahlen. Das Handbuch erklärt jede Maschine genau."]
			id: "1ADDD6C9F3C1DE3C"
			title: "Handbuch im Spiel"
			rewards: [{ id: "28F928DBD1E5C558", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "2093DA3DD35001AB", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["1ADDD6C9F3C1DE3C"]
			description: ["&6Was ist das?", "Der Kompressor macht Druckluft, die Maschinen brauchen.", "Schritt 1: Baue einen Luftkompressor.", "Schritt 2: Fülle ihn mit Brennstoff (z.B. Kohle).", "", "&6So gehts", "Aufstellen, Kohle oder Holz hineinlegen.", "Die Druckanzeige steigt. Bei zu viel Druck explodiert er, also immer Luft abnehmen.", "", "&6Wofür ist das wichtig?", "Druckluft (bar) ist die Energie für alles in PneumaticCraft.", "", "&6Gut zu wissen", "Der Kompressor erzeugt Druck aus Brennstoff. Zu hoher Druck zerstört Rohre und Maschinen, baue deshalb ein Sicherheitsventil ein."]
			id: "04815340C4F710AA"
			title: "Luftkompressor"
			rewards: [{ id: "7405CE993E6BCE08", type: "item", item: { id: "minecraft:coal", count: 8 } }]
			tasks: [{ id: "6779CBA27DFC4AD8", type: "item", item: { id: "pneumaticcraft:air_compressor", count: 1 }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["04815340C4F710AA"]
			description: ["&6Was ist das?", "Druckrohre leiten die Luft von Block zu Block.", "Schritt 1: Baue Rohre.", "Schritt 2: Verbinde Kompressor und Maschinen.", "", "&6So gehts", "Rohre zwischen Kompressor und Maschine legen.", "Mit dem Schlüssel kannst du Seiten trennen.", "", "&6Wofür ist das wichtig?", "Ein Kompressor kann viele Maschinen versorgen."]
			id: "35BD5341300C9F5F"
			title: "Druckrohre"
			rewards: [{ id: "52BE18BF3E85356C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "4C2AEF425FF74630", type: "item", item: { id: "pneumaticcraft:pressure_tube", count: 1 }, count: 8L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["35BD5341300C9F5F"]
			description: ["&6Was ist das?", "Das Manometer zeigt, wie hoch der Druck ist.", "Halte es in der Hand und klicke auf Rohre.", "Achtung: Zu hoher Druck lässt Rohre platzen.", "", "&6So gehts", "Rechtsklick auf ein Rohr oder eine Maschine.", "", "&6Wofür ist das wichtig?", "Rechtzeitig erkennen, bevor etwas explodiert.", "", "&6Gut zu wissen", "Mit dem Manometer liest du den aktuellen Druck in Rohren und Maschinen ab."]
			id: "1E49B8E5BFC25779"
			title: "Manometer"
			rewards: [{ id: "4A5C5EEB833CD7DC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2EB668977BEB291B", type: "item", item: { id: "pneumaticcraft:manometer", count: 1 }, count: 1L }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["1E49B8E5BFC25779"]
			description: ["&6Was ist das?", "Mit dem Pneumatischen Schlüssel drehst du Blöcke und baust Rohre ab.", "Er braucht Druckluft aus deinem Netz.", "", "&6So gehts", "Drehen und Rohrseiten schließen.", "", "&6Wofür ist das wichtig?", "Saubere Rohrnetze."]
			id: "616C7E4CA96161A9"
			title: "Druckluft-Schlüssel"
			rewards: [{ id: "5B7783237ACEFD2B", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "391951156ACD5DD0", type: "item", item: { id: "pneumaticcraft:pneumatic_wrench", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["616C7E4CA96161A9"]
			description: ["&6Was ist das?", "Die Druckkammer ist ein Mehrblock-Gebäude.", "Schritt 1: Baue Wände, ein Ventil und Fenster aus Kammerteilen.", "Schritt 2: Verbinde das Ventil mit Druckluft.", "", "&6So gehts", "Mindestens 3x3x3 aus Druckkammer-Wänden bauen, mit Ventil und Schnittstelle.", "Druckluft hinein, Items hinein.", "", "&6Wofür ist das wichtig?", "Hier entsteht Verdichtetes Eisen, das Hauptmaterial von PneumaticCraft."]
			id: "574A9938F9FEA985"
			title: "Druckkammer"
			rewards: [{ id: "62FAA2AA3342346D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "3F8EABBD2374933A", type: "item", item: { id: "pneumaticcraft:pressure_chamber_wall", count: 1 }, count: 8L }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["574A9938F9FEA985"]
			description: ["&6Was ist das?", "Verdichtetes Eisen ist das wichtigste Metall.", "Schritt 1: Lege Eisenbarren in die Druckkammer.", "Schritt 2: Stelle genug Druck ein.", "", "&6So gehts", "Eisenbarren in die Druckkammer oder mit TNT-Explosion verdichten.", "", "&6Wofür ist das wichtig?", "Fast alle Maschinen brauchen es."]
			id: "4B1CDA02C5F025E2"
