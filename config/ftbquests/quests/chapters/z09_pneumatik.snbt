			x: 28.50d
			y: -3.00d
		}
		{
			dependencies: ["0FB1ABFEB86194BB"]
			description: ["&6Was ist das?", "Transistoren und Kondensatoren stellst du in der Druckkammer her.", "", "&6So gehts", "Transistor (1 bar): 3 Draht, 1 Redstonestaub, 1 Plastik.", "Kondensator (1 bar): 2 Draht, 1 Schleimball, 1 Plastik.", "", "&6Wofür ist das wichtig?", "Zwei Transistoren und zwei Kondensatoren pro Platine."]
			icon: { id: "pneumaticcraft:transistor" }
			id: "5F5A8C6451AE31E7"
