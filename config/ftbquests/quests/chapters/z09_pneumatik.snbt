		}
		{
			dependencies: ["2997ECFAA38F40C0"]
			description: ["&6Was ist das?", "Der Montage-Laser schneidet und formt Teile in der Montage-Anlage.", "", "&6So gehts", "Werkbank: Rotes Glas, 3 Druckzylinder, 1 Leiterplatte und 2 Verdichtete Eisenbarren (Muster in JEI).", "", "&6Wofür ist das wichtig?", "Nötig für die Montage-Anlage."]
			id: "18C5514DB93E15E4"
			title: "Montage-Laser"
			rewards: [{ id: "63926CB5309FF271", type: "xp_levels", xp_levels: 4 }]
