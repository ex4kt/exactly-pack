		}
		{
			dependencies: ["1B8905CD6A6A07B0"]
			description: ["&6Was ist das?", "Holz ist das erste Material in Minecraft. Aus Staemmen werden Bretter, aus Brettern Stoecke, Werkbank und Werkzeug.", "", "&6So gehts", "Schlage mit der Hand oder einer Axt auf einen Baumstamm, bis er abbricht.", "In der Werkbank (oder im 2x2-Feld im Inventar) wird ein Stamm zu vier Brettern.", "", "&6Wofuer ist das wichtig?", "Du brauchst Holz fuer fast alles am Anfang: Werkbank, Kisten, Werkzeuge, Fackeln und spaeter fuer Create-Wellen und Wasserraeder.", "Tipp: Pflanze die Setzlinge wieder ein, dann geht dir das Holz nie aus."]
			id: "AD70B601151C9269"
			title: "Holz sammeln"
			rewards: [{ id: "3FD9FA36355B9A30", type: "item", item: { id: "minecraft:oak_log", count: 16 } }]
			tasks: [{ id: "55E5AE1BD49F7B38", type: "item", item: { id: "minecraft:oak_log", count: 1 }, count: 8L }]
			x: 2.0d
