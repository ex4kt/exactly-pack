	quests: [
		{
			description: ["&6Was ist das?", "Dies ist dein Questbuch. Links siehst du die Kapitel.", "Ein Kapitel nach dem anderen: Grundlagen, Lager, Abbau, Create und mehr.", "Klicke eine Quest an, um zu lesen, was zu tun ist. Haken setzt du selbst, Items werden automatisch erkannt.", "Alle kleinen Mods stehen im Kapitel Grundlagen in einer Uebersicht.", "", "&6So gehts", "Klicke eine Quest an, um das Tutorial zu lesen.", "Items werden automatisch erkannt, sobald du sie im Inventar hast. Bei Quests mit Haken klickst du selbst auf den Haken.", "Belohnungen holst du mit einem Klick auf die Truhe unten in der Quest ab.", "", "&6Wofuer ist das wichtig?", "Fange mit Willkommen und Grundlagen an. Danach kannst du frei waehlen: Technik (Create, PneumaticCraft), Magie, Kochen oder Erkunden."]
			id: "1B8905CD6A6A07B0"
			title: "Willkommen bei Exactly"
			rewards: [{ id: "5A4416ACD10664BA", type: "item", item: { id: "minecraft:bread", count: 8 } }]
