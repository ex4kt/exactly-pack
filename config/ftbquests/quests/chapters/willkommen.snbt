		}
		{
			dependencies: ["3B679BF3502503F2"]
			description: ["&6Was ist das?", "Ein Bett laesst dich die Nacht ueberspringen und setzt deinen Spawnpunkt.", "", "&6So gehts", "Drei Wolle (gleiche Farbe) ueber drei Brettern ergeben ein Bett. Wolle bekommst du von Schafen.", "Rechtsklick auf das Bett in der Nacht. Im Mehrspieler muss die Haelfte der Spieler schlafen.", "", "&6Wofuer ist das wichtig?", "Nachts kommen viele Monster. Mit Bett bist du sicher und startest nach dem Tod zu Hause, nicht am Weltspawn."]
			id: "EB8E9D7BA68A3F34"
			title: "Ein Bett fuer die Nacht"
			rewards: [{ id: "03D17CACB594EFE3", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "0801B7B2B6063697", type: "item", item: { id: "minecraft:red_bed", count: 1 }, count: 1L }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["EB8E9D7BA68A3F34"]
			description: ["&6Was ist das?", "Eine Kiste speichert 27 Stapel. Zwei nebeneinander werden eine Doppelkiste.", "", "&6So gehts", "Acht Bretter im Kreis in der Werkbank ergeben eine Kiste.", "Stelle sie auf und lege mit Shift-Klick Items hinein.", "", "&6Wofuer ist das wichtig?", "Ohne Ordnung wird es schnell chaotisch. Im Kapitel Lager und Ordnung lernst du, wie du aus Kisten ein ganzes Lagersystem machst."]
			id: "3D64137EE4BB4B1D"
