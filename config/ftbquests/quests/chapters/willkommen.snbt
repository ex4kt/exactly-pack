		}
		{
			dependencies: ["AD70B601151C9269"]
			description: ["&6Was ist das?", "Die Werkbank hat ein 3x3-Feld. Die meisten Rezepte brauchen sie.", "", "&6So gehts", "Lege vier Bretter im Quadrat in das Crafting-Feld deines Inventars.", "Stelle die Werkbank auf und klicke sie mit Rechtsklick an.", "Mit JEI (Taste R auf einem Item) siehst du jedes Rezept.", "", "&6Wofuer ist das wichtig?", "Mit Werkzeug geht alles schneller. Die Belohnung ist eine Steinspitzhacke, damit kannst du gleich Stein und Kohle abbauen.", "Spaeter: Mit Nearby Crafting nimmt die Werkbank Material direkt aus Kisten in der Naehe."]
			id: "3B679BF3502503F2"
			title: "Werkbank bauen"
			rewards: [{ id: "D82761AA28248622", type: "item", item: { id: "minecraft:stone_pickaxe", count: 1 } }]
			tasks: [{ id: "E6FCC147987DCB41", type: "item", item: { id: "minecraft:crafting_table", count: 1 }, count: 1L }]
			x: 4.0d
