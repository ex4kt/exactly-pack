		}
		{
			dependencies: ["08E5540FAC14EE5E"]
			description: ["&6Was ist das?", "Der Wächter hört Geräusche und Erschütterungen.", "", "&6So gehts", "Halte Shift (schleichen), dann machst du keine Geräusche. Wolle dämpft Schwingungen: Lege sie auf den Boden, über den du läufst.", "Sculk-Schreier rufen den Wächter. Löse sie nicht aus.", "", "&6Wofür ist das wichtig?", "Wer leise bleibt, kann die Truhen in der Stadt leeren, ohne ihn zu wecken."]
			icon: { id: "minecraft:white_wool" }
			id: "5319CD220527AB74"
