			x: 3.00d
			y: 19.500d
		}
		{
			description: ["&6Was ist das?", "Macht aus Barren Draht.", "", "&6So gehts", "Strom anschließen und Barren einlegen. Rezepte in JEI.", "", "&6Wofür ist das wichtig?", "Aus Draht und Gummi werden Kabel."]
			dependencies: ["439E229F1569BA9C"]
			id: "76BBAC9DA6093725"
			title: "Elektrische Drahtmühle"
			rewards: [{ id: "39D7F190165E185B", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "6CE5D74EFC96015E", type: "item", item: { id: "modern_industrialization:electric_wiremill", count: 1 }, count: 1L }]
			x: 4.50d
			y: 19.500d
		}
		{
			description: ["&6Was ist das?", "Kabel leiten Strom. Draht plus Gummi ergibt ein Kabel.", "", "&6So gehts", "Ein LV-Netz zieht höchstens 256 EU/t in sich hinein, MV 1024 EU/t, HV 8192 EU/t. Kurzzeitig kann ein LV-Netz mehr liefern, weil Kabel etwas speichern.", "Einzelblock-Elektromaschinen verbinden sich nur mit LV-Kabeln. Für mehr Leistung brauchst du mehrere Netze oder Transformatoren.", "", "&6Wofür ist das wichtig?", "Das Rückgrat jeder Elektro-Anlage."]
			dependencies: ["76BBAC9DA6093725"]
