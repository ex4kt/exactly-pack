	quests: [
		{
			dependencies: ["35D9C17C3DF9768D"]
			description: ["&6Was ist das?", "Diamant ist lange das Ziel. Stelle eine Spitzhacke aus Diamant her.", "", "&6So gehts", "Diamanten tief unten finden, am besten um Ebene minus 58.", "Für Diamantwerkzeug brauchst du das passende Eisenwerkzeug: Es kommt im Rezept an die Stelle des oberen Stocks.", "", "&6Wofür ist das wichtig?", "Diamantwerkzeug baut Obsidian ab. Damit kommst du in den Nether."]
			id: "63064054BBFD8FB1"
			title: "Diamant-Ausrüstung"
			rewards: [{ id: "04CF41EB62772C30", type: "item", item: { id: "minecraft:diamond", count: 2 } }]
			tasks: [{ id: "586642040DF2A94C", type: "item", item: { id: "minecraft:diamond_pickaxe", count: 1 }, count: 1L }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["63064054BBFD8FB1"]
			description: ["&6Was ist das?", "Das Hauptschwert der Diamantzeit.", "", "&6So gehts", "Zwei Diamanten, darunter das Eisenschwert statt des Stocks.", "", "&6Wofür ist das wichtig?", "Pflicht für den Aufstieg. Grundlage aller Diamant-Spezialwaffen."]
			icon: { id: "minecraft:diamond_sword" }
			id: "31E652570EB0BD57"
