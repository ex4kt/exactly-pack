			title: "Bronzekessel"
			rewards: [{ id: "7AA1D47903AF2520", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2556010CC074C32C", type: "item", item: { id: "modern_industrialization:bronze_boiler", count: 1 }, count: 1L }]
			x: 10.50d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Presst Barren zu Platten, 1 zu 1. Aus einem Doppelbarren werden 2 Platten.", "", "&6So gehts", "Baue ihn neben den Kessel, damit er Dampf bekommt. Das Rezept siehst du in JEI.", "", "&6Wofür ist das wichtig?", "Die erste Maschine, die du bauen solltest, denn Platten sind überall nötig."]
			dependencies: ["5706AB25DF043BC3"]
