		{
			dependencies: ["1DB3F417D7AE0137"]
			description: ["&6Was ist das?", "Obsidian brauchst du für Portale und Verzauberungstische. Baue ihn mit Diamant-Spitzhacke ab.", "", "&6So gehts", "Mit Diamantspitzhacke abbauen.", "", "&6Wofür ist das wichtig?", "Zehn Obsidian ergeben ein Nether-Portal. Auch für Verzauberungstisch und Enderkisten.", "", "&6Gut zu wissen", "Obsidian entsteht, wenn Wasser auf Lava trifft. Ein Nether-Portal braucht mindestens 10 Blöcke Obsidian (ein Rahmen von 4x5 ohne Ecken)."]
			id: "1512FC1565ADD973"
			title: "Obsidian"
			rewards: [{ id: "0F084224ABF2B814", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "16D60564FC57B2DD", type: "item", item: { id: "minecraft:obsidian", count: 1 }, count: 10L }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["1512FC1565ADD973"]
			description: ["&6Was ist das?", "Der Warden ist blind, hört aber jedes Geräusch. Er ist stärker als fast jeder Boss.", "", "&6So gehts", "Er lebt in der Tiefen Dunkelheit (Antike Städte). Schleiche und wirf Schneebälle, um ihn abzulenken.", "Kampf nur mit sehr guter Ausrüstung und Heiltränken.", "", "&6Wofür ist das wichtig?", "Antike Städte haben die besten Truhen der Oberwelt: Schwunghosen-Verzauberung, Echosplitter, Rüstungsdesigns."]
			id: "150D1F4AD2F8211C"
			title: "Der Wächter der Tiefe"
			rewards: [{ id: "6126F822FCD62ACF", type: "item", item: { id: "minecraft:netherite_scrap", count: 2 } }]
			tasks: [{ id: "1317427E80675D00", type: "kill", entity: "minecraft:warden", value: 1L, icon: { id: "minecraft:sculk_shrieker" } }]
			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["150D1F4AD2F8211C"]
			description: ["&6Was ist das?", "Im Woodland Mansion lauern Illager und Beute. Du brauchst Totem und Ausrüstung.", "", "&6So gehts", "Mit dem Natures Compass oder einer Forscherkarte vom Kartografen finden.", "Magier (Evoker) lassen den Totem der Unsterblichkeit fallen.", "", "&6Wofür ist das wichtig?", "Der Totem rettet dich einmal vor dem Tod. Halte ihn in der zweiten Hand bei jedem Bosskampf."]
			id: "671BE8F3FAC5BA64"
			title: "Das Waldanwesen"
			rewards: [{ id: "63F207EFFC388F04", type: "item", item: { id: "minecraft:golden_apple", count: 2 } }]
			tasks: [{ id: "1FFDCF5D84C3B5DB", type: "item", item: { id: "minecraft:totem_of_undying", count: 1 }, count: 1L }]
			x: 13.50d
			y: 1.50d
		}
		{
			dependencies: ["671BE8F3FAC5BA64"]
			description: ["&6Was ist das?", "Illager Invasion bringt den Invoker, einen sehr starken Illager-Magier.", "", "&6So gehts", "Er erscheint in Überfällen und eigenen Bauten. Halte Abstand von seinen Zaubern und greife zwischen den Zaubern an.", "", "&6Wofür ist das wichtig?", "Gute Beute und Training für die großen Bosse."]
			id: "5678565198FD7665"
			title: "Der Illager-Magier"
			rewards: [{ id: "5D0184279585879A", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "1BF16845DEFAFD0F", type: "kill", entity: "illagerinvasion:invoker", value: 1L, icon: { id: "minecraft:totem_of_undying" } }]
			x: 15.00d
			y: 1.50d
		}
		{
			dependencies: ["5678565198FD7665"]
			description: ["&6Was ist das?", "Raided: neue Raid-Gegner wie Necromancer, Incinerator und Inquisitor.", "", "&6So gehts", "Bei einem Raid oder Außenposten besiegen.", "", "&6Wofür ist das wichtig?", "Starke Gegner mit guter Beute."]
			icon: { id: "raided:necromancer_spawn_egg" }
