			x: 7.50d
			y: 0.000d
		}
		{
			description: ["&6Was ist das?", "Apothic Enchanting ersetzt das normale Verzaubern.", "Jedes Bücherregal hat Werte: Eterna (Stärke), Quanta (Zufall) und Arcana (Seltenheit).", "", "&6So gehts", "Stelle verschiedene Bücherregale um den Verzauberungstisch. Fahre mit der Maus über den Tisch, um die Werte zu sehen.", "Bessere Regale (z.B. aus Nether- oder End-Material) bringen höhere Stufen.", "JEI zeigt alle besonderen Regale und Rezepte.", "", "&6Wofür ist das wichtig?", "Mit guten Regalen bekommst du Verzauberungen über der normalen Höchststufe. Das macht Werkzeuge und Rüstung für die Bosse stark."]
			icon: { id: "minecraft:enchanted_book" }
			dependencies: ["2502CCD91E41AFC0"]
			id: "1DB3F417D7AE0137"
			title: "Apothic Enchanting"
			rewards: [{ id: "59E9963E549C5FF8", type: "xp_levels", xp_levels: 5 }]
