		}
		{
			dependencies: ["0FD6302A9ABCCF31"]
			description: ["&6Was ist das?", "Apothic Enchanting ersetzt das normale Verzaubern.", "Jedes Buecherregal hat Werte: Eterna (Staerke), Quanta (Zufall) und Arcana (Seltenheit).", "", "&6So gehts", "Stelle verschiedene Buecherregale um den Verzauberungstisch. Fahre mit der Maus ueber den Tisch, um die Werte zu sehen.", "Bessere Regale (z.B. aus Nether- oder End-Material) bringen hoehere Stufen.", "JEI zeigt alle besonderen Regale und Rezepte.", "", "&6Wofuer ist das wichtig?", "Mit guten Regalen bekommst du Verzauberungen ueber der normalen Hoechststufe. Das macht Werkzeuge und Ruestung fuer die Bosse stark."]
			icon: { id: "minecraft:enchanted_book" }
			id: "37407FF743621E7E"
			title: "Apothic Enchanting"
			rewards: [{ id: "651AA4FF3759A8C1", type: "xp_levels", xp_levels: 5 }]
