		{
			dependencies: ["04B61412DE38FA60"]
			description: ["&6Was ist das?", "Apothic Enchanting: besondere Regale wie Bienen-, Melonen- oder Geodenregal.", "", "&6So gehts", "Rezepte in JEI mit @apothic_enchanting.", "", "&6Wofür ist das wichtig?", "Jedes Regal verändert die Werte am Tisch anders."]
			icon: { id: "apothic_enchanting:beeshelf" }
			id: "0A60B7540735FCD4"
