		{
			dependencies: ["2DEDA3D57FB89524"]
			description: ["&6Was ist das?", "Schritt 1: Baue einen Verzauberungstisch.", "Schritt 2: Lege Werkzeug und Lapislazuli hinein.", "Mit Easy Magic bleiben die Items nach dem Schließen drin.", "", "&6So gehts", "Diamanten, Obsidian und ein Buch.", "Bis zu 15 Bücherregale im Abstand von einem Block darum herum machen die Verzauberungen stärker.", "Lapis und Erfahrung zahlen.", "", "&6Wofür ist das wichtig?", "Effizienz, Glück und Haltbarkeit machen dich viel schneller und sparen Material.", "", "&6Gut zu wissen", "Mit 15 Bücherregalen im Abstand von einem Block rund um den Tisch erreichst du die höchste Verzauberungsstufe (30). Lapislazuli ist der Preis jeder Verzauberung."]
			id: "2502CCD91E41AFC0"
			title: "Der Verzauberungstisch"
			rewards: [{ id: "69B8EA263F9CBAB4", type: "item", item: { id: "minecraft:lapis_lazuli", count: 16 } }]
			tasks: [{ id: "108E99E367ADB315", type: "item", item: { id: "minecraft:enchanting_table", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["2502CCD91E41AFC0"]
			description: ["&6Was ist das?", "Apothic Enchanting ersetzt das normale Verzaubern.", "Jedes Bücherregal hat Werte: Eterna (Stärke), Quanta (Zufall) und Arcana (Seltenheit).", "", "&6So gehts", "Stelle verschiedene Bücherregale um den Verzauberungstisch. Fahre mit der Maus über den Tisch, um die Werte zu sehen.", "Bessere Regale (z.B. aus Nether- oder End-Material) bringen höhere Stufen.", "JEI zeigt alle besonderen Regale und Rezepte.", "", "&6Wofür ist das wichtig?", "Mit guten Regalen bekommst du Verzauberungen über der normalen Höchststufe. Das macht Werkzeuge und Rüstung für die Bosse stark."]
			icon: { id: "minecraft:enchanted_book" }
			id: "1DB3F417D7AE0137"
			title: "Apothic Enchanting"
			rewards: [{ id: "59E9963E549C5FF8", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "675BE451169A1D81", type: "checkmark" }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["1DB3F417D7AE0137"]
			description: ["&6Was ist das?", "Mit Easy Disenchanting überträgst du Verzauberungen auf Bücher.", "Schritt 1: Lege das verzauberte Item und ein Buch in den Amboss.", "Schritt 2: Nimm das verzauberte Buch heraus.", "", "&6So gehts", "Item in den Schleifstein legen.", "", "&6Wofür ist das wichtig?", "Schlechte Verzauberungen loswerden und neu verzaubern."]
			id: "79245A87CC32FE72"
			title: "Verzauberung übertragen"
			rewards: [{ id: "6016C3A2CE568AF9", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "753B1D909508CF15", type: "checkmark" }]
			x: 10.50d
			y: -4.50d
		}
		{
			dependencies: ["79245A87CC32FE72"]
			description: ["&6Was ist das?", "Der XP Tome speichert Erfahrung in einem Buch.", "Rechtsklick füllt oder leert es.", "", "&6So gehts", "Rechtsklick füllt, Shift-Rechtsklick holt sie zurück.", "", "&6Wofür ist das wichtig?", "Beim Tod verlierst du gespeicherte Erfahrung nicht. Spare für große Verzauberungen."]
			id: "0FD6302A9ABCCF31"
			title: "XP speichern"
			rewards: [{ id: "03686DE193C50947", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3A662C5170BCFE53", type: "checkmark" }]
			x: 12.00d
			y: -4.50d
		}
		{
			dependencies: ["0FD6302A9ABCCF31"]
			description: ["&6Was ist das?", "Mit der Verzauberung Veinminer baust du ganze Erzadern auf einmal ab.", "", "&6So gehts", "Das Buch bekommst du nicht geschenkt. Du findest es am Verzauberungstisch (hohes Level), beim Bibliothekar im Dorf oder in Beutetruhen.", "Lege Spitzhacke und Buch in den Amboss. Halte beim Abbauen die Veinminer-Taste (Standard: Tilde/Grad) gedrückt, dann folgt die ganze Ader.", "", "&6Wofür ist das wichtig?", "Spart viel Zeit beim Erzabbau. Bestätige die Quest, sobald du das Buch selbst besorgt hast."]
			icon: { id: "minecraft:enchanted_book" }
			id: "37407FF743621E7E"
			title: "Veinminer-Verzauberung"
			rewards: [{ id: "05CA28B6C57B677E", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "089675ACCE9F3071", type: "checkmark" }]
			x: 13.50d
			y: -4.50d
		}
		{
			dependencies: ["37407FF743621E7E"]
			description: ["&6Was ist das?", "Die Verzauberung Glück bringt mehr Items aus Erzen.", "Verzaubere deine Spitzhacke damit, bevor du Diamanten abbaust.", "", "&6So gehts", "Auf die Spitzhacke verzaubern.", "", "&6Wofür ist das wichtig?", "Bis zu viermal so viele Diamanten. Für Eisen und Gold lieber die Create-Zerkleinerung nutzen."]
			id: "08E13C4778BBECAD"
			title: "Glück (Fortune)"
			rewards: [{ id: "4DD145F7248AA806", type: "item", item: { id: "minecraft:lapis_lazuli", count: 8 } }]
			tasks: [{ id: "0EDE54BC06F9109D", type: "checkmark" }]
			x: 15.00d
			y: -4.50d
		}
		{
			dependencies: ["08E13C4778BBECAD"]
			description: ["&6Was ist das?", "Mit Seidenberührung bekommst du Blöcke selbst statt ihrer Drops, z.B. Erz oder Glas.", "", "&6So gehts", "Auf eine Spitzhacke verzaubern.", "", "&6Wofür ist das wichtig?", "Für Glas, Eis, Bienennester und Erzblöcke zum späteren Glück-Abbau."]
			id: "188BE6C057D774EB"
			title: "Seidenberührung"
			rewards: [{ id: "7503D49029A10950", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2AC6DFDF11A53533", type: "checkmark" }]
			x: 16.50d
			y: -4.50d
		}
		{
			dependencies: ["188BE6C057D774EB"]
			description: ["&6Was ist das?", "Mit der Verzauberung Reparatur (Mending) reparieren sich Werkzeuge durch Erfahrung. Du bekommst sie von Bibliothekaren oder aus Truhen.", "", "&6So gehts", "Mit Reparatur (Mending) verzaubern, dann repariert Erfahrung das Item.", "Oder im Amboss mit Material reparieren.", "", "&6Wofür ist das wichtig?", "Gute Werkzeuge musst du dann nie mehr neu machen."]
			id: "2CB401D63D9F4388"
			title: "Reparieren"
			rewards: [{ id: "782AFEB88FB49A62", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "5A5DE05870933D6F", type: "checkmark" }]
			x: 18.00d
			y: -4.50d
		}
		{
			dependencies: ["2502CCD91E41AFC0"]
			description: ["&6Was ist das?", "Bücherregale machen den Verzauberungstisch stärker.", "", "&6So gehts", "Bretter und Bücher. Bücher aus Papier und Leder.", "", "&6Wofür ist das wichtig?", "Mit Apothic Enchanting gibt es viele besondere Regale."]
			icon: { id: "minecraft:bookshelf" }
