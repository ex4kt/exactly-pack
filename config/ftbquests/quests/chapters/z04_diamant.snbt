			x: 13.50d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Ab hier läuft alles mit Strom. Elektromaschinen sind wie Dampfmaschinen, übertakten aber stufenlos bis 32 EU/t.", "Das Ziel: Baue Anlagen, die du dauerhaft ausbaust. Die volle Leistung erreichen Elektromaschinen im Dauerbetrieb.", "", "&6So gehts", "Die Quests unten führen dich von der ersten Turbine bis zur Ölraffinerie.", "", "&6Wofür ist das wichtig?", "Starke Technik ohne Zauberei, aber mit Planung."]
			dependencies: ["63064054BBFD8FB1"]
			id: "037AFA5329EC37DE"
			title: "Die Elektrozeit"
			rewards: [{ id: "5D54B9953A0DF190", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "68938CCF419BF4D1", type: "checkmark" }]
			x: 0.00d
			y: 19.500d
		}
		{
			description: ["&6Was ist das?", "Wandelt Dampf in Strom (EU) um: 1 mb Dampf wird zu 1 EU, bis zu 32 mb pro Tick.", "", "&6So gehts", "Sie gibt Strom nur an Kabel auf ihrer Ausgabeseite ab. Sie hat die Stufe LV (Niederspannung).", "Kabel haben eine Stufe: Kupfer, Silber und Zinn sind LV, Kupfernickel und Elektrum sind MV.", "", "&6Wofür ist das wichtig?", "Die erste Stromquelle."]
			dependencies: ["037AFA5329EC37DE"]
			id: "24C9F1CD29645A91"
			title: "LV Dampfturbine"
			rewards: [{ id: "198E7BCEB139EDBA", type: "xp_levels", xp_levels: 8 }]
