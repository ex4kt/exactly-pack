		}
		{
			dependencies: ["37407FF743621E7E"]
			description: ["&6Was ist das?", "Mit Easy Disenchanting uebertraegst du Verzauberungen auf Buecher.", "Schritt 1: Lege das verzauberte Item und ein Buch in den Amboss.", "Schritt 2: Nimm das verzauberte Buch heraus.", "", "&6So gehts", "Item in den Schleifstein legen.", "", "&6Wofuer ist das wichtig?", "Schlechte Verzauberungen loswerden und neu verzaubern."]
			id: "08E13C4778BBECAD"
