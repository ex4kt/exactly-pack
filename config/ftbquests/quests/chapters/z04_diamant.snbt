			tasks: [{ id: "335F8079690CBD37", type: "item", item: { id: "modern_industrialization:bronze_compressor", count: 1 }, count: 1L }]
			x: 12.00d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Mischt Stäube zu besseren Verhältnissen: Bronze, Schamotte und später Rohstahl.", "", "&6So gehts", "Neben den Kessel stellen. Legt man Kupfer- und Zinnstaub hinein, entsteht Bronzestaub. Er macht auch Bruchstein und Ton.", "", "&6Wofür ist das wichtig?", "Spart Material gegenüber dem Mischen im Handwerkstisch."]
			dependencies: ["0A48575E5B1895F5"]
			id: "4C454C552CE9303A"
			title: "Bronzemischer"
