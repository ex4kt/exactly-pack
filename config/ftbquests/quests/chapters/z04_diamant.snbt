			tasks: [{ id: "602685C21B170B63", type: "item", item: { id: "modern_industrialization:bronze_furnace", count: 1 }, count: 1L }]
			x: 3.00d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Das wichtigste Werkzeug dieser Mod.", "", "&6So gehts", "Rechtsklick dreht eine Maschine, Umschalt+Rechtsklick dreht ihre Ausgabeseite.", "Mit dem Schlüssel in der Hand siehst du bei Mehrblock-Bauten fehlende Blöcke und Fehler.", "Achtung: Mit dem Schlüssel abgebaut lässt eine Maschine nichts fallen. Dafür nimmst du eine Spitzhacke.", "", "&6Wofür ist das wichtig?", "Du brauchst ihn für Rohre, Maschinen und jeden Mehrblock-Bau."]
			dependencies: ["42C4773EE44E1BC3"]
			id: "43AF4FD247B5545E"
			title: "Der Schraubenschlüssel"
			rewards: [{ id: "28FD12B3E40A9236", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "63EC3389B375AF26", type: "item", item: { id: "modern_industrialization:wrench", count: 1 }, count: 1L }]
			x: 4.50d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Jede Maschine nimmt Eingaben von allen Seiten an und hat eine Ausgabeseite.", "", "&6So gehts", "Im Menü schaltest du das automatische Auswerfen ein. Ein Schloss sperrt einen Slot auf eine Sorte, mit dem Mausrad senkst du die Stapelgröße.", "Trichter, Rohre und andere Automatik können aus jeder Seite entnehmen.", "Die Bronze-Luke, die du hier abgibst, brauchst du gleich für den Koksofen.", "", "&6Wofür ist das wichtig?", "So automatisierst du später ganze Fertigungsstraßen."]
			dependencies: ["43AF4FD247B5545E"]
			id: "75A96C18F78FD229"
			title: "Maschinen einstellen"
			rewards: [{ id: "77B9F5C1F7221D31", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "3B5065FA27750793", type: "item", item: { id: "modern_industrialization:bronze_item_input_hatch", count: 1 }, count: 1L }]
			x: 6.00d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Transportiert Flüssigkeiten zwischen Maschinen und Tanks.", "", "&6So gehts", "Bis zu 3 Rohre passen in einen Block, Rohre verschiedener Farben verbinden sich nicht.", "Ein Rohr enthält nur eine Flüssigkeit und verbindet sich nicht von allein mit leeren Rohren. Schlüssel-Rechtsklick ändert die Verbindung, in die Mitte klicken erzwingt sie.", "", "&6Wofür ist das wichtig?", "Für Wasser zum Kessel, Dampf und später Öl."]
			dependencies: ["75A96C18F78FD229"]
			id: "1541A904AAF72D6C"
			title: "Flüssigkeitsrohr"
			rewards: [{ id: "696CAB8626369921", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "46F46A94C8EEC5F3", type: "item", item: { id: "modern_industrialization:fluid_pipe", count: 1 }, count: 1L }]
			x: 7.50d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Transportiert Gegenstände, etwa 16 alle paar Sekunden.", "", "&6So gehts", "Rechtsklick auf eine Verbindung ohne Schlüssel öffnet den Filter. Standardmäßig ist er eine Erlaubnisliste: es wird nichts bewegt, bis du Gegenstände einträgst oder auf Sperrliste umstellst.", "Konfiguriere beide Enden des Rohrs, sonst bewegt sich nichts. Mit Motoren lässt es sich aufrüsten.", "", "&6Wofür ist das wichtig?", "Dein Transportsystem zwischen Maschinen und Lagern."]
			dependencies: ["1541A904AAF72D6C"]
			id: "435FD94055B4F772"
			title: "Gegenstandsrohr"
			rewards: [{ id: "49871BE937469D73", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "4DC34C88D1552BFA", type: "item", item: { id: "modern_industrialization:item_pipe", count: 1 }, count: 1L }]
			x: 9.00d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Eine Pumpe, die Wasser selbst nachliefert.", "", "&6So gehts", "Umgib sie seitlich mit Wasserblöcken. Pro angrenzender Quelle gibt sie alle 5 Sekunden 1/8 Eimer, höchstens 1 Eimer alle 5 Sekunden, und kostet 1 EU/t.", "Das Wasser geht automatisch an die Maschine auf ihrer Ausgabeseite.", "", "&6Wofür ist das wichtig?", "Automatischer Wassernachschub für den Kessel."]
			dependencies: ["435FD94055B4F772"]
			id: "63CA735E130DC614"
			title: "Bronzepumpe"
			rewards: [{ id: "4E6EA38AA9245A08", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "7DF7165362C483A4", type: "item", item: { id: "modern_industrialization:bronze_water_pump", count: 1 }, count: 1L }]
			x: 10.50d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Ein Tank für 4 Eimer Flüssigkeit, auch in der Welt platzierbar.", "", "&6So gehts", "Rechtsklick mit Eimern oder anderen Tanks füllt und leert ihn. Tanks mit gleichem Inhalt stapeln sich im Inventar.", "", "&6Wofür ist das wichtig?", "Zwischenlager für Wasser, Öl und Co."]
			dependencies: ["63CA735E130DC614"]
			id: "64994A6760C218C1"
			title: "Bronzetank"
			rewards: [{ id: "629A48BD9E08B1E9", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "5F5AAD8C7C0749CA", type: "item", item: { id: "modern_industrialization:bronze_tank", count: 1 }, count: 1L }]
			x: 12.00d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Speichert 32 Stapel einer Sorte.", "", "&6So gehts", "Rechtsklick gibt einen Stapel hinein (mit Umschalt so viel wie möglich), Linksklick nimmt einen Stapel heraus (mit Umschalt nur einen Gegenstand).", "Beim Abbauen behält das Fass seinen Inhalt.", "", "&6Wofür ist das wichtig?", "Platzsparendes Lager, ideal für Maschinen-Eingänge."]
			dependencies: ["64994A6760C218C1"]
			id: "78ABBEC60C6CDC65"
			title: "Bronzefass"
			rewards: [{ id: "1731BE477E079629", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "413D1B47E0A0D008", type: "item", item: { id: "modern_industrialization:bronze_barrel", count: 1 }, count: 1L }]
			x: 13.50d
			y: -21.000d
		}
		{
			description: ["&6Was ist das?", "Die erste Mehrblock-Maschine: Sie macht aus Kohle Koks, dem Weg zu Stahl.", "", "&6So gehts", "Du brauchst den Koksofen als Steuerblock (Controller), 21 Ziegel und 3 Luken: Gegenstands-Eingang, Gegenstands-Ausgang und Flüssigkeits-Eingang für Dampf. Optional ein Flüssigkeits-Ausgang für Kreosot.", "Halte den Schraubenschlüssel in der Hand, um fehlende Blöcke zu sehen. Mit einer Luke in der Hand siehst du, wo sie hin darf. Fehlt eine Luke, startet er nicht.", "Steht „Form gültig“, fülle den Eingang mit Dampf und Kohle.", "", "&6Wofür ist das wichtig?", "Koks ist der Grundstoff für Stahl und ein starker Brennstoff."]
			dependencies: ["63064054BBFD8FB1"]
			id: "7D64281ACD707388"
			title: "Der Koksofen"
			rewards: [{ id: "187E744A0A516B58", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "6765F9DADEF0DA69", type: "item", item: { id: "modern_industrialization:coke_oven", count: 1 }, count: 1L }]
			x: 0.00d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Gebrannte Kohle. Als Brennstoff hält Koks viermal so lange wie Kohle.", "", "&6So gehts", "Lass den Koksofen laufen und hole Koks aus dem Ausgang.", "", "&6Wofür ist das wichtig?", "Koks wird zu Koksstaub für Stahl und später für Gummi."]
			dependencies: ["7D64281ACD707388"]
			id: "03B69C3DEDBCF753"
			title: "Koks"
			rewards: [{ id: "4A6436F248257D97", type: "xp_levels", xp_levels: 6 }]
