		{
			description: ["&6Was ist das?", "Schritt 1: Baue einen Verzauberungstisch.", "Schritt 2: Lege Werkzeug und Lapislazuli hinein.", "Das Werkzeug kommt in den linken, der Lapislazuli in den rechten Platz.", "", "&6So gehts", "Diamanten, Obsidian und ein Buch.", "Bis zu 15 Bücherregale im Abstand von einem Block darum herum machen die Verzauberungen stärker.", "Lapis und Erfahrung zahlen.", "", "&6Wofür ist das wichtig?", "Effizienz, Glück und Haltbarkeit machen dich viel schneller und sparen Material.", "", "&6Gut zu wissen", "Mit 15 Bücherregalen im Abstand von einem Block rund um den Tisch erreichst du die höchste Verzauberungsstufe (30). Lapislazuli ist der Preis jeder Verzauberung."]
			dependencies: ["2DEDA3D57FB89524"]
			id: "2502CCD91E41AFC0"
			title: "Der Verzauberungstisch"
			rewards: [{ id: "69B8EA263F9CBAB4", type: "item", item: { id: "minecraft:lapis_lazuli", count: 16 } }]
			tasks: [{ id: "108E99E367ADB315", type: "item", item: { id: "minecraft:enchanting_table", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.000d
		}
		{
			description: ["&6Was ist das?", "Apothic Enchanting ersetzt das normale Verzaubern.", "Jedes Bücherregal hat Werte: Eterna (Stärke), Quanta (Zufall) und Arcana (Seltenheit).", "", "&6So gehts", "Stelle verschiedene Bücherregale um den Verzauberungstisch. Fahre mit der Maus über den Tisch, um die Werte zu sehen.", "Bessere Regale (z.B. aus Nether- oder End-Material) bringen höhere Stufen.", "Das Rezeptbuch (JEI) zeigt alle besonderen Regale und Rezepte.", "", "&6Wofür ist das wichtig?", "Mit guten Regalen bekommst du Verzauberungen über der normalen Höchststufe. Das macht Werkzeuge und Rüstung für die Bosse stark."]
			icon: { id: "minecraft:enchanted_book" }
			dependencies: ["2502CCD91E41AFC0"]
			id: "1DB3F417D7AE0137"
			title: "Apothic Enchanting"
			rewards: [{ id: "59E9963E549C5FF8", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "675BE451169A1D81", type: "checkmark" }]
			x: 9.00d
			y: 0.000d
		}
		{
			description: ["&6Was ist das?", "Mit Easy Disenchanting holst du Verzauberungen vom Item auf ein Buch. Das Item bleibt erhalten, nur ohne Verzauberung.", "", "&6So gehts", "Öffne einen Amboss (nicht den Schleifstein).", "Links das verzauberte Item, rechts ein leeres Buch. Rechts nimmst du das verzauberte Buch.", "Willst du auf ein Buch, das schon Verzauberungen hat: das Buch links, das Item rechts.", "Der Schleifstein löscht Verzauberungen und gibt nur Erfahrung zurück. Die Verzauberung ist dann weg.", "", "&6Wofür ist das wichtig?", "Gute Verzauberungen von alter Ausrüstung retten und neu verteilen."]
			dependencies: ["1DB3F417D7AE0137"]
			id: "79245A87CC32FE72"
			title: "Verzauberung übertragen"
			rewards: [{ id: "6016C3A2CE568AF9", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "753B1D909508CF15", type: "checkmark" }]
			x: 10.50d
			y: -4.500d
		}
		{
			description: ["&6Was ist das?", "Der XP Tome speichert Erfahrung in einem Buch.", "Rechtsklick füllt oder leert es.", "", "&6So gehts", "Rechtsklick füllt, Shift-Rechtsklick holt sie zurück.", "", "&6Wofür ist das wichtig?", "Beim Tod verlierst du gespeicherte Erfahrung nicht. Spare für große Verzauberungen."]
			dependencies: ["79245A87CC32FE72"]
			id: "0FD6302A9ABCCF31"
