		}
		{
			dependencies: ["0A60B7540735FCD4"]
			description: ["&6Was ist das?", "Die Bibliothek speichert unendlich viele Verzauberungsbücher.", "", "&6So gehts", "Rezept in JEI. Bücher hineinlegen, einzelne Verzauberungen wieder herausnehmen.", "", "&6Wofür ist das wichtig?", "Ordnung für alle Bücher und gezieltes Verzaubern."]
			icon: { id: "apothic_enchanting:library" }
