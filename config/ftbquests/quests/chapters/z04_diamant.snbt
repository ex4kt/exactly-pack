			x: 1.50d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Der Hammer ist dein erstes Werkzeug. Er erhöht die Ausbeute im Schmiedehammer und schaltet mehr Rezepte frei, kostet aber Haltbarkeit.", "", "&6So gehts", "Rezept in JEI ansehen und herstellen.", "", "&6Wofür ist das wichtig?", "Ohne Hammer gibt es kaum Staub und Platten in der frühen Phase."]
			dependencies: ["7F68C56FAD48BA20"]
			id: "368968294CAB3CCA"
			title: "Eisenhammer"
			rewards: [{ id: "47C2AEF75CCB97C2", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "5D6D97FDE9224C68", type: "item", item: { id: "modern_industrialization:iron_hammer", count: 1 }, count: 1L }]
			x: 3.00d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Der Schmiedehammer ist ein Block für einfache Verarbeitung ohne Strom.", "", "&6So gehts", "Lege Eisen-, Kupfer- oder Zinnerz hinein: du bekommst 2 Roherz pro Erz.", "Mit dem Eisenhammer steigt das Verhältnis noch weiter. Jedes Roherz lässt sich schmelzen.", "", "&6Wofür ist das wichtig?", "Er verdoppelt bis verdreifacht deine Erzausbeute zu Beginn."]
			dependencies: ["368968294CAB3CCA"]
			id: "0C440DB65CD680CE"
			title: "Schmiedehammer"
			rewards: [{ id: "46C0370F57499978", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "213E7CC40474F701", type: "item", item: { id: "modern_industrialization:forge_hammer", count: 1 }, count: 1L }]
			x: 4.50d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Ein Bohrer, der 3x3 Blöcke auf einmal abbaut und Behutsamkeit hat.", "", "&6So gehts", "Er braucht Wasser und festen Brennstoff, zum Beispiel Kohle.", "Rechtsklick auf eine Wasserquelle füllt ihn. Brennstoff legst du per Rechtsklick im Inventar auf den Bohrer. Beim Abbauen wird der Brennstoff langsam verbraucht.", "", "&6Wofür ist das wichtig?", "Zusammen mit dem Schmiedehammer holst du Erze ohne Behutsamkeits-Spitzhacke."]
			dependencies: ["0C440DB65CD680CE"]
			id: "479687E2AACCCA3C"
			title: "Dampf-Bergbaubohrer"
			rewards: [{ id: "389F6E24B88E8A6A", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "7E4908B9BE5EC5B5", type: "item", item: { id: "modern_industrialization:steam_mining_drill", count: 1 }, count: 1L }]
			x: 6.00d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Bronze ist das Material der ersten Maschinen.", "", "&6So gehts", "Hämmere Kupfer- und Zinnbarren im Schmiedehammer zu Staub. Beides zusammen ergibt Bronzestaub, im Ofen wird daraus ein Bronzebarren.", "Besser ist es im Mischer, den du gleich baust. Merke: 9 winzige Stäube sind 1 Staub.", "", "&6Wofür ist das wichtig?", "Bronze braucht fast jeder Bau der ersten Stufe."]
			dependencies: ["479687E2AACCCA3C"]
			id: "754DA6F04BD88A3B"
			title: "Deine erste Bronze"
			rewards: [{ id: "5B84981BB6FEC97A", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2507EF7BF882C54E", type: "item", item: { id: "modern_industrialization:bronze_ingot", count: 1 }, count: 1L }]
			x: 7.50d
			y: -18.000d
		}
		{
			description: ["&6Was ist das?", "Feuerfeste Ziegel für Koksofen, Hochofen und Kessel.", "", "&6So gehts", "Lege Ziegel in den Schmiedehammer, du bekommst Ziegelstaub. Daraus wird Schamottestaub, im Ofen entsteht der Schamottestein.", "In Dampfmaschinen oder mit dem Hammer klappt das effizienter.", "", "&6Wofür ist das wichtig?", "Für Koksofen und Dampfhochofen braucht man viele davon."]
			dependencies: ["754DA6F04BD88A3B"]
			id: "72776E94CB6184AD"
			title: "Schamottestein"
			rewards: [{ id: "1B48DFEC309D3F49", type: "xp_levels", xp_levels: 3 }]
