		}
		{
			dependencies: ["69BF8973F8D01A34"]
			description: ["&6Was ist das?", "Der Diamant-Rucksack ist riesig und hat viele Upgrade-Plätze.", "", "&6So gehts", "Gold-Rucksack mit Diamanten aufwerten.", "", "&6Wofür ist das wichtig?", "Viele Plätze und Upgrade-Slots für lange Reisen."]
			id: "797F4B8218472B01"
