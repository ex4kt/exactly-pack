			x: 4.50d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Verbessert Bronzemaschinen zu Stahlmaschinen.", "", "&6So gehts", "Im Handwerkstisch auf eine Bronzemaschine anwenden, oder mit Umschalt+Rechtsklick direkt auf die Maschine.", "Stahlmaschinen schaffen Rezepte bis 4 EU/t und arbeiten doppelt so schnell. Ein Stahlkessel liefert doppelt so viel Dampf, ein Stahltank fasst 16 Eimer, die Stahlpumpe liefert doppelt so viel Wasser.", "Ein Mehrblock mit mindestens einer Stahl-Luke wird ebenfalls zur Stahlstufe.", "", "&6Wofür ist das wichtig?", "Doppelte Geschwindigkeit ohne neue Maschinen."]
			dependencies: ["7C22C0ACA75671CC"]
			id: "1F4C25C7E7BB4DF2"
			title: "Stahl-Upgrade"
			rewards: [{ id: "59C8B7AEFDBF4906", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "74A4E858D8A0E3A0", type: "item", item: { id: "modern_industrialization:steel_upgrade", count: 1 }, count: 1L }]
			x: 6.00d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Erledigt einfache Handwerksrezepte automatisch, zum Beispiel Doppelbarren und Rohre.", "", "&6So gehts", "Rezepte siehst du in JEI. Der Packer ist erst ab Stahlstufe verfügbar.", "", "&6Wofür ist das wichtig?", "Spart viel Handarbeit bei Massenproduktion."]
