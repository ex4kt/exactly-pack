			x: 1.50d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Hier entsteht Stahl.", "", "&6So gehts", "Zerkleinere Koks zu Koksstaub und mische ihn mit Eisen zu ungekochtem Stahlstaub. Im Mischer wird das Verhältnis besser.", "Aufbau: Steuerblock, 29 Schamottesteine und dieselben drei Luken wie beim Koksofen. Er sieht aus wie der Koksofen mit einer zusätzlichen hohlen Schicht oben.", "", "&6Wofür ist das wichtig?", "Stahl brauchst du für fast alle besseren Maschinen."]
			dependencies: ["03B69C3DEDBCF753"]
			id: "5A3A1ADC4085F1A4"
			title: "Der Dampfhochofen"
			rewards: [{ id: "54ED5A2252643722", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "3363D51A585C7CB9", type: "item", item: { id: "modern_industrialization:steam_blast_furnace", count: 1 }, count: 1L }]
			x: 3.00d
			y: -24.000d
		}
		{
			description: ["&6Was ist das?", "Stahl ist stabiler als Bronze und das Material der zweiten Dampfstufe.", "", "&6So gehts", "Ungekochten Stahlstaub im Dampfhochofen verarbeiten.", "", "&6Wofür ist das wichtig?", "Mit Stahl baust du den Steinbruch und alles Weitere."]
			dependencies: ["5A3A1ADC4085F1A4"]
			id: "7C22C0ACA75671CC"
			title: "Dein erster Stahl"
			rewards: [{ id: "46A9E19439A5A833", type: "xp_levels", xp_levels: 6 }]
