	title: "&eKochen"
	quests: [
		{
			description: ["&6Was ist das?", "Farmers Delight bringt bessere Gerichte, Felder und Kochgeraete.", "Die naechsten Quests fuehren dich Schritt fuer Schritt durch die Kueche.", "Tipp: Mahlzeiten aus dem Kochtopf geben Effekte wie Nahrhaft und Gemuetlich (Lebensregeneration).", "", "&6So gehts", "Folge den Quests in diesem Kapitel: erst Werkzeug, dann Kochgeraete, dann Gerichte.", "", "&6Wofuer ist das wichtig?", "Mahlzeiten aus dem Kochtopf geben die Effekte Nahrhaft (kein Hunger) und Gemuetlich (Leben regeneriert). Das hilft enorm in Kaempfen und Dungeons."]
			id: "6A04023D48E9532D"
			title: "Kochen mit Farmers Delight"
			rewards: [{ id: "664D8DC07DA7E676", type: "item", item: { id: "minecraft:bread", count: 4 } }]
			tasks: [{ id: "E93FBDA59827FC8E", type: "checkmark" }]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["6A04023D48E9532D"]
			description: ["&6Was ist das?", "Ein Messer ist das wichtigste Werkzeug. Damit schneidest du Zutaten, erntest Stroh und holst mehr aus Tieren.", "", "&6So gehts", "Baue ein Messer aus Eisen (oder Feuerstein, Gold, Diamant).", "Mit dem Messer erntest du Stroh von Gras und bekommst mehr Fleisch von Tieren.", "", "&6Wofuer ist das wichtig?", "Ohne Messer kannst du auf dem Schneidebrett kaum etwas schneiden. Stroh brauchst du fuer Leinwand und Reiche Erde."]
			id: "B5118D50497C373F"
			title: "Messer"
			rewards: [{ id: "62462C71D28E3273", type: "item", item: { id: "minecraft:iron_nugget", count: 8 } }]
			tasks: [{ id: "27EA70C03DCB43E0", type: "item", item: { id: "farmersdelight:iron_knife", count: 1 }, count: 1L }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["B5118D50497C373F"]
			description: ["&6Was ist das?", "Auf dem Schneidebrett schneidest du Zutaten. Rechtsklick mit Messer, Axt oder Schaufel auf das Brett.", "", "&6So gehts", "Stelle das Brett auf, lege mit Rechtsklick eine Zutat darauf.", "Rechtsklick mit Messer schneidet.", "In JEI siehst du alle Schneide-Rezepte.", "", "&6Wofuer ist das wichtig?", "Fast jedes Gericht braucht geschnittene Zutaten. Spaeter kann der Slicer aus Slice and Dice das automatisch machen."]
			id: "EF946351EB28CE2D"
			title: "Schneidebrett"
			rewards: [{ id: "EA0B2145FDD47ED0", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "0C48ED7694AB01B3", type: "item", item: { id: "farmersdelight:cutting_board", count: 1 }, count: 1L }]
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["EF946351EB28CE2D"]
			description: ["&6Was ist das?", "Der Herd ist die beste Hitzequelle fuer Topf und Pfanne. Du kannst auch ein Lagerfeuer nehmen.", "", "&6So gehts", "Stelle den Herd auf und zuende ihn mit Feuerzeug an.", "Lege rohes Fleisch mit Rechtsklick auf den Herd, um es zu grillen.", "", "&6Wofuer ist das wichtig?", "Topf und Pfanne brauchen Hitze von unten. Der Herd ist sauberer als ein Lagerfeuer und haelt ewig."]
			id: "9AF11B4850F7A6AC"
			title: "Herd"
			rewards: [{ id: "74F92B0E7F9003EB", type: "item", item: { id: "minecraft:coal", count: 8 } }]
			tasks: [{ id: "69B8E529ADCE1C0C", type: "item", item: { id: "farmersdelight:stove", count: 1 }, count: 1L }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["9AF11B4850F7A6AC"]
			description: ["&6Was ist das?", "Im Kochtopf gart man Eintoepfe und Suppen. Stelle ihn auf den Herd und lege Zutaten plus Schuessel hinein.", "", "&6So gehts", "Stelle den Topf auf den Herd.", "Lege bis zu sechs Zutaten und das Gefaess (meist Schuessel) hinein.", "Warte, bis das Gericht fertig ist, und nimm es heraus.", "", "&6Wofuer ist das wichtig?", "Topf-Gerichte geben die wichtigen Effekte. Mit Wasser im Topf brauchst du fuer Suppen kein Wasser extra."]
			id: "4FB6AD78F02DAD46"
			title: "Kochtopf"
			rewards: [{ id: "D1C3E4DA8D0FC187", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6A47524877044543", type: "item", item: { id: "farmersdelight:cooking_pot", count: 1 }, count: 1L }]
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["4FB6AD78F02DAD46"]
			description: ["&6Was ist das?", "In der Pfanne brutzelt man Fleisch, Fisch und Eier direkt auf dem Herd.", "", "&6So gehts", "Stelle sie auf den Herd und lege Zutaten mit Rechtsklick hinein.", "Du kannst sie auch in der Hand benutzen und damit zuschlagen.", "", "&6Wofuer ist das wichtig?", "Schneller als ein Ofen. Mit dem Korb daneben landet das Essen automatisch darin."]
			id: "692982D2B0F63E67"
			title: "Pfanne"
			rewards: [{ id: "B53F6AD2C9F814B5", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "F0777864F61BAC91", type: "item", item: { id: "farmersdelight:skillet", count: 1 }, count: 1L }]
			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["692982D2B0F63E67"]
			description: ["&6Was ist das?", "Der Korb sammelt Items, die auf ihn fallen. Stelle ihn neben die Pfanne, dann landet das Essen automatisch darin.", "", "&6So gehts", "Stelle den Korb neben oder unter Pfanne und Herd.", "Richte ihn auf eine Kiste.", "", "&6Wofuer ist das wichtig?", "Erste kleine Automatisierung in der Kueche, auch fuer Farmen nuetzlich."]
			id: "064C3C3C271186D7"
			title: "Korb"
