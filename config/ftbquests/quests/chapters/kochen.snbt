		}
		{
			dependencies: ["9AC4972966600C94"]
			description: ["&6Was ist das?", "Tomaten wachsen an Ranken und brauchen ein Seil oder Stange zum Klettern.", "", "&6So gehts", "Pflanze Tomatensamen und setze Seil darueber, damit sie hoch wachsen.", "", "&6Wofuer ist das wichtig?", "Tomaten brauchst du fuer Pasta-Sauce, Pizza und Ketchup."]
			id: "27AAD63E22BA19E1"
