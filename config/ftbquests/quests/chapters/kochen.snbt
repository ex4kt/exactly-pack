		}
		{
			dependencies: ["B910314218B9D051"]
			description: ["&6Was ist das?", "Reis waechst im flachen Wasser. Du brauchst ihn fuer viele Gerichte.", "", "&6So gehts", "Pflanze Reis in flaches Wasser (ein Block tief).", "Reife Rispen auf dem Schneidebrett zu Reis verarbeiten.", "", "&6Wofuer ist das wichtig?", "Reis brauchst du fuer Gebratenen Reis, Sushi und viele asiatische Gerichte."]
			id: "9AC4972966600C94"
			title: "Reis anbauen"
