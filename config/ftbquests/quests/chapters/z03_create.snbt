			tasks: [{ id: "6616455F30CA73D8", type: "item", item: { id: "create:copper_casing", count: 1 }, count: 8L }]
			x: 6.00d
			y: -20.25d
		}
		{
			dependencies: ["182C4C6D2B12D400"]
			description: ["&6Was ist das?", "Das große Wasserrad liefert viel mehr Kraft als das kleine.", "", "&6So gehts", "Rezept: 8 Bretter rund um 1 Wasserrad in der Mitte (Werkbank).", "Stelle es auf ein breites Stück fließendes Wasser, wie bei der kleinen Version.", "", "&6Wofür ist das wichtig?", "Eine Fabrik ohne Brennstoff."]
			icon: { id: "create:large_water_wheel" }
			id: "24F010691B763632"
			title: "Großes Wasserrad"
			rewards: [{ id: "2B5B117367788A8A", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "53743AE5D1E79FBB", type: "item", item: { id: "create:large_water_wheel", count: 1 }, count: 1L }]
			x: 6.00d
