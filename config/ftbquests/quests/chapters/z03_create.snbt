		}
		{
			dependencies: ["1E28AAEED1B4799C"]
			description: ["&6Was ist das?", "Der Präzisionsmechanismus ist das wichtigste Bauteil der Spätphase.", "", "&6So gehts", "Du brauchst 3 Deployer, ein Förderband und Goldblech. Gib dem ersten Deployer ein Zahnrad, dem zweiten ein großes Zahnrad, dem dritten Eisennuggets.", "Setze die drei Deployer in einer Reihe über das Band, Goldblech aufs Band legen.", "Das Teil muss 5 mal durch alle drei Deployer laufen. Mache das Band zu einer Schleife oder lege es nach jedem Durchgang wieder an den Anfang.", "Am Ende hast du einen fertigen Präzisionsmechanismus.", "", "&6Wofür ist das wichtig?", "Für Züge, Crafter, Arm, Drehzahlregler und mehr.", "", "&6Gut zu wissen", "Das Rezept zeigt JEI als „Montage“ mit allen Schritten."]
			id: "57ECEE26D1794CC7"
			title: "Präzisionsmechanismus"
			rewards: [{ id: "45931AE54350891C", type: "item", item: { id: "minecraft:diamond", count: 2 } }]
			tasks: [{ id: "07D511411AB178CB", type: "item", item: { id: "create:precision_mechanism", count: 1 }, count: 1L }]
			x: 28.50d
			y: 0.00d
		}
		{
			dependencies: ["57ECEE26D1794CC7"]
			description: ["&6Was ist das?", "Der Mechanische Arm bewegt Items zwischen Maschinen von allein.", "", "&6So gehts", "Rezept: 2 Messingbleche, 1 Messingblech, 1 Messinggehäuse, 1 Präzisionsmechanismus und 1 Legierung (Muster in JEI).", "Halte den Arm in der Hand, Rechtsklick auf die Eingangs-Quelle, dann Rechtsklick auf das Ziel, danach stelle ihn hin.", "Gib ihm Kraft.", "", "&6Wofür ist das wichtig?", "Ersetzt viele Trichter und Bänder."]
