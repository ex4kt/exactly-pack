		}
		{
			dependencies: ["674AB1A536761250"]
			description: ["&6Was ist das?", "Das ist der erste Werkstoff.", "Stelle eine Andesit-Legierung her (Andesit und Eisenstuecke).", "", "&6So gehts", "Andesit und Eisennugget (oder Zinknugget) in der Werkbank.", "Spaeter schneller im Mixer.", "", "&6Wofuer ist das wichtig?", "Fast jedes Create-Teil am Anfang braucht Andesit-Legierung. Sammle viel Andesit."]
			id: "42732661CDA6F864"
