		}
		{
			dependencies: ["24F010691B763632"]
			description: ["&6Was ist das?", "Drehzahlmesser und Belastungsmesser zeigen dir Tempo und Last.", "", "&6So gehts", "Drehzahlmesser: 1 Kompass und 1 Andesit-Gehäuse (Werkbank).", "Belastungsmesser: stelle aus dem Drehzahlmesser in der Werkbank den anderen her.", "Setze sie an eine Welle. Die Anzeige zeigt, ob alles läuft.", "", "&6Wofür ist das wichtig?", "Du siehst, wenn die Anlage zu schwach ist, bevor etwas stehen bleibt."]
			icon: { id: "create:stressometer" }
			id: "7FA24E0EEF26FEFF"
			title: "Messgeräte"
			rewards: [{ id: "7CB9D00F32013DC3", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "1F4768D4D661CFEB", type: "item", item: { id: "create:stressometer", count: 1 }, count: 1L }]
			x: 7.50d
			y: 20.25d
		}
		{
			dependencies: ["489ADC0B60AB13A5"]
			description: ["&6Was ist das?", "Die Mühle zermahlt Items, zum Beispiel Getreide zu Mehl.", "", "&6So gehts", "Rezept: Zahnrad oben, Andesit-Gehäuse in der Mitte, Stein unten (Werkbank).", "Setze sie so, dass sie von einer Welle oder Kurbel Kraft bekommt.", "Wirf die Items oben hinein. Das Ergebnis wirft sie seitlich aus oder legt es unten ab.", "", "&6Wofür ist das wichtig?", "Mehl für Brot, Farben aus Blumen und Brocken aus Erz."]
			id: "3E86AA6370B6B05D"
			title: "Mühle (Millstone)"
			rewards: [{ id: "2917D9E3CEC5D626", type: "item", item: { id: "minecraft:wheat", count: 8 } }]
			tasks: [{ id: "0DD4D70EC6DCC5D8", type: "item", item: { id: "create:millstone", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["3E86AA6370B6B05D"]
			description: ["&6Was ist das?", "Die Mechanische Presse presst Barren zu Blechen.", "", "&6So gehts", "Rezept: Welle oben, Andesit-Gehäuse in der Mitte, Eisenblock unten (Werkbank).", "Stelle sie in 2 Blöcken Höhe über ein Depot oder Förderband und schließe Kraft an die Welle an.", "Lege einen Barren auf das Depot. Die Presse drückt herunter und macht ein Blech daraus.", "", "&6Wofür ist das wichtig?", "Bleche brauchst du für viele Create-Rezepte: Eisen, Kupfer, Gold, Messing.", "", "&6Gut zu wissen", "Die Presse braucht zum Arbeiten das Depot darunter. Ohne Depot passiert nichts."]
			id: "38AF595D86D9B7CE"
			title: "Mechanische Presse"
			rewards: [{ id: "6D385C55F984D2EC", type: "item", item: { id: "minecraft:copper_ingot", count: 8 } }]
			tasks: [{ id: "1D27CA69A0DAD2E1", type: "item", item: { id: "create:mechanical_press", count: 1 }, count: 1L }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["38AF595D86D9B7CE"]
			description: ["&6Was ist das?", "Das Depot ist eine kleine Ablage für Items und der einfachste Arbeitsplatz für Maschinen.", "", "&6So gehts", "Rezept: 1 Andesit-Legierung und 1 Andesit-Gehäuse (Werkbank, formlos).", "Stelle es unter die Presse oder einen Deployer.", "Lege ein Item mit Rechtsklick hinein, es bleibt liegen, bis die Maschine fertig ist.", "", "&6Wofür ist das wichtig?", "Ohne Depot arbeitet keine Presse."]
			id: "511AB40D87A4293D"
			title: "Depot"
			rewards: [{ id: "47A89CE68BEB6A34", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "716A8CF010634C11", type: "item", item: { id: "create:depot", count: 1 }, count: 1L }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["511AB40D87A4293D"]
			description: ["&6Was ist das?", "Zwei Brechräder zerkleinern Erz zu Brocken und holen mehr aus Erz heraus als ein Ofen.", "", "&6So gehts", "Du stellst sie im Mechanischen Crafter her (Rezept in JEI). Baue zuerst Messing und den Crafter, siehe Zweig „Messing und Technik“. Die Quest zählt erst dann.", "Setze zwei Räder nebeneinander, mit einem Block Lücke dazwischen.", "Gib beiden Kraft, sie müssen gegeneinander drehen: Das Rad links dreht sich anders herum als das Rad rechts (Schlüssel benutzen).", "Wirf Erz von oben in die Lücke.", "", "&6Wofür ist das wichtig?", "Mehr Barren pro Erz und Extra-Beute, zum Beispiel Zink.", "", "&6Gut zu wissen", "Das Brechrad steht hinter dem Mechanischen Crafter. Du kannst bis dahin Erz im Ofen schmelzen."]
			id: "1B38A51428195D36"
			title: "Brechrad"
			rewards: [{ id: "5E8DCA7C1E1BFE8A", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "27C480AE6E5BE1F2", type: "item", item: { id: "create:crushing_wheel", count: 1 }, count: 2L }]
			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["1B38A51428195D36"]
			description: ["&6Was ist das?", "Das Förderband bringt Items von A nach B.", "", "&6So gehts", "Rezept: 6 getrocknete Seetang-Blätter in 2 Reihen zu 3 (Werkbank). Getrockneter Seetang entsteht im Ofen aus Seetang.", "Rechtsklick mit dem Band auf eine Welle, danach Rechtsklick auf eine zweite Welle in gerader Linie.", "Das Band läuft, wenn die Welle Kraft hat. Items auf dem Band wandern mit.", "", "&6Wofür ist das wichtig?", "Das Rückgrat jeder Fabrik.", "", "&6Gut zu wissen", "Beide Wellen müssen auf derselben Höhe liegen und das Band muss gerade sein, nicht um die Ecke."]
			id: "4D19FA2F8D6EE1AE"
			title: "Förderband"
			rewards: [{ id: "35FED5194CD1AE5A", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6E9CBD7FD91D02DA", type: "item", item: { id: "create:belt_connector", count: 1 }, count: 4L }]
			x: 13.50d
			y: 0.00d
		}
		{
			dependencies: ["4D19FA2F8D6EE1AE"]
			description: ["&6Was ist das?", "Der Schacht ist ein Rohr für Items. Er lässt sie fallen oder zieht sie hoch.", "", "&6So gehts", "Rezept: Eisenblech oben, Eisenbarren in der Mitte, Eisenblech unten (Werkbank, 4 Stück).", "Stelle ihn senkrecht unter eine Kiste oder Maschine: Die Items fallen heraus.", "Mit einem Gebläse unten können sie auch nach oben fliegen.", "", "&6Wofür ist das wichtig?", "Items von Band zu Kiste und zurück."]
			id: "2F0645A576106C0B"
			title: "Schacht und Trichter"
