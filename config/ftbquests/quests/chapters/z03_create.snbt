			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["6DF28229B667A2EE"]
			description: ["&6Was ist das?", "Mit der Handkurbel erzeugst du erste Kraft selbst.", "Rechtsklick halten dreht die Welle.", "", "&6So gehts", "Aufstellen und Rechtsklick halten.", "", "&6Wofuer ist das wichtig?", "Perfekt zum Testen. Fuer Dauerbetrieb brauchst du Wasserrad oder Windmuehle.", "", "&6Gut zu wissen", "Halte Rechtsklick, um zu kurbeln. Mit Shift drehst du in die Gegenrichtung. Die Handkurbel ist die erste Kraftquelle, bevor du Wasser- oder Windkraft hast."]
			id: "489ADC0B60AB13A5"
