		{
			dependencies: ["489ADC0B60AB13A5"]
			hide_dependency_lines: true
			description: ["&6Was ist das?", "Das Wasserrad macht Kraft aus fliessendem Wasser.", "Platziere es neben Wasser, das fliesst, und verbinde es mit Wellen.", "", "&6So gehts", "Wasserrad auf eine Welle setzen und Wasser darueber fliessen lassen.", "", "&6Wofuer ist das wichtig?", "Erste dauerhafte Kraftquelle. Mehrere Raeder hintereinander ergeben mehr Kraft."]
