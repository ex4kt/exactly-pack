		{
			dependencies: ["79C5111ED6A1E634"]
			description: ["&6Was ist das?", "Der Blazebrenner heizt Becken und macht damit Messing möglich.", "", "&6So gehts", "Der leere Brenner: 4 Eisenbleche plus 1 Netherrack in der Mitte, kreuzförmig (Werkbank).", "Fange im Nether eine Blaze: Rechtsklick mit dem leeren Brenner auf die Blaze.", "Stelle den Brenner unter ein Becken und füttere ihn mit Kohle oder Holz. Mit Blaze-Kuchen wird er überheiß.", "", "&6Wofür ist das wichtig?", "Ohne Hitze kein Messing.", "", "&6Gut zu wissen", "Bring Feuerresistenz mit, wenn du im Nether auf Blazes gehst."]
			id: "130F33E0BDF1373A"
			title: "Blazebrenner"
			rewards: [{ id: "02E4922F1217C502", type: "item", item: { id: "minecraft:blaze_powder", count: 4 } }]
			tasks: [{ id: "5C374AFDF0EB2024", type: "item", item: { id: "create:blaze_burner", count: 1 }, count: 1L }]
			x: 21.00d
			y: 0.00d
		}
		{
			dependencies: ["130F33E0BDF1373A"]
			description: ["&6Was ist das?", "Das Becken hält Zutaten. Der Mixer darüber vermengt sie.", "", "&6So gehts", "Becken: 2 Legierungen oben, 3 unten (Werkbank, wie ein Trog).", "Mixer: Zahnrad, Andesit-Gehäuse, Schneebesen untereinander (Werkbank). Schneebesen: 5 Eisenbleche um 2 Legierungen.", "Mixer genau über das Becken stellen, Kraft anschließen. Unter das Becken kommt der Blazebrenner.", "Wirf die Zutaten ins Becken und lass den Mixer laufen.", "", "&6Wofür ist das wichtig?", "Messing, Teig, Schokolade und viele Flüssigkeiten.", "", "&6Gut zu wissen", "Ohne Brenner mischt der Mixer nur Dinge, die keine Hitze brauchen."]
			id: "5EAAFA8DBD065E8F"
			title: "Becken und Mixer"
			rewards: [{ id: "73CE919C75D997E4", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "281176B96323C21F", type: "item", item: { id: "create:mechanical_mixer", count: 1 }, count: 1L }]
			x: 22.50d
			y: 0.00d
		}
		{
			dependencies: ["5EAAFA8DBD065E8F"]
			description: ["&6Was ist das?", "Messing ist der Werkstoff für fortgeschrittene Maschinen.", "", "&6So gehts", "Wirf 1 Kupferbarren und 1 Zinkbarren ins Becken, das auf einem Blazebrenner steht.", "Mixer darüber laufen lassen. Es ergibt 2 Messing.", "Hole den Barren mit einem Trichter oder von Hand heraus.", "", "&6Wofür ist das wichtig?", "Für Mechanischen Arm, Crafter, Gehäuse und Züge.", "", "&6Gut zu wissen", "Wenn das Becken nicht arbeitet: Brenner muss „erhitzt“ sein, Blaze-Kuchen wird „überhitzt“."]
			id: "6A62DADBFA2996A0"
