{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "z03_create"
	icon: { id: "create:andesite_alloy" }
	id: "7D73897943AFB1A9"
	order_index: 8
	quest_links: [ ]
	title: "&6Create"
	quests: [
		{
			dependencies: ["01FA39B55E675D70"]
			description: ["&6Was ist das?", "Create baut Maschinen mit Drehkraft statt Strom. Alles besteht aus drei Dingen: einer Kraftquelle, Wellen und Zahnrädern, die die Kraft weitergeben, und einer Maschine, die sie benutzt.", "", "&6So gehts", "Halte im Inventar oder in JEI die Taste W über einem Create-Item: Dann spielt Ponder eine kurze Animation ab, die genau zeigt, wie es gebaut wird.", "Arbeite die Quests von links nach rechts ab. Bau jedes Teil sofort in deiner Welt auf, dann verstehst du es.", "Alles dreht sich nur, wenn eine Kraftquelle läuft. Wenn nichts läuft: zuerst die Quelle prüfen, dann die Welle.", "", "&6Wofür ist das wichtig?", "Mit Create automatisierst du Erzverarbeitung, Farmen und Essen und baust sogar Züge.", "", "&6Gut zu wissen", "Mit dem Schlüssel (Quest „Schlüssel“) kannst du Blöcke drehen und abbauen, ohne sie zu zerstören.", "Mit der Brille (Quest „Brille“) siehst du, wie viel Kraft die Anlage erzeugt und verbraucht."]
			id: "674AB1A536761250"
			title: "Was ist Create?"
			rewards: [{ id: "3136A5AA9B94E223", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "270424B22FC24966", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["674AB1A536761250"]
			description: ["&6Was ist das?", "Andesit-Legierung ist der erste Werkstoff von Create. Fast jedes Bauteil braucht sie.", "", "&6So gehts", "Öffne eine Werkbank. Lege 2 Andesit und 2 Eisennuggets über Kreuz: Andesit oben links und unten rechts, Eisennugget oben rechts und unten links.", "Du bekommst 1 Legierung. Statt Eisennuggets gehen auch Zinknuggets.", "Eisennuggets bekommst du, wenn du einen Eisenbarren in der Werkbank in 9 Nuggets zerlegst. Andesit findest du in Höhlen oder stellst ihn aus Diorit und Bruchstein her.", "", "&6Wofür ist das wichtig?", "Ohne Andesit-Legierung gibt es keine Wellen, Zahnräder oder Gehäuse.", "", "&6Gut zu wissen", "Später geht es automatisch im Mixer. Für den Anfang reicht die Werkbank."]
			id: "42732661CDA6F864"
			title: "Andesit-Legierung"
			rewards: [{ id: "264472CF9321B1B1", type: "item", item: { id: "minecraft:iron_nugget", count: 8 } }]
			tasks: [{ id: "444E72D7F28BC30A", type: "item", item: { id: "create:andesite_alloy", count: 1 }, count: 4L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["42732661CDA6F864"]
			description: ["&6Was ist das?", "Wellen und Zahnräder leiten die Drehkraft von der Quelle zur Maschine.", "", "&6So gehts", "Welle: 2 Andesit-Legierungen untereinander in die Werkbank, das ergibt mehrere Wellen auf einmal.", "Zahnrad: 1 Welle und 1 beliebiges Brett zusammen in die Werkbank.", "Setze eine Welle an die Kraftquelle. Die Welle verbindet sich mit allem, was sie berührt und mitdrehen kann.", "Zwei Zahnräder, die sich seitlich berühren, drehen sich gegenläufig. Sie müssen aneinander stoßen, ohne eine Lücke.", "", "&6Wofür ist das wichtig?", "So bringst du Kraft von der Quelle zu jeder Maschine.", "", "&6Gut zu wissen", "Wellen kannst du nur in gerader Linie verlegen. Für Kurven brauchst du Zahnräder oder Getriebe.", "Mit dem Schlüssel drehst du eine Welle in eine andere Richtung."]
			id: "6DF28229B667A2EE"
			title: "Welle und Zahnrad"
			rewards: [{ id: "17D9E7587F3E6A2C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "66D058E9290E3E2B", type: "item", item: { id: "create:cogwheel", count: 1 }, count: 4L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["6DF28229B667A2EE"]
			description: ["&6Was ist das?", "Die Handkurbel ist die erste Kraftquelle, die du ohne Wasser oder Wind bekommst.", "", "&6So gehts", "Rezept: 3 Bretter in eine Reihe oben, 1 Andesit-Legierung unten rechts (Werkbank).", "Stelle die Kurbel an eine Welle und halte Rechtsklick gedrückt. Solange du hältst, dreht sich die Welle.", "Zum Testen: Setze daneben die Mühle oder die Presse und kurbele.", "", "&6Wofür ist das wichtig?", "Perfekt zum Ausprobieren. Für Dauerbetrieb brauchst du später Wasserrad oder Windmühle."]
			id: "489ADC0B60AB13A5"
			title: "Handkurbel"
			rewards: [{ id: "17E0CDE492A1F49B", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "19E35ECDA69E0972", type: "item", item: { id: "create:hand_crank", count: 1 }, count: 1L }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["182C4C6D2B12D400"]
			description: ["&6Was ist das?", "Das Wasserrad macht aus fließendem Wasser Dauerkraft.", "", "&6So gehts", "Rezept: 8 Bretter rund um 1 Welle in der Mitte (Werkbank).", "Stelle das Rad direkt neben einen Bach oder baue selbst einen Wasserlauf: Kippe einen Eimer Wasser oben, damit das Wasser über oder an das Rad fließt.", "Das Wasser muss fließen. Stehendes Wasser dreht nichts.", "Setze eine Welle ans Rad und führe sie zu deinen Maschinen.", "", "&6Wofür ist das wichtig?", "Die erste Kraftquelle, die von allein weiterläuft. Mehrere Räder geben mehr Kraft.", "", "&6Gut zu wissen", "Wenn sich das Rad nicht dreht, prüfe, ob das Wasser auf der richtigen Seite vorbeiläuft. Mit der Brille siehst du die Leistung."]
			id: "039A708DA9C8F9F7"
			title: "Wasserrad"
			rewards: [{ id: "282F450CB79B7BF2", type: "item", item: { id: "minecraft:oak_planks", count: 16 } }]
			tasks: [{ id: "5D440B2135D5C071", type: "item", item: { id: "create:water_wheel", count: 1 }, count: 1L }]
			x: 7.50d
			y: 18.00d
		}
		{
			dependencies: ["039A708DA9C8F9F7"]
			description: ["&6Was ist das?", "Die Windmühle erzeugt Kraft aus Wind. Sie braucht ein Lager und Segel.", "", "&6So gehts", "Windmühlenlager: Holzstufe oben, ein Stein in der Mitte und eine Welle unten (Werkbank).", "Segel: Wolle und Stock, dazu Stock und Andesit-Legierung (Werkbank, ergibt 2 Segel).", "Stelle das Lager an die Wand. Baue vor der Vorderseite des Lagers eine Fläche aus mindestens 8 Segeln, sie haften aneinander.", "Rechtsklick mit leerer Hand auf das Lager: Die Windmühle startet. Mehr Segel geben mehr Kraft.", "", "&6Wofür ist das wichtig?", "Dauerhafte Kraft ohne Wasser. Reicht für eine ganze Fabrik, wenn du genug Segel baust.", "", "&6Gut zu wissen", "Hindernisse vor den Segeln stören nicht, aber die Fläche darf nicht an Blöcken streifen."]
			id: "68B64382EC0CCC2C"
			title: "Windmühle"
			rewards: [{ id: "7CB61A4DD33079A0", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "12E8F4525669F1D3", type: "item", item: { id: "create:windmill_bearing", count: 1 }, count: 1L }]
			x: 9.00d
			y: 18.00d
		}
		{
			dependencies: ["68B64382EC0CCC2C"]
			description: ["&6Was ist das?", "Große Zahnräder übersetzen die Drehzahl und geben mehr Kraft pro Drehung.", "", "&6So gehts", "Rezept: 1 Welle und 2 Bretter (oder 1 Zahnrad und 1 Brett) in der Werkbank.", "Setze ein kleines Zahnrad so neben ein großes, dass sie sich diagonal an den Rändern berühren.", "Klein treibt Groß: Die Drehzahl halbiert sich, die Kraft verdoppelt sich. Groß treibt Klein: umgekehrt.", "", "&6Wofür ist das wichtig?", "Damit stellst du Geschwindigkeit und Kraft für jede Maschine passend ein."]
			id: "3BCEB9B8C58D7608"
			title: "Großes Zahnrad"
			rewards: [{ id: "64D729A88AAFC5F3", type: "item", item: { id: "minecraft:oak_planks", count: 8 } }]
			tasks: [{ id: "662A3A3BF4C43192", type: "item", item: { id: "create:large_cogwheel", count: 1 }, count: 2L }]
			x: 10.50d
			y: 18.00d
		}
		{
			dependencies: ["3BCEB9B8C58D7608"]
			description: ["&6Was ist das?", "Das Getriebe leitet Drehkraft in mehrere Richtungen gleichzeitig weiter.", "", "&6So gehts", "Rezept in JEI nachschlagen (Andesit-Gehäuse mit Zahnrädern, Taste R auf dem Item).", "Setze es zwischen Wellen. Aus jeder Seite, an die du eine Welle setzt, kommt Kraft heraus.", "Eine Seite ist der Eingang, die anderen beliebig viele Ausgänge.", "", "&6Wofür ist das wichtig?", "Kompakte Kraftverteilung: eine Quelle versorgt viele Maschinen."]
			id: "36305C6C501DC44F"
			title: "Getriebe"
			rewards: [{ id: "2B5653D3B0CEE566", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "4B512C2B9B855433", type: "item", item: { id: "create:gearbox", count: 1 }, count: 1L }]
			x: 12.00d
			y: 18.00d
		}
		{
			dependencies: ["36305C6C501DC44F"]
			description: ["&6Was ist das?", "Die Kupplung schaltet Kraft mit einem Redstone-Signal ein und aus.", "", "&6So gehts", "Rezept: 1 Andesit-Gehäuse, 1 Welle und 1 Redstonestaub (Werkbank, formlos).", "Setze sie zwischen zwei Wellen.", "Ohne Signal läuft die Kraft durch. Mit Redstone-Signal (zum Beispiel Hebel) trennt sie.", "", "&6Wofür ist das wichtig?", "Maschinen gezielt an- und ausschalten."]
			id: "1953C0BFA6CFB012"
			title: "Kupplung"
			rewards: [{ id: "7F95F5599D0955F6", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "58901113A9ADBC89", type: "item", item: { id: "create:clutch", count: 1 }, count: 1L }]
			x: 13.50d
			y: 18.00d
		}
		{
			dependencies: ["1953C0BFA6CFB012"]
			description: ["&6Was ist das?", "Die Gangschaltung dreht die Drehrichtung um, wenn Redstone-Signal anliegt.", "", "&6So gehts", "Rezept: 1 Andesit-Gehäuse, 1 Zahnrad und 1 Redstonestaub (Werkbank, formlos).", "Baue sie zwischen zwei Wellen ein und lege einen Hebel daneben.", "Hebel an: Die Welle dahinter dreht die Gegenrichtung.", "", "&6Wofür ist das wichtig?", "Wichtig für Aufzüge und Maschinen, die vor und zurück sollen."]
			id: "70BD1FCFABB3D919"
			title: "Gangschaltung"
			rewards: [{ id: "736EB073C8433437", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "56FE4899C8FE3170", type: "item", item: { id: "create:gearshift", count: 1 }, count: 1L }]
			x: 15.00d
			y: 18.00d
		}
		{
			dependencies: ["05C9BB5F1F32E0B9"]
			description: ["&6Was ist das?", "Mit der Brille siehst du, wie viel Kraft deine Anlage hat und braucht.", "", "&6So gehts", "Rezept: 1 Faden oben in der Mitte, unten Glas, Goldblech, Glas (Werkbank). Goldblech presst du aus einem Goldbarren in der Presse.", "Setze die Brille auf (Helm-Platz) und sieh eine Maschine an.", "Rot bedeutet: überlastet, die Kraft reicht nicht.", "", "&6Wofür ist das wichtig?", "So erkennst du Fehler sofort, statt zu raten.", "", "&6Gut zu wissen", "Das Goldblech presst du in der Mechanischen Presse. Baue deshalb erst die Presse und dann die Brille."]
			id: "18BE1CC2A35E0604"
			title: "Brille und Schlüssel"
			rewards: [{ id: "3F22F1ADC00B57B8", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "64156C5D4A82C61B", type: "item", item: { id: "create:goggles", count: 1 }, count: 1L }]
			x: 7.50d
			y: -20.25d
		}
		{
			dependencies: ["18BE1CC2A35E0604"]
			description: ["&6Was ist das?", "Der Schlüssel dreht, versetzt und baut Create-Blöcke ab, ohne sie zu zerstören.", "", "&6So gehts", "Rezept: 2 Goldbleche oben, links Goldblech und rechts Zahnrad in der Mitte, 1 Stock unten rechts (Werkbank).", "Rechtsklick dreht einen Block.", "Schleichen und Rechtsklick baut ihn ab und gibt dir das Item sofort zurück.", "", "&6Wofür ist das wichtig?", "Umbauen ohne Spitzhacke und ohne Verluste."]
			id: "628F1B0AF1E9D261"
			title: "Schlüssel (Wrench)"
			rewards: [{ id: "79031085A495C97C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "4698D920D3194453", type: "item", item: { id: "create:wrench", count: 1 }, count: 1L }]
			x: 9.00d
			y: -20.25d
		}
		{
			dependencies: ["3DC943295B23ACC3"]
			description: ["&6Was ist das?", "Gehäuse umhüllen Maschinen. Fast jede Create-Maschine braucht eines.", "", "&6So gehts", "Brich einen Holzstamm mit einer Axt: Du bekommst einen entrindeten Stamm.", "Halte eine Andesit-Legierung und mache Rechtsklick auf den entrindeten Stamm. Er wird zum Andesit-Gehäuse.", "Es ist kein Werkbank-Rezept, die Anwendung geschieht direkt in der Welt.", "", "&6Wofür ist das wichtig?", "Mühle, Presse, Kupplung, Depot und viele Maschinen brauchen es.", "", "&6Gut zu wissen", "Gleiches Prinzip: Kupferbarren auf Stamm gibt Kupfergehäuse, Messingbarren gibt Messinggehäuse."]
			icon: { id: "create:andesite_casing" }
			id: "09FFCF7C8C464AAA"
			title: "Andesit-Gehäuse"
			rewards: [{ id: "39B6261C835ACE39", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "7D8C315247A50DDA", type: "item", item: { id: "create:andesite_casing", count: 1 }, count: 8L }]
			x: 4.50d
			y: -20.25d
		}
		{
			dependencies: ["09FFCF7C8C464AAA"]
			description: ["&6Was ist das?", "Das Kupfergehäuse ist die Hülle für alles mit Flüssigkeit.", "", "&6So gehts", "Halte einen Kupferbarren und mache Rechtsklick auf einen entrindeten Stamm.", "Es ist kein Werkbank-Rezept.", "", "&6Wofür ist das wichtig?", "Für Ausguss, Abfluss, Pumpen und Tanks."]
			icon: { id: "create:copper_casing" }
			id: "05C9BB5F1F32E0B9"
			title: "Kupfergehäuse"
