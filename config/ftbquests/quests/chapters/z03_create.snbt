		}
		{
			dependencies: ["42732661CDA6F864"]
			description: ["&6Was ist das?", "Wellen und Zahnraeder uebertragen die Drehung.", "Baue eine Welle, dann ein Zahnrad, und stecke es daran.", "", "&6So gehts", "Welle: Andesit-Legierung. Zahnrad: Welle und Holz.", "Zahnraeder greifen ineinander, Wellen verbinden gerade.", "", "&6Wofuer ist das wichtig?", "Damit bringst du Kraft von der Quelle zu jeder Maschine.", "", "&6Gut zu wissen", "Mit dem Schluessel baust du Create-Bloecke ab oder drehst sie, ohne sie zu zerstoeren. Grosse und kleine Zahnraeder aendern die Geschwindigkeit."]
			id: "6DF28229B667A2EE"
			title: "Welle und Zahnrad"
			rewards: [{ id: "17D9E7587F3E6A2C", type: "xp_levels", xp_levels: 2 }]
