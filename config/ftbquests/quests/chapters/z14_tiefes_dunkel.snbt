	title: "&3Tiefes Dunkel"
	quests: [
		{
			description: ["&6Was ist das?", "Deeper Darker erweitert das Tiefe Dunkel: Es gibt eine eigene Dimension (Otherside) mit Gloomslate, neuen Gegnern und starkem Resonarium-Werkzeug.", "Hier steht Schritt für Schritt, wie du dorthin kommst und was du mitnehmen kannst.", "", "&6Wofür ist das wichtig?", "Alles in diesem Kapitel ist freiwillig und jederzeit nachholbar. Jede Quest gibt eine Belohnung."]
			icon: { id: "deeperdarker:resonarium" }
			id: "04D7ABAA8C88AD3A"
			title: "&3Tiefes Dunkel"
			rewards: [{ id: "59812B742ADC2D70", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "51C9BC701E7EA419", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["04D7ABAA8C88AD3A"]
			description: ["&6Was ist das?", "Das Tiefe Dunkel ist sehr gefährlich (Wächter!). Nimm Heilung, gute Rüstung, Wolle und Blöcke mit. Schleichen vermeidet Geräusche.", "", "&6So gehts", "Lies zuerst die Anleitung zum Wächter im Diamant-Kapitel. Bereite Essen, Goldene Äpfel und Fernkampf vor."]
			id: "25FD9EA42E87DEB6"
			title: "Tiefes Dunkel: Vorbereitung"
			rewards: [{ id: "29DC51F6D3CC2E3D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "68A1E0D7560646C9", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["25FD9EA42E87DEB6"]
			description: ["&6Was ist das?", "Ein Portal führt in die Dimension Otherside.", "", "&6So gehts", "Das Portal braucht einen Rahmen und das Herz der Tiefe. Rezept und Aufbau zeigt JEI und das Handbuch des Mods."]
			id: "6BAD6BE28E7AA6E9"
			title: "Tiefes Dunkel: Portal zur Otherside"
			rewards: [{ id: "050ADA384413F268", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "35824E43AE321B2C", type: "checkmark" }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["6BAD6BE28E7AA6E9"]
			description: ["&6Was ist das?", "Resonarium ist das Material für Wächter-Waffen und -Rüstung.", "", "&6So gehts", "Besiege Schlamm-Gegner (Sludge) in der Otherside. Sie lassen Resonarium fallen.", "Die Wächter-Aufwertungsvorlage dupliziert du an der Werkbank: 7 Diamanten, 1 Sculk und 1 Vorlage (Muster in JEI).", "Im Schmiedetisch wertest du Diamantausrüstung mit der Vorlage zu Wächter-Ausrüstung auf.", "", "&6Wofür ist das wichtig?", "Starke Wächter-Ausrüstung."]
			id: "18E334144443C0F9"
			title: "Tiefes Dunkel: Resonarium"
			rewards: [{ id: "7DABE929C4A334BF", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "49C79995E18BD542", type: "checkmark" }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["18E334144443C0F9"]
			description: ["&6Was ist das?", "In der Otherside leben Gegner, die auf Geräusche reagieren.", "", "&6So gehts", "Schleiche (Shift), setze Wolle als Dämpfer und beleuchte den Weg.", "Der Stalker lässt Seelenkristalle fallen. Seelenkristalle liegen auch im Brunnen des Alten Tempels.", "Aus Seelenkristall, Seelenstaub, Sculk-Knochen und einer Elytra baust du die Seelen-Elytra (Muster in JEI).", "", "&6Wofür ist das wichtig?", "Beute für Waffen, Rüstung und die Seelen-Elytra."]
			id: "70EB9A0A96263AE6"
			title: "Tiefes Dunkel: Gefahren"
			rewards: [{ id: "00A61F933D6C51E3", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "360D02EA0BD466D6", type: "checkmark" }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["04D7ABAA8C88AD3A"]
			description: ["&6Was ist das?", "Ein seltenes Herz, das das Portal zur Otherside öffnet.", "", "&6So gehts", "Finde es in den Truhen der Alten Städte.", "Das Rezept oder den Fundort zeigt dir JEI (R auf dem Item).", "", "&6Wofür ist das wichtig?", "Freiwillig, unabhängig von allen anderen Quests."]
