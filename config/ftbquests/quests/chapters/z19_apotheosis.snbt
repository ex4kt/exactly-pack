		}
		{
			dependencies: ["17C766681B68D333"]
			description: ["&6Was ist das?", "Fünf Welt-Stufen: Zuflucht, Grenzland, Aufstieg, Gipfel, Zenit. Höhere Stufen machen Mobs stärker und die Beute besser.", "", "&6So gehts", "Strg + T öffnet die Auswahl. Dort siehst du die Voraussetzungen jeder Stufe und die Drop-Chancen.", "", "&6Wofür ist das wichtig?", "Wer die Stufen ignoriert, bekommt nur schwache Beute."]
			icon: { id: "apotheosis:boss_summoner" }
