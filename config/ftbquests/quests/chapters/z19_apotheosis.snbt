		{
			dependencies: ["3BD92E6E5A5F283E"]
			description: ["&6Was ist das?", "Ein Talisman, der nie kaputt geht: unbegrenzt lange Trankwirkung.", "", "&6So gehts", "Nur per Aufguss-Verzauberung in der Welt-Stufe Zenit, mit sehr guten Verzauberungswerten. Siehe das Kapitel Verzauberung (Apothic).", "", "&6Wofür ist das wichtig?", "Das Endziel der Tränke."]
			icon: { id: "apotheosis:potion_charm" }
			id: "18910296DB6D4BAE"
			title: "Unzerbrechlicher Talisman"
			rewards: [{ id: "5452424B524FEBFC", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "42E2375E5556035E", type: "checkmark" }]
			x: 10.50d
			y: -6.00d
		}
		{
			dependencies: ["46C408A67E0A482D"]
			description: ["&6Was ist das?", "Apothic-Edelsteine setzt du in Gegenstände mit Sockel ein. Sie geben mächtige Zusatzwerte. Jeder Edelstein hat eine Reinheit von Rissig bis Perfekt.", "", "&6So gehts", "Du findest sie in Kisten und mit kleiner Chance als Beute von Monstern, bei Eindringlingen und Bossen öfter. Von Maschinen fallen sie kaum. Hebe einen auf und bestätige die Quest.", "", "&6Wofür ist das wichtig?", "Die Welt-Stufe bestimmt, welche Edelsteine mit welcher Reinheit erscheinen."]
			icon: { id: "apotheosis:gem_dust" }
			id: "32ABE07174CBA42E"
			title: "Edelsteine"
			rewards: [{ id: "03047C30A74C6E68", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "640DDE65766479E4", type: "checkmark" }]
			x: 3.00d
			y: 3.00d
		}
		{
			dependencies: ["32ABE07174CBA42E"]
			description: ["&6Was ist das?", "Zerstoßener Edelstein, Zutat für fast alles.", "", "&6So gehts", "Die erste Portion bekommst du so: Wirf einen Edelstein auf den Boden und lass einen Amboss darauf fallen. Danach nutzt du den Zerlegetisch.", "", "&6Wofür ist das wichtig?", "Ohne Staub kannst du keinen Tisch bauen."]
			id: "2827943BD2B957AB"
			title: "Edelsteinstaub"
			rewards: [{ id: "640CB3C2002209CC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "754CCAD2D0B55717", type: "item", item: { id: "apotheosis:gem_dust", count: 1 }, count: 1L }]
			x: 4.50d
			y: 3.00d
		}
		{
			dependencies: ["2827943BD2B957AB"]
			description: ["&6Was ist das?", "Wertet Edelsteine mit Edelsteinstaub, Seltenheitsmaterial und einem zweiten Edelstein auf.", "", "&6So gehts", "Herstellung: Schere, vier Bretter, zwei glatte Steine und Edelsteinstaub.", "", "&6Wofür ist das wichtig?", "So werden aus Rissigen Steinen Perfekte."]
			id: "7C5F719ECC18BB03"
			title: "Edelstein-Schleiftisch"
			rewards: [{ id: "3A527FBCDB21FDF1", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "757010184A54F53C", type: "item", item: { id: "apotheosis:gem_cutting_table", count: 1 }, count: 1L }]
			x: 6.00d
			y: 3.00d
		}
		{
			dependencies: ["7C5F719ECC18BB03"]
			description: ["&6Was ist das?", "Verstärkter Tiefenschiefer, Grundstoff aller Sigille.", "", "&6So gehts", "Herstellung: acht Tiefenschiefer um ein Edelsteinstaub.", "", "&6Wofür ist das wichtig?", "Ohne Platten keine Sigille."]
			id: "25CE80C3C2768D50"
			title: "Edelsteinverschmolzene Schieferplatte"
			rewards: [{ id: "487BFBB1D19DB88A", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "219E63DCD9A149F2", type: "item", item: { id: "apotheosis:gem_fused_slate", count: 1 }, count: 1L }]
			x: 7.50d
			y: 3.00d
		}
		{
			dependencies: ["25CE80C3C2768D50"]
			description: ["&6Was ist das?", "Mit dem Schmiedetisch setzt du Edelsteine in Sockel ein.", "", "&6So gehts", "Gegenstand links, Edelstein rechts. Alternativ hebst du den Edelstein auf und klickst ihn im Inventar auf den Gegenstand. Manche Edelsteine sind einzigartig: nur einer pro Gegenstand. Ein eingesetzter Edelstein ist teuer wieder zu entfernen.", "", "&6Wofür ist das wichtig?", "Wähle deine Edelsteine mit Bedacht."]
			id: "76A4761EA3AA3D00"
			title: "Edelstein einsetzen"
			rewards: [{ id: "531380204444BF70", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "0B3BE54FA7EDB52D", type: "checkmark" }]
			x: 9.00d
			y: 3.00d
		}
		{
			dependencies: ["76A4761EA3AA3D00"]
			description: ["&6Was ist das?", "Fügt einem Gegenstand einen Sockel hinzu, bis höchstens zwei.", "", "&6So gehts", "Herstellung: vier Edelsteinstaub, Schießpulver, drei Edelsteinverschmolzene Schieferplatten und ein Amethystsplitter. Im Schmiedetisch auf den Gegenstand anwenden.", "", "&6Wofür ist das wichtig?", "Mehr Sockel bedeuten mehr Edelsteine."]
			id: "2D087E1C8AAFDA58"
			title: "Sigill der Sockelung"
			rewards: [{ id: "13437CB3145FE20B", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3807EDFF16DF5FBE", type: "item", item: { id: "apotheosis:sigil_of_socketing", count: 1 }, count: 1L }]
			x: 10.50d
			y: 3.00d
		}
		{
			dependencies: ["2D087E1C8AAFDA58"]
			description: ["&6Was ist das?", "Die Reinheit steigt von Rissig über Angeschlagen, Fehlerhaft, Normal und Makellos bis Perfekt.", "", "&6So gehts", "Am Schleiftisch kostet jede Stufe Edelsteinstaub, Seltenheitsmaterial und einen zweiten Edelstein gleicher Reinheit. Die Kosten steigen mit der Reinheit, JEI zeigt sie.", "", "&6Wofür ist das wichtig?", "Die Reinheit allein bestimmt die Stärke des Edelsteins."]
			id: "667099AF0368D250"
			title: "Edelstein veredeln"
			rewards: [{ id: "467E792ABB4E5375", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2B95D93FAFF6D46B", type: "checkmark" }]
			x: 12.00d
			y: 3.00d
		}
		{
			dependencies: ["667099AF0368D250"]
			description: ["&6Was ist das?", "Ein Lager für Edelsteine, bis zu 32.000 pro Sorte und Reinheit. Mit Filter nach Name und Gegenstand. Sechs Zusatzplätze erlauben Veredeln direkt im Kasten.", "", "&6So gehts", "Herstellung: drei Glasblöcke, vier Basalt, Edelstein-Schleiftisch und Endertruhe. Eine Version mit Platz für zwei Milliarden gibt es nur per Aufguss-Verzauberung.", "", "&6Wofür ist das wichtig?", "Hält das Inventar sauber und ersetzt den Schleiftisch."]
			id: "5381904E6E22E9D6"
			title: "Edelsteinkasten"
			rewards: [{ id: "573293ED2BA08D35", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "5C5550EAC496775F", type: "item", item: { id: "apotheosis:gem_case", count: 1 }, count: 1L }]
			x: 13.50d
			y: 3.00d
		}
		{
			dependencies: ["5381904E6E22E9D6"]
			description: ["&6Was ist das?", "Entfernt alle Edelsteine aus einem Gegenstand, ohne etwas zu zerstören.", "", "&6So gehts", "Herstellung: vier Edelsteinverschmolzene Schieferplatten, Lohenrute, zwei Enderperlen, Lavaeimer und Edelsteinstaub. Mit dem Gegenstand im Schmiedetisch kombinieren.", "", "&6Wofür ist das wichtig?", "Damit kannst du Edelsteine ohne Verlust umsetzen."]
			id: "634B1AEC0696E19E"
			title: "Sigill des Entzugs"
			rewards: [{ id: "3679FF6A17D58400", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3DA0281CA3C02300", type: "item", item: { id: "apotheosis:sigil_of_withdrawal", count: 1 }, count: 1L }]
			x: 15.00d
			y: 3.00d
		}
		{
			dependencies: ["634B1AEC0696E19E"]
			description: ["&6Was ist das?", "Die höchste Reinheit. Perfekte Edelsteine lassen sich nicht weiter aufwerten.", "", "&6So gehts", "Veredle einen Edelstein am Schleiftisch oder im Kasten auf Perfekt.", "", "&6Wofür ist das wichtig?", "Ein perfekter Edelstein ist der beste Beitrag zu jeder Ausrüstung."]
			icon: { id: "apotheosis:gem_dust" }
			id: "32A6DAA0FE65EAD0"
			title: "Perfekter Edelstein"
			rewards: [{ id: "62122377B32E427D", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "1FAFB48517969E06", type: "checkmark" }]
			x: 16.50d
			y: 3.00d
		}
		{
			dependencies: ["32ABE07174CBA42E"]
			description: ["&6Was ist das?", "Eindringlinge sind gerüstete Monster mit Namen und Beute. Sie ersetzen einen kleinen Teil normaler Monster-Spawns.", "", "&6So gehts", "In der Oberwelt erscheinen sie an der Oberfläche oder auf deiner Tiefe, im Nether überall, im Ende nur auf den äußeren Inseln, nie in der Zuflucht. Ein lauter Ton, eine Nachricht und ein Lichtstrahl kündigen sie an.", "", "&6Wofür ist das wichtig?", "Je höher die Welt-Stufe, desto häufiger und stärker sind sie."]
			icon: { id: "apotheosis:boss_summoner" }
			id: "4C62B32ECF646A53"
			title: "Apothic-Eindringlinge"
			rewards: [{ id: "4BB3570777BD0CC8", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "27E62848CF13E7A5", type: "checkmark" }]
			x: 3.00d
			y: 6.00d
		}
		{
			dependencies: ["4C62B32ECF646A53"]
			description: ["&6Was ist das?", "Jeder Eindringling trägt genau einen Affix-Gegenstand, den er garantiert fallen lässt.", "", "&6So gehts", "Erschlage einen Eindringling. Der Gegenstand hat seine Seltenheit, stärkere Affixe als üblich und seinen Namen als Zusatz. Dazu mehr Chance auf Edelsteine.", "", "&6Wofür ist das wichtig?", "Der Weg zum Aufstieg und eine sichere Quelle für gute Ausrüstung."]
			id: "771B0193EF859420"
			title: "Eindringlings-Beute"
			rewards: [{ id: "440783A736BB78B6", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "246405953E87D792", type: "checkmark" }]
			x: 4.50d
			y: 6.00d
		}
		{
			dependencies: ["771B0193EF859420"]
			description: ["&6Was ist das?", "Einzelne Monster mit Namen und mehr Stärke. Sie ersetzen normale Monster ohne Auftritt.", "", "&6So gehts", "Sie spawnen in der Oberwelt und im Nether. Sei vorsichtig, sie fallen nicht groß auf.", "", "&6Wofür ist das wichtig?", "Sie können Affix-Gegenstände fallen lassen."]
			id: "6934B837F973649A"
			title: "Elite-Monster"
			rewards: [{ id: "56C6C6B9127C619E", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "312C8CC0181DAED3", type: "checkmark" }]
			x: 6.00d
			y: 6.00d
		}
		{
			dependencies: ["6934B837F973649A"]
			description: ["&6Was ist das?", "Verstecke tief unter der Erde mit einem Eingesperrten Eindringling und ein paar Truhen.", "", "&6So gehts", "Es gibt mehrere Varianten. Der Käfig öffnet sich, wenn du nah kommst, und entlässt den Eindringling.", "", "&6Wofür ist das wichtig?", "Gute Beute, wenn du vorbereitet bist."]
			icon: { id: "apotheosis:boss_spawner" }
			id: "5DE6012B017167DA"
			title: "Eindringlings-Verliese"
			rewards: [{ id: "2DC1775EAD7067C5", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "1AACECA092754715", type: "checkmark" }]
			x: 7.50d
			y: 6.00d
		}
		{
			dependencies: ["5DE6012B017167DA"]
			description: ["&6Was ist das?", "Zwei Arten freistehender Spawner: Brutal-Spawner rufen stärkere, feuerresistente Monster mit langer Pause. Schwarm-Spawner rufen sehr schnell viele schwache Monster, meist Spinnen.", "", "&6So gehts", "Du findest sie in der Welt. Erschlage die Monster, danach plünderst du die Truhe.", "", "&6Wofür ist das wichtig?", "Gute Übung, bevor du eigene Spawner bearbeitest."]
			icon: { id: "minecraft:spawner" }
			id: "5FC7A6623C183F11"
			title: "Wilde Spawner"
			rewards: [{ id: "3D99BD8A127183CC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2C4EE292BFB131C3", type: "checkmark" }]
			x: 9.00d
			y: 6.00d
		}
		{
			dependencies: ["5FC7A6623C183F11"]
			description: ["&6Was ist das?", "Der Fahrende Händler bietet jetzt Leuchtfeuer, Totems der Unsterblichkeit und zufällige Affix-Gegenstände an. Bezahlt wird mit Smaragden und dem Reparaturmaterial. Er taucht öfter auf und bleibt kürzer, auch unter der Erde.", "", "&6So gehts", "Kaufe einen Affix-Gegenstand bei ihm. In der Welt-Stufe Gipfel und Zenit bietet er teils fertige Ausrüstung an.", "", "&6Wofür ist das wichtig?", "Eine ruhige Quelle für Gegenstände."]
			icon: { id: "minecraft:emerald" }
			id: "0C2E57C439D4343F"
			title: "Fahrender Händler"
			rewards: [{ id: "4FCD8D099D9B3856", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "148F366F41AE3DBA", type: "checkmark" }]
			x: 10.50d
			y: 6.00d
		}
		{
			dependencies: ["4C62B32ECF646A53"]
			description: ["&6Was ist das?", "Mit Apothic Spawners lassen sich Mob-Spawner einsammeln und umsetzen.", "", "&6So gehts", "Baue einen Spawner mit einem Werkzeug mit Behutsamkeit ab. Das kostet zusätzliche Haltbarkeit. Halte Umschalt über dem Gegenstand, dann siehst du seine Werte.", "", "&6Wofür ist das wichtig?", "Mob-Farmen nach deinen Regeln."]
			icon: { id: "minecraft:spawner" }
			id: "07D2579F1F9C806D"
			title: "Spawner einsammeln"
			rewards: [{ id: "5C87C3D604714E85", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2B2794DE623C2DC6", type: "checkmark" }]
			x: 3.00d
			y: 9.00d
		}
		{
			dependencies: ["07D2579F1F9C806D"]
			description: ["&6Was ist das?", "Entsteht, wenn ein Mob-Spawner durch eine Explosion zerstört wird. Eine Kaskade zerstört ihn, wenig später detoniert er, der gespeicherte Mob und viele Ketten bleiben liegen.", "", "&6So gehts", "Zerstöre einen Spawner mit TNT oder Ähnlichem und sammle die Ketten auf. Der Spawner geht dabei verloren.", "", "&6Wofür ist das wichtig?", "Ketten sind der Rohstoff aller Runen."]
			id: "3CF889920FEEBF6C"
			title: "Spawner-Kette"
			rewards: [{ id: "58E3D4E8462333F4", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "063916BECCF29FE3", type: "item", item: { id: "apotheosis:spawner_chain", count: 1 }, count: 1L }]
			x: 4.50d
			y: 9.00d
		}
		{
			dependencies: ["3CF889920FEEBF6C"]
			description: ["&6Was ist das?", "Die leere Rune, Grundlage aller anderen.", "", "&6So gehts", "Herstellung: fünf Spawner-Ketten, zwei Edelsteinverschmolzene Schieferplatten und zwei Edelsteinstaub.", "", "&6Wofür ist das wichtig?", "Alle weiteren Runen entstehen aus ihr."]
			id: "0DAB3A9E3D160338"
			title: "Spawner-Rune"
			rewards: [{ id: "793DBA21EBB7D773", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "483CD663E807C62C", type: "item", item: { id: "apotheosis:spawner_rune", count: 1 }, count: 1L }]
			x: 6.00d
			y: 9.00d
		}
		{
			dependencies: ["0DAB3A9E3D160338"]
			description: ["&6Was ist das?", "Runen verändern Spawner-Werte wie Pause, Anzahl, Reichweite und mehr.", "", "&6So gehts", "Halte die Rune in der Hand und klicke mit Rechtsklick auf den Spawner. Jede Rune und ihre Wirkung zeigt JEI unter den Verwendungen von Mob-Spawnern.", "", "&6Wofür ist das wichtig?", "Der Kern des Spawner-Systems."]
			id: "3920584F9FFDB2B4"
			title: "Rune anwenden"
			rewards: [{ id: "5E2F7A56A90DB1A7", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3BC47DD1308BE3D8", type: "checkmark" }]
			x: 7.50d
			y: 9.00d
		}
		{
			dependencies: ["3920584F9FFDB2B4"]
			description: ["&6Was ist das?", "Die erste Stufen-Rune: verbessert die Kernwerte etwas.", "", "&6So gehts", "Herstellung: vier Zeitgenagte Stoffe, zwei Uhren, zwei Feuerstein und eine Spawner-Rune.", "", "&6Wofür ist das wichtig?", "Es gibt eine Stufen-Rune je Welt-Stufe über der Zuflucht."]
			id: "787E2039CC986946"
			title: "Rune des Grenzgängers"
			rewards: [{ id: "6284478A16D328AC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "0D2647ED99BEB898", type: "item", item: { id: "apotheosis:frontier_spawner_upgrade_rune", count: 1 }, count: 1L }]
			x: 9.00d
			y: 9.00d
		}
		{
			dependencies: ["787E2039CC986946"]
			description: ["&6Was ist das?", "Die zweite Stufen-Rune: spürbar bessere Kernwerte.", "", "&6So gehts", "Herstellung: vier Leuchtende Kristallsplitter, ein beliebiges Spawn-Ei, zwei Quarz, Sigill der Sockelung und Spawner-Rune.", "", "&6Wofür ist das wichtig?", "Mehr Monster pro Zyklus und kürzere Pausen."]
			id: "02E76468E9EC60FC"
			title: "Rune des Wanderers"
			rewards: [{ id: "178A53ECE675EB2C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "02CE421164FF43BD", type: "item", item: { id: "apotheosis:ascent_spawner_upgrade_rune", count: 1 }, count: 1L }]
			x: 10.50d
			y: 9.00d
		}
		{
			dependencies: ["02E76468E9EC60FC"]
			description: ["&6Was ist das?", "Die Vorstufe für starke Runen.", "", "&6So gehts", "Entsteht per Aufguss-Verzauberung aus einer Spawner-Rune, mit Verzauberungswerten Eterna 70, Quanta 30 und Arcana 50. Siehe das Kapitel Verzauberung (Apothic).", "", "&6Wofür ist das wichtig?", "Voraussetzung für Rune des Bergsteigers und Donnernde Rune."]
			id: "4FEBAD3395B45A2B"
			title: "Durchtränkte Rune"
			rewards: [{ id: "6C95C02B8874B60D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "00B4E8F82D394F10", type: "item", item: { id: "apotheosis:infused_spawner_rune", count: 1 }, count: 1L }]
			x: 12.00d
			y: 9.00d
		}
		{
			dependencies: ["4FEBAD3395B45A2B"]
			description: ["&6Was ist das?", "Die dritte Stufen-Rune: stark verbessert.", "", "&6So gehts", "Herstellung: vier Arkane Sande, Wächter-Ranke, zwei Phantomhäute, Sigill der Bosheit und Durchtränkte Rune.", "", "&6Wofür ist das wichtig?", "Das Kraftwerk für Mob-Farmen."]
			id: "3B5CADB1D7CF9C65"
			title: "Rune des Bergsteigers"
			rewards: [{ id: "52FDD3160252A95A", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "1B59D311FD5DE13D", type: "item", item: { id: "apotheosis:summit_spawner_upgrade_rune", count: 1 }, count: 1L }]
			x: 13.50d
			y: 9.00d
		}
		{
			dependencies: ["3B5CADB1D7CF9C65"]
			description: ["&6Was ist das?", "Die letzte Stufen-Rune bringt den Spawner an sein Maximum.", "", "&6So gehts", "Herstellung: vier Gottgeschmiedete Perlen, ein Perfekter Endersurge-Edelstein, zwei Erfüllte Atem, Nether-Stern und Durchtränkte Rune.", "", "&6Wofür ist das wichtig?", "Die ultimative Mob-Maschine."]
			id: "71E1F78ACA022DB6"
			title: "Donnernde Rune"
			rewards: [{ id: "1ACAB70680A38F2B", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "10A5C300ECF5AA97", type: "item", item: { id: "apotheosis:pinnacle_spawner_upgrade_rune", count: 1 }, count: 1L }]
			x: 15.00d
			y: 9.00d
		}
		{
			dependencies: ["71E1F78ACA022DB6"]
			description: ["&6Was ist das?", "Eigene Runen für einzelne Werte: Reichweite, Kontrolle per Redstone, ewiges Zwielicht, Stille, Jugend, Verbrennung und mehr.", "", "&6So gehts", "Rezepte siehe JEI. Halte beim Anwenden Netherquarz in der Zweithand, dann kehrt sich die Wirkung um. Stufen-Runen lassen sich nicht umkehren.", "", "&6Wofür ist das wichtig?", "Stärkere Runen wie Echos, Einsamkeit, Trotz und Benommenheit brauchen die Durchtränkte Rune. Bei großen Farmen immer die Rune der Benommenheit nutzen: weniger Last, leichter zu steuern."]
			icon: { id: "apotheosis:silent_spawner_rune" }
			id: "1275B014EBCD20AD"
			title: "Stat-Runen"
			rewards: [{ id: "09E20BDE8B8EBA40", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "5B931ADE89B8514E", type: "checkmark" }]
			x: 16.50d
			y: 9.00d
		}
