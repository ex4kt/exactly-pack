		{
			dependencies: ["427A7EF48D722BD5"]
			description: ["&6Was ist das?", "Jede Stufe gibt 20 Prozent Schadensminderung gegen alles.", "", "&6So gehts", "Braue einen Seltsamen Trank und gib eine Shulkerschale dazu.", "", "&6Wofür ist das wichtig?", "Hilft in harten Kämpfen."]
			icon: { id: "minecraft:shulker_shell" }
			id: "44D16D0D02A719A8"
			title: "Trank der Resistenz"
			rewards: [{ id: "2FAF81C752E0E49E", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2E1FFB7948CA6FFE", type: "checkmark" }]
			x: 7.50d
			y: -6.00d
		}
		{
			dependencies: ["44D16D0D02A719A8"]
			description: ["&6Was ist das?", "Jede Stufe gibt zwei zusätzliche Herzen, die nicht nachwachsen.", "", "&6So gehts", "Braue einen Seltsamen Trank und gib einen Goldenen Apfel dazu. Die Herzen frischen sich nicht auf, deshalb ist ein Talisman besser als der Trank.", "", "&6Wofür ist das wichtig?", "Zusätzlicher Puffer für harte Kämpfe."]
			icon: { id: "minecraft:golden_apple" }
			id: "3BD92E6E5A5F283E"
