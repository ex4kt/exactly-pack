	title: "&dApotheosis"
	quests: [
		{
			dependencies: ["32D7C0032123B540"]
			description: ["&6Was ist das?", "Apotheosis macht Ausrüstung zu Beute: Gegenstände mit zufälligen Fähigkeiten (Affixe), Edelsteine zum Einsetzen, Welt-Stufen, Eindringlinge, Elite-Monster und Spawner, die du einsammeln und verbessern kannst.", "", "&6So gehts", "Der Hauptweg in der Mitte führt durch die fünf Welt-Stufen. Darunter und darüber hängen die Zweige: Ausrüstung veredeln, Tränke, Edelsteine, Gegner und Beute, Spawner. Alles ist freiwillig. Der Mod gehört wie die Apothic-Verzauberungen (eigenes Kapitel) ins Diamant-Zeitalter.", "", "&6Wofür ist das wichtig?", "Je höher deine Welt-Stufe, desto härter die Gegner und desto besser die Beute."]
			icon: { id: "apotheosis:gem_cutting_table" }
			id: "5698BF92CF245300"
			title: "Apotheosis"
			rewards: [{ id: "5A6120CCABD137D7", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "37190EF62A190E1F", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["5698BF92CF245300"]
			description: ["&6Was ist das?", "Das Handbuch zu Apotheosis, direkt im Spiel (auf Englisch).", "", "&6So gehts", "Herstellung: ein Buch und ein Goldbarren, formlos in der Werkbank.", "", "&6Wofür ist das wichtig?", "Es erklärt Affixe, Edelsteine, Welt-Stufen, Spawner, Tränke und Verzauberungen ausführlich."]
			id: "1E023313CF477816"
			title: "Chronik der Schatten"
			rewards: [{ id: "782309DF261C6F75", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3DE57AA9DD3C5106", type: "item", item: { id: "patchouli:guide_book", count: 1 }, count: 1L }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["1E023313CF477816"]
			description: ["&6Was ist das?", "Waffen, Werkzeuge und Rüstung können jetzt Affixe tragen: Zusatzwerte und Fähigkeiten. Du erkennst sie an Namen, Seltenheit und Farbe.", "", "&6So gehts", "Du findest sie in Kisten, bei Elite-Monstern und Eindringlingen, beim Fahrenden Händler und mit Glück als Beute normaler Monster. Hebe einen auf und bestätige die Quest.", "", "&6Wofür ist das wichtig?", "Der erste Fund schaltet die Welt-Stufe Zuflucht frei."]
			icon: { id: "apotheosis:sigil_of_rebirth" }
			id: "46C408A67E0A482D"
			title: "Der erste Affix-Gegenstand"
			rewards: [{ id: "4BDFA3D558552C39", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "52815E3C782E65FE", type: "checkmark" }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["46C408A67E0A482D"]
			description: ["&6Was ist das?", "Eine Welt-Stufe gilt nur für dich. Sie bestimmt, wie stark die Gegner sind und wie gut die Beute ist.", "", "&6So gehts", "Strg + T öffnet die Welt-Stufen-Auswahl. Symbol anklicken, dann „Aktivieren\". „Detailinfo\" zeigt die Drop-Chancen, „?\" ein Tutorial. Solange du noch nie eine Stufe aktiviert hast, zeigen Affix-Gegenstände ihre Werte nicht an.", "", "&6Wofür ist das wichtig?", "Neue Stufen schalten sich nicht von selbst ein. Du kannst jederzeit zwischen freigeschalteten Stufen wechseln."]
			icon: { id: "apotheosis:boss_summoner" }
			id: "3A5645CE8150CB6E"
			title: "Welt-Stufe aktivieren"
			rewards: [{ id: "50E3643BFA0E3C4D", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "347B3A8951342D7A", type: "checkmark" }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["3A5645CE8150CB6E"]
			description: ["&6Was ist das?", "Die zweite Welt-Stufe. Ab hier erscheinen Apothic-Eindringlinge.", "", "&6So gehts", "Trage in jedem Rüstungsplatz einen Affix-Gegenstand und halte eine Affix-Waffe in einer Hand. Danach schaltest du das Grenzland frei und aktivierst es mit Strg + T.", "", "&6Wofür ist das wichtig?", "Seltenere Gegenstände und die ersten Eindringlinge."]
			icon: { id: "minecraft:iron_chestplate" }
			id: "7E9CC5005197FB45"
			title: "Grenzland"
			rewards: [{ id: "44FA2FAF83F72BA7", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "7C2C2B886A6613A5", type: "checkmark" }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["7E9CC5005197FB45"]
			description: ["&6Was ist das?", "Die dritte Welt-Stufe.", "", "&6So gehts", "Trage ein komplettes Set Ungewöhnlicher Affix-Gegenstände samt Waffe und erschlage einen Apothic-Eindringling. Dann freischalten und aktivieren.", "", "&6Wofür ist das wichtig?", "Mehr seltene Gegenstände und Eindringlinge."]
			icon: { id: "minecraft:diamond_chestplate" }
			id: "6528795EAD5D074D"
			title: "Aufstieg"
			rewards: [{ id: "3EA9ED0FD820A79C", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "5E567C9C363342E2", type: "checkmark" }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["6528795EAD5D074D"]
			description: ["&6Was ist das?", "Die vierte Welt-Stufe.", "", "&6So gehts", "Trage ein komplettes Set Seltener Affix-Gegenstände und erschlage den Wither.", "", "&6Wofür ist das wichtig?", "Hier fallen erste epische Gegenstände. Monster bekommen Schadensminderung, bleib also ausgerüstet."]
			icon: { id: "minecraft:wither_skeleton_skull" }
			id: "72FA1A5F2EB9026A"
			title: "Gipfel"
			rewards: [{ id: "781BDBC4D65C171F", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "298182E60FD4D12B", type: "checkmark" }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["72FA1A5F2EB9026A"]
			description: ["&6Was ist das?", "Die letzte Welt-Stufe.", "", "&6So gehts", "Trage ein komplettes Set Epischer Affix-Gegenstände und erschlage den Enderdrachen.", "", "&6Wofür ist das wichtig?", "Die besten Affixe, Edelsteine und Eindringlinge im Spiel. Unzerbrechliche Talismane gibt es nur in dieser Stufe."]
			icon: { id: "minecraft:dragon_head" }
			id: "372521EDADBF67A6"
			title: "Zenit"
			rewards: [{ id: "4F10D256669BEAD6", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "2BD30A9AE61C0BA8", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["372521EDADBF67A6"]
			description: ["&6Was ist das?", "Mythische Gegenstände sind die seltenste Stufe: vier Zusatzwerte, zwei Effekte, eine Fähigkeit und mehrere Sockel.", "", "&6So gehts", "Finde einen mythischen Affix-Gegenstand, etwa bei einem starken Eindringling, und bestätige die Quest.", "", "&6Wofür ist das wichtig?", "Sie sind das Ziel aller Verbesserungen. Mit dem Verstärkungstisch machst du sie perfekt."]
			icon: { id: "apotheosis:godforged_pearl" }
			id: "2F4751A1F8113396"
			title: "Titanengeschmiedet"
			rewards: [{ id: "731992E4D23B41B9", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "10D863996E91AE7F", type: "checkmark" }]
			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["46C408A67E0A482D"]
			description: ["&6Was ist das?", "Affixe sind Zusatzfähigkeiten auf Ausrüstung. Zusatzwerte steigern ein Attribut, Effekte bringen neue Eigenschaften, Fähigkeiten sind die stärkste Art und haben oft Abklingzeit. Dazu kommen Sockel und eine Haltbarkeits-Verbesserung.", "", "&6So gehts", "Schau dir einen Gegenstand in der Beschreibung genau an. Zusatzwerte gibt es auf jeder Stufe, Effekte ab Ungewöhnlich, Fähigkeiten auf Episch und Mythisch. Bestätige, wenn du Affixe gelesen hast.", "", "&6Wofür ist das wichtig?", "Wer Affixe versteht, wählt die richtige Ausrüstung und die richtigen Edelsteine."]
			icon: { id: "apotheosis:gem_dust" }
			id: "1C5C6118C83B64CE"
			title: "Affixe"
			rewards: [{ id: "200F5D5887F9CBA1", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "15E47D77B7489C25", type: "checkmark" }]
			x: 3.00d
			y: -3.00d
		}
		{
			dependencies: ["1C5C6118C83B64CE"]
			description: ["&6Was ist das?", "Gewöhnlich, Ungewöhnlich, Selten, Episch, Mythisch. Je höher, desto mehr Zusatzwerte, Effekte und Sockel.", "", "&6So gehts", "Gewöhnlich: ein Zusatzwert. Ungewöhnlich: zwei Zusatzwerte, vielleicht ein Sockel. Selten: ein Effekt und bis zu zwei Sockel. Episch: dazu eine Fähigkeit. Mythisch: vier Zusatzwerte, zwei Effekte, eine Fähigkeit.", "", "&6Wofür ist das wichtig?", "Die Seltenheit entscheidet über Welt-Stufen, Umschmieden und Materialien."]
			id: "7ED0C626917C05A0"
			title: "Seltenheiten"
			rewards: [{ id: "6A0C3ED7FDD579D0", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6A24D79FEA9F422E", type: "checkmark" }]
			x: 4.50d
			y: -3.00d
		}
		{
			dependencies: ["7ED0C626917C05A0"]
			description: ["&6Was ist das?", "Zerlegt Affix-Gegenstände und Edelsteine in Seltenheitsmaterialien beziehungsweise Edelsteinstaub.", "", "&6So gehts", "Herstellung: drei Kupferbarren, Eisenspitzhacke, Eisenaxt, Schmiedetisch, Lavaeimer und zwei Edelsteinstaub. Den ersten Staub gewinnst du im Zweig Edelsteine mit dem Amboss-Trick.", "", "&6Wofür ist das wichtig?", "Ohne Zerlegetisch kommst du nicht an Material für Umschmieden und Veredeln."]
			id: "7C1E99DFBDAF1B1F"
			title: "Zerlegetisch"
			rewards: [{ id: "7EE8208F70DD3061", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "356588B1C51A6799", type: "item", item: { id: "apotheosis:salvaging_table", count: 1 }, count: 1L }]
			x: 6.00d
			y: -3.00d
		}
		{
			dependencies: ["7C1E99DFBDAF1B1F"]
			description: ["&6Was ist das?", "Jede Seltenheit hat ihr Material: Gewöhnlich Geheimnisvoller Metallschrott, Ungewöhnlich Zeitgenagter Stoff, Selten Leuchtender Kristallsplitter, Episch Arkane Sande, Mythisch Gottgeschmiedete Perle.", "", "&6So gehts", "Zerlege Gegenstände der jeweiligen Seltenheit am Zerlegetisch.", "", "&6Wofür ist das wichtig?", "Du brauchst sie zum Umschmieden, für Edelstein-Veredelung und für viele Runen."]
			id: "62309D16ABE28BAA"
			title: "Seltenheitsmaterial"
			rewards: [{ id: "153F61F8AC199C05", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2C41AA27DB3EA020", type: "item", item: { id: "apotheosis:mysterious_scrap_metal", count: 1 }, count: 1L }]
			x: 7.50d
			y: -3.00d
		}
		{
			dependencies: ["62309D16ABE28BAA"]
			description: ["&6Was ist das?", "Würfelt die Affixe eines Gegenstands neu, bis zur Seltenheit Selten.", "", "&6So gehts", "Herstellung: Eisenbarren, zwei Edelsteinstaub, Verzauberungstisch und drei glatte Steine.", "", "&6Wofür ist das wichtig?", "Wenn dir ein Affix nicht gefällt oder ein Gegenstand noch keinen hat."]
			id: "55C56213C54DB7FE"
			title: "Einfacher Umschmiedetisch"
			rewards: [{ id: "777C2C7298B8F56E", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6E63D56A51242402", type: "item", item: { id: "apotheosis:simple_reforging_table", count: 1 }, count: 1L }]
			x: 9.00d
			y: -3.00d
		}
		{
			dependencies: ["55C56213C54DB7FE"]
			description: ["&6Was ist das?", "Treibstoff des Umschmiedetischs.", "", "&6So gehts", "Herstellung: sechs Edelsteinverschmolzene Schieferplatten und drei Edelsteinstaub.", "", "&6Wofür ist das wichtig?", "Jedes Umschmieden ab Ungewöhnlich verbraucht Sigille."]
			id: "4F5595EE700E48BD"
			title: "Sigill der Wiedergeburt"
			rewards: [{ id: "31BA46DD6FD0F195", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2BC0149576409DF7", type: "item", item: { id: "apotheosis:sigil_of_rebirth", count: 1 }, count: 1L }]
			x: 10.50d
			y: -3.00d
		}
		{
			dependencies: ["4F5595EE700E48BD"]
			description: ["&6Was ist das?", "Lege den Gegenstand in die Mitte, oben links das Material der gewünschten Seltenheit, unten rechts die Sigille.", "", "&6So gehts", "Du bekommst drei Angebote, keines ist besser als die anderen. Das zweite und dritte kosten das Doppelte und Dreifache an Stufen und Material. Kosten pro Seltenheit: Gewöhnlich 2 Stufen und 1 Material; Ungewöhnlich 5 Stufen, 2 Material, 1 Sigill; Selten 15 Stufen, 2 Material, 2 Sigille.", "", "&6Wofür ist das wichtig?", "So holst du aus Fundstücken genau die Affixe, die du willst."]
			icon: { id: "apotheosis:reforging_table" }
			id: "5A798828142B020E"
			title: "Umschmieden"
			rewards: [{ id: "452F94ADE373B6D9", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "081F9BF64A7E5C5C", type: "checkmark" }]
			x: 12.00d
			y: -3.00d
		}
		{
			dependencies: ["5A798828142B020E"]
			description: ["&6Was ist das?", "Die große Version: erlaubt auch Episch und Mythisch.", "", "&6So gehts", "Herstellung: Netheritbarren, zwei Arkane Sande, Einfacher Umschmiedetisch und drei Netherziegel. Episch kostet 30 Stufen, 2 Material und 4 Sigille, Mythisch 50 Stufen, 3 Material und 5 Sigille.", "", "&6Wofür ist das wichtig?", "Für die besten Gegenstände."]
			id: "0977AE63F46DB6CB"
			title: "Umschmiedetisch"
			rewards: [{ id: "669C4EBA90FED353", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "589E6ADB2C52C5DF", type: "item", item: { id: "apotheosis:reforging_table", count: 1 }, count: 1L }]
			x: 13.50d
			y: -3.00d
		}
		{
			dependencies: ["0977AE63F46DB6CB"]
			description: ["&6Was ist das?", "Treibstoff des Verstärkungstischs.", "", "&6So gehts", "Herstellung: vier Edelsteinstaub, vier Edelsteinverschmolzene Schieferplatten und eine Gottgeschmiedete Perle.", "", "&6Wofür ist das wichtig?", "Verbessert einzelne Affixe."]
			id: "7BAD1045390BB4A6"
			title: "Sigill der Verstärkung"
			rewards: [{ id: "54BB0A3ED29372A4", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "77C67C1564F0B8DD", type: "item", item: { id: "apotheosis:sigil_of_enhancement", count: 1 }, count: 1L }]
			x: 15.00d
			y: -3.00d
		}
		{
			dependencies: ["7BAD1045390BB4A6"]
			description: ["&6Was ist das?", "Die Endspiel-Werkbank für einzelne Affixe.", "", "&6So gehts", "Herstellung: Nether-Stern, zwei Gottgeschmiedete Perlen, Verzauberungstisch und drei polierte Schwarzsteine.", "", "&6Wofür ist das wichtig?", "Lohnt sich vor allem für Mythische, notfalls auch Epische Gegenstände."]
			id: "70DF6DA7BB3D1A7E"
			title: "Verstärkungstisch"
			rewards: [{ id: "2137F1DC32E655E2", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "0D5E094DB8EF146D", type: "item", item: { id: "apotheosis:augmenting_table", count: 1 }, count: 1L }]
			x: 16.50d
			y: -3.00d
		}
		{
			dependencies: ["70DF6DA7BB3D1A7E"]
			description: ["&6Was ist das?", "Zwei Arbeitsschritte: Aufwerten und Neu würfeln.", "", "&6So gehts", "Aufwerten kostet zwei Sigille der Verstärkung und 225 Stufen und erhöht die Stärke eines Affixes um 25 Prozent. Neu würfeln kostet ein Sigill und 175 Stufen und tauscht den Affix gegen einen anderen derselben Art. Affixe ohne Stufen lassen sich nicht aufwerten.", "", "&6Wofür ist das wichtig?", "So wird aus einem guten Fund der perfekte Gegenstand."]
			id: "620E00B8BFFA62FC"
			title: "Affix aufwerten"
			rewards: [{ id: "345F34AA1667D91D", type: "xp_levels", xp_levels: 4 }]
			tasks: [{ id: "4604FA6539E34C40", type: "checkmark" }]
			x: 18.00d
			y: -3.00d
		}
		{
			dependencies: ["620E00B8BFFA62FC"]
			description: ["&6Was ist das?", "Überlädt einen Affix und setzt einen anderen zurück.", "", "&6So gehts", "Das Rezept zeigt JEI. Das Sigill wird auch für die Rune des Bergsteigers gebraucht.", "", "&6Wofür ist das wichtig?", "Stärkere Affixe gegen einen Preis."]
			id: "2D4EDEDE0C31E851"
			title: "Sigill der Bosheit"
			rewards: [{ id: "24705A85FAF6C532", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "5F55E26D11C60A8E", type: "item", item: { id: "apotheosis:sigil_of_malice", count: 1 }, count: 1L }]
			x: 19.50d
			y: -3.00d
		}
		{
			dependencies: ["1C5C6118C83B64CE"]
			description: ["&6Was ist das?", "Ein Talisman verteilt einen Trank über viel längere Zeit als die drei Tränke, aus denen er entsteht.", "", "&6So gehts", "Herstellung: drei gleiche Tränke in der mittleren Reihe, darum sechs Lohenpulver.", "", "&6Wofür ist das wichtig?", "Dauerhafte Effekte ohne Trank-Flaschen im Kampf."]
			id: "2E3B78F5E1BDBC16"
			title: "Talisman"
			rewards: [{ id: "3BAE8281788E64CC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "12BBF3B9A01B4FD0", type: "item", item: { id: "apotheosis:potion_charm", count: 1 }, count: 1L }]
			x: 3.00d
			y: -6.00d
		}
		{
			dependencies: ["2E3B78F5E1BDBC16"]
			description: ["&6Was ist das?", "Ein Talisman wirkt nur, wenn er eingeschaltet ist.", "", "&6So gehts", "Rechtsklick schaltet ihn ein, er leuchtet dann. Solange er im Inventar liegt, wirkt er in kurzen Stößen und verbraucht Haltbarkeit. Ist sie leer, geht er kaputt.", "", "&6Wofür ist das wichtig?", "Ohne Einschalten tut er nichts."]
			id: "1593168ABE53C48E"
			title: "Talisman benutzen"
			rewards: [{ id: "116CB91F0BF022AD", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "2C29807BAC719A84", type: "checkmark" }]
			x: 4.50d
			y: -6.00d
		}
		{
			dependencies: ["1593168ABE53C48E"]
			description: ["&6Was ist das?", "Jede Stufe gibt 20 Prozent mehr Abbaugeschwindigkeit.", "", "&6So gehts", "Braue einen Seltsamen Trank und gib Pilzsuppe dazu. Mit den üblichen Zutaten verlängerst, verstärkst oder machst du ihn zum Wurftrank.", "", "&6Wofür ist das wichtig?", "Der Trank hat in Vanilla kein Rezept."]
			icon: { id: "minecraft:mushroom_stew" }
			id: "427A7EF48D722BD5"
			title: "Trank der Eile"
			rewards: [{ id: "0D645BB1525638BF", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "7CDEFC3F7AD4D8B0", type: "checkmark" }]
			x: 6.00d
