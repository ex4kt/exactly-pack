		}
		{
			dependencies: ["1C588DAD6DB23882"]
			description: ["&6Was ist das?", "In der Verfluchten Pyramide liegt der Ancient Remnant. Er ist ein harter Boss.", "", "&6So gehts", "Bringe gute Rüstung, Essen und Heilung mit. Er ruft Sandstürme und Käfer.", "", "&6Wofür ist das wichtig?", "Er lässt Antikes Metall fallen, Material für starke Cataclysm-Waffen."]
			id: "171ACBF09717672B"
			title: "Cataclysm: Verfluchte Pyramide"
