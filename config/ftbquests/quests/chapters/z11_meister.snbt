		}
		{
			dependencies: ["1C35BA97EED2E9ED"]
			description: ["&6Was ist das?", "Der Kampf: Besiege den Wither.", "", "&6So gehts", "Unter der Hälfte seiner Leben verliert er den Schutz gegen Pfeile und fliegt weg. Greife ihn aus der Nähe an und lass ihn nicht entkommen.", "Nutze Milch und Goldene Äpfel. Schlage zu und weiche zurück, sobald du den Effekt bekommst.", "", "&6Wofür ist das wichtig?", "Er lässt einen Netherstern fallen. Daraus baust du das Leuchtfeuer."]
			icon: { id: "minecraft:nether_star" }
			id: "6EA9343D7DA261CB"
