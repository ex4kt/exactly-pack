		}
		{
			dependencies: ["0117E82FFC94BBC7"]
			description: ["&6Was ist das?", "Maledictus, ein verfluchter Krieger aus Cataclysm.", "", "&6Wo findest du ihn?", "Im Frostgefängnis in verschneiten Ebenen. Den Weg zeigt das Auge des Fluchs (Enderauge, Knochen, Goldbarren, Phantomhaut, verrottetes Fleisch).", "", "&6Was brauchst du?", "Netherit-Ausrüstung, Schild, Heilung.", "", "&6So gehts", "Er wird im Gefängnis gerufen. Er ist sehr schnell: ausweichen und nach seinen Angriffen zuschlagen.", "", "&6Beute", "Cursiumbarren (für Cursium-Rüstung)."]
			id: "632520937276C1DE"
			title: "Cataclysm: Maledictus"
			rewards: [{ id: "7C5BDA6C516B0C4F", type: "xp_levels", xp_levels: 14 }]
			tasks: [{ id: "1E5D4B95C06CBB31", type: "kill", entity: "cataclysm:maledictus", value: 1L, icon: { id: "cataclysm:cursium_ingot" } }]
			x: 22.50d
