		}
		{
			dependencies: ["3DEEC0BEF56E570F"]
			description: ["&6Was ist das?", "Der Netherite Monstrosity lauert in den Lavahöhlen. Er ist extrem stark.", "", "&6So gehts", "In der Seelenschmiede im Nether. Weiche den Lavakugeln aus.", "", "&6Wofür ist das wichtig?", "Er lässt die Höllen-Schmiede fallen."]
