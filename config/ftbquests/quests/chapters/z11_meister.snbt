		{
			dependencies: ["6E01392665CDEBA9"]
			description: ["&6Was ist das?", "Der Wither ist ein Boss mit 300 Leben. Er fliegt, schießt Totenkopf-Geschosse, die den Wither-Effekt (Schaden über Zeit) geben, und zerstört Blöcke um sich.", "", "&6So gehts", "Diese Anleitung führt dich in acht Schritten: Ausrüstung, Heilung, Netherfestung, Schädel, Seelensand, Kampfplatz, Aufbau, Kampf.", "Mach die Schritte von links nach rechts. Jeder Schritt gibt Erfahrung.", "", "&6Wofür ist das wichtig?", "Der Wither liefert den Netherstern, ohne den es kein Leuchtfeuer gibt. Ohne Vorbereitung ist der Kampf sehr gefährlich."]
			icon: { id: "minecraft:wither_skeleton_skull" }
			id: "3FACB52F0FE5B297"
			title: "Wither: Überblick"
			rewards: [{ id: "5382FAF4314874F5", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6E5AFAF34A3E9BF0", type: "checkmark" }]
			x: 12.00d
			y: -4.50d
		}
		{
			dependencies: ["3FACB52F0FE5B297"]
			description: ["&6Was ist das?", "Du brauchst die beste Ausrüstung, die du hast.", "", "&6So gehts", "Trage Diamant- oder Netheritrüstung mit Schutz IV. Nimm ein Schwert mit Schärfe und einen Bogen mit Stärke mit.", "Verzaubere die Rüstung vorher am Verzauberungstisch oder kaufe Bücher bei Dorfbewohnern.", "", "&6Wofür ist das wichtig?", "Der Wither macht auch durch Rüstung hindurch Schaden über Zeit. Mehr Schutz heißt mehr Zeit zum Zurücktreten und Heilen."]
			icon: { id: "minecraft:netherite_chestplate" }
			id: "4DDA58D817A4984D"
			title: "Wither: Rüstung und Waffen"
			rewards: [{ id: "29E78B3FD51AF1A2", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "08AAC4330566ED73", type: "checkmark" }]
			x: 13.50d
			y: -4.50d
		}
		{
			dependencies: ["4DDA58D817A4984D"]
			description: ["&6Was ist das?", "Gegen den Wither-Effekt und Treffer brauchst du Heilung.", "", "&6So gehts", "Stelle drei Goldene Äpfel her (acht Goldbarren um einen Apfel). Nimm zusätzlich zwei Milcheimer mit.", "Milch (Eimer trinken) entfernt alle Effekte, auch den Wither-Effekt.", "", "&6Wofür ist das wichtig?", "Im Kampf bleibt keine Zeit zum Kochen. Goldene Äpfel geben dir sofort Regeneration und Absorptionsherzen."]
			icon: { id: "minecraft:golden_apple" }
			id: "0E820BF0F76E3142"
			title: "Wither: Heilung"
			rewards: [{ id: "5B9A795712C384EA", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2CB62E5141802B07", type: "item", item: { id: "minecraft:golden_apple", count: 1 }, count: 3L }]
			x: 15.00d
			y: -4.50d
		}
		{
			dependencies: ["0E820BF0F76E3142"]
			description: ["&6Was ist das?", "Witherskelette leben nur in Netherfestungen.", "", "&6So gehts", "Gehe ins Nether und suche eine Netherfestung (dunkle Backstein-Bauten). Mit dem Naturkompass aus dem Pack kannst du nach ihr suchen lassen.", "Baue Brücken über Lavaseen und nimm genug Blöcke und Feuerresistenz-Tränke mit.", "", "&6Wofür ist das wichtig?", "Nur dort fallen die Witherskelett-Schädel. Eine Festung ist voll von Blazes und Skeletten: Sei vorsichtig."]
			icon: { id: "minecraft:nether_bricks" }
			id: "2CC166EDC1678FF2"
			title: "Wither: Netherfestung finden"
			rewards: [{ id: "0C8B99C7EE289B99", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "25A8B886B39D53C3", type: "checkmark" }]
			x: 16.50d
			y: -4.50d
		}
		{
			dependencies: ["2CC166EDC1678FF2"]
			description: ["&6Was ist das?", "Du brauchst drei Witherskelett-Schädel.", "", "&6So gehts", "Besiege Witherskelette in der Festung. Der Schädel ist ein seltener Drop (etwa 2,5 Prozent pro Kill), mit Plünderung etwas häufiger.", "Witherskelette sind groß und geben dir selbst den Wither-Effekt. Trinke danach Milch.", "", "&6Wofür ist das wichtig?", "Die Schädel sind die Köpfe des Withers. Ohne drei Stück kannst du ihn nicht rufen."]
			icon: { id: "minecraft:wither_skeleton_skull" }
			id: "6660171B05E970DF"
			title: "Wither: Schädel sammeln"
			rewards: [{ id: "6E903ECD9B698DB1", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "3446DB56C2DFD5E2", type: "item", item: { id: "minecraft:wither_skeleton_skull", count: 1 }, count: 3L }]
			x: 18.00d
			y: -4.50d
		}
		{
			dependencies: ["6660171B05E970DF"]
			description: ["&6Was ist das?", "Der Körper des Withers besteht aus vier Blöcken.", "", "&6So gehts", "Sammle vier Seelensand (oder Seelenerde) in den Seelensandtälern im Nether.", "", "&6Wofür ist das wichtig?", "Vier Blöcke in T-Form plus drei Schädel rufen den Wither."]
			icon: { id: "minecraft:soul_sand" }
			id: "2BBDFD98C3E0C9B1"
			title: "Wither: Seelensand"
			rewards: [{ id: "7AA757C7465DF6C5", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "3B5199995D6F4830", type: "item", item: { id: "minecraft:soul_sand", count: 1 }, count: 4L }]
			x: 19.50d
			y: -4.50d
		}
		{
			dependencies: ["2BBDFD98C3E0C9B1"]
			description: ["&6Was ist das?", "Der Wither zerstört fast alle Blöcke. Wähle den Platz mit Bedacht.", "", "&6So gehts", "Grabe einen Gang tief unter der Erde in den Fels, mindestens vier Blöcke hoch und drei breit, mit Decke direkt über dir. So kann der Wither nicht über dich fliegen.", "Beleuchte den Raum. Lege dir Fluchtwege und eine Ecke für Heilung an. Baue nicht in der Nähe deiner Basis oder deiner Kisten.", "", "&6Wofür ist das wichtig?", "Der Wither löst Explosionen aus: Dein Haus und deine Lager sind in Gefahr. Ein enger Gang schützt dich vor seinem Flug."]
			icon: { id: "minecraft:deepslate_bricks" }
			id: "37E9FE2F7A39F750"
			title: "Wither: Kampfplatz"
			rewards: [{ id: "01ADAD8BBB353648", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "3B36B7CC8ED9C67D", type: "checkmark" }]
			x: 21.00d
			y: -4.50d
		}
		{
			dependencies: ["37E9FE2F7A39F750"]
			description: ["&6Was ist das?", "Hier rufst du ihn.", "", "&6So gehts", "Stelle drei Seelensand in einer Reihe, dann einen Seelensand in die Mitte darunter (T-Form). Setze zuletzt drei Schädel auf die obere Reihe.", "Der Wither blinkt blau und ist kurz unverwundbar, dann explodiert er. Gehe vorher mehrere Blöcke zurück.", "", "&6Wofür ist das wichtig?", "Wer zu nah steht, nimmt Explosionsschaden. Setze die Schädel aus sicherer Entfernung."]
			icon: { id: "minecraft:soul_sand" }
			id: "1C35BA97EED2E9ED"
			title: "Wither: Aufbau"
			rewards: [{ id: "5DC969B26362A92C", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "79FC1DDC88579A9C", type: "checkmark" }]
			x: 22.50d
