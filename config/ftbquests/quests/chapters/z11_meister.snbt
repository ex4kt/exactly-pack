		{
			dependencies: ["2CC166EDC1678FF2"]
			description: ["&6Was ist das?", "Du brauchst drei Witherskelett-Schädel.", "", "&6So gehts", "Besiege Witherskelette in der Festung. Der Schädel ist ein seltener Drop (etwa 2,5 Prozent pro Kill), mit Plünderung etwas häufiger.", "Witherskelette sind groß und geben dir selbst den Wither-Effekt. Trinke danach Milch.", "", "&6Wofür ist das wichtig?", "Die Schädel sind die Köpfe des Withers. Ohne drei Stück kannst du ihn nicht rufen."]
			icon: { id: "minecraft:wither_skeleton_skull" }
			id: "6660171B05E970DF"
