	title: "&4VIII. Meister-Zeitalter"
	quests: [
		{
			dependencies: ["07BE262D9D78209B", "5157AEBF5A6074A6"]
			description: ["&6Was ist das?", "Advanced Netherite verbessert Netherit mit Eisen, Gold, Smaragd oder Diamant. Jede Stufe hat eigene Vorteile.", "", "&6So gehts", "Im Schmiedetisch mit den passenden Barren.", "", "&6Wofür ist das wichtig?", "Starke Boni, z.B. mehr Erze oder Schutz vor Piglins."]
			id: "103D3053E09ACE15"
			hide_dependency_lines: true
			hide_dependent_lines: true
			title: "Advanced Netherite"
			rewards: [{ id: "1632C5334FF82323", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "7341702896665770", type: "item", item: { id: "advancednetherite:netherite_diamond_pickaxe", count: 1 }, count: 1L }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["103D3053E09ACE15"]
			description: ["&6Was ist das?", "Der Wither entsteht aus Seelensand und drei Totenköpfen.", "", "&6So gehts", "T-Form aus vier Seelensand, oben drei Wither-Skelett-Schädel.", "Kämpfe unter der Erde, damit er nicht davonfliegt. Bring Milch gegen den Wither-Effekt.", "", "&6Wofür ist das wichtig?", "Er lässt den Netherstern fallen, daraus baust du ein Leuchtfeuer.", "", "&6Gut zu wissen", "Er entsteht aus vier Seelensand und drei Witherskelett-Schädeln. Kämpfe in einem Raum mit Decke und sorge für genug Heilung, er hat 300 Leben."]
			id: "6E01392665CDEBA9"
			title: "Der Wither"
			rewards: [{ id: "4DC4D1E1F6E946A8", type: "item", item: { id: "minecraft:enchanted_golden_apple", count: 1 } }]
			tasks: [{ id: "123623BFCDAD3606", type: "kill", entity: "minecraft:wither", value: 1L, icon: { id: "minecraft:wither_skeleton_skull" } }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["6E01392665CDEBA9"]
			description: ["&6Was ist das?", "Ignis ist ein Feuer-Boss aus dem Nether und lässt Ignitium fallen. Den Netherstern bekommst du vom Wither.", "", "&6So gehts", "Suche Ignis im Nether. Nimm Feuerresistenz-Tränke, beste Rüstung, Heilung und Fernkampf mit.", "Weiche seinen Feuerangriffen aus und schlage zu, sobald er nachlädt.", "Den Wither rufst du aus Seelensand und drei Wither-Schädeln, der Netherstern fällt beim Tod.", "", "&6Wofür ist das wichtig?", "Der Netherstern gibt dir das Leuchtfeuer, Ignis das Ignitium.", "", "&6Gut zu wissen", "Ignis lässt Ignitium-Barren und eine Musikplatte fallen."]
			id: "03D0118EABF00FE3"
			title: "Netherstern"
			rewards: [{ id: "2CBDB488CEAE20E0", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "3B3697284B64572C", type: "item", item: { id: "minecraft:nether_star", count: 1 }, count: 1L }]
			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["03D0118EABF00FE3"]
			description: ["&6Was ist das?", "Mit dem Netherstern baust du ein Leuchtfeuer. Es gibt starke Effekte in der Nähe.", "", "&6So gehts", "Auf eine Pyramide aus Metallblöcken setzen.", "", "&6Wofür ist das wichtig?", "Eile II macht Abbauen sehr schnell.", "", "&6Gut zu wissen", "Ein Leuchtfeuer steht auf einer Pyramide aus Eisen-, Gold-, Smaragd-, Diamant- oder Netheritblöcken. Die kleinste Stufe braucht 9 Blöcke."]
			id: "006F97AFB62AF7CC"
			title: "Leuchtfeuer"
			rewards: [{ id: "29775321EC52269B", type: "item", item: { id: "minecraft:iron_block", count: 4 } }]
			tasks: [{ id: "6A24EBCEC4960C95", type: "item", item: { id: "minecraft:beacon", count: 1 }, count: 1L }]
			x: 13.50d
			y: 0.00d
		}
		{
			dependencies: ["006F97AFB62AF7CC"]
			description: ["&6Was ist das?", "Ignis, der Flammen-Ritter aus Cataclysm.", "", "&6Wo findest du ihn?", "In der Brennenden Arena in den Nether-Ödlanden. Den Weg zeigt das Auge der Flamme (Enderauge, Lohenstaub, Netheritplatte, Seelensand).", "", "&6Was brauchst du?", "Brennende Asche: lassen Entflammte Wiedergänger fallen. Dazu Feuerresistenz, Netherit-Ausrüstung, Heilung.", "", "&6So gehts", "Lege die Brennende Asche auf den Altar des Feuers in der Arena, dann erwacht Ignis. Erst seinen Schild brechen, dann die Rüstung.", "", "&6Beute", "Ignitiumbarren. Danach erscheinen in Netherfestungen Entflammte Berserker."]
			id: "780152119A23FCE9"
			title: "Cataclysm: Ignis"
			rewards: [{ id: "5A8204465CC5DEF1", type: "xp_levels", xp_levels: 12 }]
			tasks: [{ id: "67FAF71329234E9F", type: "kill", entity: "cataclysm:ignis", value: 1L, icon: { id: "minecraft:blaze_powder" } }]
			x: 15.00d
			y: 0.00d
		}
		{
			dependencies: ["780152119A23FCE9"]
			description: ["&6Was ist das?", "Das Netherit-Ungeheuer ist ein riesiger Boss. Von ihm kommt die Höllen-Schmiede.", "", "&6So gehts", "Nimm Feuerresistenz, beste Rüstung, viele Heiltränke mit. Er schlägt mit riesigem Hammer.", "Weiche seitlich aus und greife an, nachdem er zugeschlagen hat.", "", "&6Wofür ist das wichtig?", "Seine Beute macht feuerfeste Ausrüstung und starke Waffen möglich.", "", "&6Gut zu wissen", "Beute: Höllen-Schmiede (Hammer), Monströses Horn, Lava-Energiezelle, Musikplatte. Ignitium bekommst du aber von Ignis."]
			id: "4BCD5B014E5A3A68"
			title: "Ignitium"
			rewards: [{ id: "61DD01683588F3A1", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "39145ADCC0FCAF28", type: "item", item: { id: "cataclysm:ignitium_ingot", count: 1 }, count: 1L }]
			x: 16.50d
			y: 0.00d
		}
		{
			dependencies: ["4BCD5B014E5A3A68"]
			description: ["&6Was ist das?", "Der Incinerator ist das Schwert des Ignis.", "", "&6So gehts", "Werkbank: Lohenruten, Ignitium-Barren und Netherit-Schwert (Muster in JEI, Taste R).", "Ignitium kommt von Ignis.", "", "&6Wofür ist das wichtig?", "Feuer-Waffe."]
			id: "3DEEC0BEF56E570F"
			title: "Der Incinerator"
