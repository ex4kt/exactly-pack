		{
			dependencies: ["3F8056687CC98678"]
			description: ["&6Was ist das?", "Der Harbinger, ein Kampfroboter aus Cataclysm.", "", "&6Wo findest du ihn?", "In der Alten Fabrik tief unter der Erde (etwa Höhe -30). Den Weg zeigt das Auge der Mechanik (Enderauge, Eisenbarren, Redstoneblock).", "", "&6Was brauchst du?", "Netherit-Ausrüstung, Schild, viel Heilung, Blöcke für Deckung.", "", "&6So gehts", "Er schläft in seiner Halle und muss geweckt werden. Er schießt Laser und Raketen: bleib in Bewegung und nutze Deckung.", "", "&6Beute", "Witheritblock (für Witherit-Ausrüstung)."]
			id: "0117E82FFC94BBC7"
			title: "Cataclysm: Harbinger"
			rewards: [{ id: "21CB7DA05EE93751", type: "xp_levels", xp_levels: 14 }]
