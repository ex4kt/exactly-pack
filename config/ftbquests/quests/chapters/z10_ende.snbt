		{
			dependencies: ["45A55CC567172AB3"]
			description: ["&6Was ist das?", "Drachenatem ist eine lila Wolke, die der Drache hinterlässt.", "", "&6So gehts", "Warte, bis der Drache Atem ausspuckt.", "Halte eine Glasflasche in die Wolke und sammle den Atem.", "", "&6Wofür ist das wichtig?", "Daraus entstehen Verweiltränke.", "", "&6Gut zu wissen", "Bleibe nicht in der Wolke, sie verletzt dich."]
			id: "244709AF9446ADAB"
			title: "Drachenatem"
			rewards: [{ id: "171DFB6F70293EDA", type: "xp_levels", xp_levels: 4 }]
