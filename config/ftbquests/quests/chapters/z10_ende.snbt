		{
			dependencies: ["61920C28D0F155A0"]
			description: ["&6Was ist das?", "Das End-Zeitalter hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Der Weg ins Ende, End-Bau, Äußere Inseln, Fliegen, End-Natur, End-Küche.", "", "&6So gehts", "Wähle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofür ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins nächste. Nebenzweige kannst du jederzeit später machen."]
			icon: { id: "minecraft:end_stone" }
			id: "2600278FFBA40B51"
			title: "Beginn: End-Zeitalter"
			rewards: [{ id: "08AE23588778BA70", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "0672309CE24966C2", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 1.50d
			y: 1.38d
		}
		{
			dependencies: ["7DB4E4B2AC7C8E3C"]
			description: ["&6Was ist das?", "Hier beginnt das Meister-Zeitalter. Es schaltet frei:", "Netherit-Ausrüstung, Advanced Netherite, Netherit-Hämmer und die Netherit- und Runic-Waffen.", "", "&6So gehts", "Schließe den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort für alle Spieler, auch für die, die gerade nicht online sind.", "", "&6Wofür ist das wichtig?", "Im nächsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus früheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "minecraft:netherite_ingot" }
			hide_dependency_lines: true
			id: "4EA7B6B983C1C0EE"
			title: "Zeitalter: Meister-Zeitalter"
