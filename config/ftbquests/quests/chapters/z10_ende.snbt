		{
			dependencies: ["640BA76DC1967B64"]
			description: ["&6Was ist das?", "Die Blüte der Chorus-Pflanze.", "", "&6So gehts", "Mit Behutsamkeit oder von der Spitze abbauen. Auf Endstein pflanzen.", "", "&6Wofür ist das wichtig?", "Eine eigene Chorus-Farm."]
			icon: { id: "minecraft:chorus_flower" }
