		{
			dependencies: ["244709AF9446ADAB"]
			description: ["&6Was ist das?", "YUNGs Better End Island verbessert die Hauptinsel.", "", "&6So gehts", "Reise ins Ende. Die Insel ist neu gestaltet.", "", "&6Wofür ist das wichtig?", "Spannenderer Endkampf."]
			id: "70658F68A7FDD141"
