			x: 12.00d
			y: 0.00d
		}
		{
			dependencies: ["5E60A7D94A2326A3"]
			description: ["&6Was ist das?", "Mit der Elytra gleitest du über die Welt. Du findest sie im Ende.", "", "&6So gehts", "In Endschiffen in Endstädten finden. Mit Feuerwerk beschleunigen.", "", "&6Wofür ist das wichtig?", "Das beste Reisemittel im Spiel.", "", "&6Gut zu wissen", "Mit Feuerwerksraketen beschleunigst du im Flug. Die Elytra ersetzt die Brustplatte, nimm also beim Fliegen deinen Brustschutz ab."]
			id: "5BDDA6FEC33CD7FB"
			title: "Elytra"
			rewards: [{ id: "3BE9DEE41EF1B973", type: "item", item: { id: "minecraft:firework_rocket", count: 16 } }]
			tasks: [{ id: "6E6993634A3CF6DA", type: "item", item: { id: "minecraft:elytra", count: 1 }, count: 1L }]
			x: 13.50d
			y: 0.00d
		}
		{
			dependencies: ["5BDDA6FEC33CD7FB"]
			description: ["&6Was ist das?", "Better End Cities macht die Endstädte größer, mit mehr Beute.", "", "&6So gehts", "Fliege zu den äußeren Inseln und erkunde die Städte.", "Öffne die Truhen und besiege die Shulker.", "", "&6Wofür ist das wichtig?", "Mehr Beute und mehr Gegner."]
			id: "7DB4E4B2AC7C8E3C"
			title: "Bessere Endstädte"
			rewards: [{ id: "6F8EB8225A37402E", type: "xp_levels", xp_levels: 3 }]
