	title: "&5VII. End-Zeitalter"
	quests: [
		{
			dependencies: ["2600278FFBA40B51"]
			description: ["&6Was ist das?", "Stelle Enderperlen und Blazepulver zu Enderaugen zusammen. Damit findest du die Festung.", "", "&6So gehts", "Enderperle und Blazepulver ergeben ein Enderauge.", "Wirf eines in die Luft, es fliegt in Richtung Festung. Folge ihm, bis es nach unten zeigt.", "", "&6Wofür ist das wichtig?", "Ohne zwölf Enderaugen kein Ende. Enderperlen bekommst du von Endermen oder Piglins."]
			id: "5E7EC2AF62FB134D"
			title: "Augen des Enders"
			rewards: [{ id: "1F28EAB434A05769", type: "item", item: { id: "minecraft:ender_pearl", count: 4 } }]
			tasks: [{ id: "2706F89C06B7CACF", type: "item", item: { id: "minecraft:ender_eye", count: 1 }, count: 12L }]
			x: 3.00d
			y: 1.38d
		}
		{
			dependencies: ["5E7EC2AF62FB134D"]
			description: ["&6Was ist das?", "Aktiviere das Portal in der Festung mit zwölf Enderaugen.", "", "&6So gehts", "In der Festung das Portal mit den Augen füllen und hineinspringen.", "Nimm Blöcke, Bogen, Wasser und Kürbis mit.", "", "&6Wofür ist das wichtig?", "Nach dem Drachen öffnen sich die äußeren Inseln mit Endstädten und Elytren.", "", "&6Gut zu wissen", "Für das Portal in der Festung müssen alle zwölf Rahmen ein Enderauge tragen. Nimm viele Blöcke zum Brücken und einen Eimer Wasser gegen Endermen mit."]
			id: "028ADF99FBF6807C"
			title: "Das Ende"
			rewards: [{ id: "52CF935ACF9E29CC", type: "item", item: { id: "minecraft:ender_pearl", count: 4 } }]
			tasks: [{ id: "3CF0889F596216CE", type: "dimension", dimension: "minecraft:the_end", icon: { id: "minecraft:end_stone" } }]
			x: 4.50d
			y: 1.38d
		}
		{
			dependencies: ["028ADF99FBF6807C"]
			description: ["&6Was ist das?", "Endstein ist der Boden dieser Dimension. Er brennt nicht und hat viele Verwendungen.", "", "&6So gehts", "Abbauen.", "", "&6Wofür ist das wichtig?", "Endsteinziegel, Endstäbe und Ende-Herd."]
			id: "15E61654C80FD4A8"
			title: "Endstein"
			rewards: [{ id: "0C0571FF622F3E8F", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "70F682F887A87123", type: "item", item: { id: "minecraft:end_stone", count: 1 }, count: 16L }]
			x: 7.50d
			y: 2.00d
		}
		{
			dependencies: ["15E61654C80FD4A8"]
			description: ["&6Was ist das?", "Zerstöre die Kristalle auf den Säulen und besiege den Drachen.", "", "&6So gehts", "Zerstöre zuerst die Kristalle auf den Säulen, manche sind in Käfigen.", "Greife an, wenn er auf dem Portal landet.", "", "&6Wofür ist das wichtig?", "Nach dem Sieg erscheint ein Portal zu den äußeren Inseln.", "", "&6Gut zu wissen", "Zerstöre zuerst die Endkristalle auf den Säulen, sonst heilt sich der Drache. Ein Bogen und Wasser für die Kristalle helfen sehr."]
			id: "094E3A3AB01FE3FF"
			title: "Der Enderdrache"
			rewards: [{ id: "21D67324ECFED6C0", type: "xp_levels", xp_levels: 15 }]
