	title: "&5VII. End-Zeitalter"
	quests: [
		{
			dependencies: ["2600278FFBA40B51"]
			description: ["&6Was ist das?", "Hier bekommst du Enderaugen und besiegst den Enderdrachen, den Boss des Endes.", "", "&6So gehts", "Enderperle und Blazepulver ergeben ein Enderauge (Werkbank).", "Wirf eines in die Luft, es fliegt Richtung Festung. Folge ihm, bis es nach unten zeigt, und grabe dort.", "Fülle alle 12 Rahmen im Portalraum mit Enderaugen und spring ins Portal.", "Im Ende: Zerstöre zuerst die Kristalle auf den Obsidian-Türmen. Einige sind mit Gittern geschützt, schieße sie mit dem Bogen ab oder klettere hoch.", "Danach greife den Drachen an, wenn er auf der Insel in der Mitte landet. Bringe Bogen, Pfeile, Wasser-Eimer und viele Blöcke mit.", "", "&6Wofür ist das wichtig?", "Ohne Drachen kein Ende-Zeitalter. Enderperlen bekommst du von Endermen oder Piglins.", "", "&6Gut zu wissen", "Der Drache atmet Drachenatem. Bleib nicht in den lila Wolken stehen."]
			id: "5E7EC2AF62FB134D"
			title: "Augen des Enders"
			rewards: [{ id: "1F28EAB434A05769", type: "item", item: { id: "minecraft:ender_pearl", count: 4 } }]
			tasks: [{ id: "2706F89C06B7CACF", type: "item", item: { id: "minecraft:ender_eye", count: 1 }, count: 12L }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["5E7EC2AF62FB134D"]
			description: ["&6Was ist das?", "Aktiviere das Portal in der Festung mit zwölf Enderaugen.", "", "&6So gehts", "In der Festung das Portal mit den Augen füllen und hineinspringen.", "Nimm Blöcke, Bogen, Wasser und Kürbis mit.", "", "&6Wofür ist das wichtig?", "Nach dem Drachen öffnen sich die äußeren Inseln mit Endstädten und Elytren.", "", "&6Gut zu wissen", "Für das Portal in der Festung müssen alle zwölf Rahmen ein Enderauge tragen. Nimm viele Blöcke zum Brücken und einen Eimer Wasser gegen Endermen mit."]
			id: "028ADF99FBF6807C"
			title: "Das Ende"
			rewards: [{ id: "52CF935ACF9E29CC", type: "item", item: { id: "minecraft:ender_pearl", count: 4 } }]
			tasks: [{ id: "3CF0889F596216CE", type: "dimension", dimension: "minecraft:the_end", icon: { id: "minecraft:end_stone" } }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["028ADF99FBF6807C"]
			description: ["&6Was ist das?", "Endstein ist der Boden der Ende-Dimension. Er ist gelb-weiß und brennt nicht.", "", "&6So gehts", "Baue ihn mit jeder Spitzhacke ab. Auf der Hauptinsel liegt er überall.", "Nimm Blöcke zum Bauen mit, sonst fällst du in die Leere.", "", "&6Wofür ist das wichtig?", "Daraus werden Endsteinziegel. Auch einige Mod-Rezepte brauchen ihn."]
			id: "15E61654C80FD4A8"
			title: "Endstein"
			rewards: [{ id: "0C0571FF622F3E8F", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "70F682F887A87123", type: "item", item: { id: "minecraft:end_stone", count: 1 }, count: 16L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["15E61654C80FD4A8"]
			description: ["&6Was ist das?", "Zerstöre die Kristalle auf den Säulen und besiege den Drachen.", "", "&6So gehts", "Zerstöre zuerst die Kristalle auf den Säulen, manche sind in Käfigen.", "Greife an, wenn er auf dem Portal landet.", "", "&6Wofür ist das wichtig?", "Nach dem Sieg erscheint ein Portal zu den äußeren Inseln.", "", "&6Gut zu wissen", "Zerstöre zuerst die Endkristalle auf den Säulen, sonst heilt sich der Drache. Ein Bogen und Wasser für die Kristalle helfen sehr."]
			id: "094E3A3AB01FE3FF"
			title: "Der Enderdrache"
			rewards: [{ id: "21D67324ECFED6C0", type: "xp_levels", xp_levels: 15 }]
			tasks: [{ id: "7871355328C80698", type: "kill", entity: "minecraft:ender_dragon", value: 1L, icon: { id: "minecraft:dragon_head" } }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["094E3A3AB01FE3FF"]
			description: ["&6Was ist das?", "Das Drachenei erscheint oben auf dem Austrittsportal, wenn du den Drachen besiegt hast.", "", "&6So gehts", "Das Ei teleportiert sich, wenn du es anklickst. Baue deshalb einen Kolben daneben.", "Schiebe das Ei mit dem Kolben vom Portal herunter und zerstöre den Block unter ihm. Dann kannst du es aufsammeln.", "", "&6Wofür ist das wichtig?", "Ein Andenken an deinen Sieg. Es gibt nur eines.", "", "&6Gut zu wissen", "Setze es nicht auf Sand oder Kies. Dort fällt es."]
			id: "6B5EC4CFDAFB5173"
			title: "Drachenei"
			rewards: [{ id: "03E3E9461075295C", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "028BF7FA915BE14F", type: "item", item: { id: "minecraft:dragon_egg", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["15E61654C80FD4A8"]
			description: ["&6Was ist das?", "Edle Ziegel aus Endstein.", "", "&6So gehts", "Vier Endstein zusammen.", "", "&6Wofür ist das wichtig?", "Schöne Bauten im Ende."]
			icon: { id: "minecraft:end_stone_bricks" }
