			rewards: [{ id: "3B8FCC2217B3D916", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "518FF68121A8584A", type: "item", item: { id: "apothic_enchanting:endshelf", count: 1 }, count: 4L }]
			x: 10.50d
			y: 1.50d
		}
		{
			dependencies: ["6B5EC4CFDAFB5173"]
			description: ["&6Was ist das?", "Endstädte sind riesige Türme auf den äußeren Inseln. Dort leben Shulker.", "", "&6So gehts", "Wirf nach dem Drachen eine Enderperle in das Tor hinter der Hauptinsel. Es erscheint, wenn du den Drachen besiegt hast.", "Fliege oder baue Brücken zu den äußeren Inseln. Folge den Endstädten.", "Töte 3 Shulker. Sie schießen Geschosse, die dich schweben lassen. Schlage sie, wenn die Schale offen ist.", "", "&6Wofür ist das wichtig?", "Hier findest du Shulkerschalen und den Elytra-Flügel in den Schiffen.", "", "&6Gut zu wissen", "Nimm Wasser oder Blöcke zum Abfangen mit."]
			id: "295A76E48CBFA8D5"
			title: "Endstadt"
			rewards: [{ id: "1695CC2291054EB9", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "7ACFF6B573D34D5B", type: "kill", entity: "minecraft:shulker", value: 3L, icon: { id: "minecraft:shulker_shell" } }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["295A76E48CBFA8D5"]
			description: ["&6Was ist das?", "Aus Shulkerschalen baust du Shulkerkisten.", "", "&6So gehts", "Besiege Shulker in Endstädten und sammle 2 Schalen.", "Werkbank: 2 Shulkerschalen und eine Kiste in der Mitte ergeben die Shulkerkiste.", "", "&6Wofür ist das wichtig?", "Eine Shulkerkiste behält ihren Inhalt, wenn du sie abbaust."]
			id: "4A052AD9B9039188"
			title: "Shulkerschalen"
			rewards: [{ id: "339AE3A617CADC3D", type: "item", item: { id: "minecraft:ender_chest", count: 1 } }]
			tasks: [{ id: "43EB246DD1EAABFA", type: "item", item: { id: "minecraft:shulker_shell", count: 1 }, count: 2L }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["4A052AD9B9039188"]
			description: ["&6Was ist das?", "Eine Shulkerkiste behält ihren Inhalt, wenn du sie abbaust. Der perfekte Koffer.", "", "&6So gehts", "Zwei Shulkerschalen aus Endstädten und eine Kiste.", "", "&6Wofür ist das wichtig?", "Ideal zum Umziehen und als Vorrat auf Reisen. Lass dich nicht im Ende von Shulkern fallen."]
			id: "5E60A7D94A2326A3"
			title: "Shulker-Kiste"
			rewards: [{ id: "440575B4A25A1C81", type: "item", item: { id: "minecraft:diamond", count: 2 } }]
