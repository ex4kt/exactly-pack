		{
			dependencies: ["45F7DF303BD48E57"]
			description: ["&6Was ist das?", "Apothic Enchanting: Regale aus End-Material.", "", "&6So gehts", "Rezept: Werkbank: 6x Endsteinziegel, Aufgeladener Drachenatem, Bücherregale, Enderperlen (Anordnung zeigt das Rezeptbuch: Maus aufs Item, Taste R).", "", "&6Wofür ist das wichtig?", "Die stärksten Verzauberungen."]
			icon: { id: "apothic_enchanting:endshelf" }
			id: "7CD89AF46ECCCCC0"
