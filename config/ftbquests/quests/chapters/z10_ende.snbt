		{
			dependencies: ["094E3A3AB01FE3FF"]
			description: ["&6Was ist das?", "Der Enderdrache ist der Boss des Endes mit 200 Leben. Er fliegt, atmet Drachenatem und wird von zehn Endkristallen auf Obsidiansäulen geheilt.", "", "&6So gehts", "Acht Schritte: Festung finden, Portal, Pfeile, Blöcke und Wasser, Kürbis, Kristalle, Drache.", "", "&6Wofür ist das wichtig?", "Mit dem Sieg bekommst du das Drachenei, Erfahrung und den Weg zu den Endstädten."]
			icon: { id: "minecraft:dragon_head" }
			id: "5851A927F1582ED0"
			title: "Drache: Überblick"
			rewards: [{ id: "12801974D86C74D0", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "29E85CD34CE3D782", type: "checkmark" }]
			x: 10.50d
			y: 2.00d
		}
		{
			dependencies: ["5851A927F1582ED0"]
			description: ["&6Was ist das?", "Die Festung versteckt das Endportal.", "", "&6So gehts", "Wirf ein Enderauge: Es fliegt in die Richtung der Festung. Folge ihm. Wenn es nach unten fällt, grabe dort. Mit dem Naturkompass kannst du die Festung auch suchen.", "", "&6Wofür ist das wichtig?", "Im Portalraum der Festung liegt der Rahmen zum Ende."]
			icon: { id: "minecraft:ender_eye" }
			id: "2F8796DBD31DD473"
			title: "Drache: Festung finden"
			rewards: [{ id: "0ED9C93390EF3355", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "6D2AC54CE5F97CF7", type: "checkmark" }]
			x: 12.00d
			y: 2.00d
		}
		{
			dependencies: ["2F8796DBD31DD473"]
			description: ["&6Was ist das?", "Das Endportal hat zwölf Rahmen.", "", "&6So gehts", "Setze in jeden leeren Rahmen ein Enderauge. Sind alle gefüllt, öffnet sich das Portal. Manche Rahmen sind schon besetzt, plane aber bis zu zwölf Augen ein.", "Lege vorher ein Bett oder einen Respawn-Punkt weit weg an.", "", "&6Wofür ist das wichtig?", "Hinter dem Portal gibt es keinen Rückweg, bis du den Drachen besiegt hast oder stirbst."]
			icon: { id: "minecraft:end_portal_frame" }
			id: "5BEE0068AE196052"
			title: "Drache: Portal aktivieren"
			rewards: [{ id: "2F20D2D5C46DFFDB", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "67729EA2764B40DD", type: "checkmark" }]
			x: 13.50d
			y: 2.00d
		}
		{
			dependencies: ["5BEE0068AE196052"]
			description: ["&6Was ist das?", "Gegen die Kristalle auf den hohen Säulen brauchst du Fernkampf.", "", "&6So gehts", "Nimm einen Bogen (am besten mit Unendlichkeit) und viele Pfeile mit, mindestens 64.", "", "&6Wofür ist das wichtig?", "Pfeile zerstören die Kristalle aus sicherer Entfernung."]
			icon: { id: "minecraft:bow" }
			id: "088031A171F3189A"
