			tasks: [{ id: "080DE8400895D377", type: "item", item: { id: "minecraft:arrow", count: 1 }, count: 64L }]
			x: 15.00d
			y: 2.00d
		}
		{
			dependencies: ["088031A171F3189A"]
			description: ["&6Was ist das?", "Endermen sind im Ende überall, die Inseln sind klein.", "", "&6So gehts", "Nimm mindestens 64 Blöcke zum Brücken und einen Wassereimer mit. Wasser schadet Endermen, ein Block über dem Kopf schützt dich.", "", "&6Wofür ist das wichtig?", "Blöcke zum Brücken retten dich vor dem Fall in die Leere."]
			icon: { id: "minecraft:water_bucket" }
			id: "5A170150AAC1C908"
