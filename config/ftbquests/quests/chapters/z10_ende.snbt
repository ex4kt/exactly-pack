		}
		{
			dependencies: ["5A170150AAC1C908"]
			description: ["&6Was ist das?", "Ein geschnitzter Kürbis auf dem Kopf schützt vor Endermen.", "", "&6So gehts", "Schneide einen Kürbis mit der Schere zu und setze ihn auf. Endermen werden nicht aggressiv, wenn du sie ansiehst. Du siehst durch den Kürbis etwas weniger.", "", "&6Wofür ist das wichtig?", "Ohne Kürbis greifen dich viele Endermen gleichzeitig an, sobald du sie ansiehst."]
			icon: { id: "minecraft:carved_pumpkin" }
