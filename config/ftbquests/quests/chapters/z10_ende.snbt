		{
			dependencies: ["076FC99714B15558"]
			description: ["&6Was ist das?", "Eine Kiste, die überall denselben Inhalt hat.", "", "&6So gehts", "Obsidian und ein Enderauge.", "", "&6Wofür ist das wichtig?", "Sicherer Speicher für unterwegs."]
			icon: { id: "minecraft:ender_chest" }
			id: "640BA76DC1967B64"
