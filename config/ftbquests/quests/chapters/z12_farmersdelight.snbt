		{
			dependencies: ["2A259585422D8567"]
			description: ["&6Was ist das?", "Aus Stroh wird Leinwand, damit baust du Schilder und Saecke.", "", "&6So gehts", "Stroh in der Werkbank verarbeiten.", "", "&6Wofuer ist das wichtig?", "Fuer Leinwand-Schilder, Saecke und einige Rezepte."]
			id: "3A18F51A5E568F49"
