		}
		{
			dependencies: ["2BB55ABC06EFBD94"]
			description: ["&6Was ist das?", "Stroh bekommst du, wenn du Gras oder Weizen mit dem Messer erntest.", "", "&6So gehts", "Halte das Messer und baue hohes Gras ab.", "", "&6Wofuer ist das wichtig?", "Fuer Leinwand, Reiche Erde und Kompost."]
			id: "2A259585422D8567"
