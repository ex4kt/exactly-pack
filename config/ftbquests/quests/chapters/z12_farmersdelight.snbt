		}
		{
			dependencies: ["085735849D72954E"]
			description: ["&6Was ist das?", "In der Pfanne brutzelt man Fleisch, Fisch und Eier direkt auf dem Herd.", "", "&6So gehts", "Stelle sie auf den Herd und lege Zutaten mit Rechtsklick hinein.", "Du kannst sie auch in der Hand benutzen und damit zuschlagen.", "", "&6Wofür ist das wichtig?", "Schneller als ein Ofen. Mit dem Korb daneben landet das Essen automatisch darin."]
			id: "607352A859D17B8B"
