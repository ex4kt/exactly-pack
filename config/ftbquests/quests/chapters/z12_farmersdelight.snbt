		{
			dependencies: ["5C658D7AF84D36C8"]
			description: ["&6Was ist das?", "Das erste Messer ist aus Feuerstein. Feuerstein faellt manchmal aus Kies.", "", "&6So gehts", "Feuerstein ueber einem Stock. Feuerstein findest du in Kies.", "", "&6Wofuer ist das wichtig?", "Mit dem Messer schneidest du auf dem Schneidebrett und erntest Stroh. Spaeter wird daraus das Eisenmesser."]
			id: "2BB55ABC06EFBD94"
			title: "Feuerstein-Messer"
			rewards: [{ id: "4DC7F43F615CE71B", type: "xp_levels", xp_levels: 2 }]
