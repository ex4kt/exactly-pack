		}
		{
			dependencies: ["2DBF06CA4693E4A2"]
			description: ["&6Was ist das?", "Der Herd ist die beste Hitzequelle für Topf und Pfanne. Du kannst auch ein Lagerfeuer nehmen.", "", "&6So gehts", "Stelle den Herd auf und zünde ihn mit Feuerzeug an.", "Lege rohes Fleisch mit Rechtsklick auf den Herd, um es zu grillen.", "", "&6Wofür ist das wichtig?", "Topf und Pfanne brauchen Hitze von unten. Der Herd ist sauberer als ein Lagerfeuer und hält ewig."]
			id: "32BDB50E970C219C"
