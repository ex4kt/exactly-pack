		}
		{
			dependencies: ["32BDB50E970C219C"]
			description: ["&6Was ist das?", "Im Kochtopf gart man Eintöpfe und Suppen. Stelle ihn auf den Herd und lege Zutaten plus Schüssel hinein.", "", "&6So gehts", "Stelle den Topf auf den Herd.", "Lege bis zu sechs Zutaten und das Gefäß (meist Schüssel) hinein.", "Warte, bis das Gericht fertig ist, und nimm es heraus.", "", "&6Wofür ist das wichtig?", "Topf-Gerichte geben die wichtigen Effekte. Mit Wasser im Topf brauchst du für Suppen kein Wasser extra."]
			id: "085735849D72954E"
			title: "Kochtopf"
			rewards: [{ id: "75011DBE68410A93", type: "item", item: { id: "minecraft:bowl", count: 4 } }]
