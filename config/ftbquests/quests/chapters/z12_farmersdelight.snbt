		{
			dependencies: ["5C658D7AF84D36C8"]
			description: ["&6Was ist das?", "Das erste Messer ist aus Feuerstein. Feuerstein fällt manchmal aus Kies.", "", "&6So gehts", "Feuerstein über einem Stock. Feuerstein findest du in Kies.", "", "&6Wofür ist das wichtig?", "Mit dem Messer schneidest du auf dem Schneidebrett und erntest Stroh. Später wird daraus das Eisenmesser."]
			id: "2BB55ABC06EFBD94"
			title: "Feuerstein-Messer"
