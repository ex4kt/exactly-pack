	quests: [
		{
			dependencies: ["2AD1D915658D1D50"]
			description: ["&6Was ist das?", "Farmers Delight bringt bessere Gerichte, Felder und Kochgeräte.", "Die nächsten Quests führen dich Schritt für Schritt durch die Küche.", "Tipp: Mahlzeiten aus dem Kochtopf geben Effekte wie Nahrhaft und Gemütlich (Lebensregeneration).", "", "&6So gehts", "Folge den Quests in diesem Kapitel: erst Werkzeug, dann Kochgeräte, dann Gerichte.", "", "&6Wofür ist das wichtig?", "Mahlzeiten aus dem Kochtopf geben die Effekte Nahrhaft (kein Hunger) und Gemütlich (Leben regeneriert). Das hilft enorm in Kämpfen und Dungeons."]
			id: "5C658D7AF84D36C8"
			title: "Kochen mit Farmers Delight"
			rewards: [{ id: "703538BE99552503", type: "item", item: { id: "minecraft:bread", count: 4 } }]
