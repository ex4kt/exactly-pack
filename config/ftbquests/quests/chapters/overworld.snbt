			x: 6.0d
			y: 7.0d
		}
		{
			dependencies: ["0C61EBD1DCD25736"]
			description: ["&6Was ist das?", "Die Hydra hat viele Koepfe. Hau sie ab, sobald sie schlaeft.", "", "&6So gehts", "Schlage die Koepfe, wenn sie den Mund oeffnen.", "", "&6Wofuer ist das wichtig?", "Hydra-Fleisch ist eines der besten Essen. Danach folgen Ritter und Ur-Ghast."]
			id: "49A48EFF187865E1"
