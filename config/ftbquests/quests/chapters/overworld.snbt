	title: "&aOverworld"
	quests: [
		{
			description: ["&6Was ist das?", "Eisen findest du in Hoehlen und Bergen. Schmelze es im Ofen.", "", "&6So gehts", "Eisenerz findest du in Hoehlen und Bergen, viel davon um Ebene 16 und hoch in Bergen.", "Im Ofen zu Barren schmelzen. Mit Create zerkleinern bringt mehr Barren pro Erz.", "", "&6Wofuer ist das wichtig?", "Werkzeug, Ruestung, Eimer, Schienen, Andesit-Legierung, Kompressoren: Fast jede Mod braucht Eisen. Lege frueh einen Vorrat an."]
			id: "AF0D7DDE0EA184A1"
			title: "Eisen!"
			rewards: [{ id: "79EDEB9A8DB10095", type: "item", item: { id: "minecraft:bread", count: 12 } }]
			tasks: [{ id: "98238F0E1C0653FC", type: "item", item: { id: "minecraft:iron_ingot", count: 1 }, count: 16L }]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["AF0D7DDE0EA184A1"]
			description: ["&6Was ist das?", "Diamanten liegen tief unter der Erde, ab Ebene -50. Du brauchst eine Eisenspitzhacke.", "", "&6So gehts", "Gehe tief hinunter, um Ebene minus 58. Mit Eisenspitzhacke abbauen.", "Glueck auf der Spitzhacke gibt mehr Diamanten pro Erz.", "", "&6Wofuer ist das wichtig?", "Diamantwerkzeug baut Obsidian ab, damit geht es in den Nether. Auch Verzauberungstisch und viele Mod-Rezepte brauchen Diamanten."]
			id: "35FF9CEBC0378B34"
			title: "Diamanten"
			rewards: [{ id: "55FC761EE7AB3EE0", type: "xp_levels", xp_levels: 5 }]
			tasks: [{ id: "EB440EE44B906A73", type: "item", item: { id: "minecraft:diamond", count: 1 }, count: 5L }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["35FF9CEBC0378B34"]
			description: ["&6Was ist das?", "Mit dem Verzauberungstisch verbesserst du Ausruestung.", "", "&6So gehts", "Diamanten, Obsidian und Buch. Buecherregale im Abstand von einem Block machen ihn staerker (maximal 15).", "Item hineinlegen, Lapis dazu, Verzauberung waehlen.", "", "&6Wofuer ist das wichtig?", "Effizienz, Schaerfe, Schutz und Haltbarkeit sind fuer jeden Bosskampf wichtig."]
			id: "A2FBBF0AB6EE1D87"
			title: "Verzauberungstisch"
			rewards: [{ id: "58BA1CE7A6684315", type: "item", item: { id: "minecraft:lapis_lazuli", count: 16 } }]
			tasks: [{ id: "2B89EBC8A982194E", type: "item", item: { id: "minecraft:enchanting_table", count: 1 }, count: 1L }]
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["A2FBBF0AB6EE1D87"]
			description: ["&6Was ist das?", "Creeper explodieren. Halte Abstand und schlage zu.", "", "&6So gehts", "Schlag zu und weiche sofort zurueck, bevor er zischt. Ein Schild blockt die Explosion.", "Mit Bogen oder Muskete aus der Ferne ist es am sichersten.", "", "&6Wofuer ist das wichtig?", "Schwarzpulver brauchst du fuer TNT, Feuerwerk (Elytra-Flug) und Munition."]
			id: "4C40586D04169654"
			title: "Der Creeper-Jaeger"
			rewards: [{ id: "3C5A33F5D1F74347", type: "item", item: { id: "minecraft:golden_apple", count: 1 } }]
			tasks: [{ id: "D8DB1E4A972DDEC4", type: "kill", entity: "minecraft:creeper", value: 5L, icon: { id: "minecraft:gunpowder" } }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["4C40586D04169654"]
			description: ["&6Was ist das?", "Der Warden ist blind, hoert aber jedes Geraeusch. Er ist staerker als fast jeder Boss.", "", "&6So gehts", "Er lebt in der Tiefen Dunkelheit (Antike Staedte). Schleiche und wirf Schneebaelle, um ihn abzulenken.", "Kampf nur mit sehr guter Ausruestung und Heiltraenken.", "", "&6Wofuer ist das wichtig?", "Antike Staedte haben die besten Truhen der Oberwelt: Schwunghosen-Verzauberung, Echosplitter, Ruestungsdesigns."]
			id: "A6755E634543E0AE"
			title: "Der Waechter der Tiefe"
			rewards: [{ id: "A257E61987E0FD66", type: "item", item: { id: "minecraft:netherite_scrap", count: 2 } }]
			tasks: [{ id: "8259C8D73009A0AB", type: "kill", entity: "minecraft:warden", value: 1L, icon: { id: "minecraft:sculk_shrieker" } }]
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["A6755E634543E0AE"]
			description: ["&6Was ist das?", "Mit dem Schmiedetisch verbesserst du Ausruestung mit Ruestungsdesign und Netherit.", "", "&6So gehts", "Vorlage, Ausruestung und Material einlegen.", "", "&6Wofuer ist das wichtig?", "Aus Diamant wird hier Netherit, Advanced Netherite und viele Mod-Ruestungen werden hier verbessert."]
			id: "8C2C73E1C1B6EA14"
			title: "Schmiedetisch"
			rewards: [{ id: "73D2EC810B04AD86", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3A5A937BFE7326AC", type: "item", item: { id: "minecraft:smithing_table", count: 1 }, count: 1L }]
			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["8C2C73E1C1B6EA14"]
			description: ["&6Was ist das?", "Dorfbewohner handeln mit dir. Suche ein Dorf und tausche gegen Smaragde.", "", "&6So gehts", "Rede mit Dorfbewohnern mit Rechtsklick. Arbeitsbloecke geben ihnen einen Beruf.", "Smaragde verdienst du durch Verkaufen von Weizen, Papier oder Kohle.", "", "&6Wofuer ist das wichtig?", "Bibliothekare verkaufen Verzauberungsbuecher wie Reparatur. Ein gutes Dorf spart viele Stunden."]
			id: "094B622650B032FF"
			title: "Ein Dorf besuchen"
			rewards: [{ id: "C18BF37614AE2201", type: "item", item: { id: "minecraft:bread", count: 8 } }]
			tasks: [{ id: "AA60AF16A980FE72", type: "item", item: { id: "minecraft:emerald", count: 1 }, count: 10L }]
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["094B622650B032FF"]
			description: ["&6Was ist das?", "Bienen machen Honig. Nimm eine Glasflasche und sammle am Bienenstock.", "", "&6So gehts", "Mit Glasflasche am vollen Bienenstock Honig sammeln. Lagerfeuer darunter beruhigt die Bienen.", "Mit Schere bekommst du Honigwaben.", "", "&6Wofuer ist das wichtig?", "Honig fuer Met (Brewin), Kerzen aus Waben, Honig-Seetang und Create-Honig."]
			id: "A3ED49D67593305A"
			title: "Bienen"
			rewards: [{ id: "4E884D763FE65347", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "50970A1726843812", type: "item", item: { id: "minecraft:honey_bottle", count: 1 }, count: 2L }]
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["A3ED49D67593305A"]
			description: ["&6Was ist das?", "Mit der Angel fischt du Fische, Schaetze und Verzauberbuecher.", "", "&6So gehts", "Angel ins Wasser werfen, bei Blasen einziehen.", "Mit Glueck des Meeres und Koeder wird es besser.", "", "&6Wofuer ist das wichtig?", "Fisch fuer Oceans Delight und Sushi. Beim Angeln gibt es auch Reparatur-Buecher."]
			id: "4F35CE769C767ED9"
			title: "Angeln"
			rewards: [{ id: "2794A8D89341CA2E", type: "item", item: { id: "minecraft:cooked_salmon", count: 8 } }]
			tasks: [{ id: "96AE4F210088B339", type: "item", item: { id: "minecraft:fishing_rod", count: 1 }, count: 1L }]
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["4F35CE769C767ED9"]
			description: ["&6Was ist das?", "Skelette schiessen aus der Ferne. Nutze Deckung.", "", "&6So gehts", "Nutze Deckung, gehe nah ran oder blocke mit dem Schild.", "", "&6Wofuer ist das wichtig?", "Knochen ergeben Knochenmehl (Duenger) und Pfeile kannst du wiederverwenden."]
			id: "2BBAC307BD308F25"
			title: "Sieger ueber Skelette"
			rewards: [{ id: "B44D90D09141B055", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "20BDE3D4C6834EA0", type: "kill", entity: "minecraft:skeleton", value: 10L, icon: { id: "minecraft:bone" } }]
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["2BBAC307BD308F25"]
			description: ["&6Was ist das?", "Pluenderer-Aussenposten sind gefaehrlich. Besiege einen Pluenderer.", "", "&6So gehts", "Aussenposten erkennst du am grauen Turm. Toete den Anfuehrer mit Banner, dann bekommst du ein schlechtes Omen.", "", "&6Wofuer ist das wichtig?", "Ein Dorf-Ueberfall mit schlechtem Omen gibt den Totem der Unsterblichkeit und Smaragde."]
			id: "B1C4F93BB74827F9"
			title: "Der Pluenderer"
			rewards: [{ id: "845765523A4CEC9B", type: "item", item: { id: "minecraft:emerald", count: 4 } }]
			tasks: [{ id: "E96A75AF95740A4B", type: "kill", entity: "minecraft:pillager", value: 5L, icon: { id: "minecraft:crossbow" } }]
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["B1C4F93BB74827F9"]
			description: ["&6Was ist das?", "Im Woodland Mansion lauern Illager und Beute. Du brauchst Totem und Ausruestung.", "", "&6So gehts", "Mit dem Natures Compass oder einer Forscherkarte vom Kartografen finden.", "Magier (Evoker) lassen den Totem der Unsterblichkeit fallen.", "", "&6Wofuer ist das wichtig?", "Der Totem rettet dich einmal vor dem Tod. Halte ihn in der zweiten Hand bei jedem Bosskampf."]
			id: "70175AE0EB9EB6EA"
			title: "Das Waldanwesen"
			rewards: [{ id: "D997BDE8437D1E0D", type: "item", item: { id: "minecraft:golden_apple", count: 2 } }]
			tasks: [{ id: "125A8F869534890E", type: "item", item: { id: "minecraft:totem_of_undying", count: 1 }, count: 1L }]
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["70175AE0EB9EB6EA"]
			description: ["&6Was ist das?", "Illager Invasion bringt den Invoker, einen sehr starken Illager-Magier.", "", "&6So gehts", "Er erscheint in Ueberfaellen und eigenen Bauten. Halte Abstand von seinen Zaubern und greife zwischen den Zaubern an.", "", "&6Wofuer ist das wichtig?", "Gute Beute und Training fuer die grossen Bosse."]
			id: "91A619988FF4F854"
			title: "Der Illager-Magier"
			rewards: [{ id: "95E432034C548A4B", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "BC2D5928BFD1109A", type: "kill", entity: "illagerinvasion:invoker", value: 1L, icon: { id: "minecraft:totem_of_undying" } }]
			x: 4.0d
			y: 4.0d
		}
		{
			dependencies: ["91A619988FF4F854"]
			description: ["&6Was ist das?", "Cataclysm bringt grosse Bosse. Der Kobolediator lebt in der Wueste.", "", "&6So gehts", "Der Kobolediator lebt in der Wueste. Weiche seinen Spruengen seitlich aus.", "", "&6Wofuer ist das wichtig?", "Cataclysm-Bosse lassen die staerksten Materialien des Packs fallen."]
			id: "DA97DA003B53F405"
			title: "Cataclysm: Kobolediator"
			rewards: [{ id: "AC3CFCA8CF883D00", type: "xp_levels", xp_levels: 6 }]
			tasks: [{ id: "469C639470BCFD64", type: "kill", entity: "cataclysm:kobolediator", value: 1L, icon: { id: "minecraft:sand" } }]
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: ["DA97DA003B53F405"]
			description: ["&6Was ist das?", "In der Verfluchten Pyramide liegt der Ancient Remnant. Er ist ein harter Boss.", "", "&6So gehts", "Bringe gute Ruestung, Essen und Heilung mit. Er ruft Sandstuerme und Kaefer.", "", "&6Wofuer ist das wichtig?", "Er laesst Antikes Metall fallen, Material fuer starke Cataclysm-Waffen."]
			id: "9AE0C97E69F5B916"
			title: "Cataclysm: Verfluchte Pyramide"
			rewards: [{ id: "51AB78C8C007B009", type: "item", item: { id: "minecraft:diamond", count: 3 } }]
			tasks: [{ id: "A2DB7D45CAD27337", type: "kill", entity: "cataclysm:ancient_remnant", value: 1L, icon: { id: "minecraft:sandstone" } }]
			x: 8.0d
			y: 4.0d
		}
		{
			description: ["&6Was ist das?", "Twilight Forest ist eine eigene Dimension. Wirf einen Diamanten in einen Teich mit Blumen drumherum.", "Dort beginnt ein langes Abenteuer mit vielen Bossen.", "", "&6So gehts", "Baue einen 2x2-Teich und stelle Blumen oder Gras ringsum. Wirf einen Diamanten hinein.", "Im Wald hilft die Magische Karte, Bosse zu finden.", "", "&6Wofuer ist das wichtig?", "Bosse muessen in der richtigen Reihenfolge besiegt werden, sonst blockieren Fluch-Effekte den Weg. Die Reihenfolge zeigen die naechsten Quests."]
			id: "6500D6CE1A353583"
			title: "Der Zwielichtwald"
			rewards: [{ id: "B121349265E7DDAB", type: "item", item: { id: "minecraft:diamond", count: 1 } }]
			tasks: [{ id: "0A1DFBDD8EF5E718", type: "dimension", dimension: "twilightforest:twilight_forest", icon: { id: "twilightforest:naga_scale" } }]
			x: 0.0d
			y: 7.0d
		}
		{
			dependencies: ["6500D6CE1A353583"]
			description: ["&6Was ist das?", "Die Naga ist der erste Boss des Waldes. Sie hat Schuppen als Beute.", "", "&6So gehts", "Sie lebt in einem Hof aus Steinen. Weiche ihren Angriffen seitlich aus.", "", "&6Wofuer ist das wichtig?", "Naga-Schuppen ergeben Ruestung. Danach ist der Lich dran."]
			id: "F9B594743A14BA59"
			title: "Naga"
			rewards: [{ id: "E7B9EE6C0E7AC6FB", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "931C267A4D288794", type: "kill", entity: "twilightforest:naga", value: 1L, icon: { id: "twilightforest:naga_scale" } }]
			x: 2.0d
			y: 7.0d
		}
		{
			dependencies: ["F9B594743A14BA59"]
			description: ["&6Was ist das?", "Der Lich ist ein maechtiger Zauberer. Bereite dich auf Magie vor.", "", "&6So gehts", "Er hat Schilde, die du zuerst zerstoeren musst. Wirf seine Feuerbaelle zurueck.", "", "&6Wofuer ist das wichtig?", "Danach oeffnet sich das Labyrinth mit dem Minoshroom."]
			id: "AEDA4F82D0E261A0"
			title: "Lich"
			rewards: [{ id: "CA8510DAD5B3ECDE", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "34BB556498D611AE", type: "kill", entity: "twilightforest:lich", value: 1L, icon: { id: "twilightforest:lich_trophy" } }]
			x: 4.0d
			y: 7.0d
		}
		{
			dependencies: ["AEDA4F82D0E261A0"]
			description: ["&6Was ist das?", "Der Minoshroom bewacht ein Labyrinth im Sumpf.", "", "&6So gehts", "Feuerresistenz-Traenke helfen. Er rennt auf dich zu, weiche aus.", "", "&6Wofuer ist das wichtig?", "Er bringt Meef-Stroganoff und oeffnet den Weg zur Hydra."]
			id: "0C61EBD1DCD25736"
			title: "Minoshroom"
			rewards: [{ id: "48E2D9A370DF925C", type: "xp_levels", xp_levels: 10 }]
