	title: "&6Grundlagen"
	quests: [
		{
			description: ["&6Was ist das?", "Schritt 1: Druecke M, um die Weltkarte (Xaeros) zu oeffnen.", "Schritt 2: Die Minikarte oben im Bild zeigt dir, wo du bist.", "Tipp: Auf der Karte kannst du Wegpunkte setzen (Taste N).", "", "&6So gehts", "Druecke M fuer die grosse Weltkarte.", "Mit N oeffnest du die Wegpunkt-Liste. Auf der Karte setzt du mit Rechtsklick einen Wegpunkt.", "Beim Tod wird automatisch ein Wegpunkt an der Todesstelle gesetzt.", "", "&6Wofuer ist das wichtig?", "Setze Wegpunkte fuer Basis, Doerfer und Dungeons. Ueber die Karte sicherst du spaeter auch deine Chunks (Open Parties and Claims)."]
			id: "9F0FA943889A171C"
			title: "Karte oeffnen"
			rewards: [{ id: "FFBF3627AD5229B5", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "8E70101E296015ED", type: "checkmark" }]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["9F0FA943889A171C"]
			description: ["&6Was ist das?", "Schritt 1: Halte den Mauszeiger im Inventar ueber ein Item.", "Schritt 2: Druecke R, um zu sehen, wie man es herstellt.", "Schritt 3: Druecke U, um zu sehen, wofuer man es braucht.", "", "&6So gehts", "Fahre mit der Maus ueber ein Item und druecke R: So stellst du es her.", "Druecke U: Wofuer man es braucht.", "Oben in der Suchleiste suchst du nach Namen. Mit @modname suchst du nach Mod, z.B. @create.", "", "&6Wofuer ist das wichtig?", "Bei ueber 400 Mods kennt niemand alle Rezepte. JEI ist dein wichtigstes Werkzeug. Bei Create zeigt dir die Taste W ausserdem eine Animation (Ponder)."]
			id: "3964C3F0A0574FEA"
			title: "Rezepte nachschlagen (JEI)"
			rewards: [{ id: "9A1B7402C064BEC8", type: "item", item: { id: "minecraft:bread", count: 4 } }]
			tasks: [{ id: "40EF884BF81B0279", type: "checkmark" }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["3964C3F0A0574FEA"]
			description: ["&6Was ist das?", "Waystones sind Wegpunkte zum Teleportieren.", "Schritt 1: Baue einen Waystone (siehe JEI).", "Schritt 2: Stelle ihn auf und klicke ihn mit Rechtsklick an. Damit ist er aktiviert.", "Schritt 3: Benutze spaeter einen anderen Waystone, um zu einem aktivierten zu reisen.", "", "&6So gehts", "Baue einen Waystone nach dem Rezept in JEI.", "Stelle ihn neben deine Basis und aktiviere ihn mit Rechtsklick.", "Du kannst ihn umbenennen, damit alle wissen, wohin er fuehrt.", "", "&6Wofuer ist das wichtig?", "Von jedem anderen Waystone kommst du jetzt nach Hause."]
			id: "26D013B846D08BDF"
			title: "Waystone bauen"
			rewards: [{ id: "5C978FDFFC271000", type: "item", item: { id: "minecraft:ender_pearl", count: 1 } }]
			tasks: [{ id: "D0C06F57B00A4767", type: "item", item: { id: "waystones:waystone", count: 1 }, count: 1L }]
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["26D013B846D08BDF"]
			description: ["&6Was ist das?", "Mit der Warp-Schriftrolle reist du zu einem Waystone, auch ohne einen in der Naehe.", "Du findest sie in Truhen oder kannst sie herstellen.", "", "&6So gehts", "Halte sie in der Hand und benutze sie (Rechtsklick).", "Waehle den Ziel-Waystone aus der Liste.", "", "&6Wofuer ist das wichtig?", "Perfekt fuer Notfaelle in Dungeons oder wenn du dich verlaufen hast. Spaeter gibt es auch den Warpstein, der wiederverwendbar ist."]
			id: "CC7CAD15F0593DE9"
			title: "Warp-Schriftrolle"
			rewards: [{ id: "AEEF440D3D09DD5A", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "C9DF67395A0746D5", type: "item", item: { id: "waystones:warp_scroll", count: 1 }, count: 1L }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["CC7CAD15F0593DE9"]
			description: ["&6Was ist das?", "Du kannst Kisten, Oefen und sogar ein Tier tragen.", "Schritt 1: Leere Haende (nichts in der Hand halten).", "Schritt 2: Schleichen (Shift) und Rechtsklick auf den Block oder das Tier.", "Schritt 3: Rechtsklick auf den Boden, um es wieder abzusetzen.", "", "&6So gehts", "Haende leer machen (nichts in der Hand).", "Shift halten und Rechtsklick auf Kiste, Ofen oder Tier.", "Rechtsklick auf den Boden setzt es wieder ab.", "", "&6Wofuer ist das wichtig?", "So ziehst du um, ohne Kisten auszuraeumen. Tiere bringst du so leicht zu deiner Farm. Babys sind erlaubt, es geht immer nur ein Tier."]
			id: "AF8BA1AFDD055F8F"
			title: "Tragen mit Carry On"
			rewards: [{ id: "FDD311B890C869C7", type: "item", item: { id: "minecraft:chest", count: 2 } }]
			tasks: [{ id: "F0DB961E802EF6A9", type: "checkmark" }]
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["AF8BA1AFDD055F8F"]
			description: ["&6Was ist das?", "Ein Schlafsack setzt deinen Spawnpunkt nicht neu. Er ist perfekt fuer Ausfluege.", "Schritt 1: Lege drei gleichfarbige Wolle in eine Reihe in die Werkbank.", "Schritt 2: Platziere den Schlafsack und lege dich hinein.", "Hinweis: Die Haelfte der Spieler muss schlafen, damit die Nacht endet.", "", "&6So gehts", "Drei gleichfarbige Wolle in eine Reihe legen.", "Schlafsack auf den Boden stellen und hineinlegen.", "", "&6Wofuer ist das wichtig?", "Auf langen Ausfluegen kannst du schlafen, ohne dass du nach dem Tod weit weg von zu Hause aufwachst."]
			id: "36A771044701E156"
			title: "Schlafen mit Comforts"
			rewards: [{ id: "27AF029E4518988F", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "457492C4DF6411DC", type: "item", item: { id: "comforts:sleeping_bag_red", count: 1 }, count: 1L }]
			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["36A771044701E156"]
			description: ["&6Was ist das?", "Die Magnum-Fackel haelt Monster in einem grossen Bereich fern.", "Stelle sie neben dein Haus, damit nichts in der Naehe spawnt.", "", "&6So gehts", "Baue die Diamant-Magnum-Fackel (Rezept in JEI).", "Stelle sie mitten in deine Basis.", "", "&6Wofuer ist das wichtig?", "Viel einfacher als alles auszuleuchten. So kannst du in Ruhe bauen und Farmen anlegen."]
			id: "8458315A17ECDBF0"
			title: "Monsterfreie Zone"
			rewards: [{ id: "206FFC72C8F303A4", type: "item", item: { id: "minecraft:torch", count: 16 } }]
			tasks: [{ id: "4A9AF60C1862B667", type: "item", item: { id: "magnumtorch:diamond_magnum_torch", count: 1 }, count: 1L }]
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["8458315A17ECDBF0"]
			description: ["&6Was ist das?", "Wenn du stirbst, entsteht an der Stelle ein Grab mit deinen Sachen.", "Schritt 1: Merke dir die Koordinaten aus der Todesnachricht.", "Schritt 2: Gehe hin und oeffne das Grab mit Rechtsklick.", "", "&6So gehts", "Lies die Todesnachricht im Chat, dort stehen die Koordinaten.", "Auf der Karte ist ein Wegpunkt gesetzt.", "Gehe hin und klicke das Grab mit Rechtsklick an.", "", "&6Wofuer ist das wichtig?", "Keine Panik beim Sterben. Hol deine Sachen aber zeitnah, bevor Monster dich am Grab erwischen."]
			id: "856C2629F362091C"
			title: "Dein Grab"
			rewards: [{ id: "FA58280737E66CBD", type: "item", item: { id: "minecraft:golden_apple", count: 1 } }]
			tasks: [{ id: "760673DC7DE7B63D", type: "checkmark" }]
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["856C2629F362091C"]
			description: ["&6Was ist das?", "Jade zeigt dir oben im Bild, was du gerade ansiehst: Block, Mod und Inhalt.", "Schau eine Kiste oder eine Maschine an, um es auszuprobieren.", "", "&6So gehts", "Schaue einfach einen Block oder ein Tier an.", "Bei Oefen und Maschinen siehst du den Fortschritt, bei Pflanzen das Wachstum.", "", "&6Wofuer ist das wichtig?", "So erkennst du sofort, aus welcher Mod etwas kommt, und kannst es in JEI nachschlagen."]
			id: "79D1AFC1106F3379"
			title: "Alles im Blick (Jade)"
			rewards: [{ id: "5146D11E6930575A", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "E1A46FFF3981D065", type: "checkmark" }]
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["79D1AFC1106F3379"]
			description: ["&6Was ist das?", "Viele Mods haben eigene Tasten.", "Schritt 1: Druecke Esc und gehe auf Optionen, Steuerung.", "Schritt 2: Oben gibt es eine Suchleiste. Tippe den Namen der Funktion ein.", "", "&6So gehts", "Esc, Optionen, Steuerung, Tastenbelegung.", "Oben ist eine Suchleiste. Tippe einen Namen ein, z.B. Rucksack.", "Wichtig: B Rucksack, U Quests, M Karte, N Wegpunkte, R und U in JEI.", "", "&6Wofuer ist das wichtig?", "Wenn eine Taste nicht geht, schaue hier nach. Rote Tasten sind doppelt belegt."]
			id: "7089B8412C90B2A8"
			title: "Tastenbelegung suchen"
			rewards: [{ id: "080485FCFCDDBFAB", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "119ACE7FA6580E93", type: "checkmark" }]
			x: 0.0d
			y: 2.0d
		}
		{
			description: ["&6Was ist das?", "Mit Open Parties and Claims schuetzt du dein Gebiet.", "Schritt 1: Oeffne die Weltkarte (M).", "Schritt 2: Waehle Chunks aus und beanspruche sie.", "Nur du und deine Gruppe duerft dort bauen.", "", "&6So gehts", "Oeffne die Weltkarte mit M.", "Rechtsklick auf die Karte, dann Claim waehlen. Oder ziehe einen Bereich auf.", "Mit F8 oeffnest du das Menue von Open Parties and Claims.", "", "&6Wofuer ist das wichtig?", "Schuetzt deine Basis vor Explosionen, Griefing und Monstern, die Bloecke klauen."]
			id: "6243EE6995B2025B"
			title: "Chunks sichern"
			rewards: [{ id: "F0FC612C1CA01A4A", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "3DFC6C96A4C6B8E8", type: "checkmark" }]
			x: 0.0d
			y: 5.0d
		}
		{
			dependencies: ["6243EE6995B2025B"]
			description: ["&6Was ist das?", "Eine Gruppe (Party) teilt Schutz und Rechte.", "Schritt 1: Gib im Chat /oparties ein. Dort siehst du die Befehle.", "Schritt 2: Lade Freunde ein.", "", "&6So gehts", "Gib im Chat /openpac-parties create ein oder nutze das Menue mit F8.", "Lade deine Freunde ein, sie nehmen mit dem Befehl im Chat an.", "", "&6Wofuer ist das wichtig?", "Mit Gruppe koennt ihr gemeinsam in euren Claims bauen und eure Basis zusammen schuetzen."]
			id: "BDA0080F5CFE5B6E"
			title: "Gruppe gruenden"
			rewards: [{ id: "E5DBFD52B2B9195F", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "C952FCC4F9A39806", type: "checkmark" }]
			x: 2.0d
			y: 5.0d
		}
		{
			dependencies: ["BDA0080F5CFE5B6E"]
			description: ["&6Was ist das?", "Mit Ping Wheel zeigst du Freunden, wohin ihr geht.", "Standard ist die Maustaste Vorwaerts (Maus 5). Aenderbar in den Optionen.", "", "&6So gehts", "Druecke die Ping-Taste (Standard: Maustaste 5), um auf das Ziel zu zeigen.", "Halte die Taste fuer das Rad mit verschiedenen Zeichen.", "", "&6Wofuer ist das wichtig?", "Super beim gemeinsamen Erkunden: Hier ist eine Kiste, dort ein Gegner."]
			id: "5D81E3B99FF6D10F"
			title: "Ping"
			rewards: [{ id: "C31BD8BE427C1226", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "01A23B833BCC6E38", type: "checkmark" }]
			x: 4.0d
			y: 5.0d
		}
		{
			dependencies: ["5D81E3B99FF6D10F"]
			description: ["&6Was ist das?", "Serene Seasons: Fruehling, Sommer, Herbst, Winter.", "Pflanzen wachsen je nach Jahreszeit unterschiedlich. Der Kalender zeigt dir den Tag.", "", "&6So gehts", "Der Kalender zeigt die aktuelle Jahreszeit.", "In JEI siehst du beim Samen, wann er waechst.", "Im Gewaechshaus (Glas ueber den Feldern) wachsen Pflanzen auch ausserhalb der Saison.", "", "&6Wofuer ist das wichtig?", "Plane deine Felder: Im Winter waechst kaum etwas. Lege Vorraete an oder baue ein Gewaechshaus."]
			id: "6D4D897E15E1E83D"
			title: "Jahreszeiten"
			rewards: [{ id: "F2DE7A286BD13C10", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "4A27EE32DA8318BC", type: "item", item: { id: "sereneseasons:calendar", count: 1 }, count: 1L }]
			x: 6.0d
			y: 5.0d
		}
		{
			dependencies: ["6D4D897E15E1E83D"]
			description: ["&6Was ist das?", "Reife Pflanzen erntest du mit Rechtsklick. Sie werden dabei automatisch wieder eingepflanzt.", "", "&6So gehts", "Rechtsklick auf eine reife Pflanze, z.B. Weizen oder Kartoffeln.", "", "&6Wofuer ist das wichtig?", "Viel schneller als abbauen und neu pflanzen. Mit Hacke in der Hand erntest du mehrere Felder auf einmal."]
			id: "ECC294D720618A23"
			title: "Ernten mit Rechtsklick"
			rewards: [{ id: "6BCE53F97A1301F0", type: "item", item: { id: "minecraft:wheat_seeds", count: 8 } }]
			tasks: [{ id: "958CCC9E0FE2F7DB", type: "checkmark" }]
			x: 8.0d
			y: 5.0d
		}
		{
			dependencies: ["ECC294D720618A23"]
			description: ["&6Was ist das?", "Der Handelsposten (Trading Post) zeigt die Angebote aller Dorfbewohner in der Naehe. Die Bartering Station tauscht automatisch mit Piglins.", "", "&6So gehts", "Stelle den Handelsposten in ein Dorf und oeffne ihn.", "Fuer Piglin-Tausch: Gold in die Bartering Station legen.", "", "&6Wofuer ist das wichtig?", "Mit Dorfbewohnern bekommst du Verzauberungsbuecher, Diamantausruestung und Nahrung. Smaragde sind die Waehrung."]
			id: "BF77786B6A0959A1"
			title: "Handeln"
			rewards: [{ id: "D2A8F3B56E41A6DE", type: "item", item: { id: "minecraft:emerald", count: 4 } }]
			tasks: [{ id: "87AB0F039FE7CF8E", type: "checkmark" }]
			x: 8.0d
			y: 7.0d
		}
		{
			dependencies: ["BF77786B6A0959A1"]
			description: ["&6Was ist das?", "Beute-Truhen sind fuer jeden Spieler einzeln. Jeder bekommt eigene Beute.", "Du kannst also alles plundern, ohne dass die anderen leer ausgehen.", "", "&6So gehts", "Oeffne eine Lootr-Truhe (sie hat einen besonderen Rand). Der Inhalt gehoert nur dir.", "", "&6Wofuer ist das wichtig?", "Ihr koennt gemeinsam Dungeons erkunden, ohne dass einer alles leer raeumt."]
			id: "B1704D620DB73666"
			title: "Beute teilen (Lootr)"
			rewards: [{ id: "225E7604C441AE82", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "0DA8D2B7A95557D8", type: "checkmark" }]
			x: 6.0d
			y: 7.0d
		}
		{
			dependencies: ["B1704D620DB73666"]
			description: ["&6Was ist das?", "Verbandszeug und Heiltraenke helfen auch deinen Freunden.", "Rechtsklick auf einen Mitspieler mit Verband heilt ihn.", "", "&6So gehts", "Baue einen Verband und halte Rechtsklick, um dich zu heilen.", "Rechtsklick auf einen Mitspieler heilt ihn.", "", "&6Wofuer ist das wichtig?", "In schweren Kaempfen koennt ihr euch gegenseitig retten."]
			id: "3B6E0C6651CF4429"
			title: "Gemeinsam heilen"
			rewards: [{ id: "1CF70F79C6B8D9CB", type: "xp_levels", xp_levels: 2 }]
