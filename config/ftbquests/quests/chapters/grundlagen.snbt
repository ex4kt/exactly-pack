			x: 4.0d
			y: 7.0d
		}
		{
			description: ["&6Was ist das?", "Zeigt oben in der Mitte, welchen Block oder welches Tier du ansiehst.", "", "&6So gehts", "Einfach hinschauen.", "", "&6Wofuer ist das wichtig?", "Hilft beim Nachschlagen in JEI und zeigt den Fortschritt von Maschinen."]
			id: "555631ED957ADF8F"
