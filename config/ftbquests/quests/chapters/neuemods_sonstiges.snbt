		{
			dependencies: ["E8C1ED9AD85FF70C"]
			description: ["&6Was ist das?", "Lootr macht Beutekisten fuer jeden Spieler einzeln. Jeder bekommt seinen eigenen Inhalt.", "", "&6So gehts", "Kisten in Dungeons und Ruinen oeffnen. Du kannst auch eine eigene Lootr-Kiste aufstellen.", "", "&6Wofuer ist das wichtig?", "Niemand kann dir etwas wegschnappen, und du musst nicht um Beute streiten."]
			icon: { id: "lootr:lootr_chest" }
			id: "D0BB68AA1026B925"
