			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["36922ABADCA5CB7E"]
			description: ["&6Was ist das?", "Der XP-Tome speichert Erfahrung in einem Buch.", "", "&6So gehts", "Rezept: Werkbank: 4x Enderperlen, Buch (Anordnung zeigt das Rezeptbuch: Maus aufs Item, Taste R).", "Rezept nachschlagen (Maus aufs Item, Taste R). Rechtsklick nimmt oder gibt Erfahrung.", "", "&6Wofür ist das wichtig?", "Praktisch, um Level zu sichern oder an Mitspieler weiterzugeben."]
			icon: { id: "xpbook:xp_tome" }
			id: "29CE7F9BFAEE2522"
