		{
			dependencies: ["61D24810949A1CE2"]
			description: ["&6Was ist das?", "Der Schraubenschlüssel stellt Rohre ein.", "", "&6So gehts", "Rechtsklick mit dem Schlüssel auf eine Anschlussseite: Das Rohr zieht dort Dinge heraus.", "Mit Schleichen und Rechtsklick trennst du eine Verbindung.", "Rechtsklick ohne Schlüssel auf eine herausziehende Seite öffnet das Menü für Filter und Upgrades.", "", "&6Wofür ist das wichtig?", "So bestimmst du genau, was wohin fließt."]
			icon: { id: "pipez:wrench" }
			id: "2DF45986D00F660E"
