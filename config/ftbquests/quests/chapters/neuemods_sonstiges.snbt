		}
		{
			dependencies: ["D0BB68AA1026B925"]
			description: ["&6Was ist das?", "Stirbst du, entsteht an der Stelle ein Grab mit deinen Sachen.", "", "&6So gehts", "Mit dem Grabschluessel oeffnest du es. Lauf nach dem Tod einfach zurueck zum Grab.", "", "&6Wofuer ist das wichtig?", "So gehen Ausruestung und Items beim Sterben nicht verloren."]
			icon: { id: "yigd:grave" }
