	title: "&aWeitere Mods"
	quests: [
		{
			description: ["&6Was ist das?", "Ein Kapitel fuer kleine Mods, die bisher keinen Eintrag hatten: Lootr, Grabsteine, XP-Tome, Amendments, Toil and Trouble, Rechiseled Create, Dorfwachen, Relikte und mehr Zweithand-Slots.", "", "&6So gehts", "Alles hier ist freiwillig. Hake einfach ab, was dich interessiert.", "", "&6Wofuer ist das wichtig?", "Du lernst die neuen Items kennen und bekommst kleine XP-Belohnungen."]
			icon: { id: "lootr:lootr_chest" }
			id: "E8C1ED9AD85FF70C"
