			rewards: [{ id: "2148D2CC54E84D2E", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "3231E811F9B0E469", type: "item", item: { id: "amendments:dye_bottle", count: 1 }, count: 1L }]
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["3417D166F55B83C8"]
			description: ["&6Was ist das?", "Toil and Trouble gibt dem Kessel neue Aufgaben, zum Beispiel Honig, Milch und Schleim.", "", "&6So gehts", "Einen Kessel füllen und Zutaten mit dem passenden Item einfüllen.", "", "&6Wofür ist das wichtig?", "Der Kessel wird zu einer kleinen Küchenstation."]
			icon: { id: "minecraft:cauldron" }
			id: "66F4EA00E688E922"
