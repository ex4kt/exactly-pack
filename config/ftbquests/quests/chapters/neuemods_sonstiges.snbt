			x: 3.5d
			y: 2.0d
		}
		{
			dependencies: ["66F4EA00E688E922"]
			description: ["&6Was ist das?", "Rechiseled Create erweitert den Meißelblock um Create-Varianten, vor allem Fenster und Verkleidungen.", "", "&6So gehts", "Den Meißel nehmen und Create-Blöcke damit verwandeln, Rezept in JEI.", "", "&6Wofür ist das wichtig?", "Schöne Fabriken ohne Stress."]
			icon: { id: "create:andesite_casing" }
