		{
			dependencies: ["29CE7F9BFAEE2522"]
			description: ["&6Was ist das?", "Mit More Zweithand Slots hast du mehr als einen Zweithand-Platz.", "", "&6So gehts", "Wechsle mit den Maustasten 4 und 5 oder dem Mausrad zwischen den Zweithand-Slots. Die Einstellungen stehen im Menü Steuerung.", "", "&6Wofür ist das wichtig?", "Schild, Fackel und Essen sind gleichzeitig griffbereit."]
			icon: { id: "minecraft:shield" }
