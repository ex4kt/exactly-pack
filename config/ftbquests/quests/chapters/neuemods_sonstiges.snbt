	title: "&aWeitere Mods"
	quests: [
		{
			description: ["&6Was ist das?", "Ein Kapitel für kleine Mods, die bisher keinen Eintrag hatten: Lootr, Grabsteine, XP-Tome, Amendments, Toil and Trouble, Rechiseled Create, Dorfwachen, Relikte und mehr Zweithand-Slots.", "", "&6So gehts", "Alles hier ist freiwillig. Hake einfach ab, was dich interessiert.", "", "&6Wofür ist das wichtig?", "Du lernst die neuen Items kennen und bekommst kleine XP-Belohnungen."]
			icon: { id: "lootr:lootr_chest" }
			id: "1F9A49EA0F75944D"
			title: "Weitere Mods"
			rewards: []
			tasks: [{ id: "691762801BA2AE57", type: "checkmark" }]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1F9A49EA0F75944D"]
			description: ["&6Was ist das?", "Lootr macht Beutekisten für jeden Spieler einzeln. Jeder bekommt seinen eigenen Inhalt.", "", "&6So gehts", "Öffne eine Kiste in einem Dungeon oder einer Ruine und hake die Aufgabe dann ab. Lootr-Kisten lassen sich nicht herstellen.", "", "&6Wofür ist das wichtig?", "Niemand kann dir etwas wegschnappen, und du musst nicht um Beute streiten."]
			icon: { id: "lootr:lootr_chest" }
			id: "44D814032212D60D"
			title: "Lootr-Kiste"
			rewards: [{ id: "3F2E0EC6A4AA6DF5", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "09BC573007554091", type: "checkmark" }]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["44D814032212D60D"]
			description: ["&6Was ist das?", "Stirbst du, entsteht an der Stelle ein Grab mit deinen Sachen.", "", "&6So gehts", "Mit dem Grabschlüssel öffnest du es. Lauf nach dem Tod einfach zurück zum Grab. Die Aufgabe hakst du selbst ab.", "", "&6Wofür ist das wichtig?", "So gehen Ausrüstung und Items beim Sterben nicht verloren."]
			icon: { id: "yigd:grave" }
			id: "36922ABADCA5CB7E"
			title: "Grabstein"
			rewards: [{ id: "1B4DA0CAA63A8B61", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "6680E82469F8D568", type: "checkmark" }]
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: ["36922ABADCA5CB7E"]
			description: ["&6Was ist das?", "Der XP-Tome speichert Erfahrung in einem Buch.", "", "&6So gehts", "Rezept in JEI nachschlagen (R auf dem Item). Rechtsklick nimmt oder gibt Erfahrung.", "", "&6Wofür ist das wichtig?", "Praktisch, um Level zu sichern oder an Mitspieler weiterzugeben."]
			icon: { id: "xpbook:xp_tome" }
			id: "29CE7F9BFAEE2522"
			title: "XP-Tome"
			rewards: [{ id: "618092AFCDB9758D", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "2F69590B22D0ED91", type: "item", item: { id: "xpbook:xp_tome", count: 1 }, count: 1L }]
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["29CE7F9BFAEE2522"]
			description: ["&6Was ist das?", "Mit More Offhand Slots hast du mehr als einen Zweithand-Platz.", "", "&6So gehts", "Wechsle mit den Maustasten 4 und 5 oder dem Mausrad zwischen den Zweithand-Slots. Die Einstellungen stehen im Menü Steuerung.", "", "&6Wofür ist das wichtig?", "Schild, Fackel und Essen sind gleichzeitig griffbereit."]
			icon: { id: "minecraft:shield" }
			id: "0DE7AAC88236E6A3"
			title: "Mehr Zweithand-Slots"
			rewards: [{ id: "5BCCCF4A0FFD6730", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "2B4038831E1A20D8", type: "checkmark" }]
			x: 6.5d
			y: 0.0d
		}
		{
			dependencies: ["1F9A49EA0F75944D"]
			description: ["&6Was ist das?", "Amendments bringt viele kleine Verbesserungen für Blöcke und Items. Mit der Farbflasche färbst du Dinge ein.", "", "&6So gehts", "Rezept in JEI nachschlagen (R auf dem Item).", "", "&6Wofür ist das wichtig?", "Dazu gibt es Teppichtreppen, Wandlaternen und Werkzeughaken."]
			icon: { id: "amendments:dye_bottle" }
			id: "3417D166F55B83C8"
