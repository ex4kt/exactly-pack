			x: 7.50d
			y: -10.50d
		}
		{
			dependencies: ["6B4314E787C73225"]
			description: ["&6Was ist das?", "Beute-Truhen sind für jeden Spieler einzeln. Jeder bekommt eigene Beute.", "Du kannst also alles plündern, ohne dass die anderen leer ausgehen.", "", "&6So gehts", "Öffne eine Lootr-Truhe (sie hat einen besonderen Rand). Der Inhalt gehört nur dir.", "", "&6Wofür ist das wichtig?", "Ihr könnt gemeinsam Dungeons erkunden, ohne dass einer alles leer räumt."]
			id: "3762E8AE7D5A3EA6"
			title: "Beute teilen (Lootr)"
			rewards: [{ id: "4A27EE32DA8318BC", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "5DDBD34D49334BC6", type: "checkmark" }]
			x: 9.00d
			y: -10.50d
		}
		{
			dependencies: ["3762E8AE7D5A3EA6"]
			description: ["&6Was ist das?", "Wenn du stirbst, entsteht an der Stelle ein Grab mit deinen Sachen.", "Schritt 1: Merke dir die Koordinaten aus der Todesnachricht.", "Schritt 2: Gehe hin und öffne das Grab mit Rechtsklick.", "", "&6So gehts", "Lies die Todesnachricht im Chat, dort stehen die Koordinaten.", "Auf der Karte ist ein Wegpunkt gesetzt.", "Gehe hin und klicke das Grab mit Rechtsklick an.", "", "&6Wofür ist das wichtig?", "Keine Panik beim Sterben. Hol deine Sachen aber zeitnah, bevor Monster dich am Grab erwischen."]
			id: "4D55CE44664F75B9"
			title: "Dein Grab"
			rewards: [{ id: "080E7E6B6737F20B", type: "item", item: { id: "minecraft:golden_apple", count: 1 } }]
			tasks: [{ id: "431DF935F8DD49EF", type: "checkmark" }]
			x: 10.50d
			y: -10.50d
		}
		{
			dependencies: ["4CC791F37478A527"]
			description: ["&6Was ist das?", "Kohle findest du in Höhlen und an Berghängen. Du brauchst sie für Fackeln und Öfen.", "", "&6So gehts", "Mit einer Holz- oder Steinspitzhacke abbauen. Sie ist in fast jeder Felswand zu finden.", "", "&6Wofür ist das wichtig?", "Fackeln, Öfen, Schmelzöfen. Später auch Brennstoff für Blazebrenner und Dampfmaschinen.", "", "&6Gut zu wissen", "Holzkohle bekommst du auch, wenn du Stämme im Ofen brennst. Sie ist für Fackeln genauso gut wie Kohle."]
			id: "60B557A4BAD57D69"
			title: "Kohle"
