		{
			dependencies: ["00C24655867A56D6"]
			description: ["&6Was ist das?", "Rohkupfer im Ofen schmelzen.", "", "&6So gehts", "Rohkupfer in den Ofen.", "", "&6Wofür ist das wichtig?", "Neun Barren ergeben einen Block. Kupferblöcke werden mit der Zeit grün.", "", "&6Gut zu wissen", "Kupferblöcke oxidieren mit der Zeit. Mit Wachs (aus Honigwaben) bleibt der Block in seinem Zustand."]
			id: "7530D2695E6CB2F2"
			title: "Kupferbarren"
