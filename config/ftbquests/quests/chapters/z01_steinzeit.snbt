			y: 0.0d
		}
		{
			dependencies: ["00C24655867A56D6"]
			description: ["&6Was ist das?", "Rohkupfer im Ofen schmelzen.", "", "&6So gehts", "Rohkupfer in den Ofen.", "", "&6Wofuer ist das wichtig?", "Neun Barren ergeben einen Block. Kupferbloecke werden mit der Zeit gruen.", "", "&6Gut zu wissen", "Kupferbloecke oxidieren mit der Zeit. Mit Wachs (aus Honigwaben) bleibt der Block in seinem Zustand."]
			id: "7530D2695E6CB2F2"
			title: "Kupferbarren"
			rewards: [{ id: "3E3CD5D014670DB0", type: "item", item: { id: "minecraft:copper_ingot", count: 4 } }]
