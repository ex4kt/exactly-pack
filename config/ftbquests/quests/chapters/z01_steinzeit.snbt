		{
			dependencies: ["3562C0A2C728CF90"]
			description: ["&6Was ist das?", "Mit der Angel fischt du Fische, Schätze und Verzauberbücher.", "", "&6So gehts", "Angel ins Wasser werfen, bei Blasen einziehen.", "Mit Glück des Meeres und Köder wird es besser.", "", "&6Wofür ist das wichtig?", "Fisch für Oceans Delight und Sushi. Beim Angeln gibt es auch Reparatur-Bücher."]
			id: "2E1856C760C14E1D"
			title: "Angeln"
			rewards: [{ id: "56BF2A4E6813EA19", type: "item", item: { id: "minecraft:cooked_salmon", count: 8 } }]
