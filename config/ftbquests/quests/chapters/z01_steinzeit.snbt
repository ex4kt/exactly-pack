		}
		{
			dependencies: ["01E77D914BD88DA1"]
			description: ["&6Was ist das?", "Ein Fass fasst genauso viel wie eine Kiste, laesst sich aber unter Bloecken oeffnen.", "", "&6So gehts", "Sechs Bretter und zwei Holzstufen.", "Du kannst Faesser direkt stapeln und in Waende einbauen.", "", "&6Wofuer ist das wichtig?", "Platzsparend fuer kleine Basen. Hopper und Trichter funktionieren wie bei Kisten."]
			id: "06ABC2FF817AB74D"
