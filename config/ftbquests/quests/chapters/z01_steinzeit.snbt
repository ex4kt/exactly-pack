		{
			dependencies: ["149718EF5100546D"]
			description: ["&6Was ist das?", "Ein Bett lässt dich die Nacht überspringen und setzt deinen Spawnpunkt.", "", "&6So gehts", "Drei Wolle (gleiche Farbe) über drei Brettern ergeben ein Bett. Wolle bekommst du von Schafen.", "Rechtsklick auf das Bett in der Nacht. Du kannst allein schlafen: Die Nacht läuft dann schneller. Je mehr Mitspieler im Bett liegen, desto schneller wird es Morgen. Niemand muss warten, bis die Hälfte schläft.", "", "&6Wofür ist das wichtig?", "Nachts kommen viele Monster. Mit Bett bist du sicher und startest nach dem Tod zu Hause, nicht am Weltspawn."]
			id: "31E49D7CA0CDCF29"
			hide_dependency_lines: true
			title: "Ein Bett für die Nacht"
			rewards: [{ id: "2CCB051DE9617BB1", type: "item", item: { id: "minecraft:leather", count: 4 } }]
			tasks: [{ id: "08C0752D3456786D", type: "item", item: { id: "minecraft:red_bed", count: 1 }, count: 1L }]
			x: 9.00d
			y: 9.00d
		}
		{
			dependencies: ["31E49D7CA0CDCF29"]
			description: ["&6Was ist das?", "Eine Kiste speichert 27 Stapel. Zwei nebeneinander werden eine Doppelkiste.", "", "&6So gehts", "Acht Bretter im Kreis in der Werkbank ergeben eine Kiste.", "Stelle sie auf und lege mit Shift-Klick Items hinein.", "", "&6Wofür ist das wichtig?", "Ohne Ordnung wird es schnell chaotisch. Im Zweig Lager und Kisten lernst du, wie du aus Kisten ein ganzes Lagersystem machst."]
			id: "69D520822E2F3373"
			title: "Kisten sind dein Freund"
			rewards: [{ id: "3FD9FA36355B9A30", type: "item", item: { id: "minecraft:barrel", count: 2 } }]
			tasks: [{ id: "55E5AE1BD49F7B38", type: "item", item: { id: "minecraft:chest", count: 1 }, count: 1L }]
			x: 10.50d
			y: 9.00d
		}
		{
			dependencies: ["69D520822E2F3373"]
			description: ["&6Was ist das?", "Ein Fass fasst genauso viel wie eine Kiste, lässt sich aber unter Blöcken öffnen.", "", "&6So gehts", "Sechs Bretter und zwei Holzstufen.", "Du kannst Fässer direkt stapeln und in Wände einbauen.", "", "&6Wofür ist das wichtig?", "Platzsparend für kleine Basen. Hopper und Trichter funktionieren wie bei Kisten."]
			id: "06ABC2FF817AB74D"
			title: "Fass"
			rewards: [{ id: "4EEBAA08D1E81414", type: "item", item: { id: "minecraft:iron_nugget", count: 8 } }]
