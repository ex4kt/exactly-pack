	quest_links: [ ]
	title: "&7I. Steinzeit"
	quests: [
		{
			dependencies: ["32B584A362001F6A"]
			description: ["&6Was ist das?", "Exactly hat acht Zeitalter: Stein, Eisen, Diamant, Nether, Magie, Welten, Ende und Meister. Create, Pneumatik und Farmers Delight sind eigene Kapitel und von Anfang an frei.", "Alles, was zu einem späteren Zeitalter gehört, ist noch gesperrt.", "", "&6So gehts", "Das Rezeptbuch (JEI) zeigt bei gesperrten Rezepten ein Schloss.", "Gesperrte Werkzeuge und Blöcke funktionieren nicht, gesperrte Dimensionen (Nether, Aether, Zwielichtwald, Ende) weisen dich am Portal ab.", "Fahre im Rezeptbuch oder im Inventar über ein gesperrtes Item: Der Infotext nennt das Zeitalter, das es freischaltet.", "", "&6Wofür ist das wichtig?", "Am Ende jedes Kapitels steht eine Zeitalter-Quest. Wer sie abschließt, schaltet das nächste Zeitalter für alle frei. Sprecht euch also ab!"]
			icon: { id: "minecraft:clock" }
			id: "093D637910111249"
			title: "Zeitalter verstehen"
			rewards: [{ id: "00AD3BE8A3E49C52", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "77CCCC73177623FD", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["093D637910111249"]
			description: ["&6Was ist das?", "Schritt 1: Halte den Mauszeiger im Inventar über ein Item.", "Schritt 2: Drücke R, um zu sehen, wie man es herstellt.", "Schritt 3: Drücke U, um zu sehen, wofür man es braucht.", "", "&6So gehts", "Fahre mit der Maus über ein Item und drücke R: So stellst du es her.", "Drücke U: Wofür man es braucht.", "Oben in der Suchleiste suchst du nach Namen. Mit @modname suchst du nach Mod, z.B. @create.", "", "&6Wofür ist das wichtig?", "Bei über 400 Mods kennt niemand alle Rezepte. Das Rezeptbuch (JEI) ist dein wichtigstes Werkzeug. Bei Create zeigt dir die Taste W außerdem eine Animation (Ponder)."]
			id: "76B62C313C1E5D43"
			hide_dependency_lines: true
			title: "Rezepte nachschlagen (JEI)"
			rewards: [{ id: "4E710640F0D99A73", type: "item", item: { id: "minecraft:bread", count: 4 } }]
			tasks: [{ id: "64C3B366C0CF146C", type: "checkmark" }]
			x: 3.00d
			y: -10.50d
		}
		{
			dependencies: ["76B62C313C1E5D43"]
			description: ["&6Was ist das?", "Schritt 1: Drücke M, um die Weltkarte (Xaero's) zu öffnen.", "Schritt 2: Die Minikarte oben im Bild zeigt dir, wo du bist.", "Tipp: Auf der Karte kannst du Wegpunkte setzen (Taste N).", "", "&6So gehts", "Drücke M für die große Weltkarte.", "Mit N öffnest du die Wegpunkt-Liste. Auf der Karte setzt du mit Rechtsklick einen Wegpunkt.", "Beim Tod wird automatisch ein Wegpunkt an der Todesstelle gesetzt.", "", "&6Wofür ist das wichtig?", "Setze Wegpunkte für Basis, Dörfer und Dungeons. Über die Karte sicherst du später auch deine Chunks (Open Parties and Claims)."]
			id: "31AE3D3C9B7D83E7"
			title: "Karte öffnen"
			rewards: [{ id: "03D17CACB594EFE3", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "0801B7B2B6063697", type: "checkmark" }]
			x: 4.50d
			y: -12.00d
		}
		{
			dependencies: ["31AE3D3C9B7D83E7"]
			description: ["&6Was ist das?", "Jade zeigt dir oben im Bild, was du gerade ansiehst: Block, Mod und Inhalt.", "Schau eine Kiste oder eine Maschine an, um es auszuprobieren.", "", "&6So gehts", "Schaue einfach einen Block oder ein Tier an.", "Bei Öfen und Maschinen siehst du den Fortschritt, bei Pflanzen das Wachstum.", "", "&6Wofür ist das wichtig?", "So erkennst du sofort, aus welcher Mod etwas kommt, und kannst es im Rezeptbuch nachschlagen."]
			id: "0B043FE1AA795723"
			title: "Alles im Blick (Jade)"
			rewards: [{ id: "457492C4DF6411DC", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "11A4F8DB7974D30D", type: "checkmark" }]
			x: 6.00d
			y: -12.00d
		}
		{
			dependencies: ["0B043FE1AA795723"]
			description: ["&6Was ist das?", "Viele Mods haben eigene Tasten.", "Schritt 1: Drücke Esc und gehe auf Optionen, Steuerung.", "Schritt 2: Oben gibt es eine Suchleiste. Tippe den Namen der Funktion ein.", "", "&6So gehts", "Esc, Optionen, Steuerung, Tastenbelegung.", "Oben ist eine Suchleiste. Tippe einen Namen ein, z.B. Rucksack.", "Wichtig: B Rucksack, U Quests, H Zubehör, M Karte, N Wegpunkte, R und U im Rezeptbuch.", "Im Questbuch (U) oben rechts die Nadel: aktuelle Quests am Bildrand.", "", "&6Wofür ist das wichtig?", "Wenn eine Taste nicht geht, schaue hier nach. Rote Tasten sind doppelt belegt."]
			id: "7E73FC1903ABEE32"
			title: "Tastenbelegung suchen"
			rewards: [{ id: "4A9AF60C1862B667", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "27AF029E4518988F", type: "checkmark" }]
			x: 7.50d
			y: -12.00d
		}
		{
			dependencies: ["093D637910111249"]
			description: ["&6Was ist das?", "Holz ist das erste Material in Minecraft. Aus Stämmen werden Bretter, aus Brettern Stöcke, Werkbank und Werkzeug.", "", "&6So gehts", "Schlage mit der Hand oder einer Axt auf einen Baumstamm, bis er abbricht.", "In der Werkbank (oder im 2x2-Feld im Inventar) wird ein Stamm zu vier Brettern.", "", "&6Wofür ist das wichtig?", "Du brauchst Holz für fast alles am Anfang: Werkbank, Kisten, Werkzeuge, Fackeln und später für Create-Wellen und Wasserräder.", "Tipp: Pflanze die Setzlinge wieder ein, dann geht dir das Holz nie aus.", "", "&6Gut zu wissen", "Eine Axt fällt Bäume deutlich schneller als die Hand. Pflanze für jeden gefällten Baum einen Setzling nach, dann wächst der Wald nach."]
			id: "5EC7640BCBDF892E"
			title: "Holz sammeln"
			rewards: [{ id: "0D44A1C6F6BC6D14", type: "item", item: { id: "minecraft:oak_log", count: 16 } }]
			tasks: [{ id: "3B679BF3502503F2", type: "item", item: { id: "minecraft:oak_log", count: 1 }, count: 8L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["5EC7640BCBDF892E"]
			description: ["&6Was ist das?", "Birken erkennst du an der weißen Rinde. Ihr Holz ist hell.", "", "&6So gehts", "Fälle Birken mit der Axt. Pflanze die Setzlinge wieder ein.", "", "&6Wofür ist das wichtig?", "Verschiedene Holzarten bringen verschiedene Farben für Bretter, Möbel und Deko."]
			id: "60D48C13E2FD3E4E"
			title: "Birkenholz"
			rewards: [{ id: "4859E0D3BD407BB3", type: "item", item: { id: "minecraft:apple", count: 4 } }]
			tasks: [{ id: "6E7A654E51D29D73", type: "item", item: { id: "minecraft:birch_log", count: 1 }, count: 16L }]
			x: 4.50d
			y: 6.00d
		}
		{
			dependencies: ["60D48C13E2FD3E4E"]
			description: ["&6Was ist das?", "Fichten wachsen in Taiga und Bergen. Große Fichten sind 2x2 Stämme dick.", "", "&6So gehts", "Fälle eine Fichte von unten nach oben. Blätter verschwinden dank Leaves Be Gone schnell.", "", "&6Wofür ist das wichtig?", "Fichtenholz ist dunkel und eignet sich für gemütliche Hütten."]
			id: "43FE5B6E4CDC40DE"
			title: "Fichtenholz"
			rewards: [{ id: "3E925D96D5EB07CD", type: "item", item: { id: "minecraft:torch", count: 8 } }]
			tasks: [{ id: "6F295C5E2E57D446", type: "item", item: { id: "minecraft:spruce_log", count: 1 }, count: 16L }]
			x: 6.00d
			y: 6.00d
		}
		{
			dependencies: ["5EC7640BCBDF892E"]
			description: ["&6Was ist das?", "Bretter sind das wichtigste Baumaterial am Anfang.", "", "&6So gehts", "Ein Stamm in der Werkbank ergibt vier Bretter. Im Sägewerk bekommst du mehr Treppen und Stufen.", "", "&6Wofür ist das wichtig?", "Kisten, Werkzeuge, Türen, Boote und Betten brauchen Bretter.", "", "&6Gut zu wissen", "Fast alle Rezepte akzeptieren jede Brettersorte, du musst also nicht auf die Holzart achten."]
			id: "0E282EEACBC50CE7"
			title: "Bretter"
			rewards: [{ id: "5DD111E360AC1F20", type: "item", item: { id: "minecraft:stick", count: 16 } }]
			tasks: [{ id: "409359707DCE88F2", type: "item", item: { id: "minecraft:oak_planks", count: 1 }, count: 64L }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["0E282EEACBC50CE7"]
			description: ["&6Was ist das?", "Stöcke sind Griffe für Werkzeuge, Fackeln und vieles mehr.", "", "&6So gehts", "Zwei Bretter übereinander in der Werkbank ergeben vier Stöcke.", "", "&6Wofür ist das wichtig?"]
			id: "3DE40AEC331BBC59"
			title: "Stöcke"
			rewards: [{ id: "6F12A1481B3EF6AF", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "45AEE27528D7508D", type: "item", item: { id: "minecraft:stick", count: 1 }, count: 32L }]
			x: 6.00d
			y: 1.50d
		}
		{
			dependencies: ["0E282EEACBC50CE7"]
			description: ["&6Was ist das?", "Die Werkbank hat ein 3x3-Feld. Die meisten Rezepte brauchen sie.", "", "&6So gehts", "Lege vier Bretter im Quadrat in das Crafting-Feld deines Inventars.", "Stelle die Werkbank auf und klicke sie mit Rechtsklick an.", "Mit dem Rezeptbuch (Taste R auf einem Item) siehst du jedes Rezept.", "", "&6Wofür ist das wichtig?", "Mit Werkzeug geht alles schneller. Die Belohnung ist eine Steinspitzhacke, damit kannst du gleich Stein und Kohle abbauen.", "Später: Mit Nearby Crafting nimmt die Werkbank Material direkt aus Kisten in der Nähe.", "", "&6Gut zu wissen", "Stelle in jede Basis eine Werkbank. Das grüne Rezeptbuch neben dem Raster legt die Zutaten für bekannte Rezepte automatisch aus."]
			id: "0394F82571C6DE85"
			title: "Werkbank bauen"
			rewards: [{ id: "6EED97054AD334F5", type: "item", item: { id: "minecraft:stone_pickaxe", count: 1 } }]
			tasks: [{ id: "3D64137EE4BB4B1D", type: "item", item: { id: "minecraft:crafting_table", count: 1 }, count: 1L }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["0394F82571C6DE85"]
			description: ["&6Was ist das?", "Die Holzspitzhacke ist das allererste Werkzeug.", "", "&6So gehts", "Drei Bretter oben, zwei Stöcke darunter.", "", "&6Wofür ist das wichtig?", "Mit ihr baust du Stein ab. Behalte sie: Die Steinspitzhacke braucht sie im Rezept.", "", "&6Gut zu wissen", "Werkzeuge haben eine begrenzte Haltbarkeit. Holz hält nur kurz, deshalb steigst du so schnell wie möglich auf Stein um."]
			id: "149718EF5100546D"
			title: "Holzwerkzeug"
			rewards: [{ id: "7F2046C5154ED497", type: "item", item: { id: "minecraft:apple", count: 4 } }]
			tasks: [{ id: "5A7DE28E745DE755", type: "item", item: { id: "minecraft:wooden_pickaxe", count: 1 }, count: 1L }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["43FE5B6E4CDC40DE"]
			description: ["&6Was ist das?", "Setzlinge fallen aus Blättern und wachsen zu neuen Bäumen.", "", "&6So gehts", "Pflanze sie auf Erde mit genug Licht und Platz. Knochenmehl lässt sie sofort wachsen.", "", "&6Wofür ist das wichtig?", "Eine kleine Baumfarm bei der Basis spart lange Wege."]
			id: "456B0331110261E0"
			title: "Setzlinge pflanzen"
			rewards: [{ id: "4AB429C7CCE3890C", type: "item", item: { id: "minecraft:bone_meal", count: 8 } }]
			tasks: [{ id: "26C9871077CE3E66", type: "item", item: { id: "minecraft:oak_sapling", count: 1 }, count: 8L }]
			x: 7.50d
