		}
		{
			dependencies: ["0ABE13F2F0EF54DA"]
			description: ["&6Was ist das?", "Skelette schießen aus der Ferne. Nutze Deckung.", "", "&6So gehts", "Nutze Deckung, gehe nah ran oder blocke mit dem Schild.", "", "&6Wofür ist das wichtig?", "Knochen ergeben Knochenmehl (Dünger) und Pfeile kannst du wiederverwenden."]
			id: "1CA526E157A15466"
