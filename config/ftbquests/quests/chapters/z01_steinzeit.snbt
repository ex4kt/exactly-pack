		}
		{
			dependencies: ["1799BD20B88CE4F4"]
			description: ["&6Was ist das?", "Du kannst Kisten, Öfen und sogar ein Tier tragen.", "Schritt 1: Leere Hände (nichts in der Hand halten).", "Schritt 2: Schleichen (Shift) und Rechtsklick auf den Block oder das Tier.", "Schritt 3: Rechtsklick auf den Boden, um es wieder abzusetzen.", "", "&6So gehts", "Hände leer machen (nichts in der Hand).", "Shift halten und Rechtsklick auf Kiste, Ofen oder Tier.", "Rechtsklick auf den Boden setzt es wieder ab.", "", "&6Wofür ist das wichtig?", "So ziehst du um, ohne Kisten auszuräumen. Tiere bringst du so leicht zu deiner Farm. Babys sind erlaubt, es geht immer nur ein Tier."]
			id: "7F5E45D4BAEF89D0"
			title: "Tragen mit Carry On"
			rewards: [{ id: "40EF884BF81B0279", type: "item", item: { id: "minecraft:chest", count: 2 } }]
			tasks: [{ id: "509D67D5318570CD", type: "checkmark" }]
			x: 21.00d
			y: 9.00d
		}
		{
			dependencies: ["04E3728EFBB0858D"]
			description: ["&6Was ist das?", "Ein Waystone ist ein Teleport-Punkt. Alle aktivierten Waystones sind miteinander verbunden.", "", "&6So gehts", "Baue einen Waystone (Rezept im Rezeptbuch) und stelle ihn auf.", "Rechtsklick aktiviert ihn. Ab dann kannst du von jedem anderen Waystone dorthin reisen.", "In Dörfern stehen oft schon Waystones, die du nur aktivieren musst.", "", "&6Wofür ist das wichtig?", "Die Welt ist riesig. Mit Waystones sparst du lange Wege zwischen Basis, Dorf, Nether-Portal und Dungeons."]
			id: "7E5061B34C079EF7"
			title: "Wegpunkt: Waystone"
