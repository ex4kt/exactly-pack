	title: "&7I. Steinzeit"
	quests: [
		{
			dependencies: ["32B584A362001F6A"]
			description: ["&6Was ist das?", "Exactly hat acht Zeitalter: Stein, Eisen, Diamant, Nether, Magie, Welten, Ende und Meister. Create, Immersive Engineering, Pneumatik und Farmers Delight sind eigene Kapitel und von Anfang an frei.", "Alles, was zu einem spaeteren Zeitalter gehoert, ist noch gesperrt.", "", "&6So gehts", "JEI zeigt bei gesperrten Rezepten ein Schloss.", "Gesperrte Werkzeuge und Bloecke funktionieren nicht, gesperrte Dimensionen (Nether, Aether, Zwielichtwald, Ende) weisen dich am Portal ab.", "Fahre in JEI oder im Inventar ueber ein gesperrtes Item: Der Tooltip nennt das Zeitalter, das es freischaltet.", "", "&6Wofuer ist das wichtig?", "Am Ende jedes Kapitels steht eine Zeitalter-Quest. Wer sie abschliesst, schaltet das naechste Zeitalter fuer alle frei. Sprecht euch also ab!"]
			icon: { id: "minecraft:clock" }
			id: "093D637910111249"
			title: "Zeitalter verstehen"
			rewards: [{ id: "00AD3BE8A3E49C52", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "77CCCC73177623FD", type: "checkmark" }]
			x: 1.5d
			y: 0.0d
		}
		{
			dependencies: ["093D637910111249"]
			hide_dependency_lines: true
			description: ["&6Was ist das?", "Schritt 1: Halte den Mauszeiger im Inventar ueber ein Item.", "Schritt 2: Druecke R, um zu sehen, wie man es herstellt.", "Schritt 3: Druecke U, um zu sehen, wofuer man es braucht.", "", "&6So gehts", "Fahre mit der Maus ueber ein Item und druecke R: So stellst du es her.", "Druecke U: Wofuer man es braucht.", "Oben in der Suchleiste suchst du nach Namen. Mit @modname suchst du nach Mod, z.B. @create.", "", "&6Wofuer ist das wichtig?", "Bei ueber 400 Mods kennt niemand alle Rezepte. JEI ist dein wichtigstes Werkzeug. Bei Create zeigt dir die Taste W ausserdem eine Animation (Ponder)."]
			id: "76B62C313C1E5D43"
			title: "Rezepte nachschlagen (JEI)"
			rewards: [{ id: "4E710640F0D99A73", type: "item", item: { id: "minecraft:bread", count: 4 } }]
			tasks: [{ id: "64C3B366C0CF146C", type: "checkmark" }]
			x: 1.5d
			y: 33.5d
		}
		{
			dependencies: ["76B62C313C1E5D43"]
			description: ["&6Was ist das?", "Schritt 1: Druecke M, um die Weltkarte (Xaeros) zu oeffnen.", "Schritt 2: Die Minikarte oben im Bild zeigt dir, wo du bist.", "Tipp: Auf der Karte kannst du Wegpunkte setzen (Taste N).", "", "&6So gehts", "Druecke M fuer die grosse Weltkarte.", "Mit N oeffnest du die Wegpunkt-Liste. Auf der Karte setzt du mit Rechtsklick einen Wegpunkt.", "Beim Tod wird automatisch ein Wegpunkt an der Todesstelle gesetzt.", "", "&6Wofuer ist das wichtig?", "Setze Wegpunkte fuer Basis, Doerfer und Dungeons. Ueber die Karte sicherst du spaeter auch deine Chunks (Open Parties and Claims)."]
			id: "31AE3D3C9B7D83E7"
			title: "Karte oeffnen"
			rewards: [{ id: "03D17CACB594EFE3", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "0801B7B2B6063697", type: "checkmark" }]
			x: 3.0d
			y: 33.5d
		}
		{
			dependencies: ["31AE3D3C9B7D83E7"]
			description: ["&6Was ist das?", "Jade zeigt dir oben im Bild, was du gerade ansiehst: Block, Mod und Inhalt.", "Schau eine Kiste oder eine Maschine an, um es auszuprobieren.", "", "&6So gehts", "Schaue einfach einen Block oder ein Tier an.", "Bei Oefen und Maschinen siehst du den Fortschritt, bei Pflanzen das Wachstum.", "", "&6Wofuer ist das wichtig?", "So erkennst du sofort, aus welcher Mod etwas kommt, und kannst es in JEI nachschlagen."]
			id: "0B043FE1AA795723"
			title: "Alles im Blick (Jade)"
			rewards: [{ id: "457492C4DF6411DC", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "11A4F8DB7974D30D", type: "checkmark" }]
			x: 4.5d
			y: 33.5d
		}
		{
			dependencies: ["0B043FE1AA795723"]
			description: ["&6Was ist das?", "Viele Mods haben eigene Tasten.", "Schritt 1: Druecke Esc und gehe auf Optionen, Steuerung.", "Schritt 2: Oben gibt es eine Suchleiste. Tippe den Namen der Funktion ein.", "", "&6So gehts", "Esc, Optionen, Steuerung, Tastenbelegung.", "Oben ist eine Suchleiste. Tippe einen Namen ein, z.B. Rucksack.", "Wichtig: B Rucksack, U Quests, M Karte, N Wegpunkte, R und U in JEI.", "", "&6Wofuer ist das wichtig?", "Wenn eine Taste nicht geht, schaue hier nach. Rote Tasten sind doppelt belegt."]
			id: "7E73FC1903ABEE32"
			title: "Tastenbelegung suchen"
			rewards: [{ id: "4A9AF60C1862B667", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "27AF029E4518988F", type: "checkmark" }]
			x: 6.0d
			y: 33.5d
		}
		{
			dependencies: ["093D637910111249"]
			description: ["&6Was ist das?", "Holz ist das erste Material in Minecraft. Aus Staemmen werden Bretter, aus Brettern Stoecke, Werkbank und Werkzeug.", "", "&6So gehts", "Schlage mit der Hand oder einer Axt auf einen Baumstamm, bis er abbricht.", "In der Werkbank (oder im 2x2-Feld im Inventar) wird ein Stamm zu vier Brettern.", "", "&6Wofuer ist das wichtig?", "Du brauchst Holz fuer fast alles am Anfang: Werkbank, Kisten, Werkzeuge, Fackeln und spaeter fuer Create-Wellen und Wasserraeder.", "Tipp: Pflanze die Setzlinge wieder ein, dann geht dir das Holz nie aus.", "", "&6Gut zu wissen", "Eine Axt faellt Baeume deutlich schneller als die Hand. Pflanze fuer jeden gefaellten Baum einen Setzling nach, dann waechst der Wald nach."]
			id: "5EC7640BCBDF892E"
			title: "Holz sammeln"
			rewards: [{ id: "0D44A1C6F6BC6D14", type: "item", item: { id: "minecraft:oak_log", count: 16 } }]
			tasks: [{ id: "3B679BF3502503F2", type: "item", item: { id: "minecraft:oak_log", count: 1 }, count: 8L }]
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["5EC7640BCBDF892E"]
			hide_dependency_lines: true
			description: ["&6Was ist das?", "Birken erkennst du an der weissen Rinde. Ihr Holz ist hell.", "", "&6So gehts", "Faelle Birken mit der Axt. Pflanze die Setzlinge wieder ein.", "", "&6Wofuer ist das wichtig?", "Verschiedene Holzarten bringen verschiedene Farben fuer Bretter, Moebel und Deko."]
			id: "60D48C13E2FD3E4E"
			title: "Birkenholz"
			rewards: [{ id: "4859E0D3BD407BB3", type: "item", item: { id: "minecraft:apple", count: 4 } }]
			tasks: [{ id: "6E7A654E51D29D73", type: "item", item: { id: "minecraft:birch_log", count: 1 }, count: 16L }]
			x: 3.0d
			y: 30.0d
		}
		{
			dependencies: ["60D48C13E2FD3E4E"]
			description: ["&6Was ist das?", "Fichten wachsen in Taiga und Bergen. Grosse Fichten sind 2x2 Staemme dick.", "", "&6So gehts", "Faelle eine Fichte von unten nach oben. Blaetter verschwinden dank Leaves Be Gone schnell.", "", "&6Wofuer ist das wichtig?", "Fichtenholz ist dunkel und eignet sich fuer gemuetliche Huetten."]
			id: "43FE5B6E4CDC40DE"
			title: "Fichtenholz"
			rewards: [{ id: "3E925D96D5EB07CD", type: "item", item: { id: "minecraft:torch", count: 8 } }]
			tasks: [{ id: "6F295C5E2E57D446", type: "item", item: { id: "minecraft:spruce_log", count: 1 }, count: 16L }]
			x: 4.5d
			y: 30.0d
		}
		{
			dependencies: ["5EC7640BCBDF892E"]
			description: ["&6Was ist das?", "Bretter sind das wichtigste Baumaterial am Anfang.", "", "&6So gehts", "Ein Stamm in der Werkbank ergibt vier Bretter. Im Saegewerk bekommst du mehr Treppen und Stufen.", "", "&6Wofuer ist das wichtig?", "Kisten, Werkzeuge, Tueren, Boote und Betten brauchen Bretter.", "", "&6Gut zu wissen", "Fast alle Rezepte akzeptieren jede Brettersorte, du musst also nicht auf die Holzart achten."]
			id: "0E282EEACBC50CE7"
			title: "Bretter"
			rewards: [{ id: "5DD111E360AC1F20", type: "item", item: { id: "minecraft:stick", count: 16 } }]
			tasks: [{ id: "409359707DCE88F2", type: "item", item: { id: "minecraft:oak_planks", count: 1 }, count: 64L }]
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["0E282EEACBC50CE7"]
			hide_dependency_lines: true
			description: ["&6Was ist das?", "Stoecke sind Griffe fuer Werkzeuge, Fackeln und vieles mehr.", "", "&6So gehts", "Zwei Bretter uebereinander in der Werkbank ergeben vier Stoecke.", "", "&6Wofuer ist das wichtig?", "Achtung Fortschritt: Bessere Werkzeuge brauchen spaeter statt eines Stocks das Werkzeug der vorherigen Stufe."]
			id: "3DE40AEC331BBC59"
			title: "Stoecke"
			rewards: [{ id: "6F12A1481B3EF6AF", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "45AEE27528D7508D", type: "item", item: { id: "minecraft:stick", count: 1 }, count: 32L }]
			x: 1.5d
			y: 30.0d
		}
		{
			dependencies: ["0E282EEACBC50CE7"]
			description: ["&6Was ist das?", "Die Werkbank hat ein 3x3-Feld. Die meisten Rezepte brauchen sie.", "", "&6So gehts", "Lege vier Bretter im Quadrat in das Crafting-Feld deines Inventars.", "Stelle die Werkbank auf und klicke sie mit Rechtsklick an.", "Mit JEI (Taste R auf einem Item) siehst du jedes Rezept.", "Fortschritt: Werkzeuge und Waffen baust du Stufe fuer Stufe. Holz, dann Stein, dann Eisen, dann Diamant. Jede Stufe braucht das Werkzeug der vorherigen im Rezept, also wirf alte Werkzeuge nicht weg.", "", "&6Wofuer ist das wichtig?", "Mit Werkzeug geht alles schneller. Die Belohnung ist eine Steinspitzhacke, damit kannst du gleich Stein und Kohle abbauen.", "Spaeter: Mit Nearby Crafting nimmt die Werkbank Material direkt aus Kisten in der Naehe.", "", "&6Gut zu wissen", "Stelle in jede Basis eine Werkbank. Das gruene Rezeptbuch neben dem Raster legt die Zutaten fuer bekannte Rezepte automatisch aus."]
			id: "0394F82571C6DE85"
			title: "Werkbank bauen"
			rewards: [{ id: "6EED97054AD334F5", type: "item", item: { id: "minecraft:stone_pickaxe", count: 1 } }]
			tasks: [{ id: "3D64137EE4BB4B1D", type: "item", item: { id: "minecraft:crafting_table", count: 1 }, count: 1L }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["0394F82571C6DE85"]
			description: ["&6Was ist das?", "Die Holzspitzhacke ist das allererste Werkzeug.", "", "&6So gehts", "Drei Bretter oben, zwei Stoecke darunter.", "", "&6Wofuer ist das wichtig?", "Mit ihr baust du Stein ab. Behalte sie: Die Steinspitzhacke braucht sie im Rezept.", "", "&6Gut zu wissen", "Werkzeuge haben eine begrenzte Haltbarkeit. Holz haelt nur kurz, deshalb steigst du so schnell wie moeglich auf Stein um."]
			id: "149718EF5100546D"
			title: "Holzwerkzeug"
			rewards: [{ id: "7F2046C5154ED497", type: "item", item: { id: "minecraft:apple", count: 4 } }]
			tasks: [{ id: "5A7DE28E745DE755", type: "item", item: { id: "minecraft:wooden_pickaxe", count: 1 }, count: 1L }]
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["43FE5B6E4CDC40DE"]
			description: ["&6Was ist das?", "Setzlinge fallen aus Blaettern und wachsen zu neuen Baeumen.", "", "&6So gehts", "Pflanze sie auf Erde mit genug Licht und Platz. Knochenmehl laesst sie sofort wachsen.", "", "&6Wofuer ist das wichtig?", "Eine kleine Baumfarm bei der Basis spart lange Wege."]
			id: "456B0331110261E0"
			title: "Setzlinge pflanzen"
			rewards: [{ id: "4AB429C7CCE3890C", type: "item", item: { id: "minecraft:bone_meal", count: 8 } }]
			tasks: [{ id: "26C9871077CE3E66", type: "item", item: { id: "minecraft:oak_sapling", count: 1 }, count: 8L }]
			x: 6.0d
			y: 30.0d
		}
		{
			dependencies: ["0394F82571C6DE85"]
			hide_dependency_lines: true
			description: ["&6Was ist das?", "Du kannst mit Items aus Kisten in der Naehe craften.", "Schritt 1: Stelle eine Werkbank neben deine Kisten (bis etwa 8 Bloecke).", "Schritt 2: Oeffne sie. Items aus den Kisten stehen zum Craften bereit.", "", "&6So gehts", "Stelle Kisten neben deine Werkbank und oeffne sie.", "JEI-Rezepte mit dem Plus-Knopf fuellen sich dann aus den Kisten.", "", "&6Wofuer ist das wichtig?", "Du musst nicht mehr alles ins Inventar holen. Perfekt fuer eine Werkstatt."]
			id: "000FE9D86692D537"
			title: "Nearby Crafting"
			rewards: [{ id: "1B0D19B092BFA40E", type: "xp_levels", xp_levels: 2 }]
