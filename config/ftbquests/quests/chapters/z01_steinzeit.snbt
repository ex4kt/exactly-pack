			x: 13.50d
			y: 9.00d
		}
		{
			dependencies: ["06ABC2FF817AB74D"]
			description: ["&6Was ist das?", "Client Sort und Inventory Profiles Next sortieren dein Inventar und Kisten.", "Client Sort: Shift und mittlere Maustaste.", "", "&6So gehts", "Öffne eine Kiste. Rechts oben erscheinen kleine Knöpfe zum Sortieren.", "Mit Client Sort: Shift halten und mittlere Maustaste im Inventar.", "", "&6Wofür ist das wichtig?", "Spart viel Zeit. Mit Profilen kannst du auch Ausrüstungs-Sets schnell wechseln."]
			id: "0C6A9776F573027A"
			title: "Inventar sortieren"
			rewards: [{ id: "427D9B12C89E687E", type: "xp_levels", xp_levels: 1 }]
