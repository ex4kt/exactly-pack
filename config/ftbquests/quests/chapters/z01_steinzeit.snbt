		}
		{
			dependencies: ["0394F82571C6DE85"]
			description: ["&6Was ist das?", "Du kannst mit Items aus Kisten in der Nähe herstellen.", "Schritt 1: Stelle eine Werkbank neben deine Kisten (bis etwa 8 Blöcke).", "Schritt 2: Öffne sie. Items aus den Kisten stehen zum Craften bereit.", "", "&6So gehts", "Stelle Kisten neben deine Werkbank und öffne sie.", "Rezept aus dem Rezeptbuche mit dem Plus-Knopf füllen sich dann aus den Kisten.", "", "&6Wofür ist das wichtig?", "Du musst nicht mehr alles ins Inventar holen. Perfekt für eine Werkstatt."]
			id: "000FE9D86692D537"
			hide_dependency_lines: true
			title: "Nearby Crafting"
			rewards: [{ id: "1B0D19B092BFA40E", type: "xp_levels", xp_levels: 2 }]
