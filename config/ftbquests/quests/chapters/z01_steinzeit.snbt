		}
		{
			dependencies: ["24B25DD1BE315360"]
			description: ["&6Was ist das?", "Creeper explodieren. Halte Abstand und schlage zu.", "", "&6So gehts", "Schlag zu und weiche sofort zurueck, bevor er zischt. Ein Schild blockt die Explosion.", "Mit Bogen oder Muskete aus der Ferne ist es am sichersten.", "", "&6Wofuer ist das wichtig?", "Schwarzpulver brauchst du fuer TNT, Feuerwerk (Elytra-Flug) und Munition."]
			id: "0ABE13F2F0EF54DA"
			title: "Der Creeper-Jaeger"
			rewards: [{ id: "7318882164C57F16", type: "item", item: { id: "minecraft:golden_apple", count: 1 } }]
			tasks: [{ id: "26133EADAA34006C", type: "kill", entity: "minecraft:creeper", value: 5L, icon: { id: "minecraft:gunpowder" } }]
			x: 4.5d
			y: 6.5d
		}
		{
			dependencies: ["0ABE13F2F0EF54DA"]
			description: ["&6Was ist das?", "Skelette schiessen aus der Ferne. Nutze Deckung.", "", "&6So gehts", "Nutze Deckung, gehe nah ran oder blocke mit dem Schild.", "", "&6Wofuer ist das wichtig?", "Knochen ergeben Knochenmehl (Duenger) und Pfeile kannst du wiederverwenden."]
			id: "1CA526E157A15466"
