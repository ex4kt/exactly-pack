			rewards: [{ id: "30526571B5D635A2", type: "item", item: { id: "minecraft:oak_planks", count: 16 } }]
			tasks: [{ id: "2ECF0F2BE58A1FC9", type: "item", item: { id: "minecraft:chest", count: 1 }, count: 1L }]
			x: 4.5d
