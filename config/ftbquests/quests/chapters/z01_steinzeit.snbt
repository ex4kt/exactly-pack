		{
			dependencies: ["76B62C313C1E5D43"]
			description: ["&6Was ist das?", "Eine Gruppe (Party) teilt Schutz und Rechte.", "Schritt 1: Gib im Chat /openpac-parties ein. Dort siehst du die Befehle.", "Schritt 2: Lade Freunde ein.", "", "&6So gehts", "Gib im Chat /openpac-parties create ein oder nutze das Menü mit F8.", "Lade deine Freunde ein, sie nehmen mit dem Befehl im Chat an.", "", "&6Wofür ist das wichtig?", "Mit Gruppe könnt ihr gemeinsam in euren Claims bauen und eure Basis zusammen schützen."]
			id: "05A8F87077230637"
			title: "Gruppe gründen"
			rewards: [{ id: "3179A35CAD085AC1", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "449C735BCC08F21C", type: "checkmark" }]
			x: 4.50d
			y: -10.50d
		}
		{
			dependencies: ["05A8F87077230637"]
			description: ["&6Was ist das?", "Mit Open Parties and Claims schützt du dein Gebiet.", "Schritt 1: Öffne die Weltkarte (M).", "Schritt 2: Wähle Chunks (Weltabschnitte) aus und beanspruche sie.", "Nur du und deine Gruppe dürft dort bauen.", "", "&6So gehts", "Öffne die Weltkarte mit M.", "Rechtsklick auf die Karte, dann Claim wählen. Oder ziehe einen Bereich auf.", "Mit F8 öffnest du das Menü von Open Parties and Claims.", "", "&6Wofür ist das wichtig?", "Schützt deine Basis vor Explosionen, Griefing und Monstern, die Blöcke klauen."]
			id: "7D950ED7E0CB9950"
			title: "Chunks sichern"
			rewards: [{ id: "760673DC7DE7B63D", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "206FFC72C8F303A4", type: "checkmark" }]
			x: 6.00d
