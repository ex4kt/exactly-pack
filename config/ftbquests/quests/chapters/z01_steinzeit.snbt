			x: 28.5d
			y: 0.0d
		}
		{
			dependencies: ["7530D2695E6CB2F2"]
			description: ["&6Was ist das?", "Eisenerz hat beige Punkte. Mit der Steinspitzhacke abbauen.", "", "&6So gehts", "Mit der Steinspitzhacke abbauen. Viel Eisen liegt um Ebene 16 und hoch in Bergen.", "", "&6Wofuer ist das wichtig?", "Schmelze es im Ofen. Fuer die Eisenzeit brauchst du 16 Eisenbarren.", "", "&6Gut zu wissen", "Eisen liegt besonders oft in Hoehlen und Bergen. Roheisen musst du im Ofen schmelzen, bevor du es verwenden kannst."]
			id: "3E8BC412CE4C06F1"
			title: "Roheisen"
			rewards: [{ id: "10FC83FA8BED6D11", type: "item", item: { id: "minecraft:iron_nugget", count: 12 } }]
			tasks: [{ id: "5C1813D52026B033", type: "item", item: { id: "minecraft:raw_iron", count: 1 }, count: 16L }]
			x: 30.0d
			y: 0.0d
		}
		{
			dependencies: ["3E8BC412CE4C06F1"]
			description: ["&6Was ist das?", "Eisen findest du in Hoehlen und Bergen. Schmelze es im Ofen.", "", "&6So gehts", "Roheisen im Ofen schmelzen. Sammle mindestens 16 Barren.", "", "&6Wofuer ist das wichtig?", "Mit 16 Eisenbarren und den Pflicht-Zweigen schaltest du rechts die Eisenzeit frei."]
			id: "5A652BEF93A71F4D"
			title: "Eisen!"
			rewards: [{ id: "7289F77FC744A085", type: "item", item: { id: "minecraft:iron_ingot", count: 8 } }]
			tasks: [{ id: "074A6908421C1CE1", type: "item", item: { id: "minecraft:iron_ingot", count: 1 }, count: 16L }]
			x: 31.5d
			y: 0.0d
		}
		{
			description: ["&6Was ist das?", "Das ist dein Questbuch (Taste U). Exactly wird in Zeitaltern gespielt: von der Steinzeit bis zum Meister-Zeitalter.", "Jedes Zeitalter ist ein Baum: Von dieser Startquest gehen Zweige ab, zum Beispiel Holz, Stein, Nahrung, Kochen, Zuhause, Reisen und Bergbau.", "", "&6So gehts", "Waehle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Items werden automatisch erkannt. Bei Quests mit Haken klickst du selbst auf den Haken.", "Belohnungen holst du mit einem Klick auf die Truhe in der Quest ab.", "", "&6Wofuer ist das wichtig?", "Ganz rechts steht die Abschluss-Quest. Fuer die Eisenzeit brauchst du die Pflicht-Zweige und 16 Eisenbarren.", "Waffen, Werkzeuge, Ruestungen und Fernkampf findest du als eigene Reihen in jedem Zeitalter. Kleine Mods und Im Hintergrund sind immer offen."]
			id: "32B584A362001F6A"
			title: "Willkommen bei Exactly"
			rewards: [{ id: "020ACE76080D4E35", type: "item", item: { id: "minecraft:bread", count: 8 } }]
			tasks: [{ id: "1B8905CD6A6A07B0", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5A652BEF93A71F4D"]
			description: ["&6Was ist das?", "Hier beginnt die Eisenzeit. Sie schaltet frei: Eisenwerkzeug und -ruestung, Schild, Schmelzofen, Amboss, Toms Storage und die Eisenwaffen von Simply Swords.", "", "&6So gehts", "Schliesse die Pflicht-Zweige ab: Holz, Stein, Nahrung, Kochen und Bergbau.", "Habe 16 Eisenbarren im Inventar und hol dir die Belohnung.", "Das gilt sofort fuer alle Spieler.", "", "&6Wofuer ist das wichtig?", "Danach oeffnet sich das Kapitel Eisenzeit."]
			icon: { id: "minecraft:iron_ingot" }
			id: "383D2644464FE272"
			title: "Zeitalter: Eisenzeit"
			rewards: [{ id: "53F97DDED346654E", type: "historystages:history_stage", stage: "eisenzeit", remove: false, individual: false }, { id: "2F0F0595DF1A4F1B", type: "xp_levels", xp_levels: 5 }, { id: "5E1A7E00C0FFEE01", type: "item", item: { id: "minecraft:golden_apple", count: 2 } }]
			tasks: [{ id: "6102DD31983CB9FE", type: "item", item: { id: "minecraft:iron_ingot", count: 1 }, count: 16L }]
			shape: "hexagon"
			size: 1.5d
			x: 33.0d
			y: 0.0d
		}
		{
			dependencies: ["60B557A4BAD57D69"]
			description: ["&6Was ist das?", "Braucht Pfeile. Mit Verzauberungen wie Staerke und Unendlichkeit.", "Aus der Mod Minecraft.", "", "&6So gehts", "Rezept oder Fundort: Item mit R in JEI nachschlagen. Einzigartige Waffen gibt es nur als Beute oder von Bossen.", "Fortschritt: Schwerter von Vanilla, Aether und Simply Swords baust du Stufe fuer Stufe. Die naechste Stufe braucht die vorherige Waffe im Rezept.", "Better Combat: Jede Waffenart hat eigene Kombos. Teste sie an der Trainingspuppe, der Tooltip zeigt Schaden und Tempo.", "", "&6Wofuer ist das wichtig?", "Je staerker die Waffe, desto leichter die Bosse. Gute Verzauberungen: Schaerfe, Pluenderung, Haltbarkeit, Reparatur."]
			icon: { id: "minecraft:bow" }
			id: "55EF779DF279FBD5"
			title: "Bogen (Arsenal)"
			rewards: []
			tasks: [{ id: "2D02434E53530AFD", type: "item", item: { id: "minecraft:bow", count: 1 }, count: 1L }]
			x: 1.5d
