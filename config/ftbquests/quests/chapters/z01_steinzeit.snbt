		{
			dependencies: ["5EDD66726A8CB055"]
			description: ["&6Was ist das?", "Leder von Kuehen ergibt die erste Ruestung.", "", "&6So gehts", "Leder von Kuehen. Fuenf, acht, sieben oder vier Leder fuer die Teile.", "", "&6Wofuer ist das wichtig?", "Etwas Schutz fuer die ersten Naechte. In der Eisenzeit folgt Eisenruestung."]
			id: "4CC791F37478A527"
			title: "Lederruestung"
