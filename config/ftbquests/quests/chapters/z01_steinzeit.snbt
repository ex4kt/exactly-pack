		{
			dependencies: ["0C6A9776F573027A"]
			description: ["&6Was ist das?", "Türen halten Zombies nicht immer ab, aber die meisten Monster.", "", "&6So gehts", "Sechs Bretter in zwei Spalten. Zwei nebeneinander öffnen sich zusammen.", "", "&6Wofür ist das wichtig?", "Halte Monster draußen. Achtung: Zombies können Holztüren auf Schwierigkeit Schwer einschlagen."]
			id: "730075A86BE3CD99"
