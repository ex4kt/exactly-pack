		}
		{
			dependencies: ["60B557A4BAD57D69"]
			description: ["&6Was ist das?", "Kupfer ist das häufigste Metall in den Höhlen.", "", "&6So gehts", "Kupfererz mit der Steinspitzhacke abbauen.", "", "&6Wofür ist das wichtig?", "Kupfer brauchst du später für Create, Blitzableiter und Fernrohre."]
			id: "00C24655867A56D6"
