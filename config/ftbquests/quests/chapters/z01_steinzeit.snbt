		{
			dependencies: ["5A685565E72C4410"]
			description: ["&6Was ist das?", "Waffen haben eigene Schwuenge und Treffer.", "Schritt 1: Halte eine Waffe in der Hand.", "Schritt 2: Klicke zum Schlagen. Mehrere Klicks machen eine Kombination.", "", "&6So gehts", "Halte die linke Maustaste fuer Kombos.", "Zweihaender treffen mehrere Gegner, zwei Einhandwaffen schlagen abwechselnd.", "", "&6Wofuer ist das wichtig?", "Die richtige Waffe fuer jede Situation."]
			id: "38A3C7968505D99D"
