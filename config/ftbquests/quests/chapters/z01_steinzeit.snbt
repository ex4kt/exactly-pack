		}
		{
			dependencies: ["3E7ABB28E4C6BBE5"]
			description: ["&6Was ist das?", "Ein Schlafsack setzt deinen Spawnpunkt nicht neu. Er ist perfekt für Ausflüge.", "Schritt 1: Lege drei gleichfarbige Wolle in eine Reihe in die Werkbank.", "Schritt 2: Platziere den Schlafsack und lege dich hinein.", "Hinweis: Du kannst allein schlafen. Die Nacht wird schneller, je mehr Spieler im Bett oder Schlafsack liegen.", "", "&6So gehts", "Drei gleichfarbige Wolle in eine Reihe legen.", "Schlafsack auf den Boden stellen und hineinlegen.", "", "&6Wofür ist das wichtig?", "Auf langen Ausflügen kannst du schlafen, ohne dass du nach dem Tod weit weg von zu Hause aufwachst."]
			id: "1799BD20B88CE4F4"
			title: "Schlafen mit Comforts"
			rewards: [{ id: "3563618D029E7D7A", type: "xp_levels", xp_levels: 2 }]
