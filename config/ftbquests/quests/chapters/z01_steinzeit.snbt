		{
			dependencies: ["7530D2695E6CB2F2"]
			description: ["&6Was ist das?", "Eisenerz hat beige Punkte. Mit der Steinspitzhacke abbauen.", "", "&6So gehts", "Mit der Steinspitzhacke abbauen. Viel Eisen liegt um Ebene 16 und hoch in Bergen.", "", "&6Wofür ist das wichtig?", "Schmelze es im Ofen. Für die Eisenzeit brauchst du 16 Eisenbarren.", "", "&6Gut zu wissen", "Eisen liegt besonders oft in Höhlen und Bergen. Roheisen musst du im Ofen schmelzen, bevor du es verwenden kannst."]
			id: "3E8BC412CE4C06F1"
			title: "Roheisen"
			rewards: [{ id: "10FC83FA8BED6D11", type: "item", item: { id: "minecraft:iron_nugget", count: 12 } }]
			tasks: [{ id: "5C1813D52026B033", type: "item", item: { id: "minecraft:raw_iron", count: 1 }, count: 16L }]
			x: 30.00d
			y: 0.00d
		}
		{
			dependencies: ["3E8BC412CE4C06F1"]
			description: ["&6Was ist das?", "Eisen findest du in Höhlen und Bergen. Schmelze es im Ofen.", "", "&6So gehts", "Roheisen im Ofen schmelzen. Sammle mindestens 16 Barren.", "", "&6Wofür ist das wichtig?", "Mit 16 Eisenbarren und den Pflicht-Zweigen schaltest du rechts die Eisenzeit frei."]
			id: "5A652BEF93A71F4D"
			title: "Eisen!"
			rewards: [{ id: "7289F77FC744A085", type: "item", item: { id: "minecraft:iron_ingot", count: 8 } }]
