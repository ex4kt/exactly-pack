	title: "&bCC: Tweaked - Programmieren"
	quests: [
		{
			description: ["&6Was ist das?", "Dieses Kapitel bringt dir das Programmieren mit CC: Tweaked bei, Schritt für Schritt. Du brauchst keine Vorkenntnisse.", "Computer und Turtles (kleine Roboter) führen Programme aus, die du in der Sprache Lua schreibst.", "", "&6So gehts", "Arbeite die Quests der Reihe nach durch. Jede Quest erklärt ein Stück Programmierung und gibt dir Beispielcode.", "Code-Zeilen sind blau geschrieben. Tippe sie genau so in den Computer ein.", "Strg ist die Steuerungstaste (Ctrl) auf deiner Tastatur.", "", "&6Wofür ist das wichtig?", "Mit Programmen automatisierst du Türen, Farmen, Lagerhallen und Bergbau, auch dann, wenn du nicht dabei bist."]
			icon: { id: "computercraft:computer_normal" }
			id: "0582499342732963"
			title: "CC: Tweaked - Programmieren"
			rewards: [{ id: "2C9E84502EBFC22F", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "5BDE110239FDAC3C", type: "checkmark" }]
			x: 0.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Der Computer ist ein Block mit einem kleinen Bildschirm. Darauf läuft ein Betriebssystem, in dem du Befehle eintippst.", "", "&6So gehts", "Baue einen Computer. Das Rezept siehst du im Rezeptbuch, indem du auf das Item klickst und R drückst.", "Stelle ihn auf den Boden. Rechtsklick öffnet sein Terminal. Mit dem Ein-Schalter im Fenster oder mit Strg+R startet er.", "Mit der Maus kannst du im Terminal nichts anklicken, alles läuft über die Tastatur.", "", "&6Wofür ist das wichtig?", "Der Computer ist das Gehirn für alles Weitere in diesem Kapitel."]
			icon: { id: "computercraft:computer_normal" }
			dependencies: ["0582499342732963"]
			id: "513C44676E8366E2"
			title: "Der Computer"
			rewards: [{ id: "284D541B6C264D16", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "308593A8785BB939", type: "item", item: { id: "computercraft:computer_normal", count: 1 }, count: 1L }]
			x: 1.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Im Terminal gibst du Befehle ein und bestätigst sie mit der Enter-Taste.", "", "&6So gehts", "Probiere diese Befehle aus:", "&bhelp          zeigt Hilfe-Themen", "&bls            zeigt die Dateien auf dem Computer", "&bclear         leert den Bildschirm", "&blabel set Hans  gibt dem Computer den Namen Hans", "Wichtige Tastenkürzel (jeweils eine Sekunde gedrückt halten):", "Strg+T beendet das laufende Programm.", "Strg+S schaltet den Computer aus.", "Strg+R startet ihn neu.", "", "&6Wofür ist das wichtig?", "Wenn ein Programm hängt, rettet dich Strg+T. Hake die Aufgabe ab, wenn du die Befehle probiert hast."]
			icon: { id: "minecraft:writable_book" }
			dependencies: ["513C44676E8366E2"]
			id: "4B5233CCD8637456"
			title: "Das Terminal"
			rewards: [{ id: "6138413AC935FD16", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "7E3DEFA2508EC1B5", type: "checkmark" }]
			x: 3.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Ein Programm ist eine Textdatei mit Anweisungen. Der Editor heißt edit.", "", "&6So gehts", "Tippe im Terminal:", "&bedit hallo", "Schreibe in den Editor diese Zeile:", "&bprint('Hallo Welt!')", "Drücke Strg, wähle im Menü Save (Speichern), dann Exit (Beenden).", "Starte das Programm mit:", "&bhallo", "Der Text erscheint auf dem Bildschirm.", "", "&6Wofür ist das wichtig?", "Jedes Programm in diesem Kapitel entsteht auf diese Weise: edit Name, Code schreiben, speichern, Name eintippen."]
			icon: { id: "minecraft:paper" }
			dependencies: ["4B5233CCD8637456"]
			id: "0BA6B60CEF207BA0"
			title: "Erstes Programm"
			rewards: [{ id: "7D4B6C8709BD064D", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "7DB02A40FE4ECE07", type: "checkmark" }]
			x: 4.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Eine Variable ist ein Platz mit einem Namen, in dem du einen Wert speicherst. Lua rechnet mit +, -, *, / und ^ für Potenzen.", "", "&6So gehts", "Neues Programm mit edit rechnen:", "&blocal a = 5", "&blocal b = 3", "&bprint(a + b)", "&bprint(a * b)", "&blocal name = 'Alex'", "&bprint('Hallo ' .. name)", "Zwei Punkte (..) hängen Texte aneinander.", "Das Wort local sagt: Die Variable gilt nur in diesem Programm.", "", "&6Wofür ist das wichtig?", "Mit Variablen merkst du dir Zahlen und Namen, zum Beispiel wie viele Kisten gefüllt sind."]
			icon: { id: "minecraft:book" }
			dependencies: ["0BA6B60CEF207BA0"]
			id: "1278474BB4CEEE9C"
			title: "Variablen und Rechnen"
			rewards: [{ id: "56D9D92617AF929A", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "1684DF9CB57347CD", type: "checkmark" }]
			x: 6.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Programme können dich etwas fragen. Die Antwort holst du mit read().", "", "&6So gehts", "&bwrite('Wie heißt du? ')", "&blocal name = read()", "&bprint('Hallo ' .. name .. '!')", "write schreibt ohne Zeilenumbruch, print mit Zeilenumbruch.", "Mit tonumber(read()) wandelst du eine Eingabe in eine Zahl um.", "", "&6Wofür ist das wichtig?", "So baust du Programme, die auf deine Eingaben reagieren, zum Beispiel einen Taschenrechner."]
			icon: { id: "minecraft:oak_sign" }
			dependencies: ["1278474BB4CEEE9C"]
			id: "0249818214849A7D"
			title: "Eingabe"
			rewards: [{ id: "022CDE644D7EA65C", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "28EA4AC9300BF991", type: "checkmark" }]
			x: 7.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Mit if entscheidet ein Programm. Vergleiche sind == (gleich), ~= (ungleich), <, >, <= und >=.", "", "&6So gehts", "&bprint('Zahl von 1 bis 10?')", "&blocal z = tonumber(read())", "&bif z > 5 then", "&b  print('Groß')", "&belseif z == 5 then", "&b  print('Genau fünf')", "&belse", "&b  print('Klein')", "&bend", "Jeder if-Block endet mit end.", "", "&6Wofür ist das wichtig?", "Programme verzweigen so: Wenn die Tür zu ist, öffne sie, sonst warte."]
			icon: { id: "minecraft:lever" }
			dependencies: ["0249818214849A7D"]
			id: "725CDD484FD1FEE4"
			title: "Wenn - dann"
			rewards: [{ id: "02CA62D357F86FA8", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "493DBA675A081C76", type: "checkmark" }]
			x: 9.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Eine Schleife wiederholt Anweisungen. for zählt, while läuft, solange eine Bedingung stimmt.", "", "&6So gehts", "Zählen von 1 bis 10:", "&bfor i = 1, 10 do", "&b  print(i)", "&bend", "Endlos wiederholen, jede Sekunde:", "&bwhile true do", "&b  print('Tick')", "&b  sleep(1)", "&bend", "Eine Endlosschleife stoppst du mit Strg+T.", "sleep(1) wartet eine Sekunde. Ohne sleep rechnet der Computer sich tot und das Programm wird abgebrochen.", "", "&6Wofür ist das wichtig?", "Schleifen lassen eine Farm oder einen Roboter stundenlang arbeiten."]
			icon: { id: "minecraft:repeater" }
			dependencies: ["725CDD484FD1FEE4"]
			id: "5C4AC9EB5813CC14"
			title: "Schleifen"
			rewards: [{ id: "58F52F04EDBE115B", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "1CD83283E20B42BE", type: "checkmark" }]
			x: 10.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Eine Funktion ist ein benannter Programmteil, den du immer wieder aufrufen kannst.", "", "&6So gehts", "&blocal function quadrat(x)", "&b  return x * x", "&bend", "&bprint(quadrat(4))", "return gibt das Ergebnis zurück. Funktionen müssen vor ihrer Benutzung im Programm stehen.", "", "&6Wofür ist das wichtig?", "Mit Funktionen wird der Code übersichtlich. Du schreibst eine Sache einmal und nutzt sie überall."]
			icon: { id: "minecraft:crafting_table" }
			dependencies: ["5C4AC9EB5813CC14"]
			id: "53D9B50C02CD6137"
			title: "Funktionen"
			rewards: [{ id: "38D0D99A1B22D2C1", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "13F7BA720AA75D53", type: "checkmark" }]
			x: 12.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Eine Tabelle ist eine Liste, in der mehrere Werte stehen. In Lua zählt die Liste ab 1, nicht ab 0.", "", "&6So gehts", "&blocal farben = {'rot', 'grün', 'blau'}", "&bprint(farben[1])          -- rot", "&bprint(#farben)           -- 3, die Länge", "&bfor i, f in ipairs(farben) do", "&b  print(i, f)", "&bend", "Auch Schlüssel-Werte-Paare gehen:", "&blocal spieler = { name = 'Alex', level = 12 }", "&bprint(spieler.name)", "Zwei Bindestriche (--) beginnen einen Kommentar, den der Computer ignoriert.", "", "&6Wofür ist das wichtig?", "Mit Tabellen speicherst du Listen von Dingen, zum Beispiel alle Items in einer Kiste."]
			icon: { id: "minecraft:chest" }
			dependencies: ["53D9B50C02CD6137"]
			id: "4120115E0C0DB490"
			title: "Tabellen"
			rewards: [{ id: "048C280BD308D51E", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "4B745258BEC83002", type: "checkmark" }]
			x: 13.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Der Computer kann an seinen sechs Seiten Redstone-Signale senden und empfangen. Die Seiten heißen top, bottom, left, right, front, back.", "front ist die Seite mit dem Bildschirm.", "", "&6So gehts", "Lege Redstone-Staub oder eine Redstone-Lampe neben den Computer. Dann:", "&bredstone.setOutput('right', true)", "Die Lampe geht an. Zum Ausschalten:", "&bredstone.setOutput('right', false)", "Das kannst du direkt im Terminal tippen oder in einem Programm.", "", "&6Wofür ist das wichtig?", "So schaltest du Lampen, Türen, Kolben und Maschinen mit dem Computer."]
			icon: { id: "minecraft:redstone" }
			dependencies: ["4120115E0C0DB490"]
			id: "168A7722F16A3C7F"
			title: "Redstone senden"
			rewards: [{ id: "4710FD39C7C5F906", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "33A752F0023DAB1D", type: "item", item: { id: "minecraft:redstone", count: 1 }, count: 1L }]
			x: 13.50d
			y: -1.50d
		}
		{
			description: ["&6Was ist das?", "Der Computer liest Signale an seinen Seiten. Dafür gibt es redstone.getInput.", "", "&6So gehts", "Setze einen Hebel an eine Seite des Computers. Dann:", "&bprint(redstone.getInput('left'))", "Es erscheint true (an) oder false (aus). Besser als Dauerabfrage: auf ein Ereignis warten.", "&bwhile true do", "&b  os.pullEvent('redstone')", "&b  print('Signal geändert!')", "&bend", "os.pullEvent wartet, bis etwas passiert. Das spart Rechenzeit.", "", "&6Wofür ist das wichtig?", "Mit Eingängen reagiert dein Computer auf Hebel, Druckplatten und Sensoren."]
			icon: { id: "minecraft:redstone_torch" }
			dependencies: ["168A7722F16A3C7F"]
			id: "6377B597E3D9093C"
			title: "Redstone lesen"
			rewards: [{ id: "2C3C3457CB8DF10D", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "6E0B1713578B637B", type: "checkmark" }]
			x: 13.50d
			y: -3.00d
		}
		{
			description: ["&6Was ist das?", "Ein erstes kleines Projekt: eine Lampe, die blinkt.", "", "&6So gehts", "Baue eine Redstone-Lampe neben den Computer (rechte Seite) und schreibe das Programm blinker:", "&bwhile true do", "&b  redstone.setOutput('right', true)", "&b  sleep(0.5)", "&b  redstone.setOutput('right', false)", "&b  sleep(0.5)", "&bend", "Mit Strg+T hörst du auf.", "", "&6Wofür ist das wichtig?", "Das Prinzip aus Schleife, Ausgang und Pause steckt in jeder Automatik."]
			icon: { id: "minecraft:redstone_lamp" }
			dependencies: ["6377B597E3D9093C"]
			id: "5465906349EA51DF"
			title: "Blinklicht"
			rewards: [{ id: "3DA5865C714B457C", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "59926F52ADAD7B00", type: "item", item: { id: "minecraft:redstone_lamp", count: 1 }, count: 1L }]
			x: 13.50d
			y: -4.50d
		}
		{
			description: ["&6Was ist das?", "Redstone hat Stärken von 0 bis 15. Der Computer kann sie lesen und senden.", "", "&6So gehts", "&bredstone.setAnalogOutput('back', 7)", "&bprint(redstone.getAnalogInput('front'))", "Hängt ein Komparator an einer Kiste, liest du so den Füllstand aus.", "", "&6Wofür ist das wichtig?", "So misst du Füllstände, steuerst Lautstärken oder Helligkeit, nicht nur an und aus."]
			icon: { id: "minecraft:comparator" }
			dependencies: ["5465906349EA51DF"]
			id: "2697519609A9ECB9"
			title: "Analoge Signale"
			rewards: [{ id: "6EF34D921E43B745", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "3FE3D271318CBD64", type: "checkmark" }]
			x: 13.50d
			y: -6.00d
		}
		{
			description: ["&6Was ist das?", "Ein Ereignis ist etwas, das passiert: eine Taste, ein Timer, ein Redstone-Signal. os.pullEvent wartet darauf.", "", "&6So gehts", "&bwhile true do", "&b  local ereignis, taste = os.pullEvent('key')", "&b  print('Taste:', keys.getName(taste))", "&b  if taste == keys.q then break end", "&bend", "Mit Q beendest du das Programm. break verlässt eine Schleife.", "Weitere Ereignisse: char (Zeichen getippt), timer, redstone, mouse_click (Fortgeschrittener Computer).", "", "&6Wofür ist das wichtig?", "Ereignisse sind die Grundlage jeder Steuerung, auch für Monitore mit Touch."]
			icon: { id: "minecraft:oak_button" }
			dependencies: ["4120115E0C0DB490"]
			id: "7F1327ED0B9BBDC0"
			title: "Tasten und Ereignisse"
			rewards: [{ id: "3AC578CC3543BB53", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "72003DC4818B20E5", type: "checkmark" }]
			x: 15.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Programme können Zeit messen und warten.", "", "&6So gehts", "&bprint(os.time())            -- Spielzeit", "&bprint(os.clock())           -- Sekunden seit Start", "&bsleep(5)                    -- fünf Sekunden warten", "Mit os.startTimer(3) startest du einen Timer, dessen Ereignis timer nach drei Sekunden kommt.", "", "&6Wofür ist das wichtig?", "Zeitgesteuerte Dinge: Tür nach drei Sekunden schließen, Farm alle zehn Minuten ernten."]
			icon: { id: "minecraft:clock" }
			dependencies: ["7F1327ED0B9BBDC0"]
			id: "164A20F1E707E8BE"
			title: "Zeit und Wartezeit"
			rewards: [{ id: "47EF8D272D8D3D79", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "3FB3F368B9C16DDC", type: "checkmark" }]
			x: 16.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Der Computer hat ein Dateisystem. Befehle: ls (anzeigen), cd (Ordner wechseln), mkdir (Ordner anlegen), rm (löschen), cp (kopieren), mv (verschieben).", "", "&6So gehts", "&bmkdir programme", "&bcd programme", "&bedit test", "&bcd ..", "Aus einem Programm heraus:", "&bprint(fs.exists('programme/test'))", "&blocal f = fs.open('notiz.txt', 'w')", "&bf.write('Hallo Datei')", "&bf.close()", "So legt dein Programm Dateien an und liest sie wieder (Modus 'r' zum Lesen).", "", "&6Wofür ist das wichtig?", "Programme speichern damit Einstellungen und Daten über den Neustart hinaus."]
			icon: { id: "minecraft:barrel" }
			dependencies: ["164A20F1E707E8BE"]
			id: "10615ED9ADABB83D"
			title: "Dateien und Ordner"
			rewards: [{ id: "5F2F476B1AAD14E1", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "1ED520F8B989949C", type: "checkmark" }]
			x: 18.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Eine Datei mit dem Namen startup läuft automatisch, wenn der Computer startet.", "", "&6So gehts", "&bedit startup", "&bprint('Computer gestartet')", "&bshell.run('blinker')", "Speichern und mit Strg+R neu starten. Die Datei startup läuft von allein, danach dein blinker.", "", "&6Wofür ist das wichtig?", "Eine Anlage läuft nach einem Server- oder Chunk-Neustart sofort wieder an, ohne dass du etwas tippst."]
			icon: { id: "minecraft:clock" }
			dependencies: ["10615ED9ADABB83D"]
			id: "3E46102C0C74EDFC"
			title: "Startprogramm"
			rewards: [{ id: "6915694831A44043", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "6C1F9D52EEE9E134", type: "checkmark" }]
			x: 19.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Ein Monitor ist ein großer Bildschirm, den du an eine Wand bauen kannst. Mehrere Monitore nebeneinander verschmelzen zu einem größeren Bild.", "", "&6So gehts", "Setze einen Monitor direkt an den Computer. Dann:", "&blocal mon = peripheral.find('monitor')", "&bmon.clear()", "&bmon.setTextScale(2)", "&bmon.setCursorPos(1, 1)", "&bmon.write('Hallo!')", "Mit term.redirect(mon) lässt du alle print-Ausgaben auf dem Monitor erscheinen.", "Ein Fortgeschrittener Monitor zeigt Farben und meldet Berührungen (Ereignis monitor_touch).", "", "&6Wofür ist das wichtig?", "Anzeigen für Vorräte, Uhren, Maschinenzustände und Schilder in deiner Basis."]
			icon: { id: "computercraft:monitor_normal" }
			dependencies: ["3E46102C0C74EDFC"]
			id: "537B85BB8C583DD8"
			title: "Monitor"
			rewards: [{ id: "36E9B0A53380745C", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "52B85FDE331CC574", type: "item", item: { id: "computercraft:monitor_normal", count: 1 }, count: 1L }]
			x: 19.50d
			y: 1.50d
		}
		{
			description: ["&6Was ist das?", "Peripheriegeräte sind Dinge, die du an den Computer anschließt: Monitor, Lautsprecher, Drucker, Laufwerk.", "Direkt neben dem Computer reicht. Weiter weg verbindest du sie mit Kabel und Modem.", "", "&6So gehts", "Frage alle Geräte ab:", "&bprint(textutils.serialize(peripheral.getNames()))", "Mit Kabel: Kabel und Modems ans Gerät und an den Computer setzen. Rechtsklick auf das Modem (rote Ringe werden grün) verbindet es.", "Dann:", "&blocal p = peripheral.wrap('monitor_0')", "Welche Funktionen ein Gerät kann, zeigt dir:", "&bprint(textutils.serialize(peripheral.getMethods('monitor_0')))", "", "&6Wofür ist das wichtig?", "So steuert ein Computer eine ganze Anlage mit vielen Geräten, auch mit dem Redstone Link Bridge von Create."]
			icon: { id: "computercraft:wired_modem" }
			dependencies: ["537B85BB8C583DD8"]
			id: "7D880A8DE7EF12D0"
			title: "Geräte verbinden"
			rewards: [{ id: "047E056E5C6AF10C", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "5856BA7C729F23CB", type: "item", item: { id: "computercraft:wired_modem", count: 1 }, count: 1L }]
			x: 19.50d
			y: 3.00d
		}
		{
			description: ["&6Was ist das?", "Der Lautsprecher spielt Noten und Geräusche ab.", "", "&6So gehts", "&blocal sp = peripheral.find('speaker')", "&bsp.playNote('harp', 1, 12)", "&bsp.playSound('minecraft:entity.pig.ambient')", "Die Zahl bei playNote ist die Tonhöhe von 0 bis 24.", "", "&6Wofür ist das wichtig?", "Alarmanlagen, Türklingeln und Melodien für deine Basis."]
			icon: { id: "computercraft:speaker" }
			dependencies: ["7D880A8DE7EF12D0"]
			id: "72451E05F30CEB0A"
			title: "Lautsprecher"
			rewards: [{ id: "286217E0A611CA26", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "1641D8A41D78D6AC", type: "item", item: { id: "computercraft:speaker", count: 1 }, count: 1L }]
			x: 19.50d
			y: 4.50d
		}
		{
			description: ["&6Was ist das?", "Auf Disketten speicherst du Programme und trägst sie zu anderen Computern und Turtles.", "", "&6So gehts", "Setze das Laufwerk neben den Computer und lege eine Diskette hinein (Rechtsklick).", "Die Diskette erscheint im Ordner disk:", "&bcp meinprogramm disk/meinprogramm", "In einem anderen Computer mit Laufwerk kopierst du sie zurück. Mit label set Name auf der Diskette gibst du ihr einen Namen.", "Manche Dungeons enthalten Disketten mit Musik oder Programmen.", "", "&6Wofür ist das wichtig?", "Programme einmal schreiben und auf viele Turtles verteilen."]
			icon: { id: "computercraft:disk_drive" }
			dependencies: ["72451E05F30CEB0A"]
			id: "17169ACE89EA090D"
			title: "Diskettenlaufwerk"
			rewards: [{ id: "0CCCFCD2B5909199", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "080A1945931C2E87", type: "item", item: { id: "computercraft:disk_drive", count: 1 }, count: 1L }]
			x: 19.50d
			y: 6.00d
		}
		{
			description: ["&6Was ist das?", "Ein Funkmodem lässt Computer und Turtles Nachrichten austauschen. Das Netzwerk heißt rednet.", "", "&6So gehts", "Baue ein Funkmodem und setze es an den Computer (Seite zum Beispiel top). Beide Computer brauchen eins.", "Empfänger (Computer A):", "&brednet.open('top')", "&blocal id, nachricht = rednet.receive()", "&bprint(id, nachricht)", "Sender (Computer B):", "&brednet.open('top')", "&brednet.send(1, 'Hallo A!')", "Die Zahl bei send ist die Nummer des Empfängers. Sie steht mit dem Befehl id im Terminal. Mit rednet.broadcast('Text') erreichst du alle.", "Reichweite und Dimensionen hängen vom Modemtyp ab. Ein Funkmodem für Fortgeschrittene (Ender) hat die größere Reichweite.", "", "&6Wofür ist das wichtig?", "Du steuerst Turtles aus der Ferne oder meldest Alarm an mehrere Computer gleichzeitig."]
			icon: { id: "computercraft:wireless_modem_normal" }
			dependencies: ["17169ACE89EA090D"]
			id: "380CF6CA1873D2D1"
			title: "Funk-Modem"
			rewards: [{ id: "77F1A82FD1BD9677", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "5C1E8F3FFB1A5190", type: "item", item: { id: "computercraft:wireless_modem_normal", count: 1 }, count: 1L }]
			x: 19.50d
			y: 7.50d
		}
		{
			description: ["&6Was ist das?", "Ein Taschencomputer ist ein tragbarer Computer in der Hand. Mit Funkmodem schickst du von unterwegs Befehle.", "", "&6So gehts", "Rechtsklick öffnet ihn. Dort läuft dasselbe System wie im Computer.", "Ein Funkmodem baust du in der Werkbank ein (Rezept im Rezeptbuch). Dann kannst du Nachrichten an deine Turtles schicken.", "", "&6Wofür ist das wichtig?", "Eine Fernbedienung für deine ganze Anlage."]
			icon: { id: "computercraft:pocket_computer_normal" }
			dependencies: ["380CF6CA1873D2D1"]
			id: "1A85216CC5D47773"
			title: "Taschencomputer"
			rewards: [{ id: "5BA121029682603C", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "776B215424B0DAC5", type: "item", item: { id: "computercraft:pocket_computer_normal", count: 1 }, count: 1L }]
			x: 19.50d
			y: 9.00d
		}
		{
			description: ["&6Was ist das?", "Eine Turtle ist ein Computer auf Rädern. Sie läuft, gräbt, baut, kämpft und trägt Items. Du programmierst sie wie einen normalen Computer.", "", "&6So gehts", "Baue eine Turtle (Rezept im Rezeptbuch).", "Stelle sie auf, Rechtsklick öffnet das Terminal. Sie braucht Treibstoff: Lege Kohle ins Inventar und tippe:", "&brefuel all", "&bprint(turtle.getFuelLevel())", "Ein Stück Kohle reicht für etwa 80 Schritte. Ohne Treibstoff bewegt sie sich nicht.", "", "&6Wofür ist das wichtig?", "Turtles arbeiten für dich: Tunnelbau, Holzfarm, Aufräumen, Einsammeln."]
			icon: { id: "computercraft:turtle_normal" }
			dependencies: ["4A4ADF95A3ECF983"]
			id: "028B5F465235FCCB"
			title: "Die Turtle"
			rewards: [{ id: "71A21DBBF7BAF75A", type: "item", item: { id: "minecraft:coal", count: 16 } }]
			tasks: [{ id: "240DD119D4FF72B5", type: "item", item: { id: "computercraft:turtle_normal", count: 1 }, count: 1L }]
			x: 21.00d
			y: -1.50d
		}
		{
			description: ["&6Was ist das?", "Die Turtle kennt Befehle zum Gehen und Drehen.", "", "&6So gehts", "&bturtle.forward()    -- vor", "&bturtle.back()       -- zurück", "&bturtle.up()         -- hoch", "&bturtle.down()       -- runter", "&bturtle.turnLeft()   -- links drehen", "&bturtle.turnRight()  -- rechts drehen", "Jeder Befehl gibt true oder false zurück, je nachdem, ob es geklappt hat. Bei einem Block im Weg ist es false.", "", "&6Wofür ist das wichtig?", "Alles weitere baut darauf auf. Mit einer Schleife läuft die Turtle eine ganze Strecke ab."]
			icon: { id: "minecraft:rail" }
			dependencies: ["028B5F465235FCCB"]
			id: "03FBC2A235755AE4"
			title: "Turtle bewegen"
			rewards: [{ id: "7F5153BE679FC748", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "01C799D3B4557CCF", type: "checkmark" }]
			x: 21.00d
			y: -3.00d
		}
		{
			description: ["&6Was ist das?", "Eine Turtle mit Spitzhacke gräbt, und sie kann Blöcke setzen.", "", "&6So gehts", "Eine Grabturtle baust du, indem du Turtle und eine Spitzhacke in die Werkbank legst (Rezept im Rezeptbuch).", "&bturtle.dig()           -- vorne graben", "&bturtle.digUp()         -- oben graben", "&bturtle.digDown()       -- unten graben", "&bturtle.select(1)       -- Slot 1 wählen", "&bturtle.place()         -- Block aus dem gewählten Slot setzen", "&bturtle.detect()        -- true, wenn vorne ein Block ist", "", "&6Wofür ist das wichtig?", "Damit gräbst du Tunnel, baust Brücken und erntest Bäume automatisch."]
			icon: { id: "minecraft:iron_pickaxe" }
			dependencies: ["03FBC2A235755AE4"]
			id: "38640E6A053DB4C4"
			title: "Graben und Bauen"
			rewards: [{ id: "78B78A4B12024424", type: "xp_levels", xp_levels: 1 }]
			tasks: [{ id: "412E4F7590EFF1AF", type: "checkmark" }]
			x: 21.00d
			y: -4.50d
		}
		{
			description: ["&6Was ist das?", "Ein erstes vollständiges Turtle-Programm: ein Tunnel von zehn Blöcken.", "", "&6So gehts", "Programm tunnel10:", "&bfor i = 1, 10 do", "&b  while turtle.detect() do turtle.dig() end", "&b  turtle.forward()", "&bend", "Die innere while-Schleife gräbt weiter, solange vorne etwas ist (zum Beispiel fallender Kies).", "Eingebaute Programme gibt es auch: tunnel 20 und excavate 5 graben für dich.", "", "&6Wofür ist das wichtig?", "Bergbau, Strecken, Gruben: Alles, was nach Wiederholung aussieht, ist ein Turtle-Programm."]
			icon: { id: "minecraft:iron_pickaxe" }
			dependencies: ["38640E6A053DB4C4"]
			id: "422800ED433A5310"
			title: "Programm: Tunnel"
			rewards: [{ id: "1FA8CAFB2CC80752", type: "xp_levels", xp_levels: 1 }]
