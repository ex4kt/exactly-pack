	title: "&dAbbau und Verzauberung"
	quests: [
		{
			description: ["&6Was ist das?", "Schlage mit der Axt Staemme ab. Mit einer Axt geht es schneller als mit der Hand.", "Du brauchst Holz fuer Werkbank, Werkzeuge und die ersten Bauten.", "", "&6So gehts", "Schlage mit der Hand oder einer Axt auf einen Baumstamm, bis er abbricht.", "In der Werkbank (oder im 2x2-Feld im Inventar) wird ein Stamm zu vier Brettern.", "", "&6Wofuer ist das wichtig?", "Du brauchst Holz fuer fast alles am Anfang: Werkbank, Kisten, Werkzeuge, Fackeln und spaeter fuer Create-Wellen und Wasserraeder.", "Tipp: Pflanze die Setzlinge wieder ein, dann geht dir das Holz nie aus."]
			id: "72E53652C30F4A40"
			title: "Holz sammeln"
			rewards: [{ id: "FFDBA311B4A67B0F", type: "item", item: { id: "minecraft:stick", count: 16 } }]
			tasks: [{ id: "70BDCD75D89F9331", type: "item", item: { id: "minecraft:oak_log", count: 1 }, count: 8L }]
			x: 0.0d
