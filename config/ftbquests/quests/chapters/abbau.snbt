			tasks: [{ id: "074F13AC488E27A9", type: "checkmark" }]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["4025DE8C8C663C62"]
			description: ["&6Was ist das?", "Easy Anvils macht den Amboss fairer: Kosten sind niedriger, Teile bleiben drin.", "Mit ihm kannst du Verzauberungen kombinieren.", "", "&6So gehts", "Item links, Buch oder zweites Item rechts.", "Mit Easy Anvils gibt es keine Zu-teuer-Grenze.", "", "&6Wofuer ist das wichtig?", "So bekommst du genau die Verzauberungen, die du willst."]
