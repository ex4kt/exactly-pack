	title: "&cBosse der Zerstörung"
	quests: [
		{
			description: ["&6Was ist das?", "Bosses of Mass Destruction fügt vier Bosse mit eigener Arena hinzu: Lich (kalte Biome), Gauntlet (Nether), Void Blossom (tief unter der Oberwelt) und Obsidilith (End).", "", "&6Reihenfolge", "Empfohlen: Lich, dann Void Blossom, dann Gauntlet im Nether, zum Schluss Obsidilith im End.", "", "&6Wofür ist das wichtig?", "Die Beute wird zu starken Gegenständen verarbeitet (Erdtauch-Speer, Mob-Schutz). Alles ist freiwillig."]
			icon: { id: "bosses_of_mass_destruction:soul_star" }
			id: "659E23D298A106AC"
			title: "&cBosse der Zerstörung"
			rewards: [{ id: "09317FE228D3B867", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "66EEBC578F4ECB4F", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.00d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Diese Bosse sind deutlich stärker als Vanilla-Bosse (250 bis 350 Leben, harte Treffer, Explosionen).", "", "&6Was brauchst du?", "- Mindestens volle Diamant-, besser Netherit-Rüstung mit Schutz-Verzauberung", "- Schild, Bogen oder Armbrust mit vielen Pfeilen", "- Goldene Äpfel, Heil- und Feuerresistenz-Tränke, viel Essen", "- Blöcke zum Bauen, ein Bett oder Ankerpunkt in der Nähe", "", "&6So gehts", "Kämpfe nicht allein, wenn es geht. Die Bosse heilen sich langsam, wenn du weggehst: dranbleiben."]
			dependencies: ["659E23D298A106AC"]
			id: "4C3DE63606F736E7"
			title: "Boss: Vorbereitung"
			rewards: [{ id: "0FA3EE1A2AC39558", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "1A033B0D7FBB0B5F", type: "checkmark" }]
			x: 1.50d
			y: 0.00d
		}
		{
			description: ["&6Wo findest du ihn?", "Im Lich-Turm in kalten Biomen: verschneite Taiga, verschneite Ebenen und Hänge, Eiszapfen, gefrorene Gipfel, verschneiter Strand, gefrorener Ozean.", "", "&6Was brauchst du?", "- 4 Seelensterne: nach je 50 besiegten Untoten (Zombies, Skelette, Phantome, Ertrunkene usw.) lässt ein Untoter einen Seelenstern fallen.", "- Rechtsklick in die Luft mit einem Seelenstern: er fliegt wie ein Enderauge in Richtung des nächsten Lich-Turms.", "", "&6So gehts", "Im Turm stehen auf einer Etage 4 Gemeißelte Steinaltäre. Setze in jeden einen Seelenstern (Rechtsklick), dann erscheint der Lich.", "Er hat 300 Leben, schießt verlangsamende Geschosse und lässt Kometen fallen. Fernkampf und ständiges Ausweichen helfen.", "", "&6Beute", "Antike Anima, dazu Knochen, Bücher und Diamanten. In den Turm-Truhen liegt weitere Beute."]
			dependencies: ["4C3DE63606F736E7"]
			id: "33D918086EDD77D8"
			title: "Boss: Lich"
			rewards: [{ id: "24188ECB26CEDA39", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "66E61127E26B524A", type: "checkmark" }]
			x: 3.00d
			y: 0.00d
		}
		{
			description: ["&6Wo findest du ihn?", "Im Nether, in einer unterirdischen Arena tief unten (um Höhe 15). Arenen sind recht häufig.", "", "&6Was brauchst du?", "Feuerresistenz, Netherit-Ausrüstung, Bogen. Kein Gegenstand zum Rufen nötig: er erwacht, wenn du die Arena betrittst.", "", "&6So gehts", "Er hat 250 Leben und gute Rüstung. Seine Faustschläge explodieren, der Laser lädt sich hörbar auf: dann hinter Deckung.", "Schlag zu, wenn er nach einem Angriff kurz stillsteht.", "", "&6Beute", "Das Brennende Auge liegt in der Truhe der Arena. Beim Tod erscheint Antiker Schrott."]
			dependencies: ["33D918086EDD77D8"]
			id: "265C28EA0879D955"
			title: "Boss: Gauntlet"
			rewards: [{ id: "04D6962B25CD3671", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "025FF87C44DF8A13", type: "checkmark" }]
			x: 4.50d
			y: 0.00d
		}
		{
			description: ["&6Wo findest du sie?", "In einer Höhle ganz unten in der Oberwelt (Tiefenschiefer-Ebene), in fast allen normalen Biomen.", "", "&6Was brauchst du?", "Eine Leerenlilie zum Suchen: Maiglöckchen + Amethystscherbe (formlos). Stell sie auf: ihr Pollen fliegt in Richtung der nächsten Void Blossom.", "", "&6So gehts", "Sie erscheint, sobald du ihre Höhle betrittst. 350 Leben, wirft Dornen und lässt Ranken aus dem Boden schießen: in Bewegung bleiben.", "", "&6Beute", "Void-Dorn und Kristallfrucht."]
			dependencies: ["265C28EA0879D955"]
			id: "032FE80C0F717B8C"
			title: "Boss: Void Blossom"
			rewards: [{ id: "29FCBEFAE841099A", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "0CBE6FF1EA9E1249", type: "checkmark" }]
			x: 6.00d
			y: 0.00d
		}
		{
			description: ["&6Wo findest du ihn?", "Im End, in einer Arena auf den äußeren Inseln (erst nach dem Enderdrachen erreichbar).", "", "&6Was brauchst du?", "Ein Enderauge. Setze es in den Obsidianaltar in der Arena, dann erscheint der Obsidilith.", "Dazu: Langsamer-Fall-Tränke oder Elytren, viele Blöcke, sehr gute Rüstung.", "", "&6So gehts", "Er hat 300 Leben und sehr viel Rüstung. Er greift mit Runen und Explosionen an: weg von den markierten Stellen.", "", "&6Beute", "Das Obsidianherz liegt in der Truhe. Nach dem Sieg erscheint eine Säule."]
			dependencies: ["032FE80C0F717B8C"]
			id: "33288E16EBE80FA9"
			title: "Boss: Obsidilith"
			rewards: [{ id: "5E822143E66FFCEC", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "5C24C1AE7D510557", type: "checkmark" }]
			x: 7.50d
			y: 0.00d
		}
		{
			description: ["&6Was ist das?", "Zeigt den Weg zum Lich-Turm und ruft dort den Lich.", "", "&6So gehts", "Nach je 50 besiegten Untoten lässt einer einen Seelenstern fallen. Rechtsklick in die Luft: er fliegt Richtung Lich-Turm. Für den Lich brauchst du 4 Stück.", "", "&6Wofür ist das wichtig?", "Freiwillig, unabhängig von allen anderen Quests."]
			dependencies: ["659E23D298A106AC"]
