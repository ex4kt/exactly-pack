		}
		{
			dependencies: ["E1EAD2BD124C523A"]
			description: ["&6Was ist das?", "Der Kompressor macht Druckluft, die Maschinen brauchen.", "Schritt 1: Baue einen Luftkompressor.", "Schritt 2: Fuelle ihn mit Brennstoff (z.B. Kohle).", "", "&6So gehts", "Aufstellen, Kohle oder Holz hineinlegen.", "Die Druckanzeige steigt. Bei zu viel Druck explodiert er, also immer Luft abnehmen.", "", "&6Wofuer ist das wichtig?", "Druckluft (bar) ist die Energie fuer alles in PneumaticCraft."]
			id: "86BA63BEA1C58C27"
			title: "Luftkompressor"
