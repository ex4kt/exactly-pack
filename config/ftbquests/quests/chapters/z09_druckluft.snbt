		}
		{
			dependencies: ["F60D13AF5AC8E152"]
			description: ["&6Was ist das?", "Druckrohre leiten die Luft von Block zu Block.", "Schritt 1: Baue Rohre.", "Schritt 2: Verbinde Kompressor und Maschinen.", "", "&6So gehts", "Rohre zwischen Kompressor und Maschine legen.", "Mit dem Schluessel kannst du Seiten trennen.", "", "&6Wofuer ist das wichtig?", "Ein Kompressor kann viele Maschinen versorgen."]
			id: "67762AADFE07910B"
