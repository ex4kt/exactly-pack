			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["793A5F2F64724056"]
			description: ["&6Was ist das?", "In der Bauhütte wohnt der Baumeister. Er baut alle anderen Gebäude.", "", "&6So gehts", "Setze die Bauhütte mit dem Baustab und gib im Menü den Bauauftrag. Der Baumeister bringt die Liste der Materialien, die er braucht.", "", "&6Wofür ist das wichtig?", "Ohne Baumeister wächst die Kolonie nicht."]
			icon: { id: "minecolonies:blockhutbuilder" }
			id: "4CD9C3D5FC728544"
