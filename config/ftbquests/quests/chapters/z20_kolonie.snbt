	title: "&6Kolonie und Bauen"
	subtitle: ["Deine eigene Stadt mit MineColonies und Bauwerkzeugen"]
	quests: [
		{
			description: ["&6Was ist das?", "MineColonies lässt dich ein eigenes Dorf gründen. Bewohner bauen, ernten, kochen und verteidigen für dich.", "", "&6So gehts", "Folge den Quests von links nach rechts. Rezepte zeigt das Rezeptbuch: Maus aufs Item, Taste R.", "", "&6Wofür ist das wichtig?", "Eine Kolonie nimmt dir viel Arbeit ab und wächst mit dir durch alle Zeitalter."]
			icon: { id: "minecolonies:blockhuttownhall" }
			id: "6689339934628BBF"
			title: "Kolonie und Bauen"
			rewards: [{ id: "002D03F4FA5F1039", type: "xp_levels", xp_levels: 2 }]
