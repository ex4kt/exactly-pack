		}
		{
			dependencies: ["4CD9C3D5FC728544"]
			description: ["&6Was ist das?", "Das Klemmbrett zeigt, was deine Bewohner gerade brauchen.", "", "&6So gehts", "Rechtsklick auf das Rathaus mit dem Klemmbrett verbindet es. Danach öffnest du es überall mit Rechtsklick.", "", "&6Wofür ist das wichtig?", "So siehst du sofort, welches Material fehlt, und die Arbeit geht weiter."]
			icon: { id: "minecolonies:clipboard" }
			id: "5E3ADE60FEC76F87"
