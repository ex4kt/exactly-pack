		}
		{
			dependencies: ["5E3ADE60FEC76F87"]
			description: ["&6Was ist das?", "Die Ressourcenrolle zeigt die Materialliste eines Bauauftrags.", "", "&6So gehts", "Rechtsklick auf die Bauhütte mit der Rolle verbindet sie. Danach zeigt sie, was der Baumeister noch braucht.", "", "&6Wofür ist das wichtig?", "Damit sammelst du gezielt nur das, was wirklich fehlt."]
			icon: { id: "minecolonies:resourcescroll" }
