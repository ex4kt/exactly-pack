			rewards: [{ id: "512F5E13E4FEAA24", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "1DCB4A6FD01EFE49", type: "item", item: { id: "minecolonies:blockhutbuilder", count: 1 }, count: 1L }]
			x: 6.00d
