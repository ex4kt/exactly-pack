			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["6689339934628BBF"]
			description: ["&6Was ist das?", "Mit dem Baustab (Structurize) wählst du Gebäude aus und stellst sie als Vorschau in die Welt.", "", "&6So gehts", "Stelle den Baustab her und mache Rechtsklick auf den Boden. Wähle ein Gebäude, drehe und verschiebe die Vorschau und bestätige.", "", "&6Wofür ist das wichtig?", "Ohne Baustab kannst du keine Kolonie-Gebäude platzieren."]
			icon: { id: "structurize:sceptergold" }
			id: "3E769925842F1CE5"
			title: "Der Baustab"
			rewards: [{ id: "32E02DDB29B22A18", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "6318447EA62877C7", type: "item", item: { id: "structurize:sceptergold", count: 1 }, count: 1L }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["3E769925842F1CE5"]
			description: ["&6Was ist das?", "Das Versorgungslager (an Land) oder das Versorgungsschiff (am Wasser) ist der Startpunkt jeder Kolonie.", "", "&6So gehts", "Stelle eines von beiden her und setze es mit Rechtsklick an einen freien, flachen Platz. Danach baust du dort dein Rathaus.", "", "&6Wofür ist das wichtig?", "Hier beginnt deine Kolonie. Wähle den Ort gut, er wird zum Zentrum."]
			icon: { id: "minecolonies:supplycampdeployer" }
			id: "23FAF07B87A6E285"
			title: "Versorgungslager"
			rewards: [{ id: "7F3557811D14F850", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "3D677770711CD4A6", type: "item", title: "Versorgungslager oder Versorgungsschiff", icon: { id: "minecolonies:supplycampdeployer" }, item: { id: "ftbfiltersystem:smart_filter", count: 1, components: { "ftbfiltersystem:filter": "or(item(minecolonies:supplycampdeployer)item(minecolonies:supplychestdeployer))" } }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["23FAF07B87A6E285"]
			description: ["&6Was ist das?", "Das Rathaus gründet die Kolonie. Ab hier gehört das Gebiet um das Rathaus dir.", "", "&6So gehts", "Stelle den Rathaus-Block her und setze ihn mit dem Baustab. Rechtsklick auf den Block öffnet das Menü der Kolonie.", "", "&6Wofür ist das wichtig?", "Das Rathaus zeigt dir alle Bewohner, Gebäude und Aufträge."]
			icon: { id: "minecolonies:blockhuttownhall" }
			id: "793A5F2F64724056"
