	quests: [
		{
			description: ["&6Was ist das?", "Stelle Enderperlen und Blazepulver zu Enderaugen zusammen. Damit findest du die Festung.", "", "&6So gehts", "Enderperle und Blazepulver ergeben ein Enderauge.", "Wirf eines in die Luft, es fliegt in Richtung Festung. Folge ihm, bis es nach unten zeigt.", "", "&6Wofuer ist das wichtig?", "Ohne zwoelf Enderaugen kein Ende. Enderperlen bekommst du von Endermen oder Piglins."]
			id: "502C61E3409EAEDC"
