	quests: [
		{
			dependencies: ["56184FBD96403098"]
			description: ["&6Was ist das?", "Eine Eisenspitzhacke baut Diamanten ab. Schmelze Eisenerz im Ofen.", "", "&6So gehts", "Eisenerz schmelzen. Eisenspitzhacke: drei Eisenbarren, darunter zwei Stöcke.", "", "&6Wofür ist das wichtig?", "Erst mit einer Eisenspitzhacke kannst du Gold, Redstone und Diamanten abbauen.", "", "&6Gut zu wissen", "Eisen hält rund doppelt so lange wie Stein (250 gegen 131 Nutzungen) und ist die Voraussetzung für Diamanten."]
			id: "269F5FBF41678363"
			title: "Eisenwerkzeuge"
