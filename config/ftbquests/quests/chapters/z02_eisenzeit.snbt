		{
			dependencies: ["383D2644464FE272"]
			description: ["&6Was ist das?", "Das Eisenzeit hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Eisenwerkzeug, Haemmer, Eisen-Ausruestung, Tiefer graben, Redstone-Technik, Tiere und Dorf, Neue Biome, Toms Storage, Rucksack, Sophisticated Storage, Teleport, Kueche, Brauen und Gaeren, Meeresfruechte, Erkunden, Unterwelten, Artefakte, Waffen, Neue Gegner, Dungeons-Waffen, Waffenkammer.", "", "&6So gehts", "Waehle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofuer ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins naechste. Nebenzweige kannst du jederzeit spaeter machen."]
			icon: { id: "minecraft:iron_pickaxe" }
			id: "56184FBD96403098"
			title: "Beginn: Eisenzeit"
			rewards: [{ id: "23B9F979A728EC1C", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "1FC8213F7685196D", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["3DF69134EC71DEA1"]
			description: ["&6Was ist das?", "Hier beginnt das Diamant-Zeitalter. Es schaltet frei:", "Diamantwerkzeug und -ruestung, Verzauberungstisch, Apothic Enchanting und Diamanthaemmer.", "", "&6So gehts", "Schliesse den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort fuer alle Spieler, auch fuer die, die gerade nicht online sind.", "", "&6Wofuer ist das wichtig?", "Im naechsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus frueheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "minecraft:diamond" }
			id: "32D7C0032123B540"
			title: "Zeitalter: Diamant-Zeitalter"
			rewards: [{ id: "6A491A2F9597089E", type: "historystages:history_stage", stage: "diamantzeit", remove: false, individual: false }, { id: "79DC8B483630D416", type: "xp_levels", xp_levels: 5 }]
