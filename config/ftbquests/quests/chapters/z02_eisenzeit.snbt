	quests: [
		{
			dependencies: ["56184FBD96403098"]
			description: ["&6Was ist das?", "Eine Eisenspitzhacke baut Diamanten ab. Schmelze Eisenerz im Ofen.", "", "&6So gehts", "Eisenerz schmelzen. Eisenspitzhacke: drei Eisenbarren, darunter die Steinspitzhacke und ein Stock.", "Fortschritt: Jede Stufe braucht das Werkzeug der vorherigen Stufe. Es ersetzt im Rezept den obersten Stock, direkt unter dem Kopf. JEI zeigt dir das genaue Rezept.", "", "&6Wofür ist das wichtig?", "Erst mit einer Eisenspitzhacke kannst du Gold, Redstone und Diamanten abbauen.", "", "&6Gut zu wissen", "Eisen hält rund doppelt so lange wie Stein (250 gegen 131 Nutzungen) und ist die Voraussetzung für Diamanten."]
			id: "269F5FBF41678363"
			title: "Eisenwerkzeuge"
			rewards: [{ id: "523FC697668E6553", type: "item", item: { id: "minecraft:iron_ingot", count: 4 } }]
			tasks: [{ id: "4EF4B9004656FE1B", type: "item", item: { id: "minecraft:iron_pickaxe", count: 1 }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
