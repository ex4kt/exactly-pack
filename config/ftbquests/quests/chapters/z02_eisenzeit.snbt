		}
		{
			dependencies: ["33609DAE7AF85E00"]
			description: ["&6Was ist das?", "Das Maschinengehäuse. Fast jeder Powah-Block braucht eins.", "", "&6So gehts", "Zuerst Dielektrische Stäbe (Eisengitter und Paste, senkrecht oder waagerecht). Dann: vier Eisenbarren, zwei senkrechte und zwei waagerechte Stäbe.", "", "&6Wofür ist das wichtig?", "Ohne Gehäuse kein Generator und keine Energiezelle."]
			id: "439E31C0B019C44F"
			title: "Dielektrisches Gehäuse"
			rewards: [{ id: "2C4594C6908C2601", type: "xp_levels", xp_levels: 2 }]
