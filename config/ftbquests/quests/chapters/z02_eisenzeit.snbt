			x: 6.00d
			y: 19.500d
		}
		{
			dependencies: ["439E31C0B019C44F"]
			description: ["&6Was ist das?", "Ein Generator, der aus festem Brennstoff Strom macht: Kohle, Holz und alles, was im Ofen brennt.", "", "&6So gehts", "Herstellung: fünf Dielektrische Pasten, zwei Winzige Kondensatoren, Dielektrisches Gehäuse und ein Ofen. Brennstoff hineinlegen oder per Trichter zuführen.", "", "&6Wofür ist das wichtig?", "Das ist der einfachste Strom im Pack, die Antwort auf den Kohlegenerator."]
			id: "48C2A55DC0616220"
			title: "Furnator"
			rewards: [{ id: "7F7DB81A28AE18FB", type: "xp_levels", xp_levels: 3 }]
