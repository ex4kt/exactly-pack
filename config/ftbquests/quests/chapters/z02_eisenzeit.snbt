		{
			dependencies: ["0EE8F1575F169E87"]
			description: ["&6Was ist das?", "Dungeons Arise, Cataclysm, Yungs und mehr bauen viele Strukturen in die Welt.", "Nimm Brot und Fackeln mit und schau in jede Truhe.", "", "&6So gehts", "Erkunden und Beute sammeln.", "", "&6Wofür ist das wichtig?", "Ausrüstung, Artefakte und Bosse."]
			id: "55A3471651407E87"
			title: "Dungeons entdecken"
			rewards: [{ id: "7628019177A9932A", type: "item", item: { id: "minecraft:bread", count: 8 } }]
