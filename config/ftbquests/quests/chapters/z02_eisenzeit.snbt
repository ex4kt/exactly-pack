			tasks: [{ id: "098C805F1722D522", type: "checkmark" }]
			x: 18.00d
			y: 4.500d
		}
		{
			dependencies: ["1375D3BF673B89FD"]
			description: ["&6Was ist das?", "Yungs Mods verbessern Minen, Dungeons, Festungen und Tempel. Erkunde eine Better Stronghold oder Better Mineshaft.", "", "&6So gehts", "Better Mineshafts findest du in Höhlen, Better Strongholds mit Enderaugen.", "Achte auf Fallen in Wüstentempeln und Dschungeltempeln.", "", "&6Wofür ist das wichtig?", "Die Festung (Stronghold) brauchst du für das Endportal. Minen haben Schienen, Kohle und Beute für den Anfang."]
