		{
			dependencies: ["696A20D593371128"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Die Naga wartet im Naga-Hof, einem ummauerten Platz mit Steinkreis im Zwielichtwald (die Magische Karte zeigt ihn).", "Sie greift im Sturm an: Weiche seitlich aus, wenn sie auf dich zurast, und schlage dann auf den Kopf. Ein Schild hilft.", "Bleibe nicht in Ecken stehen, sonst wirst du eingekesselt.", "", "&6Wofür ist das wichtig?", "Erst nach der Naga lassen sich die nächsten Gebiete sicher betreten."]
			id: "358FFAE3D3E9AA34"
			title: "Anleitung: Naga"
			rewards: [{ id: "05C8C50BE8754D37", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "784E28E189E4F11B", type: "checkmark" }]
			x: 6.00d
			y: -1.50d
		}
		{
			dependencies: ["5B16792C8C1E8D9B"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Der Lich sitzt oben im Lich-Turm. Erst musst du seine Schilde brechen: Schlage seine Feuerbälle mit dem Schwert zurück zu ihm.", "Er ruft Klone und Zombies. Kämpfe die Klone nicht, sie sind Ablenkung. Wenn er keine Schilde mehr hat, greife ihn direkt an.", "Nimm Heilung und Milch gegen Effekte mit.", "", "&6Wofür ist das wichtig?", "Er lässt das Lich-Zepter fallen und öffnet den Weg zu den nächsten Gebieten."]
			id: "13FFDAF980B8CF62"
			title: "Anleitung: Lich"
			rewards: [{ id: "354ED53167F6B525", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "341A9C35BAD7B2EF", type: "checkmark" }]
			x: 7.50d
			y: -1.50d
		}
		{
			dependencies: ["76237B0ECD40643E"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Die Hydra lebt im Feuersumpf. Nimm Feuerresistenz-Tränke und viel Essen mit.", "Sie hat mehrere Köpfe, die Feuer spucken. Schlage auf einen Kopf, wenn er das Maul öffnet und nah bei dir ist.", "Der Kampf dauert lange. Halte Abstand zum Feuerstrahl und heile dich zwischendurch.", "", "&6Wofür ist das wichtig?", "Ihr Fleisch und ihre Schuppen sind wertvoll, und sie öffnet den Weg zum dunklen Turm."]
			id: "56C9779F740A834A"
			title: "Anleitung: Hydra"
			rewards: [{ id: "541A99AC1BDC6910", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "4CC46A2628DEE7C5", type: "checkmark" }]
			x: 10.50d
			y: 1.50d
		}
		{
			dependencies: ["66280F7D142AA7D1"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Steige im Dunklen Turm nach oben. Zerstöre unterwegs die Ghast-Fallen und Turm-Ghasts.", "Der Ur-Ghast weint, wenn er getroffen wird. Locke kleine Ghasts in die Fallen und aktiviere sie mit Redstone, dann wird er schwach.", "Schlage seine Feuerbälle zurück und triff ihn mit dem Bogen.", "", "&6Wofür ist das wichtig?", "Er gibt Feurige Tränen für das Feuerige Eisen."]
			id: "3D6FAD7E05059B6D"
			title: "Anleitung: Ur-Ghast"
			rewards: [{ id: "736639322420E4F3", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "2917842F46757FA1", type: "checkmark" }]
			x: 13.50d
			y: 1.50d
		}
		{
			dependencies: ["55AC6F18F0BE8BBF"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Der Alpha-Yeti wohnt in einer Eishöhle in den Schneewäldern. Nimm warme Kleidung und Essen mit.", "Er wirft Eisblöcke und lässt Eiszapfen von der Decke fallen. Wenn er nach einem Sprung erschöpft ist, greife an.", "", "&6Wofür ist das wichtig?", "Sein Fell ergibt die Arktische Rüstung."]
			id: "0B5AA98E45452C9C"
			title: "Anleitung: Alpha-Yeti"
			rewards: [{ id: "00C13868BCE62CCD", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "274F473D527FF0F1", type: "checkmark" }]
			x: 15.00d
			y: 1.50d
		}
		{
			dependencies: ["60C2E7BB2A1D95A3"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Sie wartet oben im Gletscherpalast. Sie schießt Eis und lässt Eiskugeln um sich kreisen.", "Zerstöre zuerst die kreisenden Eisblöcke, dann ist sie verwundbar. Feuerschutz und Heilung helfen.", "", "&6Wofür ist das wichtig?", "Sie ist eine der letzten Herausforderungen im Zwielichtwald."]
			id: "0C4C7A4CB4DF686D"
			title: "Anleitung: Schneekönigin"
			rewards: [{ id: "0361CA4F1130314B", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "7E2A849646BFDC1F", type: "checkmark" }]
			x: 16.50d
			y: 1.50d
		}
		{
			dependencies: ["673AD22C2CF89227"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Der Slider ist ein steinerner Block im Bronze-Dungeon des Aethers. Er rutscht schnell auf dich zu.", "Er kann nur mit einer Spitzhacke verletzt werden. Weiche zur Seite aus und schlage zu, wenn er stoppt.", "", "&6Wofür ist das wichtig?", "Er gibt den Bronze-Schlüssel für die Beute im Dungeon."]
			id: "1D05E7C9C4FAC515"
			title: "Anleitung: Slider"
			rewards: [{ id: "1CE9C92A6744F6BD", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "73D1F578BFFFABDF", type: "checkmark" }]
			x: 28.50d
			y: 1.50d
		}
		{
			dependencies: ["6045835D096A13DD"]
			description: ["&6Was ist das?", "Schritt-für-Schritt-Anleitung für diesen Boss.", "", "&6So gehts", "Sie lebt im Silber-Dungeon. Besiege erst die Valkyren, um Medaillen zu sammeln, dann darf die Königin kämpfen.", "Sie wirft Blitze: Bleibe in Bewegung und greife sie an, wenn sie landet. Eine Feder (Goldene Feder) hilft gegen Fallschaden.", "", "&6Wofür ist das wichtig?", "Sie gibt den Silber-Schlüssel und starke Ausrüstung."]
			id: "4E2490D52895813D"
			title: "Anleitung: Valkyrie-Königin"
			rewards: [{ id: "097F8BEC726BAAEE", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "6ED99F2B544FB391", type: "checkmark" }]
			x: 31.50d
			y: -1.50d
		}
