	title: "&aVI. Zeitalter der Welten"
	quests: [
		{
			dependencies: ["760DF08E063B1E50"]
			description: ["&6Was ist das?", "Twilight Forest ist eine eigene Dimension. Wirf einen Diamanten in einen Teich mit Blumen drumherum.", "Dort beginnt ein langes Abenteuer mit vielen Bossen.", "", "&6So gehts", "Baue einen 2x2-Teich und stelle Blumen oder Gras ringsum. Wirf einen Diamanten hinein.", "Im Wald hilft die Magische Karte, Bosse zu finden.", "", "&6Wofür ist das wichtig?", "Bosse müssen in der richtigen Reihenfolge besiegt werden, sonst blockieren Fluch-Effekte den Weg. Die Reihenfolge zeigen die nächsten Quests.", "", "&6Gut zu wissen", "Das Portal entsteht, wenn du einen Diamanten in einen kleinen Wasserteich wirfst, der von Pflanzen und Blumen umgeben ist."]
			id: "615E21CD98E6C777"
			title: "Der Zwielichtwald"
			rewards: [{ id: "0E4DCF75ED52D30E", type: "item", item: { id: "minecraft:diamond", count: 1 } }]
			tasks: [{ id: "0D0DCCC83D45C02A", type: "dimension", dimension: "twilightforest:twilight_forest", icon: { id: "twilightforest:naga_scale" } }]
			x: 1.50d
			y: 0.00d
		}
		{
			dependencies: ["615E21CD98E6C777"]
			description: ["&6Was ist das?", "Die Magische Karte zeigt Biome, Bosse und Strukturen im Zwielichtwald.", "", "&6So gehts", "Werkbank: 8 Papier um 1 Magischen Karten-Fokus in der Mitte (Muster in JEI).", "Rechtsklick, um sie zu aktivieren.", "", "&6Wofür ist das wichtig?", "Ohne Karte findest du die Boss-Türme schwer."]
			id: "1EFE3DB449F102E0"
			title: "Magische Karte"
			rewards: [{ id: "35387593BB9D62AB", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "23430E55A624C218", type: "item", item: { id: "twilightforest:magic_map", count: 1 }, count: 1L }]
			x: 3.00d
			y: 0.00d
		}
		{
			dependencies: ["1EFE3DB449F102E0"]
			description: ["&6Was ist das?", "Die Naga ist der erste Boss des Waldes. Sie hat Schuppen als Beute.", "", "&6So gehts", "Sie lebt in einem Hof aus Steinen. Weiche ihren Angriffen seitlich aus.", "", "&6Wofür ist das wichtig?", "Naga-Schuppen ergeben Rüstung. Danach ist der Lich dran."]
			id: "696A20D593371128"
			title: "Naga"
			rewards: [{ id: "27AE84BC4AFB6611", type: "xp_levels", xp_levels: 8 }]
			tasks: [{ id: "51A4AA4B8C814B2B", type: "kill", entity: "twilightforest:naga", value: 1L, icon: { id: "twilightforest:naga_scale" } }]
			x: 4.50d
			y: 0.00d
		}
		{
			dependencies: ["696A20D593371128"]
			description: ["&6Was ist das?", "Der Lich ist ein mächtiger Zauberer und der erste echte Magie-Boss im Zwielichtwald.", "", "&6So gehts", "Wo: im Lich-Turm. Die Magische Karte zeigt dir den Weg.", "Vorbereitung: gute Rüstung, Heiltränke, ein Schwert. Er hat Schild-Klone, die du zuerst zerstörst.", "Seine Feuerbälle schlägst du mit Schwert oder Hand zurück. Triffst du ihn damit, wird er schwächer.", "Ist der Schild weg, schlage ihn direkt an.", "", "&6Wofür ist das wichtig?", "Danach öffnet sich das Labyrinth mit dem Minoshroom.", "", "&6Gut zu wissen", "Beute: Zepter (Zombie, Lebensentzug, Verstärkung, Zwielicht), Trophäe, Goldrüstung, Perlen und Knochen."]
			id: "5B16792C8C1E8D9B"
			title: "Lich"
			rewards: [{ id: "3C52BD66AC8039EC", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "7DFD578DDD7A8EDC", type: "kill", entity: "twilightforest:lich", value: 1L, icon: { id: "twilightforest:lich_trophy" } }]
			x: 6.00d
			y: 0.00d
		}
		{
			dependencies: ["5B16792C8C1E8D9B"]
			description: ["&6Was ist das?", "Der Minoshroom bewacht das Labyrinth im Sumpf.", "", "&6So gehts", "Wo: in einem Labyrinth im Zwielichtwald. Nimm eine Magische Karte mit, sonst verläufst du dich.", "Vorbereitung: Feuerresistenz-Trank, gute Rüstung, Essen.", "Er rennt auf dich zu. Weiche seitlich aus und schlage nach dem Angriff zu.", "", "&6Wofür ist das wichtig?", "Er öffnet den Weg zur Hydra.", "", "&6Gut zu wissen", "Beute: Meef-Stroganoff, Diamant-Minotaurenaxt, Trophäe."]
			id: "342712AE7D324792"
			title: "Minoshroom"
			rewards: [{ id: "4E2ADF01B2881B05", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "454BA732E348B8C7", type: "kill", entity: "twilightforest:minoshroom", value: 1L, icon: { id: "twilightforest:meef_stroganoff" } }]
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["342712AE7D324792"]
			description: ["&6Was ist das?", "Die Hydra hat viele Köpfe. Sie lebt in einer Höhle im Feuersumpf.", "", "&6So gehts", "Wo: Feuersumpf im Zwielichtwald, in der Hydra-Höhle.", "Vorbereitung: Feuerresistenz-Trank, Wasser, gute Rüstung. Sie speit Feuer.", "Schlage die Köpfe, wenn sie den Mund öffnen. Ein Kopf wächst nach, wenn du ihn nicht ausschaltest.", "Bleib nicht direkt vor ihr stehen. Weiche aus, wenn sie beißt.", "", "&6Wofür ist das wichtig?", "Danach folgen Ritter und Ur-Ghast.", "", "&6Gut zu wissen", "Beute: Hydra-Fleisch, Feuriges Blut, Trophäe."]
			id: "76237B0ECD40643E"
			title: "Hydra"
			rewards: [{ id: "00C563F45208EB03", type: "xp_levels", xp_levels: 12 }]
			tasks: [{ id: "1028FC0C83379DA1", type: "kill", entity: "twilightforest:hydra", value: 1L, icon: { id: "twilightforest:hydra_chop" } }]
			x: 9.00d
			y: 0.00d
		}
		{
			dependencies: ["76237B0ECD40643E"]
			description: ["&6Was ist das?", "Die Ritterphantome wohnen in der Ritterfestung.", "", "&6So gehts", "Wo: in der Festung der Ritter im Zwielichtwald. Nimm Rüstung und Heiltränke mit.", "Es sind mehrere Phantome. Kämpfe in der Mitte, damit sie nacheinander kommen.", "Weiche aus und schlage zu, sobald sie dich verfehlen.", "", "&6Wofür ist das wichtig?", "Rittermetall für starke Rüstung und Werkzeuge.", "", "&6Gut zu wissen", "Beute: Ritter-Axt, -Spitzhacke, -Schwert, Phantomhelm und -brustplatte."]
			id: "5CD31E7179253C01"
			title: "Ritterphantome"
			rewards: [{ id: "67F8DE226209DE74", type: "xp_levels", xp_levels: 10 }]
			tasks: [{ id: "0D4F8FE6D7BE81C2", type: "kill", entity: "twilightforest:knight_phantom", value: 1L, icon: { id: "twilightforest:knightmetal_ingot" } }]
			x: 10.50d
			y: 0.00d
		}
		{
			dependencies: ["5CD31E7179253C01"]
			description: ["&6Was ist das?", "Der Ur-Ghast herrscht im Dunklen Turm.", "", "&6So gehts", "Wo: ganz oben im Dunklen Turm im Dunkelwald.", "Vorbereitung: Feuerresistenz, Heilung und Fernkampf. Er schießt Feuerbälle.", "Zerstöre zuerst seine Ghast-Fallen. Dann wird er schwächer.", "Triff ihn mit dem Bogen oder schlage seine Feuerbälle zurück.", "", "&6Wofür ist das wichtig?", "Seine Tränen machen Feuriges Eisen und helfen weiter.", "", "&6Gut zu wissen", "Beute: Feurige Tränen, Karminit, Trophäe."]
			id: "66280F7D142AA7D1"
			title: "Ur-Ghast"
			rewards: [{ id: "6420BABFB5E3C2FA", type: "xp_levels", xp_levels: 12 }]
			tasks: [{ id: "134C33F8915D11E9", type: "kill", entity: "twilightforest:ur_ghast", value: 1L, icon: { id: "twilightforest:fiery_tears" } }]
			x: 12.00d
