		{
			dependencies: ["388349920682B0BC"]
			description: ["&6Was ist das?", "Das Zeitalter der Welten hat begonnen. Jede Linie, die von hier abgeht, ist ein eigener Zweig.", "Zweige: Zwielichtwald, Zwielicht-Schmiede, Zwielicht-Beute, Aether, Aether-Werkstatt, Aether-Ausrüstung, Aether-Schätze, Aether-Leben.", "", "&6So gehts", "Wähle einen Zweig und arbeite ihn von links nach rechts ab. Manche Zweige teilen sich weiter auf.", "Die Abschluss-Quest ganz rechts braucht nur die wichtigen Zweige. Alle anderen sind freiwillig, lohnen sich aber.", "", "&6Wofür ist das wichtig?", "Mit dem Abschluss dieses Zeitalters geht es ins nächste. Nebenzweige kannst du jederzeit später machen."]
			icon: { id: "twilightforest:magic_map" }
			id: "760DF08E063B1E50"
			title: "Beginn: Zeitalter der Welten"
			rewards: [{ id: "4D7083D0EC9DB8F0", type: "xp_levels", xp_levels: 2 }]
			tasks: [{ id: "178C2653F0F644AB", type: "checkmark" }]
			shape: "hexagon"
			size: 1.5d
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["39C29971247BFC95"]
			description: ["&6Was ist das?", "Hier beginnt das End-Zeitalter. Es schaltet frei:", "Das Ende: Das Endportal lässt dich jetzt durch.", "", "&6So gehts", "Schließe den Hauptpfad dieses Kapitels ab.", "Hake diese Quest ab und hol dir die Belohnung. Erst die Belohnung schaltet das Zeitalter frei.", "Das gilt sofort für alle Spieler, auch für die, die gerade nicht online sind.", "", "&6Wofür ist das wichtig?", "Im nächsten Kapitel wartet der Hauptpfad des neuen Zeitalters.", "Nebenquests aus früheren Zeitaltern kannst du jederzeit nachholen."]
			icon: { id: "minecraft:end_stone" }
			id: "61920C28D0F155A0"
			title: "Zeitalter: End-Zeitalter"
			rewards: [{ id: "0F87A4A588C6C291", type: "historystages:history_stage", stage: "endzeit", remove: false, individual: false }, { id: "324CCEBBF1C242C5", type: "xp_levels", xp_levels: 5 }]
