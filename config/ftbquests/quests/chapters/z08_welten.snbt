			title: "Cockatrice"
			rewards: [{ id: "37559E0A147D7BF0", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "0BA1CCC2971C818E", type: "kill", entity: "aether:cockatrice", value: 1L, icon: { id: "aether:poison_dart" } }]
			x: 24.0d
