		}
		{
			dependencies: ["66280F7D142AA7D1"]
			description: ["&6Was ist das?", "Der Alpha-Yeti lebt in der Eishöhle im Schneewald.", "", "&6So gehts", "Wo: in der Yeti-Höhle im Schneewald. Nimm Rüstung und Heilung mit.", "Er wirft Eisbomben und lässt Eiszapfen fallen. Weiche aus.", "Schlage zu, wenn er nach dem Wurf steht.", "", "&6Wofür ist das wichtig?", "Sein Fell macht warme Rüstung und Eisbomben.", "", "&6Gut zu wissen", "Beute: Alpha-Yeti-Fell, Eisbomben, Trophäe."]
			id: "55AC6F18F0BE8BBF"
