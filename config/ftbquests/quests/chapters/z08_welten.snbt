		{
			dependencies: ["76237B0ECD40643E"]
			description: ["&6Was ist das?", "Schritt-fuer-Schritt-Anleitung fuer diesen Boss.", "", "&6So gehts", "Die Hydra lebt im Feuersumpf. Nimm Feuerresistenz-Traenke und viel Essen mit.", "Sie hat drei Koepfe, die Feuer spucken. Schlage auf einen Kopf, wenn er das Maul oeffnet und nah bei dir ist.", "Der Kampf dauert lange. Halte Abstand zum Feuerstrahl und heile dich zwischendurch.", "", "&6Wofuer ist das wichtig?", "Ihr Fleisch und ihre Schuppen sind wertvoll, und sie oeffnet den Weg zum dunklen Turm."]
			id: "56C9779F740A834A"
			title: "Anleitung: Hydra"
			rewards: [{ id: "541A99AC1BDC6910", type: "xp_levels", xp_levels: 3 }]
			tasks: [{ id: "AC0AE339F430AC05", type: "checkmark" }]
			x: 9.0d
			y: -2.0d
		}
		{
			dependencies: ["66280F7D142AA7D1"]
			description: ["&6Was ist das?", "Schritt-fuer-Schritt-Anleitung fuer diesen Boss.", "", "&6So gehts", "Steige im Dunklen Turm nach oben. Zerstoere unterwegs die Ghast-Fallen und Turm-Ghasts.", "Der Ur-Ghast weint, wenn er getroffen wird. Locke kleine Ghasts in die Fallen und aktiviere sie mit Redstone, dann wird er schwach.", "Schlage seine Feuerbaelle zurueck und triff ihn mit dem Bogen.", "", "&6Wofuer ist das wichtig?", "Er gibt Feurige Traenen fuer das Feuerige Eisen."]
			id: "C20C8905BA47CAC4"
			title: "Anleitung: Ur-Ghast"
